<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="view_customization.SaleOrderSystray">
    <div class="o_sale_systray_item d-flex align-items-center px-2"
         t-on-click="onClick"
         style="cursor:pointer;">

      <i class="fa fa-shopping-cart me-1"/>

      <!-- Badge with count -->
      <span t-if="state.count > 0"
            class="badge bg-danger rounded-pill">
        <t t-esc="state.count"/>
      </span>

      <span t-else="" class="badge bg-secondary rounded-pill">
        0
      </span>

      <span class="ms-1 d-none d-md-inline">
        Pending Orders
      </span>

    </div>
  </t>

</templates>