<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="view_customization.ColorAmountField">
    <div class="o_color_amount_field d-flex align-items-center gap-2">

      <span t-att-style="
              'color:' + colorStyle.color + ';' +
              'font-weight:' + colorStyle.fontWeight + ';' +
              'font-size:' + colorStyle.fontSize">
        <t t-esc="formattedAmount"/>
      </span>

      <span class="badge"
            t-att-style="'background-color:' + colorStyle.color">
        <t t-esc="label"/>
      </span>

    </div>
  </t>

</templates>