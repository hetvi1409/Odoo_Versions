<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_event_form_view" model="ir.ui.view">
        <field name="name">product.event.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_id']"
                position="after">
                <field name="picking_type_id" optional="show" />
            </xpath>

        </field>
    </record>
</odoo>