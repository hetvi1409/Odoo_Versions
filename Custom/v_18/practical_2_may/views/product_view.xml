<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_product_form_inherit_event" model="ir.ui.view">
        <field name="name">product.product.form.inherit.event</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='type']" position="before">
                <field name="event_id" />
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Events" name="product_events">
                    <field name="event_new_ids" widget="one2many_list">
                        <list string="Events" editable="bottom">
                            <field name="event_id" />
                            <field name="event_new_image" widget="image" />
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>