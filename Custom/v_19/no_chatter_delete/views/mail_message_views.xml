<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view for the audit log -->
    <record id="view_mail_message_delete_log_tree" model="ir.ui.view">
        <field name="name">mail.message.delete.log.tree</field>
        <field name="model">mail.message.delete.log</field>
        <field name="arch" type="xml">
            <list string="Deleted Message Audit Log" create="false" delete="false" edit="false">
                <field name="deleted_on"/>
                <field name="deleted_by"/>
                <field name="delete_reason"/>
                <field name="message_type"/>
                <field name="author_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <!-- Form view so admins can read the full deleted message body -->
    <record id="view_mail_message_delete_log_form" model="ir.ui.view">
        <field name="name">mail.message.delete.log.form</field>
        <field name="model">mail.message.delete.log</field>
        <field name="arch" type="xml">
            <form string="Deleted Message Detail" create="false" delete="false">
                <sheet>
                    <group>
                        <group string="Deletion Info">
                            <field name="deleted_by"/>
                            <field name="deleted_on"/>
                            <field name="delete_reason"/>
                        </group>
                        <group string="Original Message Info">
                            <field name="author_id"/>
                            <field name="message_type"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="message_id_ref"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="message_body" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu action to access the audit log from Settings -->
    <record id="action_mail_message_delete_log" model="ir.actions.act_window">
        <field name="name">Deleted Message Audit Log</field>
        <field name="res_model">mail.message.delete.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mail_message_delete_log"
              name="Deleted Message Log"
              parent="mail.menu_root_discuss"
              action="action_mail_message_delete_log"
              groups="base.group_system"
              sequence="100"/>

    <!-- Tab on Users to track deleted-note audit logs for that user -->
    <record id="view_users_form_deleted_note_audit" model="ir.ui.view">
        <field name="name">res.users.form.deleted.note.audit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="deleted_note_audit" string="Audit Note Track" groups="base.group_system">
                    <field name="deleted_message_log_ids" nolabel="1" readonly="1">
                        <list string="Deleted Message Audit Log" create="false" delete="false" edit="false">
                            <field name="deleted_on"/>
                            <field name="deleted_by"/>
                            <field name="delete_reason"/>
                            <field name="message_type"/>
                            <field name="author_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </list>
                        <form string="Deleted Message Detail" create="false" delete="false">
                            <sheet>
                                <group>
                                    <group string="Deletion Info">
                                        <field name="deleted_by"/>
                                        <field name="deleted_on"/>
                                        <field name="delete_reason"/>
                                    </group>
                                    <group string="Original Message Info">
                                        <field name="author_id"/>
                                        <field name="message_type"/>
                                        <field name="res_model"/>
                                        <field name="res_id"/>
                                        <field name="message_id_ref"/>
                                    </group>
                                </group>
                                <group string="Message Content">
                                    <field name="message_body" nolabel="1" readonly="1"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
