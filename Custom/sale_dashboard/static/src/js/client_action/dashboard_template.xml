<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
  <t t-name="sale_dashboard.sale_dashboard_template">
    <div class="o_sale_dashboard_wrap d-flex flex-column">
        <h1>Sale Dashboard</h1>
        <div class="o_sale_dashboard_charts d-flex flex-wrap justify-content-between">
            <div id="o_sale_dashboard_invoices_chart" class="o_sale_dashboard_chart_card p-3 mb-4">
            <h5>Invoices Overview</h5>
            <canvas id="invoices_chart_canvas"></canvas>
            </div>
            <div id="o_sale_dashboard_payments_chart" class="o_sale_dashboard_chart_card p-3 mb-4">
            <h5>Payments Overview</h5>
            <canvas id="payments_chart_canvas"></canvas>
            </div>
        </div>
    </div>
  </t>
</templates>