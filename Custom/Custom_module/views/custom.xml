<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sage_response_view_tree" model="ir.ui.view">
        <field name="name">custom.model.view.list</field>
        <field name="model">custom.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="sage_response_view_form" model="ir.ui.view">
        <field name="name">custom.model.form</field>
        <field name="model">custom.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>


    <record id="custom_model_action" model="ir.actions.act_window">
        <field name="name">Custom</field>
        <field name="res_model">custom.model</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>