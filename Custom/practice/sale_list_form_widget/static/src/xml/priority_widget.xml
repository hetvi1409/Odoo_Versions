<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        t-name must match static template = "..." in your JS class.
        owl="1" tells Odoo this is an OWL template (not legacy QWeb).
    -->
    <t t-name="sale_list_form_widget.PriorityBadge" owl="1">
        <!--
            t-att-class dynamically sets the CSS class.
            badgeClass is the getter we defined in the JS component.
        -->
        <span t-att-class="'priority-badge ' + badgeClass">
            <!-- badgeLabel is the human-readable text getter from JS -->
            <t t-esc="badgeLabel"/>
        </span>
    </t>

</templates>