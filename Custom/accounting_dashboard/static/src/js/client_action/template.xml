<!--PERFECT DESIGN BUT WHEN CHANGE IN YEAR IT WILL MESS-->
<templates xml:space="preserve">
  <t t-name="accounting_dashboard.accounting_dashboard_template">
    <div class="o_accounting_dashboard_wrap d-flex flex-column">
      <div class="o_financial_dashboard container-fluid p-3" style="max-height: 100vh; overflow-y: auto;">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="fw-bold">Financial Report</h3>

            <select class="form-select w-auto" t-on-change="onYearChange">
                  <t t-foreach="state.year_range" t-as="year" t-key="year">
                    <option t-att-value="year"
                            t-att-selected="year === state.year ? 'selected' : false">
                      <t t-esc="year"/>
                    </option>
                  </t>
            </select>
        </div>

        <!-- First Row: KPI Boxes -->
        <div class="row mb-3 text-center">
          <div class="col">
            <div class="card shadow-sm">
              <div class="card-body p-2">
                <h6>Revenue</h6>
                  <img t-att-src="'/accounting_dashboard/static/src/img/revenue.jpg'" style="height: 80px;" alt="Revenue" class="img-fluid mb-2"/>
                  <h4 id="revenue_val"><t t-esc="state.data.revenue"/></h4>
              </div>
            </div>
          </div>
          <div class="col">
            <div class="card shadow-sm">
              <div class="card-body p-2">
                <h6>Gross Profit</h6>
                  <img t-att-src="'/accounting_dashboard/static/src/img/gross_profit.png'" style="height: 80px;" alt="Gross Profit" class="img-fluid mb-2"/>
                  <h4 id="gross_profit_val">
                    <t t-esc="state.data.other_income + state.data.revenue"/>
                  </h4>
              </div>
            </div>
          </div>
          <div class="col">
            <div class="card shadow-sm">
              <div class="card-body p-2">
                <h6>EBIT</h6>
