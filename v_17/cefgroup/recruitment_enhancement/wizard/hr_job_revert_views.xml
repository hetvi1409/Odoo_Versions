<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
            <record id="hr_job_revert_view_form" model="ir.ui.view">
            <field name="name">hr.job.revert.view.form</field>
            <field name="model">hr.job.revert</field>
            <field name="arch" type="xml">
                <form string="Change Product Qty">
                    <group>
                                <field name="comments"/>
                    </group>
                    <footer>
                        <button name="action_submit" string="Submit" data-hotkey="q"
                            colspan="1" type="object" class="btn-primary"/>
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
</odoo>