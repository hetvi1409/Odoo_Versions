<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_applicant_profile_tree" model="ir.ui.view">
        <field name="name">applicant.profile.tree</field>
        <field name="model">applicant.profile</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <tree string="Applicant Profile" create="1">
                <field name="name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="skill_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="view_applicant_profile_tree_skill" model="ir.ui.view">
        <field name="name">applicant.profile.tree</field>
        <field name="model">applicant.profile</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree string="Applicant Profile" create="0">
                <field name="name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="skill_ids" widget="many2many_tags"/>
                <field name="matching_skill_ids" widget="many2many_tags" />
                <field name="missing_skill_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record id="view_applicant_profile_view_search" model="ir.ui.view">
        <field name="name">applicant.profile.view.search</field>
        <field name="model">applicant.profile</field>
        <field name="arch" type="xml">
            <search string="Candidates">
                <field name="surname"/>
                <field name="email_from"/>
                <field name="skill_ids"/>
                <filter string="My Candidates" name="my_candidates" domain="[('manager_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('manager_id', '=', False)]"/>
                <separator/>
                <filter string="Creation Date" name="filter_create" date="create_date"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Manager" name="group_by_manager" domain="[]" context="{'group_by': 'manager_id'}"/>
                    <filter string="Gender" name="group_by_gender" domain="[]" context="{'group_by': 'gender'}"/>
                    <filter string="Skills" name="group_by_skills" context="{'group_by': 'skill_ids'}"/>
                    <filter string="Race" name="group_by_race" domain="[]" context="{'group_by': 'race'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_applicant_profile_form" model="ir.ui.view">
        <field name="name">applicant.profile.form</field>
        <field name="model">applicant.profile</field>
        <field name="arch" type="xml">
            <form string="Applicant Profile" create="1">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_applications" class="oe_stat_button" icon="fa-pencil" type="object" invisible="not application_count">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="email_from" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>

                        <group>
                            <field name="user_id"/>
                            <field name="manager_id"/>
                            <field name="source_id"/>
                        </group>
                    </group>
                    <notebook id="view_users_simple_form">
                        <page name="additional_details"
                              string="Additional Details">
                            <group>
                                <group string="Personal Details">
                                    <field name="title_id"/>
                                    <field name="initial"/>
                                    <field name="surname"/>
                                    <field name="passport"/>
                                    <field name="country_id"/>
                                    <field name="date_of_birth"/>
                                    <field name="language_id"/>
                                    <field name="gender"/>
                                    <field name="race"/>
                                    <field name="disability"/>
                                    <field name="desc_disability"/>
                                </group>
                                <group string="Educational and Work Details">
                                    <field name="have_honours"/>
                                    <field name="have_master"/>
                                    <field name="professional_body"/>
                                    <field name="work_experience"/>
                                    <field name="last_role"/>
                                    <field name="exp_by_role"/>
                                    <field name="current_salary"/>
                                    <field name="notice_period"/>
                                    <field name="relocate"/>
                                    <field name="cv" filename="cv_name"/>
                                    <field name="terms_conditions"/>
                                </group>
                            </group>
                        </page>
                        <page string="Skills">
                            <div class="row ms-2">
                                <div class="o_hr_skills_editable o_hr_skills_group o_group_skills col-lg-5 d-flex flex-column">
                                    <field name="id" invisible="1"/>
                                    <field mode="tree" nolabel="1"
                                           name="applicant_skill_ids"
                                           widget="skills_one2many">
                                        <tree>
                                            <field name="skill_type_id"
                                                   optional="hidden"/>
                                            <field name="skill_id"/>
                                            <field name="skill_level_id"/>
                                            <field name="level_progress"
                                                   widget="progressbar"/>
                                        </tree>
                                    </field>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_applicant_profile" model="ir.actions.act_window">
        <field name="name">Applicant Profile</field>
        <field name="res_model">applicant.profile</field>
        <field name="view_mode">tree,form</field>
        <!--        <field name="domain">[('share', '=', True)]</field>-->
    </record>

    <menuitem
            id="hr_recruitment_menu_applicant_profiles"
            name="Applicant Profiles"
            action="action_applicant_profile"
            parent="hr_recruitment.menu_hr_recruitment_root"
            sequence="25"/>
</odoo>
