<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_send_to_applicant"
            model="mail.template">
        <field name="name">Review Application</field>
        <field name="model_id"
               ref="recruitment_enhancement.model_hr_applicant"/>
        <field name="subject">Review The Application: {{object.name}}</field>
        <field name="description">Review</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi ,
                    <br/>
                    Please Review this application
                    <b>
                        <t t-out="object.name"/>
                    </b>
                    .
                    Applicant name:
                    <t t-out="object.partner_name"/>
                </p>
            </div>
            <div style="margin: 16px 0px 16px 0px;">
                <a t-att-href="(object.get_list_url())"
                   style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                    <t>
                        Open
                        <t t-out="object.name"/>
                    </t>
                </a>
            </div>
        </field>
    </record>
