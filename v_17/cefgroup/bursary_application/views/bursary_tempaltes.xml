<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="menu_my_bursaries" model="website.menu">
        <field name="name">Bursaries</field>
        <field name="url">/bursaries</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>

    <template id="bursary_template" name="Bursary Listing Styled">
        <t t-call="website.layout">
            <div class="container mt-4 mb-4">
                <h2 class="text-center mb-4">Available Bursaries</h2>
                <div class="row">
                    <t t-foreach="bursaries" t-as="bursary">
                        <div class="col-12 mb-4 position-relative">
                            <a t-attf-href="/bursary/#{bursary.id}" class="text-decoration-none text-reset">

                                <div class="card shadow-sm border rounded p-3 position-relative"
                                     style="min-height: 150px;">
                                    <h5 class="fw-bold text-dark mb-2">
                                        <t t-esc="bursary.name"/>
                                    </h5>
                                    <div style="overflow: hidden; height: 100px;">
                                        <p class="text-muted">
                                            <t t-esc="bursary.description"/>
                                        </p>
                                        <p class="text-muted">
                                            <b>Eligibility:</b>
                                            <t t-esc="bursary.eligibility"/>
                                        </p>
                                    </div>
                                    <div class="d-flex align-items-center flex-wrap mt-3 position-relative">
                                        <t t-if="not bursary.website_published">
                                            <span class="badge bg-danger text-light">Unpublished</span>
                                        </t>
                                        <div class="ms-auto">
                                            <a t-att-href="'/bursary/' + str(bursary.id)"
                                               class="btn btn-sm btn-primary me-2">Read More
                                            </a>
                                            <a t-att-href="'/bursary_application?bursary_id=' + str(bursary.id)"
                                               class="btn btn-sm btn-primary">Apply Now!
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    <template id="bursary_detail_template" name="Bursary Detail Page">
        <t t-call="website.layout">
            <nav class="navbar navbar-light border-top shadow-sm d-print-none">
                <div class="container">
                    <div class="d-flex flex-column flex-md-row flex-md-wrap flex-lg-nowrap justify-content-between w-100">
                        <!-- Title -->
                        <span class="navbar-brand h4 my-0 me-auto">
                            <a t-attf-href="/bursaries">
                                <i class="fa fa-long-arrow-left text-primary me-2"/>
                                All Bursaries
                            </a>
                        </span>
                    </div>
                </div>
            </nav>
            <t t-set="main_object" t-value="bursary"/>
            <div class="container py-5">
                <!-- Background Image Banner (from static file) -->
                <div class="mb-4 rounded shadow" style="
                        background-image: url('/bursary_application/static/src/img/image5.jpeg');
                        background-size: cover;
                        background-position: center;
                        height: 370px;
                        position: relative;
                    ">
                    <div style="
                            background: rgba(0,0,0,0.5);
                            color: white;
                            position: absolute;
                            bottom: 0;
                            width: 100%;
                            padding: 1rem;
                        ">
                        <div class="text-center mb-4">
                            <p>
                                <t t-esc="bursary.name"/>
                            </p>
                        </div>
                    </div>
                </div>

                <p>
                    <t t-esc="bursary.description"/>
                </p>
                <p>
                    <b>Eligibility :</b>
                    <t t-esc="bursary.eligibility"/>
                </p>
                <p>
                    <b>Required Documents :</b>
                    <t t-esc="bursary.required_documents"/>
                </p>
                <div class="d-flex flex-column">
                    <div t-if="bursary.application_start_date"
                         class="d-inline-flex align-items-center">
                        <i class="fa fa-bolt fa-fw" title="Salary"
                           role="img" aria-label="Work Level"/>
                        Start End Date:
                        <span t-field="bursary.application_start_date" class="fw-light"
                              style="margin-left: 5px;"/>
                        -
                        <span t-field="bursary.application_end_date" class="fw-light"
                              style="margin-left: 5px;"/>
                    </div>
                    <div t-if="bursary.academic_year_id"
                         class="d-inline-flex align-items-center">
                        <i class="fa fa-suitcase fa-fw" title="Salary"
                           role="img" aria-label="EE Position"/>
                        Academic Year:
                        <span t-field="bursary.academic_year_id" class="fw-light"
                              style="margin-left: 5px;"/>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/bursaries" class="btn btn-secondary">Back to Bursaries</a>
                    <a t-attf-href="/bursary_application?bursary_id={{ bursary.id }}" class="btn btn-primary">Apply
                        Now
                    </a>
                </div>
            </div>
        </t>
    </template>
    <template id="application_pager" name="Bursary Application">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="mb-4 rounded shadow" style="
                        background-image: url('/bursary_application/static/src/img/image5.jpeg');
                        background-size: cover;
                        background-position: center;
                        height: 370px;
                        position: relative;
                    ">
                    <div style="
                            background: rgba(0,0,0,0.5);
                            color: white;
                            position: absolute;
                            bottom: 0;
                            width: 100%;
                            padding: 1rem;
                        ">
                        <div class="text-center mb-4">
                            <p>Apply for Bursary application</p>
                        </div>
                    </div>
                </div>
                <nav aria-label="breadcrumb" class="mt-5">
                    <ol class="breadcrumb ps-0 mb-0 pb-1">
                        <li class="breadcrumb-item">
                            <a href="/bursaries" class="text-secondary fw-bold">
                                Bursaries
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <a t-attf-href="/bursary/#{int(bursary_id)}">
                                <t t-if="bursary_name">
                                    <span t-esc="bursary_name"/>
                                </t>
                                <t t-else="">
                                    <span>Bursary</span>
                                </t>
                            </a>
                        </li>
                    </ol>
                </nav>
                <br/>
                <form method="POST" id="bursary_application" action="/bursary_application"
                      enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="bursary_id" t-att-value="bursary_id"/>

                    <!-- Personal Information -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Personal Information</h4>
                        <input type="hidden" name="bursary_id" t-att-value="bursary_id"/>
                        <input type="hidden" name="bursary_name" t-att-value="bursary_name"/>
                        <div class="row">
                            <div class="col-md-4">
                                <label>Name</label>
                                <input name="name" type="text" class="form-control" required="1"/>
                            </div>
                            <div class="col-md-4">
                                <label>Surname</label>
                                <input name="surname" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Student Email</label>
                                <input name="student_email" type="email" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Student Contact Number</label>
                                <input name="student_number" type="text" class="form-control" required="1"/>
                            </div>
                            <div class="col-md-4">
                                <label>Date of Birth</label>
                                <input name="date_of_birth" type="date" class="form-control" required="1"/>
                            </div>
                            <div class="col-md-4">
                                <label>ID Number</label>
                                <input name="id_number" type="text" class="form-control" required="1"/>
                            </div>
                            <div class="col-md-4">
                                <label>Gender</label>
                                <select name="gender" class="form-control" required="1">
                                    <option value="female">Female</option>
                                    <option value="male">Male</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Nationality</label>
                                <select name="nationality" class="form-control" required="1">
                                    <option value="sa">South African</option>
                                    <option value="non_sa">Non-South African</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Province</label>
                                <select name="province_id"
                                        id="province_id" required="True"
                                        style="width:100%;background: white;border: 1px solid #CED4DA;height: 38px;border-radius: 4px;">
                                    <option t-att-selected=""/>
                                    <t t-set="provinces"
                                       t-value="request.env['res.province'].search([])"/>
                                    <t t-foreach="provinces"
                                       t-as="province">
                                        <option t-att-value="province.id">
                                            <t t-esc="province.province"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Place of Birth</label>
                                <input name="place_of_birth" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Race</label>
                                <select name="race" class="form-control" required="1">
                                    <option value="african">African</option>
                                    <option value="coloured">Coloured</option>
                                    <option value="indian">Indian</option>
                                    <option value="white">White</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Disability</label>
                                <select name="disability" class="form-control" id="disability">
                                    <option value=""></option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>
                            </div>
                            <div id="disability_type" class="col-md-4 d-none">
                                <label>Disability Type</label>
                                <input name="disability_type" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Current Activity</label>
                                <select name="race" class="form-control" required="1">
                                    <option value="gap">Gap Year</option>
                                    <option value="matric">Matric</option>
                                    <option value="college">Tertiary/College</option>
                                </select>
                            </div>
                            <!--                            <div class="col-md-4">-->
                            <!--                                <label>Are you a South African citizen</label>-->
                            <!--                                <select name="is_citizen" class="form-control" id="is_citizen" required="1">-->
                            <!--                                    <option value=""></option>-->
                            <!--                                    <option value="yes">Yes</option>-->
                            <!--                                    <option value="no">No</option>-->
                            <!--                                </select>-->
                            <!--                            </div>-->
                        </div>
                    </div>

                    <!-- Parent/Guardian Details -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Parent/Guardian Details</h4>
                        <div class="row">
                            <div class="col-md-4">
                                <label>Contact Number</label>
                                <input name="contact_number" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Alt. Number</label>
                                <input name="alt_number" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Email</label>
                                <input name="email" type="email" class="form-control" required="1"/>
                            </div>
                            <div class="col-md-12">
                                <label>Address</label>
                                <input name="address" type="text" class="form-control"/>
                            </div>
                            <!--                            <div class="col-md-4">-->
                            <!--                                <label>Does the combined household income fall below threshold (600K)</label>-->
                            <!--                                <select name="income_below_600k" class="form-control" id="income_below_600k" required="1">-->
                            <!--                                    <option value=""></option>-->
                            <!--                                    <option value="yes">Yes</option>-->
                            <!--                                    <option value="no">No</option>-->
                            <!--                                </select>-->
                            <!--                            </div>-->
                            <div class="col-md-4">
                                <label>Mother Name</label>
                                <input name="mother_name" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Father Name</label>
                                <input name="father_name" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Guardian Name</label>
                                <input name="guardian_name" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Annual Income</label>
                                <input name="annual_income" type="number" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Payslips</label>
                                <input name="payslips" type="file" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Parent Deceased</label>
                                <select name="parent_deceased" class="form-control" id="parent_deceased">
                                    <option value=""></option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>
                            </div>
                            <div id="death_certificate" class="col-md-4 d-none">
                                <label>Death Certificate</label>
                                <input name="death_certificate" type="file" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <!-- Academic Information -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Academic Information</h4>
                        <div class="row">
                            <div class="col-md-4">
                                <label>Highest Grade</label>
                                <input name="highest_grade" type="text" class="form-control" required="1"/>
                            </div>
                            <div class="col-md-4">
                                <label>Grade 12 Average</label>
                                <input name="grade12_avg" type="number" step="0.01" class="form-control"
                                       required="1"/>
                            </div>
                            <div class="col-md-4">
                                <label>Currently Studying</label>
                                <input name="currently_studying" type="checkbox"/>
                            </div>
                            <div class="col-md-4">
                                <label>Academic Records</label>
                                <input name="academic_records" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Current Qualification</label>
                                <input name="current_qualification" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Institution</label>
                                <input name="institution" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Year of Completion</label>
                                <input name="year_of_completion" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Funding Source</label>
                                <select name="funding_source" class="form-control">
                                    <option value="parents">Parents</option>
                                    <option value="loan">Loan</option>
                                    <option value="bursary">Bursary</option>
                                    <option value="nsfas">NSFAS</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <!--                            <div class="col-md-4">-->
                            <!--                                <label>Age 16-26</label>-->
                            <!--                                <select name="age_16_26" class="form-control" id="age_16_26" required="1">-->
                            <!--                                    <option value=""></option>-->
                            <!--                                    <option value="yes">Yes</option>-->
                            <!--                                    <option value="no">No</option>-->
                            <!--                                </select>-->
                            <!--                            </div>-->
                            <div class="col-md-4">
                                <label>Applicant's age</label>
                                <input name="age" type="integer" class="form-control"/>
                            </div>
                            <!--                            <div class="col-md-4">-->
                            <!--                                <label>Previous Qualifications</label>-->
                            <!--                                <select name="has_previous_qualifications" class="form-control" id="has_previous_qualifications" required="1">-->
                            <!--                                    <option value=""></option>-->
                            <!--                                    <option value="yes">Yes</option>-->
                            <!--                                    <option value="no">No</option>-->
                            <!--                                </select>-->
                            <!--                            </div>-->
                            <!--                            <div class="col-md-4">-->
                            <!--                                <label>Are you undertaking studies beyond your undergraduate qualification</label>-->
                            <!--                                <select name="further_study_post_undergrad" class="form-control" id="further_study_post_undergrad" required="1">-->
                            <!--                                    <option value=""></option>-->
                            <!--                                    <option value="yes">Yes</option>-->
                            <!--                                    <option value="no">No</option>-->
                            <!--                                </select>-->
                            <!--                            </div>-->
                        </div>
                    </div>

                    <!-- Study Plans -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Study Plans</h4>
                        <div class="row">
                            <div class="col-md-4">
                                <label>Applied for Next Year</label>
                                <select name="applied_next_year" class="form-control" id="applied_next_year">
                                    <option value=""></option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>

                            </div>
                            <div class="col-md-4">
                                <label>Institution Type</label>
                                <select name="institution_type" class="form-control">
                                    <option value="public">Public</option>
                                    <option value="private">Private</option>
                                    <option value="international">International</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Proposed Institution</label>
                                <input name="proposed_institution" type="text" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Qualification Type</label>
                                <select name="qualification_type" class="form-control">
                                    <option value="degree">Degree</option>
                                    <option value="diploma">Diploma</option>
                                    <option value="certificate">Higher Certificate</option>
                                    <option value="postgrad">Postgraduate Diploma</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Funding Status -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Funding Status</h4>
                        <div class="row">
                            <div class="col-md-4">
                                <label>Have you applied for any bursaries or funding?</label>
                                <select name="applied_bursaries" class="form-control" id="applied_bursaries">
                                    <option value=""></option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Received Bursary Before</label>
                                <select name="received_bursary" class="form-control" id="received_bursary">
                                    <option value=""></option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>

                            </div>
                            <div id="bursary_details" class="col-md-4 d-none">
                                <label>Bursary Details</label>
                                <input name="bursary_details" type="text" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <!-- Document Uploads -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Document Uploads</h4>
                        <div class="row">
                            <div class="col-md-4">
                                <label>Mother ID</label>
                                <input name="mother_id" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Father ID</label>
                                <input name="father_id" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Mother Payslip</label>
                                <input name="mother_payslip" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Father Payslip</label>
                                <input name="father_payslip" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Student ID</label>
                                <input name="student_id" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Matric Results</label>
                                <input name="matric_results" type="file" required="" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Tertiary Results</label>
                                <input name="tertiary_results" type="file" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Proof of Registration</label>
                                <input name="proof_of_registration" type="file" class="form-control"/>
                            </div>
                            <div class="col-md-4">
                                <label>Guardian Death Certificate</label>
                                <input name="guardian_death_certificate" type="file" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <!-- Declaration -->
                    <div style="border: solid 1px #aaa7a7;padding: 17px;border-radius: 10px; margin-bottom: 15px;">
                        <h4 style="font-family: ui-monospace;">Declaration</h4>
                        <label>
                            <input type="checkbox" name="declaration" required="1"
                                   onclick="this.setCustomValidity('')"
                                   oninvalid="this.setCustomValidity('You must accept the declaration.')"/>
                            I hereby declare that the information provided is true and correct.
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <div class="text-center mt-4 mb-5">
                        <button type="submit" class="btn btn-primary btn-lg">Submit Application</button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>