<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bursary_programme_view_tree" model="ir.ui.view">
        <field name="name">bursary.programme.view.tree</field>
        <field name="model">bursary.programme</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_bursary_programme" model="ir.actions.act_window">
        <field name="name">Programme</field>
        <field name="res_model">bursary.programme</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>