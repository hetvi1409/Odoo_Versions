<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_province_tree" model="ir.ui.view">
        <field name="name">res_province_tree</field>
        <field name="model">res.province</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="country_id"/>
                <field name="province"/>
            </tree>
        </field>
    </record>

    <record id="res_province_action" model="ir.actions.act_window">
        <field name="name">Province</field>
        <field name="res_model">res.province</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your Provinces
            </p>
        </field>
    </record>

</odoo>