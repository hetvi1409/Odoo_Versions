<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="application_page" model="website.page">
        <field name="name">Bursary Application</field>
        <field name="type">qweb</field>
        <field name="url">/bursary_application</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">bursary_application.application_page</field>
        <field name="arch" type="xml">
            <t name="Bursary Application" t-name="bursary_application.application_page">
                <t t-call="website.layout">
                    <div class="container py-5">
                        <form method="POST" action="/bursary_application" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="bursary_id" t-att-value="bursary_id"/>

                            <div class="text-center mb-4">
                                <h1 style="color: #714B67;">Bursary Application</h1>
                                <p>Apply for Bursary application</p>
                            </div>

                            <!-- Personal Information -->
                            <div class="mb-5">
                                <h4>Personal Information</h4>
                                <input type="text" name="bursary_id" t-att-value="bursary_id"/>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Name</label>
                                        <input name="name" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Date of Birth</label>
                                        <input name="date_of_birth" type="date" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>ID Number</label>
                                        <input name="id_number" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Nationality</label>
                                        <select name="nationality" class="form-control" required="1">
                                            <option value="sa">South African</option>
                                            <option value="non_sa">Non-South African</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Race</label>
                                        <select name="race" class="form-control" required="1">
                                            <option value="african">African</option>
                                            <option value="coloured">Coloured</option>
                                            <option value="indian">Indian</option>
                                            <option value="white">White</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Gender</label>
                                        <select name="gender" class="form-control" required="1">
                                            <option value="female">Female</option>
                                            <option value="male">Male</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Disability</label>
                                        <input name="disability" type="checkbox"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Disability Type</label>
                                        <input name="disability_type" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Province</label>
                                        <select name="province" class="form-control" required="1">
                                            <option value="gp">Gauteng</option>
                                            <option value="fs">Free State</option>
                                            <option value="kzn">KwaZulu-Natal</option>
                                            <option value="lp">Limpopo</option>
                                            <option value="nw">North West</option>
                                            <option value="mp">Mpumalanga</option>
                                            <option value="ec">Eastern Cape</option>
                                            <option value="nc">Northern Cape</option>
                                            <option value="wc">Western Cape</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Parent/Guardian Details -->
                            <div class="mb-5">
                                <h4>Parent/Guardian Details</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Contact Number</label>
                                        <input name="contact_number" type="text" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Alt. Number</label>
                                        <input name="alt_number" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Email</label>
                                        <input name="email" type="email" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-12">
                                        <label>Address</label>
                                        <input name="address" type="text" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Income Below 600k</label>
                                        <input name="income_below_600k" type="checkbox" required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Mother Name</label>
                                        <input name="mother_name" type="text" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Father Name</label>
                                        <input name="father_name" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Guardian Name</label>
                                        <input name="guardian_name" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Annual Income</label>
                                        <input name="annual_income" type="number" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Payslips</label>
                                        <input name="payslips" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Parent Deceased</label>
                                        <input name="parent_deceased" type="checkbox"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Death Certificate</label>
                                        <input name="death_certificate" type="file" class="form-control"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Academic Information -->
                            <div class="mb-5">
                                <h4>Academic Information</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Highest Grade</label>
                                        <input name="highest_grade" type="text" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Grade 12 Average</label>
                                        <input name="grade12_avg" type="number" step="0.01" class="form-control"
                                               required="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Currently Studying</label>
                                        <input name="currently_studying" type="checkbox"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Academic Records</label>
                                        <input name="academic_records" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Current Qualification</label>
                                        <input name="current_qualification" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Institution</label>
                                        <input name="institution" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Year of Completion</label>
                                        <input name="year_of_completion" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Funding Source</label>
                                        <select name="funding_source" class="form-control">
                                            <option value="parents">Parents</option>
                                            <option value="loan">Loan</option>
                                            <option value="bursary">Bursary</option>
                                            <option value="nsfas">NSFAS</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Age 16-26</label>
                                        <input name="age_16_26" type="checkbox" required="1"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Study Plans -->
                            <div class="mb-5">
                                <h4>Study Plans</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Applied for Next Year</label>
                                        <input name="applied_next_year" type="checkbox"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Institution Type</label>
                                        <select name="institution_type" class="form-control">
                                            <option value="public">Public</option>
                                            <option value="private">Private</option>
                                            <option value="international">International</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Proposed Institution</label>
                                        <input name="proposed_institution" type="text" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Qualification Type</label>
                                        <select name="qualification_type" class="form-control">
                                            <option value="degree">Degree</option>
                                            <option value="diploma">Diploma</option>
                                            <option value="certificate">Higher Certificate</option>
                                            <option value="postgrad">Postgraduate Diploma</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Funding Status -->
                            <div class="mb-5">
                                <h4>Funding Status</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Applied Bursaries</label>
                                        <input name="applied_bursaries" type="checkbox"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Received Bursary</label>
                                        <input name="received_bursary" type="checkbox"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Bursary Details</label>
                                        <input name="bursary_details" type="text" class="form-control"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Document Uploads -->
                            <div class="mb-5">
                                <h4>Document Uploads</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Mother ID</label>
                                        <input name="mother_id" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Father ID</label>
                                        <input name="father_id" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Mother Payslip</label>
                                        <input name="mother_payslip" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Father Payslip</label>
                                        <input name="father_payslip" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Student ID</label>
                                        <input name="student_id" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Matric Results</label>
                                        <input name="matric_results" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Tertiary Results</label>
                                        <input name="tertiary_results" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Proof of Registration</label>
                                        <input name="proof_of_registration" type="file" required="1" class="form-control"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Guardian Death Certificate</label>
                                        <input name="guardian_death_certificate" type="file" required="1" class="form-control"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Declaration -->
                            <div class="mb-5">
                                <h4>Declaration</h4>
                                <label>
                                    <input type="checkbox" name="declaration" required="1"
                                           onclick="this.setCustomValidity('')"
                                           oninvalid="this.setCustomValidity('You must accept the declaration.')"/>
                                    I hereby declare that the information provided is true and correct.
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <div class="text-center mt-4 mb-5">
                                <button type="submit" class="btn btn-primary btn-lg">Submit Application</button>
                            </div>
                        </form>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="menu_my_page" model="website.menu">
        <field name="name">Bursary Application</field>
        <field name="url">/bursary_application</field>
        <field name="page_id" ref="bursary_application.application_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>
</odoo>
