<odoo>
     <record id="thank_you_page" model="website.page">
        <field name="name">Thank You</field>
        <field name="type">qweb</field>
        <field name="url">/thank-you</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">bursary_application.thank_you</field>
        <field name="arch" type="xml">
            <t name="Thank You" t-name="bursary_application.thank_you">
                <t t-call="website.layout">
                    <div class="mb-4 rounded shadow" style="
                        background-image: url('/bursary_application/static/src/img/image5.jpeg');
                        background-size: cover;
                        background-position: center;
                        height: 370px;
                        position: relative;
                    ">
                        <div style="
                            background: rgba(0,0,0,0.5);
                            color: white;
                            position: absolute;
                            bottom: 0;
                            width: 100%;
                            padding: 1rem;
                        ">
                            <div class="text-center mb-4">
                                <p>Bursary application</p>
                            </div>

                        </div>
                    </div>

                    <div class="container py-5 text-center">
                        <h1 class="text-success">Thank You!</h1>
                        <p>Your bursary application has been successfully submitted.</p>
                        <a href="/" class="btn btn-outline-primary mt-3">Back to Home</a>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
