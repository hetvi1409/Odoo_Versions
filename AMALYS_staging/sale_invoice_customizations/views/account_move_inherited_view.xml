<odoo>
    <data>
        <!-- Form View -->
        <record model="ir.ui.view" id="account_move_inherited_view_form">
            <field name="name">Account Move Inherited Form View</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='sequence']" position="after">
                    <field name="item_number"/>
                </xpath>
            </field>
        </record>

        <!-- List View -->
        <record model="ir.ui.view" id="account_move_inherited_view_list">
            <field name="name">Account Move Inherited List View</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date_due']" position="after">
                    <field name="full_payment_date" invisible="move_type != 'out_invoice'"/>
                </xpath>
            </field>
        </record>

        <record id="account.menu_finance_entries" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        </record>


    </data>
</odoo>