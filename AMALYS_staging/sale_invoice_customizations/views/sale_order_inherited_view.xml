<odoo>
    <data>
        <!-- Form View -->
        <record model="ir.ui.view" id="sale_order_inherited_form_view">
            <field name="name">Sale Order Inherited Form View</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//list//field[@name='sequence']" position="after">
                    <field name="item_number"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                    <field name="quantity_available" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="default_location_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
