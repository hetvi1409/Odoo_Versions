<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ========== Contract Template ========== -->

    <record id="contract_template_view_form" model="ir.ui.view">
        <field name="name">contract.template.view.form</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <style>
                        .o_form_view .o_field_widget .o_input {
                            border-color: black;
                        }
                    </style>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            invisible="active == True"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Template Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type"/>
                            <field name="description"/>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="body" string="Contract Body">
                            <field name="body_html" widget="html"/>
                        </page>
                        <page name="scope" string="Default Scope of Work">
                            <field name="scope_of_work" widget="html"/>
                        </page>
                        <page name="tor" string="Terms of Reference">
                            <field name="terms_of_reference" widget="html"/>
                        </page>
                        <page name="variables" string="Variables">
                            <field name="variable_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="placeholder"/>
                                    <field name="label"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                    <field name="default_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_template_view_list" model="ir.ui.view">
        <field name="name">contract.template.view.list</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="name"/>
                <field name="contract_type" widget="badge"
                       decoration-info="contract_type in ['mou','service_level','funding_agreement']"
                       decoration-warning="contract_type in ['purchase','deed_of_sale']"
                       decoration-success="contract_type in ['sale']"/>
                <field name="description"/>
                <field name="create_uid" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="write_date" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="contract_template_action" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contract template
            </p>
        </field>
    </record>

    <menuitem id="contract_template_menuitem"
              name="Contract Templates"
              action="contract_template_action"
              parent="xf_partner_contract.xf_partner_contract_config_menuitem"
              groups="xf_partner_contract.group_xf_partner_contract_manager"
              sequence="5"/>

    <!-- ========== Template Init Wizard ========== -->

    <record id="contract_template_init_wizard_view" model="ir.ui.view">
        <field name="name">contract.template.init.wizard.view</field>
        <field name="model">contract.template.init.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group string="Template &amp; Parties">
                    <group>
                        <field name="template_id"
                               options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        <field name="contract_type" readonly="True"
                               invisible="not template_id"/>
                        <field name="partner_id"
                               options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="contract_title"/>
                        <field name="amount"/>
                        <field name="currency_id"
                               options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                               groups="base.group_multi_currency"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
                <notebook>
                    <page name="body" string="Contract Body">
                        <field name="contract_body" widget="html"/>
                    </page>
                    <page name="scope" string="Scope of Work">
                        <field name="scope_of_work" widget="html"/>
                    </page>
                    <page name="tor" string="Terms of Reference">
                        <field name="terms_of_reference" widget="html"/>
                    </page>
                    <page name="variables" string="Variables">
                        <field name="variable_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="placeholder" readonly="1"/>
                                <field name="label" readonly="1"/>
                                <field name="field_type" readonly="1"/>
                                <field name="required" readonly="1"/>
                                <field name="default_value" readonly="1"/>
                                <field name="value_text"/>
                            </list>
                        </field>
                    </page>
                    <page name="notes" string="Terms &amp; Conditions">
                        <field name="notes" widget="html"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Create Contract"
                            name="action_create_contract"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancel"
                            class="btn btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="contract_template_init_action" model="ir.actions.act_window">
        <field name="name">New Contract from Template</field>
        <field name="res_model">contract.template.init.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_contract_from_template"
              name="New Contract from Template"
              action="contract_template_init_action"
              parent="xf_partner_contract.xf_partner_contract_config_menuitem"
              sequence="6"/>

</odoo>
