<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Disable resizing: keep drag/drop via .o_sign_config_handle -->
    <t t-inherit="sign.signItemConfiguration" t-inherit-mode="extension">
<!--        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_resize_handler ')]"-->
<!--               position="attributes">-->
<!--            <attribute name="class" add="d-none"/>-->
<!--        </xpath>-->
        <!-- Remove resize_height -->
        <xpath expr="//div[contains(@class, 'resize_height')]" position="replace">
            <div class="o_resize_handler resize_height" style="display:none;"></div>
        </xpath>

        <!-- Remove resize_width -->
        <xpath expr="//div[contains(@class, 'resize_width')]" position="replace">
            <div class="o_resize_handler resize_width" style="display:none;"></div>
        </xpath>

        <!-- Remove resize_both -->
        <xpath expr="//div[contains(@class, 'resize_both')]" position="replace">
            <div class="o_resize_handler resize_both" style="display:none;"></div>
        </xpath>
    </t>
</templates>

