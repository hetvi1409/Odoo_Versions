<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view -->
    <record id="res_province_view_form" model="ir.ui.view">
        <field name="name">res.province.view.form</field>
        <field name="model">res.province</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_province_view_tree" model="ir.ui.view">
        <field name="name">res.province.view.tree</field>
        <field name="model">res.province</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <!-- Action -->
    <record id="action_res_province" model="ir.actions.act_window">
        <field name="name">Province</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.province</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Province
            </p>
        </field>
    </record>
    <!-- List view -->
    <record id="res_district_view_form" model="ir.ui.view">
        <field name="name">res.district.view.form</field>
        <field name="model">res.district</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="province_id"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_district_view_tree" model="ir.ui.view">
        <field name="name">res.district.view.tree</field>
        <field name="model">res.district</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="province_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <!-- Action -->
    <record id="action_res_district" model="ir.actions.act_window">
        <field name="name">District</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.district</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new District
            </p>
        </field>
    </record>
    <!-- List view -->
    <record id="res_district_city_view_form" model="ir.ui.view">
        <field name="name">res.district.city.view.form</field>
        <field name="model">res.district.city</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="district_id"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                            <field name="province_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_district_city_view_tree" model="ir.ui.view">
        <field name="name">res.district.city.view.tree</field>
        <field name="model">res.district.city</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="district_id"/>
                <field name="province_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <!-- Action -->
    <record id="action_res_district_city" model="ir.actions.act_window">
        <field name="name">District</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.district.city</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new City
            </p>
        </field>
    </record>
</odoo>
