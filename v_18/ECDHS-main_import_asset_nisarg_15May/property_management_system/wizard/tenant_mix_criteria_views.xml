<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_tenant_mix_criteria_form" model="ir.ui.view">
        <field name="name">tenant.mix.criteria.form</field>
        <field name="model">tenant.mix.criteria</field>
        <field name="arch" type="xml">
            <form string="Tenant Mix Criteria">
                <sheet>
                    <group>
                        <field name="enquiry_id" invisible="1"/>
                        <field name="type" invisible="1"/>
                        <field name="comments" placeholder="Enter your comments..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Submit"
                            type="object"
                            name="action_submit"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_facility_comments_form" model="ir.ui.view">
        <field name="name">facility.comments.form</field>
        <field name="model">facility.comments</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <group>
                        <field name="enquiry_id" invisible="1"/>
                        <field name="type"/>
                        <field name="comments" placeholder="Enter your comments..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Submit"
                            type="object"
                            name="action_submit"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
