<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_asset_verification_history_button" model="ir.ui.view">
        <field name="name">account.asset.view.list</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_print_verification_history_button" type="object" string="Asset Verification History"/>
                    <button name="action_print_latest_verification_history_button" type="object" string="Latest Asset Verification History"/>
                </header>
            </xpath>

        </field>
    </record>

</odoo>
