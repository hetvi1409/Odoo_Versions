<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="assets_disposal_reports_view_form" model="ir.ui.view">
        <field name="name">assets.disposal.reports.view.form</field>
        <field name="model">assets.disposal.reports</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="type" widget="radio"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Print PDF"
                            type="object" class="oe_highlight"/>
                    <button name="action_export_excel" string="Print XLS"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn_default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <!-- Wizard Action -->
    <record id="action_assets_disposal_reports" model="ir.actions.act_window">
        <field name="name">Assets Disposal Report</field>
        <field name="res_model">assets.disposal.reports</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_assets_disposal_reports"
              name="Asset Disposal Report"
              parent="asset_verification_report.menu_assets_reports"
              action="action_assets_disposal_reports"/>
</odoo>