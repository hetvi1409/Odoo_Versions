<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Annual Procurement Plan Views -->
    <record id="view_sagovannual_procurement_plan_list" model="ir.ui.view">
        <field name="name">sagovtender.annual.procurement.plan.list</field>
        <field name="model">sagovtender.annual.procurement.plan</field>
        <field name="arch" type="xml">
            <list string="Annual Procurement Plans" decoration-success="state=='approved'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="item_description"/>
                <field name="estimated_value" sum="Total" widget="monetary"/>
                <field name="available_budget" sum="Total" widget="monetary"/>
                <field name="remaining_budget" sum="Total" widget="monetary"/>
                <field name="procurement_method" column_invisible="1"/>
                <field name="procurement_method_config_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="preference_point_system_config_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="source_app_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="source_app_line_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-success="state=='approved'"/>
            </list>
        </field>
    </record>

    <record id="view_sagovannual_procurement_plan_form" model="ir.ui.view">
        <field name="name">sagovtender.annual.procurement.plan.form</field>
        <field name="model">sagovtender.annual.procurement.plan</field>
        <field name="arch" type="xml">
            <form string="Annual Procurement Plan">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['cancelled', 'completed']"/>
                    <!-- <button name="action_create_requisition" string="Add Requisition" type="object" class="btn-success" invisible="state != 'approved'"/> -->
                    <!-- <button name="action_create_tender" string="Add Tender" type="object" class="btn-success" invisible="state != 'approved' or not has_approved_requisition_line"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,completed"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requisitions" type="object" class="oe_stat_button" icon="fa-file-text-o" string="Requisitions">
                            <span class="o_stat_value"><field name="requisition_count" widget="statbutton" string="Requisitions"/></span>
                            <span class="o_stat_text">. Requisitions</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="fiscal_year"/>
                            <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="budget_line"/>
                            <field name="planned_date"/>
                            <field name="source_app_id" invisible="not source_app_id and not source_app_line_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="available_budget" widget="monetary"/>
                            <field name="estimated_value" widget="monetary"/>
                            <field name="allocated_amount" widget="monetary"/>
                            <field name="remaining_budget" widget="monetary"/>
                            <field name="currency_id" invisible="0" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="procurement_method" invisible="1"/>
                            <field name="procurement_method_config_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="preference_point_system_config_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="source_app_line_id" invisible="not source_app_id and not source_app_line_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="item_description" placeholder="Detailed description of items to be procured..."/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                        <page string="Requisitions" name="requisitions">
                            <button name="action_create_requisition" string="Add New Requisition" type="object" class="btn-success" invisible="state != 'approved'"/>
                            <field name="requisition_ids" readonly="1">
                                <list string="Requisitions" decoration-info="state=='draft'" decoration-success="state=='approved'" default_order="id desc" editable="bottom" open_form_view="1">
                                    <field name="name"/>
                                    <field name="date_request"/>
                                    <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="description"/>
                                    <field name="budget_confirmed_amount" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tenders" name="tenders">
                            <button name="action_create_tender" string="Add New Tender" type="object" class="btn-success" invisible="state != 'approved' or not has_approved_requisition_line"/>
                            <field name="tender_ids" readonly="1">
                                <list string="Tenders" decoration-info="state=='draft'" decoration-success="state=='approved'" default_order="id desc" editable="bottom" open_form_view="1">
                                    <field name="name"/>
                                    <field name="tender_type_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="estimated_value" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sagovannual_procurement_plan_search" model="ir.ui.view">
        <field name="name">sagovtender.annual.procurement.plan.search</field>
        <field name="model">sagovtender.annual.procurement.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="item_description"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Fiscal Year" name="group_fiscal_year" context="{'group_by':'fiscal_year'}"/>
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sagovannual_procurement_plan" model="ir.actions.act_window">
        <field name="name">Annual Procurement Plans</field>
        <field name="res_model">sagovtender.annual.procurement.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_approved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Annual Procurement Plan
            </p>
            <p>
                Annual Procurement Plans (APP) are used to plan and budget for procurement activities.
            </p>
        </field>
    </record>
</odoo>
