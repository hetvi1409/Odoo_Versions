<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================================== -->
        <!-- Document Requirement - Tree View -->
        <!-- ===================================== -->
        <record id="view_sagovprocurement_document_requirement_list" model="ir.ui.view">
            <field name="name">sagovprocurement.document.requirement.list</field>
            <field name="model">sagovprocurement.document.requirement</field>
            <field name="arch" type="xml">
                <list string="Document Requirements" editable="bottom" decoration-info="sequence">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="document_type"/>
                    <field name="method_id" readonly="0" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="mandatory" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- ===================================== -->
        <!-- Document Requirement - Form View -->
        <!-- ===================================== -->
        <record id="view_sagovprocurement_document_requirement_form" model="ir.ui.view">
            <field name="name">sagovprocurement.document.requirement.form</field>
            <field name="model">sagovprocurement.document.requirement</field>
            <field name="arch" type="xml">
                <form string="Document Requirement">
                    <sheet>
                        <group>
                            <group>
                                <field name="method_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="document_type"/>
                            </group>
                            <group>
                                <field name="mandatory" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ===================================== -->
        <!-- Document Requirement - Action -->
        <!-- ===================================== -->
        <record id="action_sagovprocurement_document_requirement" model="ir.actions.act_window">
            <field name="name">Document Requirements</field>
            <field name="res_model">sagovprocurement.document.requirement</field>
            <field name="view_mode">list,form</field>
            <field name="groups_id" eval="[(4, ref('sa_government_tender.group_sagovtender_scm_officer')), (4, ref('sa_government_tender.group_sagovtender_manager'))]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first document requirement
                </p>
            </field>
        </record>

    </data>
</odoo>
