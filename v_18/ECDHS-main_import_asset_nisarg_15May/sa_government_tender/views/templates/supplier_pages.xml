<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Supplier Registration Form -->
    <template id="supplier_registration_form" name="Supplier Registration">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h2 class="mb-0">Supplier Registration</h2>
                                    <p class="mb-0 mt-2">Register your company to participate in government tenders</p>
                                </div>
                                <div class="card-body">
                                    <form method="post" action="/supplier/register/submit">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <!-- Company Information -->
                                        <h4 class="mt-3 mb-3">Company Information</h4>

                                        <div class="form-group">
                                            <label for="company_name" class="required">Company/Organization Name</label>
                                            <input type="text" name="company_name" id="company_name"
                                                   class="form-control" required="required"
                                                   placeholder="Enter your company name"/>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="company_registration_number">Company Registration Number</label>
                                                    <input type="text" name="company_registration_number"
                                                           id="company_registration_number" class="form-control"
                                                           placeholder="e.g., 2021/123456/07"/>
                                                    <small class="form-text text-muted">
                                                        Required to prevent duplicate registrations
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="vat">VAT Number</label>
                                                    <input type="text" name="vat" id="vat"
                                                           class="form-control" placeholder="VAT Number"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- CSD Registration -->
                                        <h5 class="mt-4 mb-3">CSD Registration</h5>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="csd_number">CSD Number</label>
                                                    <input type="text" name="csd_number" id="csd_number"
                                                           class="form-control"
                                                           placeholder="Central Supplier Database Number"/>
                                                    <small class="form-text text-muted">
                                                        Required to prevent duplicate registrations
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="csd_registration_date">CSD Registration Date</label>
                                                    <input type="date" name="csd_registration_date"
                                                           id="csd_registration_date" class="form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Contact Information -->
                                        <h5 class="mt-4 mb-3">Contact Information</h5>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="email" class="required">Email Address</label>
                                                    <input type="email" name="email" id="email"
                                                           class="form-control" required="required"
                                                           placeholder="your@email.com"/>
                                                    <small class="form-text text-muted">
                                                        Will be used for portal login
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="phone" class="required">Phone Number</label>
                                                    <input type="tel" name="phone" id="phone"
                                                           class="form-control" required="required"
                                                           placeholder="+27 XX XXX XXXX"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="mobile">Mobile Number</label>
                                                    <input type="tel" name="mobile" id="mobile"
                                                           class="form-control" placeholder="+27 XX XXX XXXX"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="website">Website</label>
                                                    <input type="url" name="website" id="website"
                                                           class="form-control" placeholder="https://www.example.com"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Physical Address -->
                                        <h5 class="mt-4 mb-3">Physical Address</h5>

                                        <div class="form-group">
                                            <label for="street" class="required">Street Address</label>
                                            <input type="text" name="street" id="street"
                                                   class="form-control" required="required"
                                                   placeholder="Street address"/>
                                        </div>

                                        <div class="form-group">
                                            <label for="street2">Street Address 2</label>
                                            <input type="text" name="street2" id="street2"
                                                   class="form-control" placeholder="Apartment, suite, etc."/>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="city" class="required">City</label>
                                                    <input type="text" name="city" id="city"
                                                           class="form-control" required="required"
                                                           placeholder="City"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="zip" class="required">Postal Code</label>
                                                    <input type="text" name="zip" id="zip"
                                                           class="form-control" required="required"
                                                           placeholder="Postal Code"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="state_id">Province/State</label>
                                                    <select name="state_id" id="state_id" class="form-control">
                                                        <option value="">Select Province/State</option>
                                                        <t t-foreach="states" t-as="state">
                                                            <option t-att-value="state.id">
                                                                <t t-esc="state.name"/> (<t t-esc="state.country_id.name"/>)
                                                            </option>
                                                        </t>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="country_id" class="required">Country</label>
                                                    <select name="country_id" id="country_id" class="form-control" required="required">
                                                        <option value="">Select Country</option>
                                                        <t t-foreach="countries" t-as="country">
                                                            <option t-att-value="country.id"
                                                                    t-att-selected="country.code == 'ZA' and 'selected' or None">
                                                                <t t-esc="country.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Tax Compliance -->
                                        <h5 class="mt-4 mb-3">Tax Compliance</h5>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="tax_clearance_number">Tax Clearance Certificate Number</label>
                                                    <input type="text" name="tax_clearance_number"
                                                           id="tax_clearance_number" class="form-control"
                                                           placeholder="Tax Clearance Number"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="tax_clearance_expiry">Tax Clearance Expiry Date</label>
                                                    <input type="date" name="tax_clearance_expiry"
                                                           id="tax_clearance_expiry" class="form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- COID -->
                                        <div class="form-group">
                                            <label for="coid_number">COID Number</label>
                                            <input type="text" name="coid_number" id="coid_number"
                                                   class="form-control"
                                                   placeholder="Compensation for Occupational Injuries and Diseases"/>
                                        </div>

                                        <!-- B-BBEE Information -->
                                        <h5 class="mt-4 mb-3">B-BBEE Information</h5>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="bbbee_level">B-BBEE Level</label>
                                                    <select name="bbbee_level" id="bbbee_level" class="form-control">
                                                        <option value="">Select B-BBEE Level</option>
                                                        <option value="1">Level 1</option>
                                                        <option value="2">Level 2</option>
                                                        <option value="3">Level 3</option>
                                                        <option value="4">Level 4</option>
                                                        <option value="5">Level 5</option>
                                                        <option value="6">Level 6</option>
                                                        <option value="7">Level 7</option>
                                                        <option value="8">Level 8</option>
                                                        <option value="0">Non-Compliant</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="bbbee_certificate_number">B-BBEE Certificate Number</label>
                                                    <input type="text" name="bbbee_certificate_number"
                                                           id="bbbee_certificate_number" class="form-control"
                                                           placeholder="Certificate Number"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="bbbee_certificate_date">B-BBEE Certificate Date</label>
                                                    <input type="date" name="bbbee_certificate_date"
                                                           id="bbbee_certificate_date" class="form-control"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="bbbee_expiry_date">B-BBEE Expiry Date</label>
                                                    <input type="date" name="bbbee_expiry_date"
                                                           id="bbbee_expiry_date" class="form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Additional Information -->
                                        <h5 class="mt-4 mb-3">Additional Information</h5>

                                        <div class="form-group">
                                            <label for="additional_info">Additional Information / Comments</label>
                                            <textarea name="additional_info" id="additional_info"
                                                      class="form-control" rows="4"
                                                      placeholder="Any additional information you would like to provide..."></textarea>
                                        </div>

                                        <!-- Terms and Conditions -->
                                        <div class="form-group mt-4">
                                            <div class="custom-control custom-checkbox">
                                                <input type="checkbox" class="custom-control-input"
                                                       id="accept_terms" required="required"/>
                                                <label class="custom-control-label font-weight-bold" for="accept_terms">
                                                    I confirm that all information provided is accurate and complete,
                                                    and I accept the terms and conditions.
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Submit Button -->
                                        <div class="form-group text-center mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <i class="fa fa-check"/> Register as Supplier
                                            </button>
                                            <a href="/sagovtenders" class="btn btn-secondary btn-lg ml-2">
                                                <i class="fa fa-times"/> Cancel
                                            </a>
                                        </div>

                                        <!-- Information Notice -->
                                        <div class="alert alert-info mt-3">
                                            <strong><i class="fa fa-info-circle"/> Note:</strong>
                                            <ul class="mb-0 pl-3">
                                                <li>All fields marked with <span class="text-danger">*</span> are required.</li>
                                                <li>A portal account will be created using your email address.</li>
                                                <li>You will receive an email with login instructions.</li>
                                                <li>CSD Number and Company Registration Number must be unique.</li>
                                            </ul>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Registration Success Page -->
    <template id="supplier_registration_success" name="Registration Success">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-6 offset-lg-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <div class="text-success mb-4">
                                        <i class="fa fa-check-circle" style="font-size: 80px;"/>
                                    </div>
                                    <h2 class="text-success">Registration Successful!</h2>
                                    <p class="lead">Your supplier account has been created.</p>

                                    <div class="card bg-light mt-4 mb-4">
                                        <div class="card-body text-left">
                                            <h5>Company Details</h5>
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <th width="40%">Company Name:</th>
                                                    <td><strong><t t-esc="partner.name"/></strong></td>
                                                </tr>
                                                <tr t-if="partner.company_registration_number">
                                                    <th>Registration Number:</th>
                                                    <td><t t-esc="partner.company_registration_number"/></td>
                                                </tr>
                                                <tr t-if="partner.csd_number">
                                                    <th>CSD Number:</th>
                                                    <td><t t-esc="partner.csd_number"/></td>
                                                </tr>
                                                <tr>
                                                    <th>Email:</th>
                                                    <td><t t-esc="partner.email"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <t t-if="password_sent">
                                        <div class="alert alert-success">
                                            <h5><i class="fa fa-envelope"/> Email Sent Successfully!</h5>
                                            <p class="mb-2">A registration confirmation email with password reset link has been sent to <strong><t t-esc="partner.email"/></strong></p>
                                            <ul class="mb-0">
                                                <li>Check your email inbox (and spam folder if needed)</li>
                                                <li>Click the password reset link in the email to set a secure password</li>
                                                <li>Login to your supplier portal</li>
                                            </ul>
                                        </div>

                                        <div class="alert alert-warning">
                                            <h5><i class="fa fa-key"/> Temporary Password</h5>
                                            <p class="mb-2">Your temporary default password is: <strong><code style="background-color: #f8f9fa; padding: 5px 10px; border-radius: 4px;"><t t-esc="partner.email"/></code></strong></p>
                                            <p class="mb-0">
                                                <i class="fa fa-exclamation-triangle"/> <strong>Important:</strong>
                                                For security reasons, please use the password reset link in your email to set a strong password, or change this temporary password immediately after your first login.
                                            </p>
                                        </div>

                                        <div class="alert alert-info">
                                            <h5><i class="fa fa-info-circle"/> Portal Access Granted</h5>
                                            <p class="mb-0">Your account has been created as a <strong>Portal User</strong>. You now have access to:</p>
                                            <ul class="mb-0">
                                                <li>Browse and view government tender opportunities</li>
                                                <li>Submit bids for eligible tenders</li>
                                                <li>Track your bid submissions and status</li>
                                                <li>Manage your company profile and documents</li>
                                                <li>Receive notifications about new tenders</li>
                                            </ul>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-warning">
                                            <h5><i class="fa fa-exclamation-triangle"/> Note: Email Could Not Be Sent</h5>
                                            <p>Your supplier account has been created successfully, but we were unable to send the password reset email.</p>
                                            <p class="mb-0"><strong>Please contact the administrator</strong> with your email address <strong><t t-esc="partner.email"/></strong> to obtain your login credentials.</p>
                                        </div>
                                    </t>

                                    <p class="text-muted mb-4">
                                        You can now browse and bid on open government tenders.
                                    </p>

                                    <div class="btn-group" role="group">
                                        <a href="/sagovtenders" class="btn btn-primary">
                                            <i class="fa fa-search"/> Browse Tenders
                                        </a>
                                        <a href="/web/login" class="btn btn-secondary">
                                            <i class="fa fa-sign-in"/> Login
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Registration Error Page -->
    <template id="supplier_registration_error" name="Registration Error">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-6 offset-lg-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <div class="text-danger mb-4">
                                        <i class="fa fa-exclamation-circle" style="font-size: 80px;"/>
                                    </div>
                                    <h2 class="text-danger">Registration Error</h2>
                                    <p class="lead">There was a problem with your registration.</p>

                                    <div class="alert alert-danger text-left mt-4">
                                        <strong>Error Details:</strong>
                                        <ul class="mb-0 mt-2">
                                            <t t-foreach="errors" t-as="error">
                                                <li><t t-esc="error"/></li>
                                            </t>
                                        </ul>
                                    </div>

                                    <t t-if="show_login_link">
                                        <div class="alert alert-info text-left mt-3">
                                            <h5><i class="fa fa-info-circle"/> Already Registered?</h5>
                                            <p class="mb-2">If you already have an account with us:</p>
                                            <ul class="mb-0">
                                                <li><a href="/web/login" class="alert-link"><strong>Login here</strong></a> to access your account</li>
                                                <li><a href="/web/reset_password" class="alert-link"><strong>Reset your password</strong></a> if you forgot it</li>
                                                <li>Contact support if you need assistance</li>
                                            </ul>
                                        </div>
                                    </t>

                                    <p class="text-muted mt-3">
                                        Please correct the errors and try again, or contact support for assistance.
                                    </p>

                                    <div class="btn-group" role="group">
                                        <t t-if="show_login_link">
                                            <a href="/web/login" class="btn btn-success">
                                                <i class="fa fa-sign-in"/> Login
                                            </a>
                                        </t>
                                        <a href="/supplier/register" class="btn btn-primary">
                                            <i class="fa fa-arrow-left"/> Try Again
                                        </a>
                                        <a href="/sagovtenders" class="btn btn-secondary">
                                            Back to Tenders
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Supplier Profile Page -->
    <template id="supplier_profile_page" name="Supplier Profile">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <h1 class="mb-4">Supplier Profile</h1>

                            <!-- Success/Error Messages -->
                            <t t-if="request.params.get('success')">
                                <div class="alert alert-success alert-dismissible fade show">
                                    <button type="button" class="close" data-dismiss="alert">&amp;times;</button>
                                    <strong><i class="fa fa-check"/> Success!</strong>
                                    Your profile has been updated successfully.
                                </div>
                            </t>
                            <t t-if="request.params.get('error')">
                                <div class="alert alert-danger alert-dismissible fade show">
                                    <button type="button" class="close" data-dismiss="alert">&amp;times;</button>
                                    <strong><i class="fa fa-exclamation-circle"/> Error:</strong>
                                    <t t-esc="request.params.get('error')"/>
                                </div>
                            </t>

                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h3 class="mb-0">Update Your Profile</h3>
                                </div>
                                <div class="card-body">
                                    <form method="post" action="/supplier/profile/update">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <!-- Company Information (Read-only) -->
                                        <h5 class="mt-3 mb-3">Company Information</h5>

                                        <div class="form-group">
                                            <label>Company Name</label>
                                            <input type="text" class="form-control" t-att-value="partner.name" disabled="disabled"/>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Company Registration Number</label>
                                                    <input type="text" class="form-control"
                                                           t-att-value="partner.company_registration_number" disabled="disabled"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>CSD Number</label>
                                                    <input type="text" class="form-control"
                                                           t-att-value="partner.csd_number" disabled="disabled"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Contact Information (Editable) -->
                                        <h5 class="mt-4 mb-3">Contact Information</h5>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Email Address</label>
                                                    <input type="email" class="form-control"
                                                           t-att-value="partner.email" disabled="disabled"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="phone">Phone Number</label>
                                                    <input type="tel" name="phone" id="phone"
                                                           class="form-control" t-att-value="partner.phone"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="mobile">Mobile Number</label>
                                                    <input type="tel" name="mobile" id="mobile"
                                                           class="form-control" t-att-value="partner.mobile"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="website">Website</label>
                                                    <input type="url" name="website" id="website"
                                                           class="form-control" t-att-value="partner.website"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Address (Editable) -->
                                        <h5 class="mt-4 mb-3">Physical Address</h5>

                                        <div class="form-group">
                                            <label for="street">Street Address</label>
                                            <input type="text" name="street" id="street"
                                                   class="form-control" t-att-value="partner.street"/>
                                        </div>

                                        <div class="form-group">
                                            <label for="street2">Street Address 2</label>
                                            <input type="text" name="street2" id="street2"
                                                   class="form-control" t-att-value="partner.street2"/>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="city">City</label>
                                                    <input type="text" name="city" id="city"
                                                           class="form-control" t-att-value="partner.city"/>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="zip">Postal Code</label>
                                                    <input type="text" name="zip" id="zip"
                                                           class="form-control" t-att-value="partner.zip"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- More editable fields... -->
                                        <div class="form-group text-center mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <i class="fa fa-save"/> Update Profile
                                            </button>
                                            <a href="/my/bids" class="btn btn-secondary btn-lg ml-2">
                                                <i class="fa fa-times"/> Cancel
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Already Registered as Supplier -->
    <template id="supplier_already_registered" name="Already Registered as Supplier">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <div class="card">
                                <div class="card-header bg-info text-white">
                                    <h2 class="mb-0"><i class="fa fa-check-circle"/> Already Registered</h2>
                                </div>
                                <div class="card-body text-center">
                                    <div class="text-info mb-4" style="font-size: 60px;">
                                        <i class="fa fa-user-check"/>
                                    </div>
                                    <h3 class="text-info mb-3">You are already registered as a supplier!</h3>

                                    <div class="alert alert-info">
                                        <p>Your account is active and you can participate in government tenders.</p>
                                    </div>

                                    <div class="card bg-light mb-4">
                                        <div class="card-body text-left">
                                            <h5 class="mb-3">Your Supplier Information</h5>
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <th width="40%">Company Name:</th>
                                                    <td><strong><t t-esc="partner.name"/></strong></td>
                                                </tr>
                                                <tr t-if="partner.company_registration_number">
                                                    <th>Registration Number:</th>
                                                    <td><t t-esc="partner.company_registration_number"/></td>
                                                </tr>
                                                <tr t-if="partner.csd_number">
                                                    <th>CSD Number:</th>
                                                    <td><t t-esc="partner.csd_number"/></td>
                                                </tr>
                                                <tr>
                                                    <th>Email:</th>
                                                    <td><t t-esc="partner.email"/></td>
                                                </tr>
                                                <tr>
                                                    <th>Phone:</th>
                                                    <td><t t-esc="partner.phone"/></td>
                                                </tr>
                                                <tr>
                                                    <th>Status:</th>
                                                    <td>
                                                        <span class="badge badge-success">Active Supplier</span>
                                                        <t t-if="partner.is_blacklisted">
                                                            <span class="badge badge-danger ml-2">Blacklisted</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="alert alert-warning mb-4">
                                        <h5><i class="fa fa-info-circle"/> What Next?</h5>
                                        <ul class="mb-0">
                                            <li>Browse and bid on open tenders</li>
                                            <li>Update your company profile to keep information current</li>
                                            <li>Check your bid submissions and their status</li>
                                        </ul>
                                    </div>

                                    <div class="btn-group" role="group">
                                        <a href="/sagovtenders" class="btn btn-primary btn-lg">
                                            <i class="fa fa-search"/> Browse Tenders
                                        </a>
                                        <a href="/supplier/profile" class="btn btn-info btn-lg">
                                            <i class="fa fa-edit"/> Update Profile
                                        </a>
                                        <a href="/my/bids" class="btn btn-secondary btn-lg">
                                            <i class="fa fa-file-o"/> My Bids
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
