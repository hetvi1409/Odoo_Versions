<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sagov_account_report_budget_form_inherit" model="ir.ui.view">
        <field name="name">account.report.budget.form.inherit.sagov</field>
        <field name="model">account.report.budget</field>
        <field name="inherit_id" ref="account_reports.account_report_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    </group>
                    <group/>
                </group>
            </xpath>
            <xpath expr="//field[@name='item_ids']/list/field[@name='account_id']" position="before">
                <field name="product_id" required="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_sagov_account_report_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">account.report.budget</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
