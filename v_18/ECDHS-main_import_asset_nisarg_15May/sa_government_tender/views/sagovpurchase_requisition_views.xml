<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_list" model="ir.ui.view">
        <field name="name">sagovtender.purchase.requisition.list</field>
        <field name="model">sagovtender.purchase.requisition</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'" decoration-success="state=='approved'">
                <field name="name"/>
                <field name="date_request"/>
                <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_requisition_form" model="ir.ui.view">
        <field name="name">sagovtender.purchase.requisition.form</field>
        <field name="model">sagovtender.purchase.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_to_specification" string="Send to Specification" type="object" invisible="state != 'budget_confirmed'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'scm_processing'"/>
                    <button name="action_open_sagovbudget_confirmation" string="Budget" type="object" class="btn-primary" invisible="state != 'budget_review'"/>
                    <button name="action_create_specification" string="Specification" type="object" class="btn-primary" invisible="specification_id or state != 'specification'"/>
                    <button name="action_create_specification" string="Create Specification" type="object" class="btn-primary" invisible="state != 'specification or not specification_id'"/>
                    <button name="action_send_to_scm" string="Send to SCM" type="object" invisible="not specification_id or state != 'specification'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state in ['approved', 'rejected','cancelled']"/>
                    <!-- <button name="action_create_specification" string="Create Specification" type="object" class="btn-primary" invisible="specification_id"/> -->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="description" placeholder="Detailed description..."/>
                            <field name="is_on_app" readonly="0" invisible="0"/>
                            <field name="app_id" invisible="not is_on_app" required="is_on_app" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="motivation" invisible="is_on_app" placeholder="Provide motivation for items not on APP..."/>
                            <field name="procurement_method_config_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="preference_point_system_config_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="date_required" required="1"/>
                            <field name="date_request" required="1"/>
                        </group>
                        <group>
                            <field name="department_id" required="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="user_id" required="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="currency_id" invisible="0" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <!-- <field name="link_to_memo" widget="boolean_toggle"/> -->
                            <field name="link_to_memo"/>
                            <field name="memo_id" required="link_to_memo" invisible="not link_to_memo" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="sagovbudget_confirmation_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="specification_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="has_specification" invisible="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commodities (Estimate)" name="commodities">
                            <field name="commodity_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="name" required="1"/>
                                    <field name="uom_id" required="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="quantity" required="1"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                    <field name="budget_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="remaining_budget" widget="monetary" readonly="1"/>
                                    <field name="account_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <!-- <field name="notes" optional="hide"/> -->
                                </list>
                            </field>
                            <group>
                                <field name="gl_account_summary" widget="text" nolabel="1" readonly="1" class="oe_read_only" style="font-family: monospace; white-space: pre; background-color: #f9f9f9; padding: 10px; border: 1px solid #ddd;"/>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids" widget="many2many_binary" options="{'accepted_file_extensions': '.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_purchase_requisition" model="ir.actions.act_window">
        <field name="name">Purchase Requisitions</field>
        <field name="res_model">sagovtender.purchase.requisition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>