<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================================== -->
        <!-- Preference Criteria - List View -->
        <!-- ===================================== -->
        <record id="view_sagovpreference_point_criteria_list" model="ir.ui.view">
            <field name="name">sagovpreference.point.criteria.list</field>
            <field name="model">sagovpreference.point.criteria</field>
            <field name="arch" type="xml">
                <list string="Preference Criteria">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="criteria_type"/>
                    <field name="points"/>
                    <field name="scoring_rule"/>
                </list>
            </field>
        </record>

        <!-- ===================================== -->
        <!-- Preference Criteria - Form View -->
        <!-- ===================================== -->
        <record id="view_sagovpreference_point_criteria_form" model="ir.ui.view">
            <field name="name">sagovpreference.point.criteria.form</field>
            <field name="model">sagovpreference.point.criteria</field>
            <field name="arch" type="xml">
                <form string="Preference Criteria">
                    <sheet>
                        <group>
                            <group>
                                <field name="system_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="name"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="criteria_key"/>
                                <field name="criteria_type"/>
                                <field name="points"/>
                                <field name="scoring_rule"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        <group string="Tiered Scoring" invisible="scoring_rule != 'tiered'">
                            <field name="tiered_scoring" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
