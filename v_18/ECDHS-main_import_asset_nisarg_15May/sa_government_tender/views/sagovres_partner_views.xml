		<!-- Inherit Contact Form View -->
        <record id="sagovres_partner_form_inherit" model="ir.ui.view">
            <field name="name">sagovres.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_type']" position="attributes">
                    <attribute name="force_save">1</attribute>
                    <attribute name="required">True</attribute>
                </xpath>
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page string="Supplier SCM Details" name="sagov_supplier_scm_details">
                        <group>
                            <group>
                                <field name="supplier_rank" readonly="1"/>
                            </group>
                            <group>
                                <field name="is_company" readonly="1"/>
                            </group>
                            <group string="CSD Details">
                                <field name="csd_registered"/>
                                <field name="csd_number"/>
                                <field name="csd_registration_date"/>
                            </group>
                            <group string="Tax Clearance Details">
                                <field name="tax_clearance_number"/>
                                <field name="tax_clearance_expiry"/>
                                <field name="tax_compliant"/>
                            </group>
                            <group string="COID Details">
                                <field name="coid_number"/>
                                <field name="coid_compliant"/>
                            </group>
                            <group string="B-BBEE Details">
                                <field name="bbbee_level"/>
                                <field name="bbbee_certificate_number"/>
                                <field name="bbbee_certificate_date"/>
                                <field name="bbbee_expiry_date"/>
                                <field name="bbbee_valid"/>
                            </group>
                            <group string="Tendering Details">
                                <field name="sagovtender_bid_count"/>
                                <field name="sagovtender_award_count"/>
                                <field name="total_tender_value"/>
                            </group>
                            <group string="Blacklist Details">
                                <field name="is_blacklisted"/>
                                <field name="blacklist_date"/>
                                <field name="blacklist_reason"/>
                            </group>
                        </group>
                            <field name="sagovtender_bid_ids" string="Tender Bids"/>
                    </page>
                </xpath>
                <!-- <xpath expr="//span[@name='address_name']" position="before">
                    <xpath expr="//field[@name='ref']" position="move"/>
                </xpath> -->
                <!-- <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> -->
            </field>
        </record>

