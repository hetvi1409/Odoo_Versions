<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sagovtender_document_list" model="ir.ui.view">
        <field name="name">sagovtender.document.list</field>
        <field name="model">sagovtender.document</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-info="sequence">
                <field name="sequence" widget="handle"/>
                <field name="attachment_id" domain="[('id', '=', False)]"
                       options="{'create': false, 'create_edit': false}"
                       column_invisible="True"/>
                <field name="datas" filename="attachment_filename" string="File"/>
                <field name="name" string="Document Name"/>
                <field name="document_type"/>
                <field name="mandatory"/>
                <field name="public"/>
                <field name="version"/>
                <field name="upload_date"/>
                <button name="action_preview_document" type="object" string="Preview"
                        class="btn-primary"
                        invisible="attachment_id == False"/>
            </list>
        </field>
    </record>

    <record id="view_sagovtender_document_form" model="ir.ui.view">
        <field name="name">sagovtender.document.form</field>
        <field name="model">sagovtender.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group>
                        <group>
                            <field name="document_type" required="1" onchange="1"/>
                            <field name="name" required="1"/>
                            <field name="attachment_id" domain="[('id', '=', False)]"
                                   options="{'create': false, 'create_edit': false}"
                                   invisible="True"/>
                            <field name="datas" filename="attachment_filename" string="File" required="True"/>
                            <field name="attachment_filename" invisible="True"/>
                            <field name="version"/>
                            <field name="mandatory"/>
                            <field name="public"/>
                            <button name="action_preview_document" type="object" string="Preview"
                                    class="btn-primary"
                                    invisible="attachment_id == False"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="tender_id" required="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="upload_date"/>
                            <field name="uploaded_by_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="description" placeholder="Detailed description..."/>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>