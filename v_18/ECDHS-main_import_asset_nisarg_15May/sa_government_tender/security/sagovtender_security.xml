<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categories -->
        <record id="module_category_tender_management" model="ir.module.category">
            <field name="name">Tender Management</field>
            <field name="description">Manage tender process and access rights</field>
            <field name="sequence">20</field>
        </record>

        <!-- User Groups -->
        <record id="group_sagovtender_user" model="res.groups">
            <field name="name">User: Own Requisitions</field>
            <field name="category_id" ref="module_category_tender_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">User can create and view own purchase requisitions</field>
        </record>

        <record id="group_sagovtender_scm_officer" model="res.groups">
            <field name="name">SCM Officer</field>
            <field name="category_id" ref="module_category_tender_management"/>
            <field name="implied_ids" eval="[(4, ref('group_sagovtender_user'))]"/>
            <field name="comment">Can manage tender process, advertising, and documentation</field>
        </record>

        <record id="group_sagovtender_finance" model="res.groups">
            <field name="name">Finance Officer</field>
            <field name="category_id" ref="module_category_tender_management"/>
            <field name="implied_ids" eval="[(4, ref('group_sagovtender_user'))]"/>
            <field name="comment">Can confirm budgets and financial aspects</field>
        </record>

        <record id="group_sagovtender_evaluator" model="res.groups">
            <field name="name">BEC Member / Evaluator</field>
            <field name="category_id" ref="module_category_tender_management"/>
            <field name="implied_ids" eval="[(4, ref('group_sagovtender_scm_officer'))]"/>
            <field name="comment">Can evaluate bids and participate in BEC</field>
        </record>

        <record id="group_sagovtender_bac_member" model="res.groups">
            <field name="name">BAC Member</field>
            <field name="category_id" ref="module_category_tender_management"/>
            <field name="implied_ids" eval="[(4, ref('group_sagovtender_evaluator'))]"/>
            <field name="comment">Can review evaluations and make award decisions</field>
        </record>

        <record id="group_sagovtender_manager" model="res.groups">
            <field name="name">Tender Manager</field>
            <field name="category_id" ref="module_category_tender_management"/>
            <field name="implied_ids" eval="[(4, ref('group_sagovtender_bac_member'))]"/>
            <field name="comment">Full access to tender management system</field>
        </record>

        <!-- Record Rules -->

        <!-- Purchase Requisition Rules -->
        <record id="requisition_user_rule" model="ir.rule">
            <field name="name">Purchase Requisition: User - Own Requisitions</field>
            <field name="model_id" ref="model_sagovtender_purchase_requisition"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="requisition_scm_rule" model="ir.rule">
            <field name="name">Purchase Requisition: SCM - All</field>
            <field name="model_id" ref="model_sagovtender_purchase_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_scm_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Budget Confirmation Rules -->
        <record id="budget_finance_rule" model="ir.rule">
            <field name="name">Budget Confirmation: Finance - All</field>
            <field name="model_id" ref="model_sagovtender_budget_confirm"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_finance'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tender Rules -->
        <record id="tender_public_rule" model="ir.rule">
            <field name="name">Tender: Public Read</field>
            <field name="model_id" ref="model_sagovtender_tender"/>
            <field name="domain_force">[('state', 'in', ['advertised', 'bid_submission'])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="tender_scm_rule" model="ir.rule">
            <field name="name">Tender: SCM - Full Access</field>
            <field name="model_id" ref="model_sagovtender_tender"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_scm_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Evaluation Rules -->
        <record id="evaluation_evaluator_rule" model="ir.rule">
            <field name="name">Evaluation: BEC Members Only</field>
            <field name="model_id" ref="model_sagovtender_bid_evaluation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_evaluator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- BAC Review Rules -->
        <record id="sagovbac_review_bac_rule" model="ir.rule">
            <field name="name">BAC Review: BAC Members Only</field>
            <field name="model_id" ref="model_sagovtender_bac_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_bac_member'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: Full Access to All -->
        <record id="all_models_manager_rule" model="ir.rule">
            <field name="name">All Models: Manager - Full Access</field>
            <field name="model_id" ref="model_sagovtender_purchase_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_manager'))]"/>
        </record>

        <!-- Bid Access Rules: Suppliers can only see their own bids -->
        <record id="bid_supplier_own_rule" model="ir.rule">
            <field name="name">Bid: Supplier - Own Bids Only</field>
            <field name="model_id" ref="model_sagovtender_bid"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Bid Access Rules: SCM Officers can see all bids -->
        <record id="bid_scm_all_rule" model="ir.rule">
            <field name="name">Bid: SCM - All Bids</field>
            <field name="model_id" ref="model_sagovtender_bid"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sagovtender_scm_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Prevent portal users from accessing sensitive data -->
        <record id="portal_tender_public_only" model="ir.rule">
            <field name="name">Tender: Portal - Published Only</field>
            <field name="model_id" ref="model_sagovtender_tender"/>
            <field name="domain_force">[('state', 'in', ['advertised', 'briefing', 'bid_submission'])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>