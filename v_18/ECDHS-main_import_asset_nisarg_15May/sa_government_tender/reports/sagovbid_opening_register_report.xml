<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sagovbid_opening_register_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h2>BID OPENING REGISTER</h2>
                            <h3 t-field="o.tender_id.name"/>
                            <h4 t-field="o.tender_id.title"/>
                        </div>

                        <div class="row mt-4">
                            <div class="col-6">
                                <p><strong>Register Number:</strong> <span t-field="o.name"/></p>
                                <p><strong>Tender Number:</strong> <span t-field="o.tender_id.name"/></p>
                                <p><strong>Department:</strong> <span t-field="o.tender_id.department_id.name"/></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Opening Date:</strong> <span t-field="o.opening_date"/></p>
                                <p><strong>Opening Location:</strong> <span t-field="o.opening_location"/></p>
                                <p><strong>Closing Date:</strong> <span t-field="o.tender_id.closing_date"/></p>
                            </div>
                        </div>

                        <h4 class="mt-4">Bids Received</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Bidder Name</th>
                                    <th>Bid Amount</th>
                                    <th>Submission Date</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><t t-esc="line_index + 1"/></td>
                                    <td><span t-field="line.partner_id.name"/></td>
                                    <td><span t-field="line.bid_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                                    <td><span t-field="line.submission_date"/></td>
                                    <td><span t-field="line.notes"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <p class="mt-3"><strong>Total Bids Received: </strong><t t-esc="len(o.line_ids)"/></p>

                        <h4 class="mt-4">Stakeholders Present</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Title</th>
                                    <th>Organization</th>
                                    <th>Type</th>
                                    <th>Signature</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.stakeholder_ids" t-as="stakeholder">
                                    <td><span t-field="stakeholder.name"/></td>
                                    <td><span t-field="stakeholder.title"/></td>
                                    <td><span t-field="stakeholder.organization"/></td>
                                    <td><span t-field="stakeholder.stakeholder_type"/></td>
                                    <td>
                                        <t t-if="stakeholder.signed">
                                            <span>Signed: <t t-esc="stakeholder.signature_date"/></span>
                                        </t>
                                        <t t-else="">
                                            _____________________
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-5">
                            <p><em>This bid opening register is published in accordance with National Treasury regulations
                            and forms part of the procurement documentation.</em></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
