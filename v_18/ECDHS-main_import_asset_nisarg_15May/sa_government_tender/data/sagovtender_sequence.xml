<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequences -->
        <record id="seq_tender_app" model="ir.sequence">
            <field name="name">Annual Procurement Plan</field>
            <field name="code">sagovtender.app</field>
            <field name="prefix">APP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_tender_requisition" model="ir.sequence">
            <field name="name">Purchase Requisition</field>
            <field name="code">sagovtender.requisition</field>
            <field name="prefix">PR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sagovtender_budget_confirm" model="ir.sequence">
            <field name="name">Budget Confirmation</field>
            <field name="code">sagovtender.budget.confirm</field>
            <field name="prefix">BC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_tender_tender" model="ir.sequence">
            <field name="name">Tender</field>
            <field name="code">sagovtender.tender</field>
            <field name="prefix">TNR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sagovtender_bid" model="ir.sequence">
            <field name="name">Tender Bid</field>
            <field name="code">sagovtender.bid</field>
            <field name="prefix">BID/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sagovtender_bid_opening" model="ir.sequence">
            <field name="name">Bid Opening Register</field>
            <field name="code">sagovtender.bid.opening</field>
            <field name="prefix">BOR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sagovtender_compliance_check" model="ir.sequence">
            <field name="name">Compliance Check</field>
            <field name="code">sagovtender.compliance.check</field>
            <field name="prefix">CC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_tender_declaration" model="ir.sequence">
            <field name="name">Declaration of Interest</field>
            <field name="code">sagovtender.declaration</field>
            <field name="prefix">DOI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_tender_evaluation" model="ir.sequence">
            <field name="name">Bid Evaluation</field>
            <field name="code">sagovtender.evaluation</field>
            <field name="prefix">EVAL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sagovtender_bac_review" model="ir.sequence">
            <field name="name">BAC Review</field>
            <field name="code">sagovtender.bac.review</field>
            <field name="prefix">BAC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sagovtender_award" model="ir.sequence">
            <field name="name">Tender Award</field>
            <field name="code">sagovtender.award</field>
            <field name="prefix">AWD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
