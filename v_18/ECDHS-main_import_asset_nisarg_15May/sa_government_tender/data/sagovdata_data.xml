<odoo>
    <data noupdate="0">
        <record id="view_module_filter_inherit_sa_government_tender" model="ir.ui.view">
            <field name="name">ir.module.module.list.select.inherit.sa_government_tender</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.view_module_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="sa_government_tender" string="sa_government_tender" domain="[('name', 'ilike', 'sa_government_tender')]"/>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="base.open_module_list">
            <field name="context" eval="{'search_default_app':1, 'search_default_sa_government_tender':1}" />
        </record>

