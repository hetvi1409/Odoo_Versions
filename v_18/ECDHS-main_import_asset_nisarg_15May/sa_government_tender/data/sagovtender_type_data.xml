<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tender Types -->
        <record id="tender_type_goods" model="sagovtender.type">
            <field name="name">Goods / Supplies</field>
            <field name="code">GOODS</field>
            <field name="description">Procurement of goods, equipment, and supplies</field>
        </record>

        <record id="tender_type_services" model="sagovtender.type">
            <field name="name">Services</field>
            <field name="code">SERVICES</field>
            <field name="description">Professional and general services</field>
        </record>

        <record id="tender_type_works" model="sagovtender.type">
            <field name="name">Works / Construction</field>
            <field name="code">WORKS</field>
            <field name="description">Construction, renovation, and maintenance works</field>
        </record>

        <record id="tender_type_consultancy" model="sagovtender.type">
            <field name="name">Consultancy Services</field>
            <field name="code">CONSULT</field>
            <field name="description">Professional consultancy services</field>
        </record>

        <!-- Advertisement Platforms -->
        <record id="platform_etender" model="sagovtender.advert.platform">
            <field name="name">eTender Portal</field>
            <field name="platform_type">etender</field>
            <field name="url">https://esagovtender.treasury.gov.za</field>
        </record>

        <record id="platform_website" model="sagovtender.advert.platform">
            <field name="name">Department Website</field>
            <field name="platform_type">website</field>
        </record>

        <record id="platform_bulletin" model="sagovtender.advert.platform">
            <field name="name">Government Tender Bulletin</field>
            <field name="platform_type">bulletin</field>
        </record>

        <record id="platform_newspaper" model="sagovtender.advert.platform">
            <field name="name">Local Newspaper</field>
            <field name="platform_type">newspaper</field>
        </record>
    </data>
</odoo>
