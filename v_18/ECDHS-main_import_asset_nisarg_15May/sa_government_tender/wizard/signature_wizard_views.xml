<odoo>
    <record id="view_signature_wizard_form" model="ir.ui.view">
        <field name="name">app.signature.wizard.form</field>
        <field name="model">app.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Sign">
                <group>
                    <field name="use_existing"/>
                    <field name="signature" widget="signature" options="{'size': [0,50]}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>