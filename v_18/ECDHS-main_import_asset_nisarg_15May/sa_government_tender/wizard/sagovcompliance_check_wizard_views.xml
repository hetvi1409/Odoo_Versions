<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sagovcompliance_check_wizard_form" model="ir.ui.view">
        <field name="name">sagovtender.compliance.check.wizard.form</field>
        <field name="model">sagovtender.compliance.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Compliance Check">
                <group>
                    <group>
                        <field name="tender_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                        <field name="bid_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                        <field name="partner_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Continue" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
