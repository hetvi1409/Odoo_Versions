<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sagovspecification_wizard_form" model="ir.ui.view">
        <field name="name">sagovtender.specification.wizard.form</field>
        <field name="model">sagovtender.specification.wizard</field>
        <field name="arch" type="xml">
            <form string="Open Specification">
                <group>
                    <field name="requisition_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="specification_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_open_specification" type="object" string="Open Specification" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
