<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sagovbudget_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">sagovtender.budget.confirmation.wizard.form</field>
        <field name="model">sagovtender.budget.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Open Budget Confirmation">
                <group>
                    <field name="requisition_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="budget_confirmation_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_open_budget_confirmation" type="object" string="Open Budget Confirmation" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
