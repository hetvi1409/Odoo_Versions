<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_app_rejection_wizard_form" model="ir.ui.view">
        <field name="name">app.rejection.wizard.form</field>
        <field name="model">app.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject APP">
                <group>
                    <field name="app_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Please provide a detailed reason for rejecting this APP..." required="1"/>
                </group>
                <footer>
                    <button string="Confirm Rejection" name="action_confirm_rejection" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
