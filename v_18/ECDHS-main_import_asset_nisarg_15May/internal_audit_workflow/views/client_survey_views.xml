<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="survey_form_custom" model="ir.ui.view">
        <field name="name">survey_form_custom</field>
        <field name="model">client.survey</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.survey_form_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//div[2]" position="replace">
                <div style="width:100%">
                    <table border="1" style="width:100%">
                        <tr>
                            <td>
                                <h3 style="text-align:left;">Umzimkhulu Municipality</h3>
                            </td>
                            <td>
                                <strong>W/P Reference:
                                    <field name="survey_number"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <h5 style="text-align:left;">Internal Audit Unit</h5>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <h4 style="text-align:left;">CUSTOMER SATISFACTION SURVEY</h4>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Auditee:
                                    <field name="auditee"/>
                                </strong>
                            </td>
                            <td>
                                <strong>Project:
                                    <field name="project"/>
                                </strong>
                            </td>
                            <td>
                                <strong>Team Leader:
                                    <field name="team_leader"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Subject:
                                    <field name="subject"/>
                                </strong>
                            </td>
                            <td>
                                <strong>Project Name:
                                    <field name="project_name"/>
                                </strong>
                            </td>
                            <td>
                                <strong>Reviewer:
                                    <field name="reviewer"/>
                                </strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </xpath>
        </field>
    </record>
</odoo>