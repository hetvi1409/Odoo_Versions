<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="internal_audit_charter_view_form" model="ir.ui.view">
        <field name="name">internal_audit_charter_view_form</field>
        <field name="model">internal.audit.charter</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.internal_audit_charter_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <field name="stages" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                    <button name="action_2nd_review" type="object" string="Prepare"
                            class="oe_highlight"
                            invisible="stages != 'preparer' or uid != preparer_id"/>
                    <button name="action_approve" type="object" string="Reviewed"
                            class="oe_highlight"
                            invisible="stages != 'second_reviewer' or uid != reviewer_id"/>
                    <button name="action_revert" type="object"
                            invisible="stages != 'second_reviewer'"
                            string="Revert" class="oe_highlight"/>
                    <button name="action_reject" type="object"
                            invisible="stages != 'second_reviewer'"
                            string="Reject" class="oe_highlight"/>
                    <button name="action_revert" type="object"
                            invisible="stages != 'rejected'"
                            string="Move to Prepare" class="oe_highlight"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='user_preparer_ids']" position="replace">
                <field name="can_edit" invisible="1"/>
                <field name="preparer_id" widget="many2one_avatar_user"/>
                <field name="reviewer_id" widget="many2one_avatar_user"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='requirements']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='record_work_done']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='conclusion']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='attachment_ids']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='document_ids']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='audit_charter_ids']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='feedback']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
        </field>
    </record>
</odoo>
