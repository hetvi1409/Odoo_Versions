<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Adding more fields to res config settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='analytic']" position="after">
                <block title="Approvers" name="internal_audit_workflow" >
                    <setting>
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="audit_preparer_id" string="Preparer" class="col-2 o_light_label"/>
                                    <field name="audit_preparer_id" />
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting>
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="audit_reviewer_id" string="Reviewer" class="col-2 o_light_label"/>
                                    <field name="audit_reviewer_id" />
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting>
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="audit_approver_id" string="Approver" class="col-2 o_light_label"/>
                                    <field name="audit_approver_id" />
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>