<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_subsidy_verify" model="mail.template">
        <field name="name">Verify the Application</field>
        <field name="model_id"
               ref="website_housing_subsidy.model_housing_subsidy"/>
        <field name="subject">Verify the Application</field>
        <field name="description">send to the conveyar.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi<t t-out="object.convey_name.name"/>,
                    <br/>
                    Please verify the application
                    <t t-out="object.individual_reg_number"/>
                </p>
            </div>
            <div style="margin: 16px 0px 16px 0px;">
                <a t-att-href="(object.get_form_url())"
                   style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                    <t>
                        Open
                        <t t-out="object.individual_reg_number"/>
                    </t>
                </a>
            </div>
        </field>
    </record>
    <record id="email_template_subsidy_approve" model="mail.template">
        <field name="name">Approve the Application</field>
        <field name="model_id"
               ref="website_housing_subsidy.model_housing_subsidy"/>
        <field name="subject">Approve the Application</field>
        <field name="description">send to the lender.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi<t t-out="object.lender_name.name"/>,
                    <br/>
                    Please approve the application
                    <t t-out="object.individual_reg_number"/>
                </p>
            </div>
            <div style="margin: 16px 0px 16px 0px;">
                <a t-att-href="(object.get_form_url())"
                   style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                    <t>
                        Open
                        <t t-out="object.individual_reg_number"/>
                    </t>
                </a>
            </div>
        </field>
    </record>
</odoo>