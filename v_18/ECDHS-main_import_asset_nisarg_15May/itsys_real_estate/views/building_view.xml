<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_update_farm_erf" model="ir.actions.server">
            <field name="name">ERF</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_building"/>
            <field name="state">code</field>
            <field name="code">action = records.update_farm_erf()</field>
            <field name="binding_model_id"
                   ref="model_building"/>
        </record>

        <menuitem id="menu_itsys_real_estate" name="Property"
                  web_icon="itsys_real_estate,static/description/icon.png"
                  sequence="28"/>

        <record model="ir.ui.view" id="building_form">
            <field name="name">building.form</field>
            <field name="model">building</field>
            <field name="priority">1</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Real Estate">
                    <header>
                        <button name="action_create_units" type="object"
                                string="Create Units" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">

                        </div>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="bg-danger"
                                invisible="active == True"/>

                        <group>
                            <group>
                                <field name="property_name"/>
                                <field name="name"/>
                                <field name="code" requied="1"/>
                                <field name="region_id"/>
                                <field name="partner_id"
                                       context="{'res_partner_search_mode': 'is_owner', 'default_is_owner':True,}"
                                       domain="[('is_owner','=',True)]"/>
                            </group>
                            <group>
                                <field name="purchase_date"/>
                                <field name="launch_date"/>

                                <!--                                <field name="account_analytic_id" />-->
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                                <field name="active"/>
                                <field name="sg_code"/>
                                <field name="description"/>
                                <field name="farm_erf"/>
                            </group>
                        </group>

                        <notebook colspan="4">
                            <page string="invisible" invisible="1"/>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="building_base_pages_form">
            <field name="name">building.base_pages.form</field>
            <field name="model">building</field>
            <field name="inherit_id" ref="building_form"/>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <notebook>
                    <page string="Basic Information" name="info">
                        <group>
                            <group>
                                <field name="type"/>
                                <field name="status"/>
                                <field name="building_area"/>
                                <field name="land_area"/>
                                <field name="constructed"/>
                                <field name="lift"/>
                                <field name="lift_f"/>
                                <field name="pricing"/>
                                <field name="gps_x"/>
                                <field name="gps_y"/>
                                <field name="other_land_property_use"/>
                                <field name="other_land_use_type"/>
                                <field name="land_claim"/>
                                <field name="claimant_name"/>
                                <field name="audit_status"/>
                            </group>
                            <group>
                                <field name="no_of_floors"/>
                                <field name="props_per_floors"/>
                                <field name="surface"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="north"/>
                                <field name="south"/>
                                <field name="east"/>
                                <field name="west"/>
                                <field name="local_municipality"/>
                                <field name="municipality_id"/>
                                <field name="township"/>
                                <field name="registration_division"/>
                                <field name="rural_urban"/>
                                <field name="farm_portion"/>
                                <field name="farm_name"/>
                            </group>
                        </group>
                    </page>
                    <page string="Properties">
                        <field name="unit_ids"
                               context="{'default_is_property':True,'form_view_ref':'itsys_real_estate.building_unit_form',
                               'tree_view_ref':'building_unit_list'}"/>
                    </page>
                    <page string="Images">
                        <group name="building_template_images"
                               string="Building Images">
                            <field name="building_image_ids"
                                   class="o_website_sale_image_list"
                                   context="{'default_name': name}"
                                   mode="kanban"
                                   options="{'create_text':'Add a Media'}"
                                   nolabel="1"/>
                        </group>
                    </page>
                    <page string="Floor Plans">
                        <group name="floor_plan_template_images"
                               string="Floor Plans">
                            <field name="property_floor_plan_image_ids"
                                   class="o_website_sale_image_list"
                                   context="{'default_name': name}"
                                   mode="kanban"
                                   options="{'create_text':'Add a Media'}"
                                   nolabel="1"/>
                        </group>
                    </page>
                    <page string="Lease Documents" name="building_documents">
                        <field name="rental_attachment_document_ids">
                            <list editable="bottom" create="true"
                                  force_save="1">
                                <field name="name"/>
                                <field name="file" filename="filename"
                                       readonly="1" widget="binary"/>
                                <field name="filename" readonly="1"
                                       invisible="1"/>

                                <!--                                <field name="partner_id"/>-->
                            </list>
                            <form>
                                <group>
                                    <field name="name"/>
                                    <field name="filename"/>
                                </group>
                                <group>
                                    <field name="file" filename="filename"/>
                                </group>
                            </form>
                        </field>
                    </page>
                    <page string="Additional Information">
                        <group>
                            <group>
                                <field name="license_code"/>
                                <field name="license_date"/>
                                <field name="date_added"/>
                                <field name="license_location"/>
                            </group>
                        </group>
                    </page>
                    <page string="Geolocation" name="geolocation">
                        <group>
                            <group>
                                <field name="address"
                                       widget="place_autocomplete"
                                       class="oe_inline"/>
                            </group>
                        </group>
                    </page>
                    <page string="Notes">
                        <field name="note" colspan="4" nolabel="1"/>
                    </page>
                </notebook>
                <xpath expr="//sheet" position="inside">
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                    </style>
                </xpath>

            </field>
        </record>

        <record model="ir.ui.view" id="building_list">
            <field name="name">building.list</field>
            <field name="model">building</field>
            <field name="priority">1</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Building">
                    <field name="region_id"/>
                    <field name="local_municipality"/>
                    <field name="sg_code"/>
                    <field name="township"/>
                    <field name="municipality_id"/>
                    <field name="registration_division"/>
                    <field name="rural_urban"/>
                    <field name="name"/>
                    <field name="farm_name"/>
                    <field name="portion_name"/>
                    <field name="sg_diagram_no"/>
                    <field name="extent_ha"/>
                    <field name="title_deed_no"/>
                    <field name="registered_owner"/>
                    <field name="land_use"/>
                    <field name="user_department"/>
                    <field name="property_name"/>
                    <field name="location_street_address"/>
                    <field name="lpi_code"/>
                    <field name="property_category_type"/>
                    <field name="gps_x"/>
                    <field name="gps_y"/>
                    <field name="other_land_property_use"/>
                    <field name="other_land_use_type"/>
                    <field name="land_claim"/>
                    <field name="claimant_name"/>
                    <field name="audit_status"/>
                </list>
            </field>
        </record>
        <record id="building_filter" model="ir.ui.view">
            <field name="name">building.list.filter</field>
            <field name="model">building</field>
            <field name="arch" type="xml">
                <search string="Property Search">
                    <!-- Quick search fields -->
                    <group>
                        <field name="region_id"/>
                        <field name="local_municipality"/>
                        <field name="township"/>
                        <field name="name"/>
                        <field name="land_use"/>
                        <field name="location_street_address"/>
                        <field name="lpi_code"/>
                        <field name="property_category_type"/>
                    </group>
                    <newline/>
                    <!-- Filters -->
                    <filter string="Archived"
                            name="inactive"
                            domain="[('active', '=', False)]"/>
                    <newline/>
                    <!-- Group By -->
                    <group expand="0" string="Group By">
                        <filter string="Region"
                                name="group_region"
                                domain="[]"
                                context="{'group_by': 'region_id'}"/>

                        <filter string="Local Municipality"
                                name="group_local_municipality"
                                domain="[]"
                                context="{'group_by': 'local_municipality'}"/>

                        <filter string="Township"
                                name="group_township"
                                domain="[]"
                                context="{'group_by': 'township'}"/>

                        <filter string="Land Use"
                                name="group_land_use"
                                domain="[]"
                                context="{'group_by': 'land_use'}"/>

                        <filter string="Property Category"
                                name="group_property_category"
                                domain="[]"
                                context="{'group_by': 'property_category_type'}"/>
                    </group>

                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="building_act1">
            <field name="name">Main Property</field>
            <field name="res_model">building</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="building_list"/>
            <!--<field name="search_view_id" ref="building_filter"/>-->
        </record>
        <record model="ir.actions.act_window.view" id="building_act1_view2">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="building_list"/>
            <field name="act_window_id" ref="building_act1"/>
        </record>
        <record model="ir.actions.act_window.view" id="building_act1_view1">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="building_form"/>
            <field name="act_window_id" ref="building_act1"/>
        </record>
        <menuitem
                id="menu_building_list"
                name="Property structure"
                parent="menu_itsys_real_estate"
                sequence="1"/>
        <menuitem
                sequence="0"
                action="building_act1"
                id="menu_building_list_sub"
                parent="menu_building_list"/>

        <record model="ir.ui.view" id="building_list_web">
            <field name="name">building.list_web</field>
            <field name="model">building</field>
            <field name="priority">1</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Real Estate">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="usage"/>
                    <field name="surface" sum="Total Surface"/>
                    <field name="lease_target"/>
                    <field name="staircase"/>
                    <field name="floor"/>
                    <field name="lift"/>
                    <!--                    <field name="category"/>-->
                    <field name="old_building"/>
                    <field name="handicap"/>
                    <field name="parking_place_rentable"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="building_act1_web">
            <field name="name">Top (Test)</field>
            <field name="res_model">building</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="building_list_web"/>
        </record>
        <record model="ir.actions.act_window.view" id="building_act1_view2_web">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="building_list_web"/>
            <field name="act_window_id" ref="building_act1_web"/>
        </record>
        <record model="ir.actions.act_window.view" id="building_act1_view1_web">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="building_form"/>
            <field name="act_window_id" ref="building_act1_web"/>
        </record>
        <menuitem
                id="menu_settings"
                name="Settings"
                parent="menu_itsys_real_estate"
                sequence="2000"/>

    </data>
</odoo>
