<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_move_prop_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_user_id" position="after">
                    <field name="property_owner_id"/>
                </field>
            </field>
        </record>
        <record model="ir.ui.menu" id="sign.menu_document">
            <field name="name">Digital Signature</field>
        </record>

        <record id="inherit_sign_request_view_kanban" model="ir.ui.view">
            <field name="name">sign.request.kanban.inherit</field>
            <field name="model">sign.request</field>
            <field name="inherit_id" ref="sign.sign_request_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@t-name='menu']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>