<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_update_form" model="ir.ui.view">
        <field name="name">res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='contact_addresses']" position="after">
                <page name="CSD" invisible="not supplier_rank">
                    <group>
                        <group>
                            <field name="csd_titles"/>
                            <field name="csd_initials"/>
                            <field name="telephones_1" placeholder="Telephone 1..."/>
                            <field name="telephones_2" placeholder="Telephone 2..."/>
                            <field name="faxs_1" placeholder="Fax 1..."/>
                            <field name="faxs_2" placeholder="Fax 2..."/>
                        </group>
                        <group>
                            <field name="registrations"/>
                            <field name="c_id_numbers"/>
                            <field name="c_passport_numbers"/>
                            <field name="ub_ap_tax_clearance_cert_valids"/>
                            <field name="ub_ap_tax_clearance_cert_expirys"/>
                            <field name="uc_ap_csd_supplier_ids"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="uc_ap_csd_in_actives"/>
                            <field name="uc_ap_csd_on_holds"/>
                            <field name="uc_ap_commoditys_1"/>
                            <field name="uc_ap_commoditys_2"/>
                            <field name="uc_ap_commoditys_3"/>
                            <field name="uc_ap_commoditys_4"/>
                            <field name="uf_ap_black_ownerships"/>
                        </group>
                        <group>
                            <field name="uf_ap_black_woman_ownerships"/>
                            <field name="uf_ap_empowering_suppliers"/>
                            <field name="uf_ap_value_adding_suppliers"/>
                            <field name="uf_ap_black_youths"/>
                            <field name="uf_ap_blacks_disabled"/>
                            <field name="uf_ap_directors_surname_1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="uf_ap_directors_surname_1"/>
                            <field name="uf_ap_directors_surname_2"/>
                            <field name="uf_ap_directors_surname_3"/>
                            <field name="uf_ap_directors_surname_4"/>
                            <field name="uf_ap_directors_surname_5"/>
                        </group>
                        <group>
                            <field name="uf_ap_directors_surname_6"/>
                            <field name="uf_ap_directors_surname_7"/>
                            <field name="uf_ap_directors_surname_8"/>
                            <field name="uf_ap_directors_surname_9"/>
                            <field name="uf_ap_directors_surname_10"/>
                        </group>

                    </group>
                    <group name="Director">
                        <group>
                            <field name="uf_ap_directors_name_1"/>
                            <field name="uf_ap_directors_name_2"/>
                            <field name="uf_ap_directors_name_3"/>
                            <field name="uf_ap_directors_name_4"/>
                            <field name="uf_ap_directors_name_5"/>
                        </group>
                        <group>
                            <field name="uf_ap_directors_name_6"/>
                            <field name="uf_ap_directors_name_7"/>
                            <field name="uf_ap_directors_name_8"/>
                            <field name="uf_ap_directors_name_9"/>
                            <field name="uf_ap_directors_name_10"/>
                        </group>
                    </group>
                    <group name="Director">
                        <group>
                            <field name="uf_ap_directors_id_1"/>
                            <field name="uf_ap_directors_id_2"/>
                            <field name="uf_ap_directors_id_3"/>
                            <field name="uf_ap_directors_id_4"/>
                            <field name="uf_ap_directors_id_5"/>
                        </group>
                        <group>
                            <field name="uf_ap_directors_id_6"/>
                            <field name="uf_ap_directors_id_7"/>
                            <field name="uf_ap_directors_id_8"/>
                            <field name="uf_ap_directors_id_9"/>
                            <field name="uf_ap_directors_id_10"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="uc_ap_status_level_contributors"/>
                            <field name="ud_ap_certificate_issues_expiry_date"/>
                            <field name="ud_ap_vat_numbers"/>
                        </group>
                        <group>
                            <field name="ud_ap_income_tax_numbers"/>
                            <field name="uc_ap_csd_bank_accounts_status"/>
                            <field name="uc_ap_csd_tax_validation_responses"/>
                            <field name="uc_ap_csd_trading_names"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>