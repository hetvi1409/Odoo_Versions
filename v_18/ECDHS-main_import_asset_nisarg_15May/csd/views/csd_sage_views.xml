<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="csd_sage_view_form" model="ir.ui.view">
        <field name="name">csd.sage.view.form</field>
        <field name="model">csd.sage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="csd_partner_id" invisible="1"/>
                            <field name="csd_name"/>
                            <field name="csd_title"/>
                            <field name="csd_initial"/>
                            <field name="contact_person"/>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State"
                                       options='{"no_open": True}'/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country"
                                       options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </group>
                        <group>
                            <label for="post_street" string="Post Address"/>
                            <div class="o_address_format">
                                <field name="post_street" placeholder="Street..." class="o_address_street"/>
                                <field name="post_street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="post_city" placeholder="City" class="o_address_city"/>
                                <field name="post_state_id" class="o_address_state" placeholder="State"
                                       options='{"no_open": True}'/>
                                <field name="post_zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="post_country_id" placeholder="Country" class="o_address_country"
                                       options='{"no_open": True, "no_create": True}'/>
                            </div>
                            <field name="telephone_1"/>
                            <field name="fax_1"/>
                            <field name="tax_number"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="telephone_2"/>
                            <field name="fax_2"/>
                            <field name="email"/>
                            <field name="registration"/>
                            <field name="branch_code"/>
                            <field name="bank_acc_num"/>
                            <field name="bank_acc_type"/>
                            <field name="c_bank_acc_holder"/>
                            <field name="c_id_number"/>
                        </group>
                        <group>
                            <field name="c_passport_number"/>
                            <field name="ub_ap_tax_clearance_cert_valid"/>
                            <field name="ub_ap_tax_clearance_cert_expiry"/>
                            <field name="uc_ap_csd_supplier_id"/>
                            <field name="uc_ap_csd_in_active"/>
                            <field name="uc_ap_csd_on_hold"/>
                            <field name="uc_ap_commodity_1"/>
                            <field name="uc_ap_commodity_2"/>
                            <field name="uc_ap_commodity_3"/>
                            <field name="uc_ap_commodity_4"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="uf_ap_black_ownership"/>
                            <field name="uf_ap_black_woman_ownership"/>
                            <field name="uf_ap_empowering_supplier"/>
                            <field name="uf_ap_value_adding_supplier"/>
                            <field name="uf_ap_black_youth"/>
                            <field name="uf_ap_black_disabled"/>
                        </group>
                        <group>
                            <field name="uc_ap_status_level_contributor"/>
                            <field name="ud_ap_certificate_issue_expiry_date"/>
                            <field name="ud_ap_vat_number"/>
                            <field name="ud_ap_income_tax_number"/>
                            <field name="uc_ap_csd_bank_account_status"/>
                            <field name="uc_ap_csd_tax_validation_response"/>
                            <field name="uc_ap_csd_tax_validation_response"/>
                        </group>

                    </group>
                    <group name="Director">
                        <group>
                            <field name="uf_ap_director_name_1"/>
                            <field name="uf_ap_director_name_2"/>
                            <field name="uf_ap_director_name_3"/>
                            <field name="uf_ap_director_name_4"/>
                            <field name="uf_ap_director_name_5"/>
                        </group>
                        <group>
                            <field name="uf_ap_director_name_6"/>
                            <field name="uf_ap_director_name_7"/>
                            <field name="uf_ap_director_name_8"/>
                            <field name="uf_ap_director_name_9"/>
                            <field name="uf_ap_director_name_10"/>
                        </group>
                    </group>
                    <group name="Director">
                        <group>
                            <field name="uf_ap_director_id_1"/>
                            <field name="uf_ap_director_id_2"/>
                            <field name="uf_ap_director_id_3"/>
                            <field name="uf_ap_director_id_4"/>
                            <field name="uf_ap_director_id_5"/>
                        </group>
                        <group>
                            <field name="uf_ap_director_id_6"/>
                            <field name="uf_ap_director_id_7"/>
                            <field name="uf_ap_director_id_8"/>
                            <field name="uf_ap_director_id_9"/>
                            <field name="uf_ap_director_id_10"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="csd_sage_view_list" model="ir.ui.view">
        <field name="name">csd.sage.view.list</field>
        <field name="model">csd.sage</field>
        <field name="arch" type="xml">
            <list>
                <field name="csd_name"/>
                <field name="csd_title"/>
                <field name="csd_initial"/>
            </list>
        </field>
    </record>
    <record id="csd_sage_action" model="ir.actions.act_window">
        <field name="name">CSD Sage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">csd.sage</field>
        <field name="view_mode">list,form</field>
    </record>
