<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="frontdeskEnhancement.RegisterPage"
       t-inherit="frontdesk.RegisterPage"
       t-inherit-mode="extension">

        <!-- Move the "You have been registered!" section downward -->
        <xpath expr="/t/div[1]" position="attributes">
            <attribute name="class" add="o_fd_registered_block_shift" separator=" "/>
        </xpath>
    </t>
</templates>