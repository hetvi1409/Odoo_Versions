<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="frontdeskEnhancement.frondesk_visitor_view" t-inherit="frontdesk.VisitorForm" t-inherit-mode="extension">

        <xpath expr="//form/div[1]/div" position="before">
            <!-- Category Dropdown -->
            <div class="mt-3">
                <label for="category" class="form-label">Category</label>
                <select id="category" class="form-select"
                        t-ref="inputCategory" t-on-change="onCategoryChange" style="border: solid 1px;"
                        t-att-class="props.theme === 'light' ? '' : 'bg-700 border-0 text-white'">
                    <option value="">Select Category</option>
                    <option value="Visitor" t-att-selected="state.category === 'Visitor'">Visitor</option>
                    <option value="Contractor" t-att-selected="state.category === 'Contractor'">Contractor</option>
                </select>
            </div>
        </xpath>
        <xpath expr="//form/div[1]/div[2]" position="replace">
            <div>
                <label for="name" class="form-label">Name and Surname<span class="small text-danger">*</span></label>
                <input type="text" class="form-control"
                   t-att-class="props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                   id="name" t-ref="inputName"
                   placeholder="e.g. John Doe" required="1"
                   t-att-value="state.visitorName"
                   t-on-input="(ev) => { state.visitorName = ev.target.value }"/>
            </div>
        </xpath>
        <xpath expr="//form/div[1]/t" position="inside">
            <div class="mt-3">
                <label for="x_has_firearm" class="form-label">Are you in possession of a firearm?</label>
                <select id="x_has_firearm" class="form-select"
                        t-ref="inputFirearm"
                        t-on-change="onFirearmChange"
                        t-att-value="state.inputFirearm">   <!-- ✅ binding -->
                    <option value="">Select</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                </select>
            </div>
            <t t-if="state.inputFirearm === 'yes'">
                <div class="mt-3">
                    <label for="x_firearm_serial" class="form-label">Serial Number</label>
                    <input type="text" id="x_firearm_serial" class="form-control"
                           t-ref="inputFirearmSerial" t-att-required="state.inputFirearm === 'yes'"
                           t-on-input="(ev) => { state.x_firearm_serial = ev.target.value }"
                           t-att-value="state.x_firearm_serial"/>
                </div>
                <div class="mt-3">
                    <label for="x_firearm_name" class="form-label">Name of Firearm</label>
                    <input type="text" id="x_firearm_name" class="form-control"
                           t-ref="inputFirearmName" t-att-required="state.inputFirearm === 'yes'"
                           t-on-input="(ev) => { state.x_firearm_name = ev.target.value }"
                           t-att-value="state.x_firearm_name"/>
                </div>
            </t>
            <div class="mt-3">
                    <label for="office_visiting" class="form-label">Office Visiting<span class="small text-danger">*</span></label>
                    <input type="text" id="office_visiting" class="form-control"
                       t-ref="inputOfficeVisiting" required="1"
                       t-att-value="state.office_visiting"
                       t-on-input="(ev) => { state.office_visiting = ev.target.value }"/>
                </div>
            <div class="mt-3">
                    <label for="purpose" class="form-label">Purpose of the Meeting<span class="small text-danger">*</span></label>
                    <textarea id="purpose" class="form-control"
                          t-ref="inputPurpose"
                          required="1"
                          style="border: solid 1px;"
                          t-on-input="(ev) => this.state.purpose_of_the_meeting = ev.target.value">
                        <t t-esc="state.purpose_of_the_meeting"/>
                    </textarea>
                </div>
            <t t-if="state.category === 'Visitor'">
                <div class="mt-3">
                    <label for="visitor_laptop" class="form-check-label">
                        Does The Visitor's Have A Laptop To Register?
                    </label>
                    <select id="visitor_laptop" class="form-select"
                            t-ref="inputLaptop"
                            t-on-change="onLaptopCheckChange"
                            t-att-value="state.visitor_leptop_register">   <!-- ✅ binding -->
                        <option value="">Select Category</option>
                        <option value="yes">Yes</option>
                        <option value="no">No</option>
                    </select>
                </div>
            </t>
        </xpath>

        <!-- Department dropdown for Contractors -->
        <xpath expr="//t[@t-if='props.stationInfo.authenticate_guest']" position="inside">
            <t t-if="state.category === 'Contractor' and props.departments.length">
                <div class="mt-3">
                    <label for="department" class="form-label">Department</label>
                    <select id="department"
                            t-ref="inputDepartment"
                            t-on-change="props.setDepartment"
                            t-att-value="props.visitorData.department_id"
                            class="form-select"
                            t-att-class="props.theme === 'light' ? '' : 'bg-700 border-0 text-white'">
                        <option value="">Select Department</option>
                        <option t-foreach="props.departments || []" t-as="dept" t-key="dept.id"
                                t-att-value="dept.id" t-esc="dept.display_name"/>
                    </select>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[@t-if='props.stationInfo.authenticate_guest']" position="before">
<!--            <div class="mt-3">-->
<!--                <label for="surname" class="form-label">Surname</label>-->
<!--                <input type="text" id="surname" class="form-control"-->
<!--                   t-ref="inputSurname"-->
<!--                   t-att-value="state.surname"-->
<!--                   t-on-input="(ev) => { state.surname = ev.target.value }"/>-->
<!--            </div>-->
            <div class="mt-3">
                <label for="id_number" class="form-label">ID Number<span class="small text-danger">*</span></label>
                <input type="text" id="id_number" class="form-control"
                   t-ref="inputIdNumber" required="1"
                   t-att-value="state.id_number"
                   t-on-input="(ev) => { state.id_number = ev.target.value }"/>
            </div>
        </xpath>

        <!-- Laptop Details -->
        <xpath expr="//t[@t-if='props.stationInfo.authenticate_guest']" position="inside">
            <t t-if="state.category === 'Visitor' and state.visitor_leptop_register === 'yes'">
                <div class="mt-3">
                    <label for="make" class="form-label">Make</label>
                    <input type="text" id="make" class="form-control"
                           t-ref="inputMake"
                           t-on-input="(ev) => { state.make = ev.target.value }"
                           t-att-value="state.make"/>
                </div>
                <div class="mt-3">
                    <label for="serial_number" class="form-label">Serial Number / Tag</label>
                    <input type="text" id="serial_number" class="form-control"
                           t-ref="inputSerial"
                           t-on-input="(ev) => { state.serial_number_or_tag = ev.target.value }"
                           t-att-value="state.serial_number_or_tag"/>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-if='props.stationInfo.authenticate_guest']/div[2]" position="replace">
            <div t-if="props.stationInfo.ask_phone !== 'none'" class="mt-3">
                <label for="phone" class="form-label">Your Phone Number <t t-if="props.stationInfo.ask_phone != 'optional'"><span class="small text-danger">*</span></t></label>
                <input type="tel" class="form-control"
                   t-att-class="props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                   id="phone" t-ref="inputPhone"
                   t-att-required="props.stationInfo.ask_phone === 'required'"
                   t-att-value="state.visitorPhone"
                   t-on-input="(ev) => { state.visitorPhone = ev.target.value }"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-if='props.stationInfo.authenticate_guest']/div[3]" position="replace">
            <div t-if="props.stationInfo.ask_company !== 'none'" class="mt-3">
                <label for="company" class="form-label">Your Company <t t-if="props.stationInfo.ask_company != 'optional'"><span class="small text-danger">*</span></t></label>
                <input type="text" class="form-control"
                   t-att-class="props.theme === 'light' ? '' : 'bg-700 border-0 text-white'"
                   id="company" t-ref="inputCompany"
                   placeholder="e.g. My Company"
                   t-att-required="props.stationInfo.ask_company === 'required'"
                   t-att-value="state.visitorCompany"
                   t-on-input="(ev) => { state.visitorCompany = ev.target.value }"/>
            </div>
        </xpath>
    </t>
</templates>
