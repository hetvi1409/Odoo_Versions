<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="risk_report_view">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="risk">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Section Header -->
                        <div style="background-color:#45D869; color:white; padding:8px; font-weight:bold; font-size:14px;">
                            Section D - Risk Analysis and Risk Assessment
                        </div>

                        <!-- Subheader -->
                        <div style="background-color:#0000cc; color:white; padding:6px; font-size:13px;">
                            <t t-esc="risk.year_id.name"/>
                            <t t-esc="risk.risk_type_id.name"/>
                        </div>
                        <div style="background-color:#f2f2f2; padding:4px; font-size:12px;">
                            <t t-esc="risk.department_id.name"/>
                        </div>
                        <div style="background-color:#45D869; color:white; font-weight:bold; padding:4px;">
                            RISK ANALYSIS
                        </div>

                        <!-- Risk Analysis Table -->

                        <table class="table table-borderless" style="width:100%; margin-top:6px;">
                            <tr>
                                <td style="font-weight:bold; width:25%;">Risk
                                    Risk Factor:
                                </td>
                                <td><t t-esc="risk.activity_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Risk Name:</td>
                                <td style="font-size:13px; font-weight:bold;">
                                    <t t-esc="risk.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Risk
                                    Description:
                                </td>
                                <td>
                                    <t t-esc="risk.description or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Risk Description:</td>
                                <td>
                                    <t t-esc="risk.uncertainty or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Root Cause:</td>
                                <td>
                                    <t t-esc="risk.main_cause or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight:bold;">Consequences:</td>
                                <td>
                                    <t t-esc="risk.consequences or ''"/>
                                </td>
                            </tr>
                        </table>
                        <!-- Risk Assessment Section -->
                        <div style="border:1px solid black; margin-top:10px; font-size:12px;">
                            <div style="background-color:#45D869; color:white; font-weight:bold; padding:4px;">
                                RISK ASSESSMENT
                            </div>

                            <table style="width:100%; border-collapse:collapse; text-align:left;">
                                <tr>
                                    <td style="border:1px solid black; font-weight:bold; width:40%;">
                                        Impact Rating:
                                    </td>
                                    <td style="border:1px solid black; background-color:yellow; width:20%; text-align:center;">
                                        <t t-foreach="risk.risk_evaluation_line_ids" t-as="valuation">
                                            <t t-if="valuation.type == 'severity'">
                                                <p>Inherit Risk:
                                                    <t t-esc="valuation.inherent_risk.name"/>
                                                </p>
                                                <p>Current Risk:
                                                    <t t-esc="valuation.current_risk.name"/>
                                                </p>
                                                <p>Residual Risk:
                                                    <t t-esc="valuation.residual_risk.name"/>
                                                </p>
                                            </t>
                                        </t>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Likelihood Rating:
                                    </td>
                                    <td style="border:1px solid black; background-color:yellow; text-align:center;">
                                        <t t-if="valuation.type == 'likelihood'">
                                                <p>Inherit Risk:
                                                    <t t-esc="valuation.inherent_risk.name"/>
                                                </p>
                                                <p>Current Risk:
                                                    <t t-esc="valuation.current_risk.name"/>
                                                </p>
                                                <p>Residual Risk:
                                                    <t t-esc="valuation.residual_risk.name"/>
                                                </p>
                                            </t>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Inherent Risk Rating:
                                    </td>
                                    <td style="border:1px solid black; background-color:yellow; text-align:center;">
                                        <span t-field="risk.inherent_risk_total_score"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Overall Control Effectiveness:
                                    </td>
                                    <td style="border:1px solid black; text-align:center;">
                                        <span t-field="risk.current_risk_total_score"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Residual Risk (Current):
                                    </td>
                                    <td style="border:1px solid black; text-align:center;">
                                        <span t-field="risk.residual_risk_total_score"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Control Effectiveness (Desired):
                                    </td>
                                    <td style="border:1px solid black; background-color:green; color:white; text-align:center;">
<!--                                        <t t-esc="risk.desired_control_score or ''"/>-->
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Residual Risk (Desired):
                                    </td>
                                    <td style="border:1px solid black; text-align:center;">
<!--                                        <t t-esc="risk.residual_risk_desired or ''"/>-->
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid black; font-weight:bold;">
                                        Residual Risk Gap:
                                    </td>
                                    <td style="border:1px solid black; text-align:center;">
<!--                                        <t t-esc="risk.residual_risk_gap or ''"/>-->
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- Current Controls Section -->
                        <div style="border:1px solid black; margin-top:10px; font-size:12px;">
                            <div style="background-color:#45D869; color:white; font-weight:bold; padding:4px;">
                                Current Controls
                            </div>

                            <table style="width:100%; border-collapse:collapse;">
                                <t t-foreach="risk.current_control_ids"
                                   t-as="control">
                                    <tr>
                                        <td style="border:1px solid black; padding:4px;">
                                            <t t-esc="control.sequence"/>   <t t-esc="control.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    <!-- Action Plans & Accountability Section -->
                        <div style="border:1px solid black; margin-top:10px; font-size:12px;">

                            <!-- Section Header -->
                            <div style="background-color:#45D869; color:white; font-weight:bold; padding:4px;">
                                Action Plans &amp; Accountability
                            </div>

                            <!-- Table Header -->
                            <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                <thead>
                                    <tr style="background-color:#d3d3d3; font-weight:bold;">
                                        <th style="border:1px solid black; padding:4px;">
                                            Task Name
                                            <br/>
                                            <span style="font-weight:normal; font-style:italic;">
                                                Description<br/>Risk Owner<br/>
                                                Action Owner
                                            </span>
                                        </th>
                                        <th style="border:1px solid black; padding:4px; width:15%;">
                                            Status
                                        </th>
                                        <th style="border:1px solid black; padding:4px; width:15%;">
                                            Target Date
                                        </th>
                                    </tr>
                                </thead>

                                <!-- Table Body -->
                                <tbody>
                                    <t t-foreach="risk.risk_treatment_ids"
                                       t-as="plan">
                                        <tr>
                                             Task Name and Description
                                            <td style="border:1px solid black; padding:4px;">
                                                <strong>
                                                    <t t-esc="plan.name"/>
                                                </strong>
                                                <br/>
                                                Risk Owner:
                                                <t t-esc="risk.owner_id.name"/>
                                                <br/>
                                                Action Owner:
                                                <t t-esc="plan.owner_id.name"/>
                                            </td>

                                            <!-- Status -->
                                            <td style="border:1px solid black; padding:4px; text-align:center;">
                                                <span t-field="plan.status"/>
                                            </td>

                                            <!-- Start Date -->
                                            <td style="border:1px solid black; padding:4px; text-align:center;">
                                                <t t-esc="plan.target_date"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>


                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_risk_report" model="ir.actions.report">
        <field name="name">Risk Report</field>
        <field name="model">risk.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_type">report</field>
        <field name="report_name">oi_risk_management_report.risk_report_view</field>
        <field name="report_file">oi_risk_management_report.risk_report_view</field>
        <field name="print_report_name">'Risk'</field>
    </record>

</odoo>