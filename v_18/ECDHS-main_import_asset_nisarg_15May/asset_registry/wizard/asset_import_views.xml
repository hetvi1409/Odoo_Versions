<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="asset_import_view_form" model="ir.ui.view">
        <field name="name">asset.import.view.form</field>
        <field name="model">asset.import</field>
        <field name="arch" type="xml">
            <form string="Import Assets">
                <group>
                    <group>
                        <field name="file"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import_asset" string="Import Asset"
                            type="object" class="btn-primary"/>
                    <button name="action_import_supplier" string="Import Supplier"
                            type="object" class="btn-secondary"/>
                    <button name="action_import_afs_classification" string="Import Asset Classification"
                            type="object" class="btn-secondary"/>
                    <button name="action_import_asset_model" string="Update Asset Model"
                            type="object" class="btn-secondary"/>
                    <button name="action_import_asset_location" string="Update Asset location"
                            type="object" class="btn-secondary"/>
                    <button name="action_import_chief_directorate" string="Update Chief Directorate"
                            type="object" class="btn-secondary"/>
                    <button name="action_import_custodian" string="Update Custodian"
                            type="object" class="btn-secondary"/>
                    <button name="action_import_classification_custodian" string="Update assets"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="asset_import_action" model="ir.actions.act_window">
        <field name="name">Asset Import</field>
        <field name="res_model">asset.import</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_import_view_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_asset_import_action"
              name="Import Asset"
              action="asset_import_action"
              parent="account.menu_finance_configuration"/>
</odoo>