<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_asset_building_list" model="ir.ui.view">
        <field name="name">asset.verification.job.building.list</field>
        <field name="model">asset.verification.job.building</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="asset_building_action" model="ir.actions.act_window">
        <field name="name">Asset Building</field>
        <field name="res_model">asset.verification.job.building</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Asset Building
            </p>
        </field>
    </record>

<!--    <menuitem id="asset_building_menuitem" name="Asset Building"-->
<!--              parent="fixed_assets.menu_action_fixed_assets" action="asset_building_action" sequence="13"/>-->

</odoo>