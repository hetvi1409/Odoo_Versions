<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_asset_fully_depreciation" model="ir.actions.report">
        <field name="name">Asset Fully Depreciated</field>
        <field name="model">asset.fully.depreciation.reports</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">asset_reports.report_asset_fully_depreciation</field>
        <field name="report_file">asset_reports.report_asset_fully_depreciation</field>
        <field name="print_report_name">'Asset Depreciation - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_asset_impairment_reports"/>
        <field name="binding_type">report</field>
    </record>
