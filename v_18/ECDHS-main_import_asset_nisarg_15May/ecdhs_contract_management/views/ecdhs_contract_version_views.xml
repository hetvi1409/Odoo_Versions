<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ecdhs_contract_version_view_list" model="ir.ui.view">
        <field name="name">ecdhs.contract.version.list</field>
        <field name="model">ecdhs.contract.version</field>
        <field name="arch" type="xml">
            <list string="Contract Versions" create="0" delete="0" default_order="id desc">
                <field name="version_number"/>
                <field name="contract_name"/>
                <field name="comment"/>
                <field name="created_by" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="date"/>
                <button name="action_revert_version" type="object" string="Revert" class="btn-secondary"
                    confirm="Are you sure you want to revert contract terms to this version? This will overwrite the current draft terms."/>
            </list>
        </field>
    </record>

    <record id="ecdhs_contract_version_view_form" model="ir.ui.view">
        <field name="name">ecdhs.contract.version.form</field>
        <field name="model">ecdhs.contract.version</field>
        <field name="arch" type="xml">
            <form string="Contract Version" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="version_number" readonly="1"/>
                            <field name="contract_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="comment" readonly="1"/>
                    </group>
                    <group string="Contract Terms Snapshot">
                        <field name="contract_terms_summary" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_revert_version" type="object" string="Revert To This Version" class="btn-primary"
                            confirm="Are you sure you want to revert contract terms to this version? This will overwrite the current draft terms."/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
