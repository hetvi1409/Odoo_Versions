<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Custom Layout for Contract Documents (Logo + Footer only, no header text)
    ================================================================= -->
    <template id="contract_minimal_layout">
        <t t-set="company" t-value="res_company or company"/>
        <div class="header">
            <div class="row">
                <div class="col-3">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;" alt="Logo"/>
                </div>
                <div class="col-9 text-right">
                    <!-- Header text removed - only logo remains -->
                </div>
            </div>
        </div>

        <div class="article o_report_layout_standard">
            <t t-raw="0"/>
        </div>

