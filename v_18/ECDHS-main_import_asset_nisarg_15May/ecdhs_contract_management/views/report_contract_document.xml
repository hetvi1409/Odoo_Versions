    <template id="report_contract_document_draft_template" inherit_id="ecdhs_contract_management.report_contract_document_template">
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <div style="position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;">
                <div style="position: absolute; top: 10%; left: -25%; width: 180%; transform: rotate(-30deg); color: rgba(120, 120, 120, 0.13); font-size: 32px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; line-height: 2.8; white-space: nowrap;">
                    <div>DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT</div>
                    <div>DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT</div>
                    <div>DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT</div>
                    <div>DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT</div>
                    <div>DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT</div>
                    <div>DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT   DRAFT DOCUMENT</div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ================================================================
         Annexure Cover Page Template  (rendered per-annexure by the
         Python PDF-merge override; NOT called directly from the main
         contract template so covers and their PDFs are interleaved).
    ================================================================= -->
    <template id="report_annexure_cover_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.contract_id.company_id"/>
                <t t-call="ecdhs_contract_management.contract_minimal_layout">
                    <t t-set="res_company" t-value="doc.contract_id.company_id"/>
                <div style="
                    width             : 100%;
                    min-height        : 247mm;
                    box-sizing        : border-box;
                    padding           : 28mm 22mm;
                    display           : flex;
                    flex-direction    : column;
                    justify-content   : space-between;
                    align-items       : stretch;
                    background        : #fff;
                ">
                    <!-- Large top box: ANNEXURE A / B … -->
                    <div style="
                        border      : 3px solid #000;
                        padding     : 32mm 20mm;
                        text-align  : center;
                    ">
                        <span style="
                            display        : block;
                            font-size      : 3.4rem;
                            font-weight    : 900;
                            text-transform : uppercase;
                            letter-spacing : .04em;
                            line-height    : 1.1;
                        "><t t-esc="doc.annexure_sequence_name or ''"/></span>
                    </div>

                    <!-- Lower-centre box: document name -->
                    <div style="
                        border      : 2px solid #000;
                        padding     : 16px 28px;
                        text-align  : center;
                        align-self  : center;
                        min-width   : 60%;
                    ">
                        <span style="
                            display        : block;
                            font-size      : 1.05rem;
                            font-weight    : 700;
                            text-transform : uppercase;
                            letter-spacing : .06em;
                        "><t t-esc="doc.name or ''"/></span>
                    </div>
                </div>

                </t>
            </t>
        </t>
    </template>

    <!-- ================================================================
         Addendum Cover Page Template  (rendered per-addendum by the
         Python PDF-merge override).
    ================================================================= -->
    <template id="report_addendum_cover_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.contract_id.company_id"/>
                <t t-call="ecdhs_contract_management.contract_minimal_layout">
                    <t t-set="res_company" t-value="doc.contract_id.company_id"/>
                <div style="
                    width             : 100%;
                    min-height        : 247mm;
                    box-sizing        : border-box;
                    padding           : 28mm 22mm;
                    display           : flex;
                    flex-direction    : column;
                    justify-content   : space-between;
                    align-items       : stretch;
                    background        : #fff;
                ">
                    <div style="
                        border      : 3px solid #000;
                        padding     : 32mm 20mm;
                        text-align  : center;
                    ">
                        <span style="
                            display        : block;
                            font-size      : 3.4rem;
                            font-weight    : 900;
                            text-transform : uppercase;
                            letter-spacing : .04em;
                            line-height    : 1.1;
                        "><t t-esc="doc.addendum_sequence_name or 'ADDENDUM'"/></span>
                    </div>

                    <div style="
                        border      : 2px solid #000;
                        padding     : 16px 28px;
                        text-align  : center;
                        align-self  : center;
                        min-width   : 60%;
                    ">
                        <span style="
                            display        : block;
                            font-size      : 1.05rem;
                            font-weight    : 700;
                            letter-spacing : .02em;
                        "><t t-esc="doc.name or ''"/></span>
                    </div>
                </div>

                </t>
            </t>
        </t>
    </template>

    <!-- ================================================================
         Addendum Content Page Template  (rendered per-addendum by the
         Python PDF-merge override).
    ================================================================= -->
    <template id="report_addendum_content_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.contract_id.company_id"/>
                <t t-call="ecdhs_contract_management.contract_minimal_layout">
                    <t t-set="res_company" t-value="doc.contract_id.company_id"/>
                    <div class="page">
                        <div style="text-align:center; margin-bottom:18px;">
                            <h2 style="margin:0; font-size:1.15rem; text-transform:uppercase; letter-spacing:.04em; font-weight:800;">
                                <t t-esc="doc.addendum_sequence_name or 'ADDENDUM'"/>
                            </h2>
                            <h3 style="margin:8px 0 0; font-size:1.05rem; font-weight:700;">
                                <t t-esc="doc.name or ''"/>
                            </h3>
                        </div>
                        <hr style="border:none; border-top:2px solid #0f4c81; margin-bottom:16px;"/>

                        <t t-if="doc.change_description">
                            <div style="font-size:.90rem; line-height:1.65;">
                                <t t-out="doc.change_description"/>
                            </div>
                        </t>
                        <t t-else="">
                            <p style="font-size:.90rem; color:#777;">No addendum content recorded.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
