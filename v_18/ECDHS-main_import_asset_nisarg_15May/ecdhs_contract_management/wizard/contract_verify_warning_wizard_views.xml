<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecdhs_contract_verify_warning_wizard_form" model="ir.ui.view">
        <field name="name">ecdhs.contract.verify.warning.wizard.form</field>
        <field name="model">ecdhs.contract.verify.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Missing Attachments Warning" create="0" edit="0" delete="0">
                <group>
                    <field name="contract_id" readonly="1"/>
                    <field name="warning_message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button string='Cancel and capture "Annexures / Appendices"'
                            special="cancel"
                            class="btn-success"
                            invisible="warning_type != 'annexure'"/>
                    <button string='Proceed without "Annexures / Appendices"'
                            name="action_proceed"
                            type="object"
                            class="btn-warning"
                            invisible="warning_type != 'annexure'"/>

                    <button string='Cancel and capture "Supporting Documents"'
                            special="cancel"
                            class="btn-success"
                            invisible="warning_type != 'supporting'"/>
                    <button string='Proceed without "Supporting Documents"'
                            name="action_proceed"
                            type="object"
                            class="btn-warning"
                            invisible="warning_type != 'supporting'"/>

                    <button string='Cancel and capture "JBCC"'
                            special="cancel"
                            class="btn-success"
                            invisible="warning_type != 'jbcc'"/>
                    <button string='Proceed without "JBCC"'
                            name="action_proceed"
                            type="object"
                            class="btn-warning"
                            invisible="warning_type != 'jbcc'"/>

                    <button string='Cancel and capture "GCC"'
                            special="cancel"
                            class="btn-success"
                            invisible="warning_type != 'gcc'"/>
                    <button string='Proceed without "GCC"'
                            name="action_proceed"
                            type="object"
                            class="btn-warning"
                            invisible="warning_type != 'gcc'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
