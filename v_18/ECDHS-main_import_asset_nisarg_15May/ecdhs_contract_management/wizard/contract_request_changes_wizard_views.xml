<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ecdhs_contract_request_changes_wizard_view_form" model="ir.ui.view">
        <field name="name">ecdhs.contract.request.changes.wizard.form</field>
        <field name="model">ecdhs.contract.request.changes.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Changes" create="0" edit="1" delete="0">
                <sheet>
                    <group>
                        <field name="contract_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        <field name="section_reference" placeholder="e.g. Payment Terms - Clause 5"/>
                        <field name="due_date"/>
                    </group>
                    <group>
                        <field name="requested_change" nolabel="1" placeholder="Describe the requested contract changes..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" type="object" string="Submit Change Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
