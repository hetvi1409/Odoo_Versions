<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             SOP Step 23 – Monthly 6-month expiry notices
        ================================================================= -->
        <record id="ir_cron_contract_expiry_notices" model="ir.cron">
            <field name="name">ECDHS Contracts: Monthly Expiry Notices (6-Month Horizon)</field>
            <field name="model_id" ref="model_ecdhs_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiry_notices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_provider_review_reminders" model="ir.cron">
            <field name="name">ECDHS Contracts: Daily Provider Review Reminders</field>
            <field name="model_id" ref="model_ecdhs_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_provider_review_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
