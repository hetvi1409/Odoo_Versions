<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ecdhs_contract" model="ir.sequence">
            <field name="name">ECDHS Procurement Contract</field>
            <field name="code">ecdhs.contract</field>
            <field name="prefix">CM/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Per-contract addendum references are generated in Python (contract.name-ADD-NNN).
             No global ir.sequence is required for addendums. -->
    </data>
</odoo>
