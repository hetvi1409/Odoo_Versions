<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ================================================================
             SOP Step 23 – Expiry Notice Email Template
        ================================================================= -->
        <record id="mail_template_contract_expiry_notice" model="mail.template">
            <field name="name">Contract Management: 6-Month Expiry Notice</field>
            <field name="model_id" ref="model_ecdhs_contract"/>
            <field name="subject">Contract Expiry Notice – {{ object.name }} expires {{ object.date_end }}</field>
            <field name="email_to">{{ object.end_user_id.email or '' }}</field>
            <field name="body_html"><![CDATA[
<div data-ecdhs-green-mail="1" style="background-color:#dcefe0;border:1px solid #b8d8bf;border-radius:8px;padding:18px 20px;color:#2f3b4a;">
<p>Dear <t t-out="object.end_user_id.name or 'Contract Administrator'"/>,</p>

<p>Please be advised that the following contract is due to expire within the next
<strong>6 months</strong> and requires your immediate attention:</p>

<table border="0" cellpadding="6" cellspacing="0" style="margin:12px 0;">
    <tr><td><strong>Contract Reference:</strong></td><td><t t-out="object.name"/></td></tr>
    <tr><td><strong>Contract Subject:</strong></td><td><t t-out="object.subject"/></td></tr>
    <tr><td><strong>Service Provider:</strong></td><td><t t-out="object.service_provider_id.name"/></td></tr>
    <tr><td><strong>Contract End Date:</strong></td><td><t t-out="object.date_end"/></td></tr>
    <tr><td><strong>Contract Value:</strong></td>
        <td><t t-out="format_amount(object.contract_value, object.currency_id)"/></td></tr>
</table>

<p>In accordance with the Contract Management Standard Operating Procedure (SOP-CONTRACT-MANAGEMENT-01),
please ensure one of the following actions is taken <strong>before the contract expires</strong>:</p>

<ol>
    <li>Initiate a new procurement process if the service will still be required beyond the expiry date.</li>
    <li>Prepare the contract termination documentation if the service is no longer required.</li>
</ol>

<p style="color:#c0392b;"><strong>Note:</strong> Allowing a contract to lapse without proper renewal or
termination processing may constitute irregular expenditure in terms of the
<em>Public Finance Management Act No. 1 of 1999 (PFMA)</em>.</p>

<p>Kind regards,<br/>
<strong>ECDHS Contract Management Unit</strong></p>
</div>
            ]]></field>
            <field name="lang">{{ object.admin_officer_id.lang or 'en_US' }}</field>
            <field name="auto_delete">False</field>
        </record>

        <!-- ================================================================
             Termination Notice to Service Provider
        ================================================================= -->
        <record id="mail_template_contract_termination_notice" model="mail.template">
            <field name="name">Contract Management: Termination Notice to Service Provider</field>
            <field name="model_id" ref="model_ecdhs_contract"/>
            <field name="subject">Formal Contract Termination Notice – {{ object.name }}</field>
            <field name="email_to">{{ object.service_provider_id.email or '' }}</field>
            <field name="body_html"><![CDATA[
<div data-ecdhs-green-mail="1" style="background-color:#dcefe0;border:1px solid #b8d8bf;border-radius:8px;padding:18px 20px;color:#2f3b4a;">
<p>Dear <t t-out="object.service_provider_id.name"/>,</p>

<p>This serves as formal notice that the contract referenced below has been terminated.</p>

<table border="0" cellpadding="6" cellspacing="0" style="margin:12px 0;">
    <tr><td><strong>Contract Reference:</strong></td><td><t t-out="object.name"/></td></tr>
    <tr><td><strong>Contract Subject:</strong></td><td><t t-out="object.subject"/></td></tr>
    <tr><td><strong>Effective Termination Date:</strong></td><td><t t-out="object.termination_date"/></td></tr>
    <tr><td><strong>Reason:</strong></td><td><t t-out="object.termination_reason or 'As per discussions'"/></td></tr>
</table>

<p>Please ensure that all outstanding deliverables, invoices and documentation are submitted
to the ECDHS Contract Management Unit within <strong>7 (seven) business days</strong> of this notice.</p>

<p>Kind regards,<br/>
<strong>ECDHS Contract Management Unit</strong><br/>
Eastern Cape Department of Human Settlements</p>
</div>
            ]]></field>
            <field name="lang">en_US</field>
            <field name="auto_delete">False</field>
        </record>

        <record id="mail_template_provider_draft_sent" model="mail.template">
            <field name="name">Contract Management: Draft Sent to Provider</field>
            <field name="model_id" ref="model_ecdhs_contract"/>
            <field name="subject">Draft Contract for Review – {{ object.name }} (v{{ object.draft_version }})</field>
            <field name="email_to">{{ object.service_provider_id.email or '' }}</field>
            <field name="body_html"><![CDATA[
<div data-ecdhs-green-mail="1" style="background-color:#dcefe0;border:1px solid #b8d8bf;border-radius:8px;padding:18px 20px;color:#2f3b4a;">
<p>Dear <t t-out="object.service_provider_id.name"/>,</p>
<p>Please review the attached draft contract and provide comments or change requests by <strong><t t-out="object.provider_review_due_date or ''"/></strong>.</p>
<p><a t-att-href="object.provider_review_url or '#'" class="btn btn-primary">Open (Draft) Contract</a></p>
<p>Kind regards,<br/><strong>ECDHS Contract Management Unit</strong></p>
</div>
            ]]></field>
            <field name="lang">en_US</field>
            <field name="auto_delete">False</field>
        </record>

