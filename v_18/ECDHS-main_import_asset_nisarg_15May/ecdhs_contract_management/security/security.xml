<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             Module Category
        ================================================================= -->
        <record id="module_category_contract_management" model="ir.module.category">
            <field name="name">Contract Management</field>
            <field name="description">Manage procurement contracts, SLAs, leases and cessions in compliance with the PFMA.</field>
            <field name="sequence">35</field>
        </record>

        <!-- ================================================================
             Security Groups (three-tier role model aligned to the SOP)
        ================================================================= -->

        <!-- Read-only access: end-users, service recipients, auditors -->
        <record id="group_contract_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_contract_management"/>
            <field name="comment">Can view contracts relevant to their department. Cannot create or edit.</field>
        </record>

        <!-- Admin Officer CM: creates contracts, verifies documents, records payments -->
        <record id="group_contract_officer" model="res.groups">
            <field name="name">Contract Officer</field>
            <field name="category_id" ref="module_category_contract_management"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
            <field name="comment">Admin Officer CM role: create, edit and verify contracts, log monitoring and payments.</field>
        </record>

        <!-- Deputy Director CM: full lifecycle management, approve, terminate -->
        <record id="group_contract_manager" model="res.groups">
            <field name="name">Contract Manager</field>
            <field name="category_id" ref="module_category_contract_management"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_officer'))]"/>
            <field name="comment">Deputy Director CM: full lifecycle management including approvals and termination.</field>
        </record>

    </data>
</odoo>
