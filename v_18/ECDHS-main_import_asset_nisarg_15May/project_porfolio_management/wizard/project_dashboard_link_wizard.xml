<odoo>
    <record id="view_project_dashboard_link_wizard" model="ir.ui.view">
        <field name="name">project.dashboard.link.wizard.form</field>
        <field name="model">project.dashboard.link.wizard</field>
        <field name="arch" type="xml">
            <form string="My Links Settings">
                <sheet>
                    <group>
                        <field name="link_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="url"/>
                                <field name="icon" widget="image" options="{'size': [90, 90]}"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_dashboard_link_wizard" model="ir.actions.act_window">
        <field name="name">Links Settings</field>
        <field name="res_model">project.dashboard.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
