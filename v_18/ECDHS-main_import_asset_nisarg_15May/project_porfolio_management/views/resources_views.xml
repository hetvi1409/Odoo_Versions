<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_view_list" model="ir.ui.view">
        <field name="name">hr.employee.view.list</field>
        <field name="model">hr.employee</field>
        <field eval="50" name="priority"/>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="work_email"/>
                <field name="job_id"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field eval="50" name="priority"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Information">
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="work_email"/>
                            <field name="work_phone"/>
                        </group>
                    </group>
                    <group string="Classification">
                        <group>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <group string="Planning Information">
                        <group>
                            <field name="standard_hours"/>
                            <field name="charge_out_rate_1"/>
                        </group>
                        <group>
                            <field name="standard_charge_out_rate"/>
                            <field name="charge_out_rate_2"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Update Detail">
                        <field name="write_uid"/>
                        <field name="write_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_employee_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_employee_view_form')})
        ]"/>

    </record>

    <menuitem id="action_hr_employee_resource_menu" name="Resources"
              parent="project.menu_main_pm"
              action="action_hr_employee_resource"
              sequence="4"/>

</odoo>