<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="health_indicator_view_list" model="ir.ui.view">
        <field name="name">health.indicator.view.list</field>
        <field name="model">health.indicator</field>
        <field name="arch" type="xml">
            <list string="Health Indicator">
                <field name="project_id" options="{'no_create': True}"/>
                <field name="title"/>
                <field name="rag_indicator" widget="badge"
                       decoration-success="rag_indicator == 'done'"
                       decoration-info="rag_indicator == 'normal'"
                       decoration-danger="rag_indicator == 'blocked'"/>
                <field name="previous_rag" widget="badge"
                       decoration-success="previous_rag == 'done'"
                       decoration-info="previous_rag == 'normal'"
                       decoration-danger="previous_rag == 'blocked'"/>
                <field name="comments"/>
                <field name="overdue" widget="badge"
                       decoration-success="overdue == 'update_current'"
                       decoration-info="overdue == 'update_due_soon'"
                       decoration-danger="overdue == 'overdue'"/>

            </list>
        </field>
    </record>

    <record id="health_indicator_view_form" model="ir.ui.view">
        <field name="name">health.indicator.view.form</field>
        <field name="model">health.indicator</field>
        <field name="arch" type="xml">
            <form string="Health Indicator">
                <sheet>
                                                            <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover),
                        .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover)
                        .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover)
                        .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group string="Details">
                        <group>
                            <field name="name"/>
                            <field name="title"/>

                            <field name="project_id" context="{'form_view_ref': 'project_porfolio_management.edit_project_ppe'}"
                             options="{'no_create': True}"/>
                            <field name="overdue" widget="badge"
                                   decoration-success="overdue == 'update_current'"
                                   decoration-info="overdue == 'update_due_soon'"
                                   decoration-danger="overdue == 'overdue'"/>
                            <field name="last_update"/>
                        </group>
                        <group string="Health Indicator">
                            <field name="rag_indicator"  widget="state_selection" />
                            <field name="previous_rag" widget="state_selection" />

                            <field name="comments"/>
                        </group>
                        <group string="Update Details">
                            <field name="logged_date"/>
                            <field name="loaded_by_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_health_indicator" model="ir.actions.act_window">
        <field name="name">Health Indicator</field>
        <field name="res_model">health.indicator</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Health Indicator found. Let's create one!
            </p>
            <p>
                Create Health Indicator to organize your tasks. Define a different workflow for each project.
            </p>
        </field>
    </record>

    <menuitem id="menu_ppo_reporting" name="Reporting" sequence="2"
              parent="project_porfolio_management.projects_ppo_mian_menu"/>

    <menuitem id="action_health_indicator_menu" name="Health Indicator"
              parent="menu_ppo_reporting"
              action="action_health_indicator"
              sequence="5"/>

</odoo>