                                           decoration-danger="health_update_status == 'r'"/>
                                    <field name="resource_allocations_exist" widget="badge"
                                           decoration-success="resource_allocations_exist == 'g'"
                                           decoration-danger="resource_allocations_exist == 'r'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
                </form>
            </field>
    </record>
