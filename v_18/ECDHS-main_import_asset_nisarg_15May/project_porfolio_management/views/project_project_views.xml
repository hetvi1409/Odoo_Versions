    <record id="edit_project_ppe" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="Project" class="o_form_project_project" js_class="form_description_expander">
                <field name="company_id" invisible="1"/>
                <header>
                    <field name="stage_id" widget="statusbar_duration" options="{'clickable': '1', 'fold_field': 'fold'}" groups="project.group_project_stages" domain="[('company_id', 'in', (company_id, False))]"/>
                    </header>
                <sheet string="Project">
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover),
                        .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover)
                        .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover)
                        .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button class="oe_stat_button" type="object" name="action_view_ppe_tasks" icon="fa-check">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Tasks</span>
                                <span class="o_stat_value">
                                    <field name="closed_task_count"/> / <field name="task_count"/>
                                    (<field name="task_completion_percentage" widget="percentage" options="{'digits': [1, 0]}"/>)
                                </span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_approvals" icon="fa-check">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Approvals</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="project_update_all_action" type="object" groups="project.group_project_user" context="{'active_id': id}">
                            <field name="last_update_color" invisible="1"/>
                            <div class="o_stat_info">
                                <field name="update_count" invisible="1"/>
                                <field name="last_update_status" readonly="1" widget="status_with_color" status_label="Dashboard" hideStatusName="True"/>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" placeholder="e.g. Office Party"/>
                        </h1>
                    </div>
                    <group string="Project Details">
                        <group>
                            <field name="sequence_code"/>
                            <field name="name"/>
                            <field name="description" options="{'resizable': true, 'height': 50}"/>
                            <field name="required_date"/>
                            <field name="dependencies" options="{'height': 50}"/>
                            <field name="assumption" options="{'height': 50}"/>
                        </group>
                        <group>
                            <field name="objective_deliverables" options="{'height': 50}"/>
                            <field name="project_benefits" options="{'height': 50}"/>
                            <field name="critical_success_factor" options="{'height': 50}"/>
                            <field name="constraints" options="{'height': 50}"/>
                            <field name="logged_date"/>
                            <field name="partner_id"/>
                            <field name="date_start" widget="daterange" options="{'start_date_field': 'date_end', 'always_range': '1'}"/>
                            <field name="is_ppe" readonly="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Project Details">
                            <group string="Project Status">
                                <group>
                                <field name="phase_id"/>
                                <field name="stage_id" string="Stage"/>
                                <field name="priority"/>
                                <field name="active"/>
                                </group>
                                <group>
                                    <label for="planned_progress" class="oe_inline"/>
                                    <div>
                                        <field name="planned_progress"
                                               class="oe_inline"/>
                                        <field name="planned_progress"
                                               widget="progressbar" class="oe_inline"/>
                                    </div>
                                    <label for="actual_progress" class="oe_inline"/>
                                    <div>
                                        <field name="actual_progress"
                                               class="oe_inline"/>
                                        <field name="actual_progress"
                                               widget="progressbar" class="oe_inline"/>
                                    </div>
                                    <field name="variance_progress" widget="progressbar"
                                           readonly="1"/>
                                </group>
                            </group>
                            <group string="Stakeholder">
                                <group>
                                    <field name="department_id"/>
                                    <field name="sponsor_id" widget="many2one_avatar"/>
                                </group>
                                <group>
                                    <field name="owner_id" widget="many2one_avatar"/>
                                    <field name="project_manager_id" widget="many2one_avatar"/>
                                    <field name="loaded_by_id" widget="many2one_avatar"/>
                                </group>
                            </group>
                            <group string="Project Classification">
                                <group>
                                    <field name="type_id"/>
                                    <field name="parent_id"/>
                                </group>
                                <group>
                                    <field name="admin_project"/>
                                    <field name="rate_to_use"/>
                                </group>
                            </group>
                            <group string="Project Estimate">
                                <group>
                                    <field name="cost_estimate"/>
                                </group>
                                <group>
                                    <field name="duration_estimation"/>
                                </group>
                            </group>
                        </page>
                        <page string="Portfolio/Program">
                            <group>
                                <group>
                                    <field name="program_id"/>
                                    <field name="budget_planned"/>
                                    <field name="budget_actual"/>
                                    <field name="budget_variance"/>
                                </group>
                                <group>
                                    <field name="portfolio_id"/>
<!--                                    <field name="total_budget"/>-->
                                    <field name="risk_rating"/>
<!--                                    <field name="actual_cost"/>-->
                                </group>
                            </group>
                        </page>
                        <page string="Health indicator">
                            <group>
                                <field name="health_indicator" widget="badge"
                                       decoration-success="health_indicator == 'done'"
                                       decoration-info="health_indicator == 'normal'"
                                       decoration-danger="health_indicator == 'blocked'"/>
                            </group>
                            <field name="health_indicator_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="rag_indicator" widget="badge"
                                           decoration-success="rag_indicator == 'done'"
                                           decoration-info="rag_indicator == 'normal'"
                                           decoration-danger="rag_indicator == 'blocked'"/>
                                    <field name="previous_rag" widget="badge"
                                           decoration-success="previous_rag == 'done'"
                                           decoration-info="previous_rag == 'normal'"
                                           decoration-danger="previous_rag == 'blocked'"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments">
                            <field name="comments_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="document_project_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="project_id"
                                           options="{'no_create': True}"/>
                                    <field name="type"/>
                                    <field name="logged_date"/>
                                    <field name="loaded_by_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Issues">
                            <field name="issue_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="title"/>
                                    <field name="priority" widget="badge"
                                           decoration-success="priority == 'Low'"
                                           decoration-warning="priority == 'Medium'"
                                           decoration-danger="priority == 'High'"/>
                                    <field name="status"/>
                                    <field name="issue_owner_id"/>
                                    <field name="follow_up_date"/>
                                    <field name="is_overdue" widget="badge"
                                           decoration-success="is_overdue == 'not_overdue'"
                                           decoration-warning="is_overdue == 'due_soon'"
                                           decoration-danger="is_overdue == 'overdue'"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Risks">
                            <field name="risk_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="title"/>
                                    <field name="rag" widget="badge"
                                           decoration-success="rag == 'G'"
                                           decoration-warning="rag == 'A'"
                                           decoration-danger="rag == 'R'"/>
                                    <field name="status"/>
                                    <field name="risk_owner_id"/>
                                    <field name="follow_up_date"/>
                                    <field name="is_overdue" widget="badge"
                                           decoration-success="is_overdue == 'not_overdue'"
                                           decoration-warning="is_overdue == 'due_soon'"
                                           decoration-danger="is_overdue == 'overdue'"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks">
                            <field name="task_ids" context="{'form_view_ref': 'project_porfolio_management.view_task_form_ppe'}">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids"
                                           widget="many2many_avatar_user"/>
                                    <field name="planned_date_begin"
                                           string="Planned Start Date"/>
                                    <field name="date_deadline"
                                           string="Planned End Date"/>
                                    <field name="baseline_start_date"/>
                                    <field name="baseline_end_date"/>
                                    <field name="variance_planned_start_date"/>
                                    <field name="variance_planned_end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost">
                            <field name="cost_ids">
                                <list>
                                    <field name="project_id"/>
                                    <field name="category_id"/>
                                    <field name="sub_category_id"/>
                                    <field name="year"/>
                                    <field name="month"/>
                                    <field name="budget"/>
                                    <field name="spent" widget="percentage"/>
                                    <field name="estimate_to_complete" widget="percentage"/>
                                    <field name="total_at_completion" widget="percentage"/>
                                    <field name="variance" widget="percentage"/>
                                    <field name="write_date"
                                           string="Last Update"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decisions">
                            <field name="decision_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="decision_type_id"/>
                                    <field name="decision_status"/>
                                    <field name="decision_date"/>
                                    <field name="decision_made_at_id"/>
                                    <field name="age"/>
                                </list>
                            </field>
                        </page>
                        <page string="Resource Allocation">
                            <field name="resource_allocations_ids">
                                <list>
                                    <field name="resource"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="remaining_days"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scope Changes">
                            <field name="scope_changes_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="impact_on_cost"/>
                                    <field name="impact_on_time"/>
                                    <field name="approval_status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Governance Requirements">
                            <group>
                                    <field name="governance_rag" widget="badge"
                                           decoration-success="governance_rag == 'done'"
                                           decoration-info="governance_rag == 'normal'"
                                           decoration-danger="governance_rag == 'blocked'"/>
                            </group>
                            <field name="governance_requirements_ids">
                                <list>
                                    <field name="phase_required_for"/>
                                    <field name="required_document_id"/>
                                    <field name="status"/>
                                    <field name="comment"/>
                                    <field name="sort_order"/>
                                    <field name="rag"/>
                                    <field name="is_document"/>
                                </list>
                            </field>
                        </page>
                        <page name="analytic" string="Analytic" groups="analytic.group_analytic_accounting">
                            <group>
                                 <group>
                                    <field name="account_id"/>
                                </group>
                            </group>
                        </page>
