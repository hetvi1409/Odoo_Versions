<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="scope_changes_allocation" model="ir.actions.act_window">
        <field name="name">Scope Changes</field>
        <field name="res_model">scope.changes</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first record
            </p>
        </field>
    </record>
    <record id="scope_changes_tree_view" model="ir.ui.view">
        <field name="name">scope.changes.tree.view</field>
        <field name="model">scope.changes</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_date"/>
                <field name="impact_on_cost"/>
                <field name="impact_on_time"/>
                <field name="approval_status"/>
                <field name="project_id" options="{'no_create': True}"/>
                <field name="write_date" string="Last Update"/>
            </list>
        </field>
    </record>
    <record id="scope_changes_form_view" model="ir.ui.view">
        <field name="name">scope.changes.form.view</field>
        <field name="model">scope.changes</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <field name="approval_status" widget='statusbar'/>
                    <button name="action_submitted"
                            class="oe_highlight"
                            string="Submitted"
                            type="object"
                            invisible="approval_status != 'draft'"/>
                    <button name="action_approve"
                            class="oe_highlight"
                            string="Approve"
                            type="object"
                            invisible="approval_status != 'submitted'"/>
                    <button name="action_rejected"
                            class="oe_highlight"
                            string="Rejected"
                            type="object"
                            invisible="approval_status != 'submitted'"/>
                </header>
                <sheet>
                                        <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover),
                        .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover)
                        .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover)
                        .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group string="Change Information">
                        <group>
                            <field name="project_id" context="{'form_view_ref': 'project_porfolio_management.edit_project_ppe'}"
                             options="{'no_create': True}"/>

                            <field name="name"/>
                            <field name="request_date"/>
                            <field name="leaded_by_id" widget="many2one_avatar_user"/>
                            <field name="requested_by_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group>
                            <field name="description" options="{'height': 50}"/>
                            <field name="reason" options="{'height': 50}"/>
                        </group>
                    </group>
                    <group string="Change Impact">
                        <group>
                            <field name="impact_on_cost"/>
                            <field name="impact_on_time"/>
                        </group>
                        <group>
                            <field name="impact" options="{'height': 50}"/>
                        </group>
                    </group>
                    <group string="Approval Information">
                        <group>
                            <field name="approval_status" readonly="True"/>
                        </group>
                        <group>
                            <field name="approval_date"/>
                        </group>
                    </group>
                    <group string="Update Detail">
                        <field name="write_uid"/>
                        <field name="write_date"/>
                    </group>

                </sheet>
                <chatter/>

            </form>
        </field>
    </record>
    <menuitem id="project_scope_changes_menu" name="Scope Changes" parent="menu_ppo_time_and_cost" action="scope_changes_allocation" sequence="8"/>

</odoo>