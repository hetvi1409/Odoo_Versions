<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_resource_allocation" model="ir.actions.act_window">
        <field name="name">Resource Allocation</field>
        <field name="res_model">resource.allocations</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first record
            </p>
        </field>
    </record>
    <record id="project_resource_allocation_form_view" model="ir.ui.view">
        <field name="name">resource.allocation.form.view</field>
        <field name="model">resource.allocations</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover),
                        .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover)
                        .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover)
                        .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group string="Resource Allocation Information">
                        <group>
                            <field name="name"/>
                            <field name="project_id"
                                   options="{'no_create': True}"/>
                            <field name="end_date" required="True"
                                   widget="daterange"
                                   options="{'start_date_field': 'start_date', 'always_range': '1'}"
                                   string="Planing Date"/>

                            <field name="days"/>
                            <field name="planned_hours"/>
                        </group>
                        <group>
                            <field name="resource_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="hours" widget="percentage"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <group string="Update Detail">
                        <field name="write_uid"/>
                        <field name="write_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="project_resource_allocation_view" model="ir.ui.view">
        <field name="name">resource.allocation.tree.view</field>
        <field name="model">resource.allocations</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="resource"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="remaining_days"/>
                <field name="project_id" options="{'no_create': True}"/>
                <field name="write_date" string="Last Update"/>
            </list>
        </field>
    </record>
    <menuitem id="project_resource_allocation_menu" name="Resource Allocation"
              parent="menu_ppo_time_and_cost" action="project_resource_allocation"
              sequence="3"/>
</odoo>