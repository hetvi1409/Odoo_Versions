    <!-- Tables -->
    <t t-name="ProjectTables">
        <div class="row mt-4 gy-2 md-5">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="card table-card table-responsive">
                    <div class="card-header table-header">
                        <span>All Tasks</span>
                    </div>
                    <table id="my_table_all_task_list" class="table table-hover">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Project</th>
                                <th>Customer</th>
                                <th>Assigned To</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody> </tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <div class="card table-card table-responsive">
                    <div class="card-header table-header">
                        <span>Upcoming Deadlines</span>
                    </div>
                    <table id="my_table_closing_task_list" class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Task</th>
                                <th>Customer</th>
                                <th>Assigned To</th>
                            </tr>
                        </thead>
                        <tbody> </tbody>
                    </table>
                </div>
            </div>
        </div>
