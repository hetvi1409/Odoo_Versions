<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="assessment_meeting_view_form" model="ir.ui.view">
        <field name="name">assessment.meeting.form.view</field>
        <field name="model">assessment.meeting</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="assessment_id"/>
                            <field name="committee_id" />
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="jmc_number"/>
                            <field name="date"/>
                            <field name="is_single_meeting"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="enquiry_assessment_meeting_view_form" model="ir.ui.view">
        <field name="name">assessment.meeting.form.view</field>
        <field name="model">assessment.meeting</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_meeting"
                            string="Create Meeting"
                            type="object"
                            groups="oi_committee.group_committee"
                            invisible="meeting_id != False"
                            class="btn btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="meeting_id" invisible="1"/>
                            <field name="assessment_id"/>
                            <field name="committee_id" />
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="jmc_number"/>
                            <field name="date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="enquiry_assessment_meeting_view_tree" model="ir.ui.view">
        <field name="name">assessment.meeting.view.tree</field>
        <field name="model">assessment.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="subject"/>
                <field name="date"/>
                <field name="assessment_id"/>
            </list>
        </field>
    </record>

    <record id="action_assessment_meeting" model="ir.actions.act_window">
        <field name="name">Meeting Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">assessment.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('client_enquiry.enquiry_assessment_meeting_view_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('client_enquiry.enquiry_assessment_meeting_view_form')})]"/>
    </record>

<!--    <menuitem id="assessment_meeting_menu"-->
<!--              name="Meeting Request"-->
<!--              action="action_assessment_meeting"-->
<!--              parent="oi_committee.menu_committee_root"-->
<!--              sequence="52"/>-->

</odoo>