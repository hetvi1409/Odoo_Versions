<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="upload_meeting_report_view_form" model="ir.ui.view">
        <field name="name">upload.meeting.report.form.view</field>
        <field name="model">upload.meeting.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="assessment_id" readonly="1"/>
                        <field name="is_no_document_available"/>
                        <field name="internal_meeting_document_ids"
                               invisible="is_no_document_available == True"
                               widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="upload_meeting_report_view_form_uploading" model="ir.ui.view">
        <field name="name">upload.meeting.report.form.view.uploading</field>
        <field name="model">upload.meeting.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="assessment_id" readonly="1"/>
                        <field name="internal_meeting_document_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit_upload"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>