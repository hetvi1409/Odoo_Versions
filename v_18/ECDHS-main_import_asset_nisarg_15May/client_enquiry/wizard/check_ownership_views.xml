<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="check_ownership_view_form" model="ir.ui.view">
        <field name="name">check.ownership.form.view</field>
        <field name="model">check.ownership</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type" widget="radio" options="{'horizontal': true}"/>
                        <field name="assessment_id" readonly="1"/>
                        <field name="jmc_number"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="check_property_view_form" model="ir.ui.view">
        <field name="name">check.property.form.view</field>
        <field name="model">check.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="enquiry_id" readonly="1"/>
                        <field name="available"/>
                    </group>
                    <group invisible="available == False">
                        <field name="property_id" required="available == True"/>
                        <field name="asset_number" required="available == True"/>
                        <field name="stand_number" required="available == True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>