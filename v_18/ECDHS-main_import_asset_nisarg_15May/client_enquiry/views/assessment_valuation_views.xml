<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="assessment_valuation_view_form" model="ir.ui.view">
        <field name="name">Assessment Valuation</field>
        <field name="model">assessment.valuation</field>
        <field name="arch" type="xml">
            <form>
                <header>
<!--                    <button name="action_approve" states="draft"-->
<!--                            groups="client_enquiry.group_property_manager"-->
<!--                            string="Approve" type="object"/>-->
<!--                    <button name="action_refuse" states="draft"-->
<!--                            groups="client_enquiry.group_property_manager"-->
<!--                            string="Refuse" type="object"/>-->
<!--                    <field name="state" widget="statusbar"/>-->
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="property_id"/>
                        <field name="assessment_id"/>
                        <field name="property_number"/>
                        <field name="property_description"/>
                        <field name="jmc_number"/>
                    </group>
                    <group>
                        <group>
                            <field name="address"/>
                            <field name="only_portion"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="property_category"/>
                        </group>
                        <group>
                            <field name="contract_ids" widget="many2many_tags"/>
                            <field name="size"/>
<!--                            <field name="circulation_comments"/>-->
                            <field name="purpose_valuation"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="assessment_valuation_tree_view" model="ir.ui.view">
        <field name="name">Assessment Valuation</field>
        <field name="model">assessment.valuation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="assessment_id"/>
<!--                <field name="state"/>-->
            </list>
        </field>
    </record>


    <record id="action_assessment_valuation" model="ir.actions.act_window">
        <field name="name">Assessment Valuation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">assessment.valuation</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="action_assessment_valuation_menu"
              name="Valuation"
              action="action_assessment_valuation"
              parent="client_enquiry.client_enquiry_helpdesk_enquiries_menu"
              sequence="52"/>

</odoo>