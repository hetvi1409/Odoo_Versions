<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_strategic_planning_form" model="ir.ui.view">
        <field name="name">strategic.planning.view.tree</field>
        <field name="model">strategic.planning</field>
        <field name="inherit_id" ref="governance.view_strategic_planning_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='goals']" position="after">
                <page string="Risk" name="risk">
                    <field name="risk_ids"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>