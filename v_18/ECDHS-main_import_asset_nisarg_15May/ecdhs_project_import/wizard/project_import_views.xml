<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="project_import_view_form" model="ir.ui.view">
        <field name="name">project.import</field>
        <field name="model">project.import</field>
        <field name="arch" type="xml">
            <form>
                <group col="4">
                    <field name="file"/>
                </group>
                <footer>
                    <button name="action_import_xlsx" string="Import" type="object" default_focus="1"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="project_import_action" model="ir.actions.act_window">
        <field name="name">Project Import</field>
        <field name="res_model">project.import</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="project_import_menu" name="Project Import" parent="project.menu_project_config"
              action="project_import_action" sequence="15"/>

</odoo>