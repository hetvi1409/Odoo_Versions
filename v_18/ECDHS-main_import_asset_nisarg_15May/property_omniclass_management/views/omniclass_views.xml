<odoo>
    <record id="view_omniclass_function_tree" model="ir.ui.view">
        <field name="model">omniclass.function</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_omniclass_function_form" model="ir.ui.view">
        <field name="model">omniclass.function</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
