<odoo>

	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">res.config.settings.view.form.jasper</field>
		<field name="model">res.config.settings</field>
		<field name="priority" eval="100" />
		<field name="inherit_id" ref="base.res_config_settings_view_form" />
		<field name="arch" type="xml">
                 <xpath expr="//form" position="inside">
                    <app data-string="Activate Workflow on" string="Activate Workflow on" name="oi_workflow">
                        <block title="Bad Debt Accounts for Loans" id="bad_debt_account_loan">
                            <setting id="write_off_account" string="Write-Off Account" >
                                <field name="module_oi_workflow_expense" />
                            </setting>
                        </block>
                        <block title="Employee" id="bad_debt_account_loan">
                            <setting id="write_off_account" string="Employee Contracts" >
                                <field name="module_oi_workflow_hr_contract" />
                            </setting>
							<setting id="write_off_account" string="Employee Time Off" >
                                <field name="module_oi_workflow_hr_holidays" />
                            </setting>
                        </block>
					</app>
				 </xpath>
