<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="RiskDashboard">
        <div class="risk_dashboard container-fluid py-3">

            <!-- Title -->
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary">⚠️ Top 10 Risks</h2>
                <p class="text-muted">High-level overview of critical risks by department</p>
            </div>

            <!-- Buttons + Department Filter -->
            <div class="d-flex justify-content-between align-items-center mb-4 px-3">
                <!-- Buttons -->
                <div>
                    <button type="button" class="btn btn-danger shadow-sm me-2" t-on-click="printPdf">
                        <i class="fa fa-file-pdf-o me-1"></i> Export PDF
                    </button>
                </div>

                <!-- Risk Filter -->
                <div class="d-flex align-items-center">
                    <div class="dropdown me-3">
                        <button class="btn btn-outline-primary dropdown-toggle shadow-sm" type="button" style="width:200px;"
                                id="riskDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-filter me-1"></i> Select Risks
                        </button>
                        <ul class="dropdown-menu p-2 border-0 shadow" aria-labelledby="riskDropdown"
                            style="max-height:250px; overflow-y:auto; border-radius:0.5rem;width:300px;">
                            <t t-foreach="state.risk_options" t-as="risk" t-key="risk.risk_id">
                                <li>
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               t-att-value="risk.risk_id"
                                               t-on-change="onRiskCheckboxChange"/>
                                        <label class="form-check-label">
                                            <t t-esc="risk.risk_name"/>
                                        </label>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </div>

                    <!-- Department Filter -->
                    <div class="d-flex align-items-center">
                        <label class="me-2 fw-bold text-muted">Department:</label>
                        <select class="form-select form-select-sm shadow-sm"
                                style="width: 220px; border-radius:0.5rem;"
                                t-ref="department_filter"
                                t-on-change="onDepartmentChange">
                            <option value="">All Departments</option>
                            <t t-foreach="state.departments" t-as="dept" t-key="dept.id">
                                <option t-att-value="dept.id">
                                    <t t-esc="dept.name['en_US']"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Risk Table -->
            <div class="card shadow-sm mb-4 risk_table_details">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <strong>📋 Risk Details</strong>
                    <div>
                    <button type="button" class="btn btn-light btn-sm text-danger shadow-sm" t-on-click="printRiskDetailsPdf">
                        <i class="fa fa-file-pdf-o me-1"></i> Export PDF
                    </button>

                </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive " style="max-height: 60vh; overflow-y: auto;">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-center">
                                    <th>Risk Name</th>
                                    <th>Department</th>
                                    <th>Main Risk</th>
                                    <th>Current Risk</th>
                                    <th>Inherent Risk</th>
                                    <th>Residual Risk</th>
                                    <th>Control Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.risks" t-as="risk" t-key="risk.risk_id">
                                    <tr class="text-center">
                                        <td><t t-esc="risk.risk_name"/></td>
                                        <t t-if="risk.department_name">
                                            <td><t t-esc="risk.department_name['en_US']"/></td>
                                        </t>
                                        <t t-else="">
                                            <td></td>
                                        </t>
                                        <td class="fw-bold text-danger"><t t-esc="risk.main_risk_score_num"/></td>
                                        <td><t t-esc="risk.current_risk_score_num"/></td>
                                        <td><t t-esc="risk.inherent_risk_score_num"/></td>
                                        <td><t t-esc="risk.residual_risk_score_num"/></td>
                                        <td><t t-esc="risk.score or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Risk Chart -->
            <div class="card shadow-sm risk_table_details_graph">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <strong>📊 Risk Score Distribution</strong>
                    <button type="button" class="btn btn-light btn-sm text-danger shadow-sm"
                            t-on-click="printRiskDetailsGraphPdf">
                        <i class="fa fa-file-pdf-o me-1"></i> Export PDF
                    </button>
                </div>
                <div class="card-body">
                    <canvas class="top_risk" t-ref="top_risk" style="background:#fff;" height="120"></canvas>
                </div>
            </div>

        </div>
    </t>
</templates>
