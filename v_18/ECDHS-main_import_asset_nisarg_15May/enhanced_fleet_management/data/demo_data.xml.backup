        <!-- Demo Accident Report (ACCIDENT_REPORT_FORM.pdf) -->
        <record id="demo_accident_1" model="fleet.accident.report">
            <field name="reference">ACC/2026/0001</field>
            <field name="vehicle_id" ref="demo_vehicle_truck"/>
            <field name="driver_id" ref="demo_driver_michael"/>
            <field name="accident_date" eval="(DateTime.now() - timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="accident_time">14.5</field>
            <field name="accident_location">N1 Highway near Midrand</field>
            <field name="accident_address">N1 North, approximately 5km north of Midrand exit, Gauteng</field>
            <field name="weather_conditions">rain</field>
            <field name="road_conditions">wet</field>
            <field name="accident_type">collision</field>
            <field name="passenger_count">1</field>
            <field name="passenger_details">Assistant: David Wilson (Employee #EMP-456)</field>
            <field name="injuries_reported" eval="False"/>
            <field name="third_party_involved" eval="True"/>
            <field name="third_party_name">Peter Anderson</field>
            <field name="third_party_contact">082 555 1234</field>
            <field name="third_party_address">45 Oak Street, Midrand, 1685</field>
            <field name="third_party_vehicle_reg">GHI789GP</field>
            <field name="third_party_vehicle_make">Volkswagen Polo</field>
            <field name="third_party_insurance">Budget Insurance</field>
            <field name="third_party_policy_number">BUD-2024-789456</field>
            <field name="accident_description">Vehicle was traveling north on N1 in heavy rain at approximately 80 km/h. Third party vehicle (GHI789GP) changed lanes suddenly from the right lane to the left lane without indicating, causing our driver to brake hard to avoid collision. Due to wet road conditions, the vehicle's ABS engaged but the vehicle continued sliding forward, making contact with the rear bumper of the third party vehicle. Impact was minor but caused damage to both vehicles.</field>
            <field name="damage_description">Front bumper damaged with cracks and dents, right headlight assembly cracked and non-functional, bonnet slightly dented near the latch area. Paint scratches on front right fender. Estimated repair cost R15,000 - R18,000.</field>
            <field name="speed_at_accident">80</field>
            <field name="driver_statement">I was driving in the left lane at approximately 80 km/h in heavy rain. The vehicle ahead (GHI789GP) suddenly changed lanes from right to left without indicating. I immediately applied brakes but due to wet conditions, the vehicle slid forward despite ABS activation. I made contact with the rear of the other vehicle. I was not speeding and was driving cautiously due to weather conditions.</field>
            <field name="witness_present" eval="True"/>
            <field name="witness_details">Traffic officer on scene: Officer J. Mthembu, Badge #12345, Midrand Traffic Department. Also witnessed by: Sarah Nkosi (passenger in third party vehicle), Contact: 083 444 5555</field>
            <field name="police_notified" eval="True"/>
            <field name="police_station">Midrand Police Station</field>
            <field name="police_case_number">CAS123/01/2026</field>
            <field name="police_officer_name">Officer J. Mthembu</field>
            <field name="police_officer_badge">12345</field>
            <field name="vehicle_driveable" eval="True"/>
            <field name="vehicle_towed" eval="False"/>
            <field name="estimated_repair_cost">15000.00</field>
            <field name="fault_determination">third_party</field>
            <field name="insurance_claim_number">SANTAM-2026-ACC-001</field>
            <field name="state">investigation</field>
        </record>

