        <!-- Demo Transport Requests (TRANSPORT_REQUEST_FORM.pdf) -->
        <record id="demo_transport_request_1" model="fleet.transport.request">
            <field name="reference">TR/2026/0001</field>
            <field name="requester_id" ref="base.user_admin"/>
            <field name="request_date" eval="(DateTime.now() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="transport_type">official</field>
            <field name="priority">normal</field>
            <field name="purpose">Client meeting in Sandton - Annual Review Presentation</field>
            <field name="passengers">3</field>
            <field name="origin">Head Office, 123 Main Street, Johannesburg</field>
            <field name="destination">Sandton Convention Centre, Sandton</field>
            <field name="distance">25</field>
            <field name="trip_start_date" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="trip_end_date" eval="(DateTime.now() + timedelta(days=2, hours=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="special_requirements">Require vehicle with air conditioning. Presentation materials and laptop equipment will be transported.</field>
            <field name="state">approved</field>
        </record>

        <record id="demo_transport_request_2" model="fleet.transport.request">
            <field name="reference">TR/2026/0002</field>
            <field name="requester_id" ref="base.user_admin"/>
            <field name="request_date" eval="(DateTime.now() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="transport_type">emergency</field>
            <field name="priority">urgent</field>
            <field name="purpose">Emergency site visit - equipment failure at Pretoria facility</field>
            <field name="passengers">2</field>
            <field name="origin">Head Office, Johannesburg</field>
            <field name="destination">Pretoria Industrial Park, Rigel Avenue</field>
            <field name="distance">60</field>
            <field name="trip_start_date" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="trip_end_date" eval="(DateTime.now() + timedelta(days=1, hours=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="special_requirements">Urgent - equipment failure affecting operations. Require LDV for tools and equipment transport.</field>
            <field name="state">submitted</field>
        </record>

        <record id="demo_transport_request_3" model="fleet.transport.request">
            <field name="reference">TR/2026/0003</field>
            <field name="requester_id" ref="base.user_admin"/>
            <field name="request_date" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="transport_type">official</field>
            <field name="priority">normal</field>
            <field name="purpose">Staff transport to training workshop - Change Management</field>
            <field name="passengers">12</field>
            <field name="origin">Head Office, Johannesburg</field>
            <field name="destination">Training Centre, Midrand</field>
            <field name="distance">35</field>
            <field name="trip_start_date" eval="(DateTime.now() + timedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="trip_end_date" eval="(DateTime.now() + timedelta(days=5, hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="special_requirements">Require bus or large vehicle for 12 passengers. Workshop materials will be transported.</field>
            <field name="state">draft</field>
        </record>

        <record id="demo_transport_request_4" model="fleet.transport.request">
            <field name="reference">TR/2026/0004</field>
            <field name="requester_id" ref="base.user_admin"/>
            <field name="request_date" eval="(DateTime.now() - timedelta(days=7)).strftime('%Y-%m-%d')"/>
            <field name="transport_type">official</field>
            <field name="priority">high</field>
            <field name="purpose">Equipment delivery to Cape Town project site</field>
            <field name="passengers">2</field>
            <field name="origin">Head Office, Johannesburg</field>
            <field name="destination">Cape Town Project Site, Century City</field>
            <field name="distance">1400</field>
            <field name="trip_start_date" eval="(DateTime.now() + timedelta(days=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="trip_end_date" eval="(DateTime.now() + timedelta(days=12, hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="special_requirements">Long-distance trip. Require LDV with canopy for equipment protection. Overnight accommodation required (2 nights). Fuel card and toll gate card needed.</field>
            <field name="state">approved</field>
        </record>

        <record id="demo_transport_request_5" model="fleet.transport.request">
            <field name="reference">TR/2026/0005</field>
            <field name="requester_id" ref="base.user_admin"/>
            <field name="request_date" eval="(DateTime.now() - timedelta(hours=2)).strftime('%Y-%m-%d')"/>
            <field name="transport_type">emergency</field>
            <field name="priority">urgent</field>
            <field name="purpose">Emergency response - site incident requiring management presence</field>
            <field name="passengers">3</field>
            <field name="origin">Head Office, Johannesburg</field>
            <field name="destination">Durban Site Office</field>
            <field name="distance">600</field>
            <field name="trip_start_date" eval="(DateTime.now() + timedelta(hours=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="trip_end_date" eval="(DateTime.now() + timedelta(days=1, hours=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="special_requirements">URGENT - Site incident requires immediate management response. Require reliable vehicle with good fuel economy for long-distance travel.</field>
            <field name="state">submitted</field>
        </record>

