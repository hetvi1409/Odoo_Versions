        <!-- Demo Vehicles with Fleet Register Data (FLEET_REGISTER_HUMAN_SETTLEMENTS.pdf) -->
        <record id="demo_vehicle_sedan" model="fleet.vehicle">
            <field name="name">Toyota Corolla - ABC123GP</field>
            <field name="license_plate">ABC123GP</field>
            <field name="vin_sn">JT2BF28K9X0123456</field>
            <field name="chassis_number">JT2BF28K9X0123456</field>
