        <!-- Demo Lost & Theft Report (LOST_THEFT_INCIDENT_REPORT.pdf) -->
        <record id="demo_lost_theft_1" model="fleet.lost.theft">
            <field name="reference">LT/2026/0001</field>
            <field name="vehicle_id" ref="demo_vehicle_sedan"/>
            <field name="incident_type">theft_attempt</field>
            <field name="incident_date" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="incident_time">2.25</field>
            <field name="incident_location">Company Parking Lot, Head Office</field>
            <field name="incident_address">123 Main Street, Johannesburg, Gauteng, 2001</field>
            <field name="incident_description">Attempted theft of vehicle radio and sound system. Suspect broke driver's side window using unknown object (possibly rock or hammer). Security alarm activated and security personnel responded within 3 minutes. Suspect fled the scene before removing any items. CCTV footage captured suspect approaching vehicle at 02:15 AM and fleeing at 02:18 AM. Suspect wore dark clothing and face covering.</field>
            <field name="items_involved">Car radio (Pioneer DEH-X6900BT), 4x speakers (Pioneer TS-G1620F), driver's side window glass</field>
            <field name="estimated_value">8500.00</field>
            <field name="driver_id" ref="demo_driver_john"/>
            <field name="last_seen_location">Company Parking Lot - Bay B12</field>
            <field name="last_seen_date" eval="(DateTime.now() - timedelta(days=30, hours=10)).strftime('%Y-%m-%d')"/>
            <field name="last_seen_time">16.0</field>
            <field name="police_notified" eval="True"/>
            <field name="police_station">Johannesburg Central Police Station</field>
            <field name="police_case_number">CAS456/12/2025</field>
            <field name="police_officer_name">Detective S. Naidoo</field>
            <field name="police_officer_badge">DET-789</field>
            <field name="insurance_notified" eval="True"/>
            <field name="insurance_claim_number">SANTAM-2025-THEFT-001</field>
            <field name="security_footage" eval="True"/>
            <field name="security_footage_details">CCTV footage shows suspect approaching vehicle at 02:15 AM from the north entrance. Suspect spent approximately 3 minutes attempting to remove radio before security arrived. Clear images of suspect's build and clothing captured. Footage provided to SAPS on USB drive (Evidence #EV-456-001).</field>
            <field name="witness_present" eval="True"/>
            <field name="witness_details">Security Guard: Thomas Mbeki (Employee #SEC-001), Contact: 082 111 2222. Guard was on patrol and responded to alarm activation. Did not see suspect's face but observed suspect fleeing towards north exit.</field>
            <field name="state">investigation</field>
        </record>

