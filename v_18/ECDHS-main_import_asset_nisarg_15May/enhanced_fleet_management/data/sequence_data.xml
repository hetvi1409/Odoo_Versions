            <field name="prefix">VC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Lost/Theft Report -->
        <record id="seq_fleet_lost_theft" model="ir.sequence">
