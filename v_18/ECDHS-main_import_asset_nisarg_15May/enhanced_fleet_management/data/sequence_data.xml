            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Odometer Reading -->
        <record id="seq_fleet_odometer_reading" model="ir.sequence">
            <field name="name">Odometer Reading</field>
