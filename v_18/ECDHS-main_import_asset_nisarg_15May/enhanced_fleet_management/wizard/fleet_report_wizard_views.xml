<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_report_wizard_form" model="ir.ui.view">
        <field name="name">fleet.report.wizard.form</field>
        <field name="model">fleet.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Fleet Report">
                <group>
                    <field name="report_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="vehicle_ids" widget="many2many_tags"/>
                    <field name="department_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Generate Report" name="action_generate_report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fleet_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Fleet Report</field>
        <field name="res_model">fleet.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
