<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Transport Request Report -->
    <record id="action_report_transport_request" model="ir.actions.report">
        <field name="name">Transport Request Form</field>
        <field name="model">fleet.transport.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">enhanced_fleet_management.report_transport_request_document</field>
        <field name="report_file">enhanced_fleet_management.report_transport_request_document</field>
        <field name="binding_model_id" ref="model_fleet_transport_request"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Transport Request - %s' % (object.reference)</field>
    </record>

