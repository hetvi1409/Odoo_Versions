<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the existing Fleet app menu from fleet module -->
    <!-- fleet.menu_root is the main Fleet menu from the fleet module -->

    <!-- Enhanced Fleet Management Submenu under main Fleet -->
    <menuitem id="menu_fleet_operations"
              name="Fleet Operations"
              parent="fleet.menu_root"
              sequence="5"/>

    <!-- Transport Requests -->
    <menuitem id="menu_fleet_transport_request"
              name="Transport Requests"
              parent="menu_fleet_operations"
              action="action_fleet_transport_request"
              sequence="1"/>

    <!-- Trip Authorities -->
    <menuitem id="menu_fleet_trip_authority"
              name="Trip Authorities"
              parent="menu_fleet_operations"
              action="action_fleet_trip_authority"
              sequence="2"/>

    <!-- Vehicle Checklists -->
    <menuitem id="menu_fleet_vehicle_checklist"
              name="Vehicle Checklists"
              parent="menu_fleet_operations"
              action="action_fleet_vehicle_checklist"
              sequence="3"/>

    <!-- Lost & Theft Reports -->
    <menuitem id="menu_fleet_lost_theft"
              name="Lost &amp; Theft Reports"
              parent="menu_fleet_operations"
              action="action_fleet_lost_theft"
              sequence="4"/>

    <!-- Accident Reports -->
    <menuitem id="menu_fleet_accident_report"
              name="Accident Reports (RT46)"
              parent="menu_fleet_operations"
              action="action_fleet_accident_report"
              sequence="5"/>

    <!-- Vehicle Relief -->
    <menuitem id="menu_fleet_vehicle_relief"
              name="Vehicle Relief"
              parent="menu_fleet_operations"
              action="action_fleet_vehicle_relief"
              sequence="6"/>

    <!-- Odometer Readings -->
    <menuitem id="menu_fleet_odometer_reading"
              name="Odometer Readings"
              parent="menu_fleet_operations"
              action="action_fleet_odometer_reading"
              sequence="7"/>

    <!-- Enhanced Reporting Menu under main Fleet -->
    <menuitem id="menu_fleet_reports"
              name="Enhanced Reports"
              parent="fleet.menu_root"
              sequence="50"/>

    <!-- Configuration Menu under main Fleet -->
    <menuitem id="menu_fleet_enhanced_configuration"
              name="Configuration"
              parent="fleet.menu_root"
              sequence="60"
              groups="enhanced_fleet_management.group_fleet_manager"/>

</odoo>
