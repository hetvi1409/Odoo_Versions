<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vehicle Checklist list View -->
        <record id="view_fleet_vehicle_checklist_list" model="ir.ui.view">
            <field name="name">fleet.vehicle.checklist.list</field>
            <field name="model">fleet.vehicle.checklist</field>
            <field name="arch" type="xml">
                <list string="Vehicle Checklists" decoration-success="state=='approved'" decoration-warning="state=='issues_found'">
                    <field name="reference"/>
                    <field name="inspection_date"/>
                    <field name="inspection_type"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="license_plate"/>
                    <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="inspector_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="overall_condition" widget="badge"/>
                    <field name="vehicle_roadworthy" widget="boolean_toggle"/>
                    <field name="state" widget="badge"
                           decoration-success="state=='approved'"
                           decoration-info="state=='draft'"
                           decoration-warning="state=='issues_found'"/>
                </list>
            </field>
        </record>

        <!-- Vehicle Checklist Form View -->
        <record id="view_fleet_vehicle_checklist_form" model="ir.ui.view">
            <field name="name">fleet.vehicle.checklist.form</field>
            <field name="model">fleet.vehicle.checklist</field>
            <field name="arch" type="xml">
                <form string="Vehicle Inspection Checklist">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="reference" string="Inspection Checklist"/>
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="license_plate"/>
                                <field name="vehicle_model"/>
                                <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="inspection_type"/>
                                <field name="inspection_date"/>
                                <field name="inspector_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="odometer_reading"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Exterior Inspection" name="exterior">
                                <group>
                                    <group string="Body &amp; Paintwork">
                                        <field name="body_condition"/>
                                        <field name="body_damage"/>
                                        <field name="body_damage_description" invisible="not body_damage" placeholder="Describe damage..."/>
                                        <field name="exterior_cleanliness"/>
                                    </group>
                                    <group string="Lights">
                                        <field name="headlights"/>
                                        <field name="taillights"/>
                                        <field name="indicators"/>
                                        <field name="brake_lights"/>
                                        <field name="hazard_lights"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Mirrors &amp; Windows">
                                        <field name="mirrors"/>
                                        <field name="windscreen"/>
                                        <field name="windows"/>
                                        <field name="wipers"/>
                                    </group>
                                    <group string="Tyres">
                                        <field name="tyre_front_left"/>
                                        <field name="tyre_front_right"/>
                                        <field name="tyre_rear_left"/>
                                        <field name="tyre_rear_right"/>
                                        <field name="spare_tyre"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Under the Hood" name="engine">
                                <group>
                                    <group string="Fluid Levels">
                                        <field name="engine_oil_level"/>
                                        <field name="coolant_level"/>
                                        <field name="brake_fluid_level"/>
                                        <field name="power_steering_fluid"/>
                                        <field name="windscreen_washer_fluid"/>
                                    </group>
                                    <group string="Engine Components">
                                        <field name="battery_condition"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Leaks Check">
                                        <field name="oil_leaks"/>
                                        <field name="coolant_leaks"/>
                                        <field name="fuel_leaks"/>
                                        <field name="other_leaks"/>
                                        <field name="leaks_description" invisible="not oil_leaks and not coolant_leaks and not fuel_leaks and not other_leaks" placeholder="Describe leaks..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Interior" name="interior">
                                <group>
                                    <group string="Interior Components">
                                        <field name="seats_condition"/>
                                        <field name="seatbelts"/>
                                        <field name="dashboard_instruments"/>
                                        <field name="horn"/>
                                        <field name="interior_cleanliness"/>
                                    </group>
                                    <group string="Climate Control">
                                        <field name="air_conditioning"/>
                                        <field name="heater"/>
                                        <field name="interior_lights"/>
                                        <field name="radio_sound_system"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Safety Equipment" name="safety">
                                <group>
                                    <group string="Emergency Equipment">
                                        <field name="fire_extinguisher"/>
                                        <field name="first_aid_kit"/>
                                        <field name="warning_triangle"/>
                                        <field name="jack_tools"/>
                                        <field name="reflective_vest"/>
                                    </group>
                                    <group string="Documents">
                                        <field name="license_disc"/>
                                        <field name="vehicle_registration"/>
                                        <field name="insurance_certificate"/>
                                        <field name="service_book"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Fuel &amp; Overall" name="overall">
                                <group>
                                    <group string="Fuel Information">
                                        <field name="fuel_level"/>
                                    </group>
                                    <group string="Overall Assessment">
                                        <field name="overall_condition" widget="badge"/>
                                        <field name="vehicle_roadworthy"/>
                                    </group>
                                </group>
                                <group string="Additional Notes">
                                    <field name="notes" nolabel="1" placeholder="Additional inspection notes..."/>
                                </group>
                            </page>
                            <page string="Related Records" name="related">
                                <group>
                                    <group>
                                        <field name="transport_request_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="trip_authority_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Vehicle Checklist Kanban View -->
        <record id="view_fleet_vehicle_checklist_kanban" model="ir.ui.view">
            <field name="name">fleet.vehicle.checklist.kanban</field>
            <field name="model">fleet.vehicle.checklist</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                    <field name="reference"/>
                    <field name="inspection_date"/>
                    <field name="inspection_type"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="license_plate"/>
                    <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="overall_condition"/>
                    <field name="vehicle_roadworthy"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="reference"/></strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <i class="fa fa-car"/> <field name="license_plate"/>
                                        </span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a type="edit" role="menuitem" class="dropdown-item">Edit</a></li>
                                            <li><a type="delete" role="menuitem" class="dropdown-item">Delete</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="inspection_date" widget="date"/>
                                    <br/>
                                    <span class="badge badge-info">
                                        <field name="inspection_type"/>
                                    </span>
                                    <div class="mt-1">
                                        <span class="badge" t-attf-class="badge-#{record.overall_condition.raw_value == 'excellent' ? 'success' : record.overall_condition.raw_value == 'poor' ? 'danger' : 'warning'}">
                                            <field name="overall_condition"/>
                                        </span>
                                        <t t-if="record.vehicle_roadworthy.raw_value">
                                            <span class="badge badge-success ms-1">
                                                <i class="fa fa-check"/> Roadworthy
                                            </span>
                                        </t>
                                        <t t-if="!record.vehicle_roadworthy.raw_value">
                                            <span class="badge badge-danger ms-1">
                                                <i class="fa fa-warning"/> Not Roadworthy
                                            </span>
                                        </t>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.driver_id.raw_value">
                                            <img t-att-src="kanban_image('res.partner', 'avatar_128', record.driver_id.raw_value)"
                                                 t-att-title="record.driver_id.value" t-att-alt="record.driver_id.value"
                                                 class="oe_kanban_avatar" style="width: 24px; height: 24px;"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vehicle Checklist Search View -->
        <record id="view_fleet_vehicle_checklist_search" model="ir.ui.view">
            <field name="name">fleet.vehicle.checklist.search</field>
            <field name="model">fleet.vehicle.checklist</field>
            <field name="arch" type="xml">
                <search string="Search Vehicle Checklists">
                    <field name="reference"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="inspector_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <filter string="My Inspections" name="my_inspections" domain="[('inspector_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Issues Found" name="issues_found" domain="[('state', '=', 'issues_found')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <separator/>
                    <filter string="Not Roadworthy" name="not_roadworthy" domain="[('vehicle_roadworthy', '=', False)]"/>
                    <filter string="Pre-Trip" name="pre_trip" domain="[('inspection_type', '=', 'pre_trip')]"/>
                    <filter string="Post-Trip" name="post_trip" domain="[('inspection_type', '=', 'post_trip')]"/>
                    <separator/>
                    <filter string="Inspection Date" name="inspection_date" date="inspection_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                        <filter string="Inspection Type" name="group_type" context="{'group_by': 'inspection_type'}"/>
                        <filter string="Overall Condition" name="group_condition" context="{'group_by': 'overall_condition'}"/>
                        <filter string="Inspection Date" name="group_date" context="{'group_by': 'inspection_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vehicle Checklist Action -->
        <record id="action_fleet_vehicle_checklist" model="ir.actions.act_window">
            <field name="name">Vehicle Checklists</field>
            <field name="res_model">fleet.vehicle.checklist</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_my_inspections': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No vehicle inspection checklists found
                </p>
                <p>
                    Create an inspection checklist to ensure vehicles are roadworthy and safe.
                </p>
            </field>
        </record>

    </data>

</odoo>
