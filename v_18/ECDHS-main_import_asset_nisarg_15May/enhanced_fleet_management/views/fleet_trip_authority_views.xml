<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trip Authority list View -->
    <record id="view_fleet_trip_authority_list" model="ir.ui.view">
        <field name="name">fleet.trip.authority.list</field>
        <field name="model">fleet.trip.authority</field>
        <field name="arch" type="xml">
            <list string="Trip Authorities" decoration-warning="is_overdue"
                  decoration-success="state=='completed'">
                <field name="reference"/>
                <field name="trip_number"/>
                                <field name="employee_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="departure_date"/>
                <field name="return_date"/>
                <field name="destination"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state=='completed'"
                       decoration-info="state in ['issued', 'active']"/>
            </list>
        </field>
    </record>

    <!-- Trip Authority Form View -->
    <record id="view_fleet_trip_authority_form" model="ir.ui.view">
        <field name="name">fleet.trip.authority.form</field>
        <field name="model">fleet.trip.authority</field>
        <field name="arch" type="xml">
            <form string="Trip Authority">
                <header>
                    <button name="action_issue" string="Issue Authority" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="enhanced_fleet_management.group_fleet_manager"/>
                    <button name="action_activate" string="Start Trip" type="object"
                            class="oe_highlight" invisible="state != 'issued'"/>
                    <button name="action_complete" string="Complete Trip" type="object"
                            class="oe_highlight" invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['completed', 'cancelled']"
                            groups="enhanced_fleet_management.group_fleet_manager"/>
                    <button name="action_print_authority" string="Print Authority" type="object" icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_checklists" icon="fa-check-square-o">
                            <field string="Checklists" name="vehicle_checklist_ids" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                        <h3>
                            <label for="trip_number" string="Trip Number:"/>
                            <field name="trip_number" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group name="employee_info" string="Employee Information">
                            <field name="transport_request_id" readonly="state != 'draft'" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="employee_number"/>
                            <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="job_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                        </group>
                        <group name="vehicle_info" string="Vehicle &amp; Driver">
                            <field name="vehicle_id" readonly="state != 'draft'"
                                options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="license_plate"/>
                            <field name="vehicle_model"/>
                            <field name="driver_id" readonly="state != 'draft'" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="driver_license_number"/>
                            <field name="co_driver" readonly="state != 'draft'"/>
                            <field name="co_driver_id" invisible="not co_driver" readonly="state != 'draft'" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="co_driver_license_number" invisible="not co_driver"/>
                        </group>
                    </group>
                    <group>
                        <group name="trip_dates" string="Trip Schedule">
                            <field name="departure_date" readonly="state not in ['draft', 'issued']"/>
                            <field name="departure_time" widget="float_time" readonly="state not in ['draft', 'issued']"/>
                            <field name="return_date" readonly="state not in ['draft', 'issued']"/>
                            <field name="return_time" widget="float_time" readonly="state not in ['draft', 'issued']"/>
                            <field name="duration_days"/>
                            <field name="actual_return_date" invisible="not actual_return_date"/>
                            <field name="is_overdue" invisible="not is_overdue"/>
                        </group>
                        <group name="trip_details" string="Trip Details">
                            <field name="destination" readonly="state != 'draft'"/>
                            <field name="route_description" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                            <field name="number_of_passengers" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="odometer_fuel" string="Odometer &amp; Fuel">
                            <group>
                                <group name="odometer" string="Odometer Readings">
                                    <field name="odometer_start" readonly="state not in ['issued', 'active']"/>
                                    <field name="odometer_end" readonly="state != 'active'"/>
                                    <field name="distance_travelled"/>
                                </group>
                                <group name="fuel" string="Fuel Information">
                                    <field name="fuel_level_start" readonly="state not in ['issued', 'active']"/>
                                    <field name="fuel_level_end" readonly="state != 'active'"/>
                                    <field name="fuel_cost" readonly="state != 'active'"/>
                                    <field name="fuel_receipts" filename="fuel_receipts_filename"
                                           readonly="state not in ['active', 'completed']"/>
                                </group>
                            </group>
                        </page>
                        <page name="passengers" string="Passengers &amp; Instructions">
                            <group>
                                <field name="passengers_list" nolabel="1"
                                       placeholder="List of all passengers..."
                                       readonly="state != 'draft'"/>
                                <field name="special_instructions" nolabel="1"
                                       placeholder="Special instructions for the trip..."
                                       readonly="state != 'draft'"/>
                            </group>
                            <group string="Emergency Contact">
                                <field name="emergency_contact_name" readonly="state != 'draft'"/>
                                <field name="emergency_contact_phone" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page name="authorization" string="Authorization">
                            <group>
                                <group name="authorized_by" string="Authorized By">
                                    <field name="authorized_by_id" readonly="state != 'draft'" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="authorization_date"/>
                                    <field name="authorized_signature" widget="image"
                                           filename="authorized_signature_filename"/>
                                </group>
                                <group name="completion" string="Trip Completion" invisible="state not in ['completed']">
                                    <field name="completed_by_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    <field name="completion_date"/>
                                </group>
                            </group>
                        </page>
                        <page name="trip_report" string="Trip Report" invisible="state not in ['active', 'completed']">
                            <group>
                                <field name="trip_report" nolabel="1"
                                       placeholder="Provide a summary of the trip..."
                                       readonly="state == 'completed'"/>
                                <field name="incidents_reported" nolabel="1"
                                       placeholder="Report any incidents or issues encountered..."
                                       readonly="state == 'completed'"/>
                            </group>
                        </page>
                        <page name="checklists" string="Vehicle Checklists" invisible="not vehicle_checklist_ids">
                            <field name="vehicle_checklist_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="inspection_type"/>
                                    <field name="inspection_date"/>
                                    <field name="overall_condition" widget="badge"/>
                                    <field name="vehicle_roadworthy" widget="boolean"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Trip Authority Kanban View -->
    <record id="view_fleet_trip_authority_kanban" model="ir.ui.view">
        <field name="name">fleet.trip.authority.kanban</field>
        <field name="model">fleet.trip.authority</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="reference"/>
                <field name="employee_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="departure_date"/>
                <field name="destination"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="reference"/>
                                    </strong>
                                </div>
                                <t t-if="record.is_overdue.raw_value">
                                    <span class="badge badge-danger">Overdue</span>
                                </t>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><strong><field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/></strong></div>
                                <div class="text-muted">
                                    <i class="fa fa-user"/> <field name="employee_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-map-marker"/> <field name="destination"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar"/> <field name="departure_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Trip Authority Search View -->
    <record id="view_fleet_trip_authority_search" model="ir.ui.view">
        <field name="name">fleet.trip.authority.search</field>
        <field name="model">fleet.trip.authority</field>
        <field name="arch" type="xml">
            <search string="Trip Authorities">
                <field name="reference"/>
                <field name="employee_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="destination"/>
                <filter string="My Trips" name="my_trips"
                        domain="['|', ('employee_id.user_id', '=', uid), ('driver_id.user_ids', 'in', uid)]"/>
                <filter string="Active Trips" name="active_trips"
                        domain="[('state', 'in', ['issued', 'active'])]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Issued" name="issued"
                        domain="[('state', '=', 'issued')]"/>
                <filter string="Active" name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Departure Date" name="group_departure" context="{'group_by': 'departure_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Trip Authority Action -->
    <record id="action_fleet_trip_authority" model="ir.actions.act_window">
        <field name="name">Trip Authorities</field>
        <field name="res_model">fleet.trip.authority</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_trips': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Trip Authorities Found
            </p>
            <p>
                Trip authorities are generated automatically from approved transport requests.
            </p>
        </field>
    </record>

</odoo>
