<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vehicle Relief list View -->
        <record id="view_fleet_vehicle_relief_list" model="ir.ui.view">
            <field name="name">fleet.vehicle.relief.list</field>
            <field name="model">fleet.vehicle.relief</field>
            <field name="arch" type="xml">
                <list string="Vehicle Relief Requests" decoration-danger="is_overdue" decoration-info="state=='draft'">
                    <field name="reference"/>
                    <field name="request_date"/>
                    <field name="original_registration"/>
                    <field name="relief_registration"/>
                    <field name="relief_reason"/>
                    <field name="start_date"/>
                    <field name="expected_end_date"/>
                    <field name="relief_duration"/>
                    <field name="priority" widget="priority"/>
                    <field name="is_overdue" invisible="1"/>
                    <field name="state" widget="badge"
                           decoration-success="state=='closed'"
                           decoration-info="state=='submitted'"
                           decoration-warning="state=='active'"/>
                </list>
            </field>
        </record>

        <!-- Vehicle Relief Form View -->
        <record id="view_fleet_vehicle_relief_form" model="ir.ui.view">
            <field name="name">fleet.vehicle.relief.form</field>
            <field name="model">fleet.vehicle.relief</field>
            <field name="arch" type="xml">
                <form string="Vehicle Relief Request">
                    <header>
                        <button name="action_submit" string="Submit" type="object"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" string="Approve" type="object"
                                class="oe_highlight" invisible="state != 'submitted'"/>
                        <button name="action_assign_relief" string="Assign Relief Vehicle" type="object"
                                invisible="state != 'approved'"/>
                        <button name="action_activate" string="Activate" type="object"
                                class="oe_highlight" invisible="state != 'relief_assigned'"/>
                        <button name="action_return_original" string="Return Original Vehicle" type="object"
                                invisible="state != 'active'"/>
                        <button name="action_close" string="Close" type="object"
                                class="oe_highlight" invisible="state not in ('active','returned')"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state in ('closed','cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,relief_assigned,active,returned,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="reference" string="Relief Request"/>
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                            <field name="name" invisible="1"/>
                        </div>
                        <group>
                            <group>
                                <field name="request_date"/>
                                <field name="requester_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="priority" widget="priority"/>
                            </group>
                            <group>
                                <field name="relief_duration" widget="integer"/>
                                <field name="is_overdue" invisible="1"/>
                                <div invisible="not is_overdue" class="alert alert-warning" role="alert">
                                    Relief period is overdue!
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page string="Relief Details" name="relief_details">
                                <group>
                                    <group string="Original Vehicle">
                                        <field name="original_vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="original_registration"/>
                                        <field name="original_vehicle_make"/>
                                        <field name="original_vehicle_model"/>
                                    </group>
                                    <group string="Period">
                                        <field name="start_date"/>
                                        <field name="expected_end_date"/>
                                        <field name="actual_end_date"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Relief Reason">
                                        <field name="relief_reason"/>
                                        <field name="reason_description" nolabel="1" placeholder="Describe the reason for vehicle relief..."/>
                                    </group>
                                    <group string="Related Records">
                                        <field name="accident_report_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="maintenance_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Relief Vehicle" name="relief_vehicle">
                                <group>
                                    <group string="Relief Vehicle Assignment">
                                        <field name="relief_vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="relief_registration"/>
                                        <field name="relief_vehicle_make"/>
                                        <field name="relief_vehicle_model"/>
                                        <field name="relief_assigned_date"/>
                                    </group>
                                    <group string="Driver">
                                        <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="driver_license"/>
                                        <field name="driver_contact"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Handover" name="handover">
                                <group>
                                    <group string="Vehicle Condition at Handover">
                                        <field name="handover_odometer"/>
                                        <field name="handover_fuel_level"/>
                                        <field name="handover_checklist_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="handover_condition" nolabel="1" placeholder="Notes on vehicle condition..."/>
                                    </group>
                                    <group string="Vehicle Condition at Return">
                                        <field name="return_odometer"/>
                                        <field name="return_fuel_level"/>
                                        <field name="return_checklist_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="return_condition" nolabel="1" placeholder="Notes on vehicle condition..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Costs" name="costs">
                                <group>
                                    <group string="Cost Details">
                                        <field name="daily_rate" widget="monetary"/>
                                        <field name="additional_costs" widget="monetary"/>
                                        <field name="total_cost" widget="monetary"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                    <group string="Notes">
                                        <field name="cost_notes" nolabel="1" placeholder="Additional cost notes..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Approval" name="approval">
                                <group>
                                    <group string="Approval Details">
                                        <field name="approved_by_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="approval_date"/>
                                    </group>
                                    <group string="Notes">
                                        <field name="approval_notes" nolabel="1" placeholder="Approval notes..."/>
                                    </group>
                                </group>
                                <group string="Additional Notes">
                                    <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                                </group>
                                <group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Vehicle Relief Kanban View -->
        <record id="view_fleet_vehicle_relief_kanban" model="ir.ui.view">
            <field name="name">fleet.vehicle.relief.kanban</field>
            <field name="model">fleet.vehicle.relief</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                    <field name="reference"/>
                    <field name="request_date"/>
                    <field name="original_vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="original_registration"/>
                    <field name="relief_vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="relief_registration"/>
                    <field name="relief_reason"/>
                    <field name="start_date"/>
                    <field name="expected_end_date"/>
                    <field name="relief_duration"/>
                    <field name="priority"/>
                    <field name="is_overdue"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click #{record.is_overdue.raw_value ? 'oe_kanban_color_2' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="reference"/></strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <i class="fa fa-car"/> <field name="original_registration"/>
                                        </span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a type="edit" role="menuitem" class="dropdown-item">Edit</a></li>
                                            <li><a type="delete" role="menuitem" class="dropdown-item">Delete</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="request_date" widget="date"/>
                                    <br/>
                                    <span class="badge badge-info">
                                        <field name="relief_reason"/>
                                    </span>
                                    <div class="mt-1">
                                        <strong>Duration:</strong> <field name="relief_duration"/> days
                                    </div>
                                    <t t-if="record.relief_registration.raw_value">
                                        <div class="mt-1">
                                            <i class="fa fa-exchange"/> Relief: <field name="relief_registration"/>
                                        </div>
                                    </t>
                                    <t t-if="record.is_overdue.raw_value">
                                        <div class="mt-1">
                                            <span class="badge badge-danger">
                                                <i class="fa fa-clock-o"/> Overdue
                                            </span>
                                        </div>
                                    </t>
                                    <div class="mt-1">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="text-muted">
                                            <field name="start_date" widget="date"/> → <field name="expected_end_date" widget="date"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vehicle Relief Search View -->
        <record id="view_fleet_vehicle_relief_search" model="ir.ui.view">
            <field name="name">fleet.vehicle.relief.search</field>
            <field name="model">fleet.vehicle.relief</field>
            <field name="arch" type="xml">
                <search string="Search Vehicle Relief">
                    <field name="reference"/>
                    <field name="original_vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="relief_vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="requester_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <filter string="My Requests" name="my_requests" domain="[('requester_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                    <separator/>
                    <filter string="High Priority" name="high_priority" domain="[('priority', '=', 'high')]"/>
                    <filter string="Urgent" name="urgent" domain="[('priority', '=', 'urgent')]"/>
                    <separator/>
                    <filter string="Request Date" name="request_date" date="request_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                        <filter string="Relief Reason" name="group_reason" context="{'group_by': 'relief_reason'}"/>
                        <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Request Date" name="group_date" context="{'group_by': 'request_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vehicle Relief Action -->
        <record id="action_fleet_vehicle_relief" model="ir.actions.act_window">
            <field name="name">Vehicle Relief</field>
            <field name="res_model">fleet.vehicle.relief</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No vehicle relief requests found
                </p>
                <p>
                    Create a vehicle relief request when a vehicle requires replacement.
                </p>
            </field>
        </record>

    </data>
</odoo>
