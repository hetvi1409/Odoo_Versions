<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Odometer Reading list View -->
        <record id="view_fleet_odometer_reading_list" model="ir.ui.view">
            <field name="name">fleet.odometer.reading.list</field>
            <field name="model">fleet.odometer.reading</field>
            <field name="arch" type="xml">
                <list string="Odometer Readings" decoration-danger="is_suspicious" decoration-success="verified">
                    <field name="reference"/>
                    <field name="reading_date"/>
                    <field name="vehicle_registration"/>
                    <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="odometer_reading"/>
                    <field name="distance_traveled"/>
                    <field name="reading_type"/>
                    <field name="fuel_level"/>
                    <field name="vehicle_condition" widget="badge"/>
                    <field name="verified" widget="boolean_toggle"/>
                    <field name="is_suspicious" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Odometer Reading Form View -->
        <record id="view_fleet_odometer_reading_form" model="ir.ui.view">
            <field name="name">fleet.odometer.reading.form</field>
            <field name="model">fleet.odometer.reading</field>
            <field name="arch" type="xml">
                <form string="Odometer Reading">
                    <header>
                        <button name="action_verify" string="Verify Reading" type="object"
                                class="oe_highlight" invisible="verified"/>
                        <field name="verified" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_photos" type="object" class="oe_stat_button" icon="fa-camera">
                                <field name="photo_count" widget="statinfo" string="Photos"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="reference" string="Odometer Reading"/>
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                            <field name="name" invisible="1"/>
                        </div>
                        <div invisible="not is_suspicious" class="alert alert-danger" role="alert">
                            <strong>Warning:</strong> <field name="warning_message" nolabel="1"/>
                        </div>
                        <group>
                            <group>
                                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="vehicle_registration"/>
                                <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="reading_date"/>
                                <field name="reading_type"/>
                            </group>
                            <group>
                                <field name="odometer_reading" class="oe_inline"/>
                                <field name="previous_reading" readonly="1"/>
                                <field name="distance_traveled" readonly="1"/>
                                <field name="location"/>
                                <field name="gps_coordinates"/>
                            </group>
                        </group>
                        <group>
                            <group string="Fuel Information">
                                <field name="fuel_level"/>
                                <field name="fuel_percentage"/>
                            </group>
                            <group string="Vehicle Condition">
                                <field name="vehicle_condition" widget="badge"/>
                                <field name="issues_noted" widget="boolean_toggle"/>
                                <field name="issue_description" invisible="not issues_noted" placeholder="Describe issues..."/>
                            </group>
                        </group>
                        <group>
                            <group string="Related Records">
                                <field name="trip_authority_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="maintenance_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            </group>
                            <group string="Verification">
                                <field name="verified_by_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="verification_date" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Administrative">
                                <field name="recorded_by_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="is_suspicious" invisible="1"/>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Photos" name="photos">
                                <field name="photo_ids" widget="many2many_binary" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Odometer Reading Kanban View -->
        <record id="view_fleet_odometer_reading_kanban" model="ir.ui.view">
            <field name="name">fleet.odometer.reading.kanban</field>
            <field name="model">fleet.odometer.reading</field>
            <field name="arch" type="xml">
                <kanban default_group_by="vehicle_id" class="o_kanban_small_column" quick_create="false">
                    <field name="reference"/>
                    <field name="reading_date"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="vehicle_registration"/>
                    <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="odometer_reading"/>
                    <field name="distance_traveled"/>
                    <field name="reading_type"/>
                    <field name="fuel_level"/>
                    <field name="vehicle_condition"/>
                    <field name="verified"/>
                    <field name="is_suspicious"/>
                    <field name="issues_noted"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click #{record.is_suspicious.raw_value ? 'oe_kanban_color_2' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="reference"/></strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <i class="fa fa-car"/> <field name="vehicle_registration"/>
                                        </span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a type="edit" role="menuitem" class="dropdown-item">Edit</a></li>
                                            <li><a type="delete" role="menuitem" class="dropdown-item">Delete</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="reading_date" widget="date"/>
                                    <div class="mt-1">
                                        <strong>Odometer:</strong> <field name="odometer_reading"/> km
                                    </div>
                                    <t t-if="record.distance_traveled.raw_value">
                                        <div>
                                            <strong>Distance:</strong> <field name="distance_traveled"/> km
                                        </div>
                                    </t>
                                    <div class="mt-1">
                                        <span class="badge badge-info">
                                            <field name="reading_type"/>
                                        </span>
                                        <span class="badge ms-1" t-attf-class="badge-#{record.vehicle_condition.raw_value == 'excellent' ? 'success' : record.vehicle_condition.raw_value == 'poor' ? 'danger' : 'warning'}">
                                            <field name="vehicle_condition"/>
                                        </span>
                                    </div>
                                    <t t-if="record.is_suspicious.raw_value">
                                        <div class="mt-1">
                                            <span class="badge badge-danger">
                                                <i class="fa fa-warning"/> Suspicious
                                            </span>
                                        </div>
                                    </t>
                                    <t t-if="record.issues_noted.raw_value">
                                        <div class="mt-1">
                                            <span class="badge badge-warning">
                                                <i class="fa fa-wrench"/> Issues Noted
                                            </span>
                                        </div>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <t t-if="record.verified.raw_value">
                                            <span class="badge badge-success" title="Verified">
                                                <i class="fa fa-check-circle"/>
                                            </span>
                                        </t>
                                        <t t-if="!record.verified.raw_value">
                                            <span class="badge badge-secondary" title="Unverified">
                                                <i class="fa fa-clock-o"/>
                                            </span>
                                        </t>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('res.partner', 'avatar_128', record.driver_id.raw_value)"
                                             t-att-title="record.driver_id.value" t-att-alt="record.driver_id.value"
                                             class="oe_kanban_avatar" style="width: 24px; height: 24px;"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Odometer Reading Search View -->
        <record id="view_fleet_odometer_reading_search" model="ir.ui.view">
            <field name="name">fleet.odometer.reading.search</field>
            <field name="model">fleet.odometer.reading</field>
            <field name="arch" type="xml">
                <search string="Search Odometer Readings">
                    <field name="reference"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <filter string="My Readings" name="my_readings" domain="[('recorded_by_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Unverified" name="unverified" domain="[('verified', '=', False)]"/>
                    <filter string="Verified" name="verified" domain="[('verified', '=', True)]"/>
                    <filter string="Suspicious" name="suspicious" domain="[('is_suspicious', '=', True)]"/>
                    <filter string="With Issues" name="with_issues" domain="[('issues_noted', '=', True)]"/>
                    <separator/>
                    <filter string="Reading Date" name="reading_date" date="reading_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                        <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                        <filter string="Reading Type" name="group_type" context="{'group_by': 'reading_type'}"/>
                        <filter string="Reading Date" name="group_date" context="{'group_by': 'reading_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Odometer Reading Action -->
        <record id="action_fleet_odometer_reading" model="ir.actions.act_window">
            <field name="name">Odometer Readings</field>
            <field name="res_model">fleet.odometer.reading</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_my_readings': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No odometer readings found
                </p>
                <p>
                    Record odometer readings to track vehicle usage and maintenance schedules.
                </p>
            </field>
        </record>

    </data>
</odoo>
