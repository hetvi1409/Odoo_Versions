<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Lost & Theft list View -->
        <record id="view_fleet_lost_theft_list" model="ir.ui.view">
            <field name="name">fleet.lost.theft.list</field>
            <field name="model">fleet.lost.theft</field>
            <field name="arch" type="xml">
                <list string="Lost &amp; Theft Reports" decoration-danger="incident_type=='theft'" decoration-warning="incident_type=='hijacking'">
                    <field name="reference"/>
                    <field name="incident_date"/>
                    <field name="incident_type" widget="badge"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="license_plate"/>
                    <field name="incident_location"/>
                    <field name="reported_by_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="police_reported" widget="boolean_toggle"/>
                    <field name="estimated_value" widget="monetary" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state=='resolved'"
                           decoration-info="state=='reported'"
                           decoration-warning="state in ('under_investigation','insurance_claimed')"/>
                </list>
            </field>
        </record>

        <!-- Lost & Theft Form View -->
        <record id="view_fleet_lost_theft_form" model="ir.ui.view">
            <field name="name">fleet.lost.theft.form</field>
            <field name="model">fleet.lost.theft</field>
            <field name="arch" type="xml">
                <form string="Lost &amp; Theft Report">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,reported,under_investigation,police_reported,resolved,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="reference" string="Lost/Theft Report"/>
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="incident_type" widget="badge"/>
                                <field name="incident_date"/>
                                <field name="discovered_date"/>
                            </group>
                            <group>
                                <field name="reported_by_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="reporter_phone"/>
                                <field name="reporter_email"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Incident Details" name="incident_details">
                                <group>
                                    <group string="Location">
                                        <field name="incident_location"/>
                                        <field name="incident_address"/>
                                        <field name="incident_coordinates"/>
                                        <field name="last_known_location"/>
                                    </group>
                                    <group string="Incident Information">
                                        <field name="vehicle_stolen"/>
                                        <field name="items_stolen"/>
                                        <field name="estimated_value" widget="monetary"/>
                                    </group>
                                </group>
                                <group string="Description">
                                    <field name="incident_description" nolabel="1" placeholder="Provide detailed description of the incident..."/>
                                </group>
                                <group string="Items Lost/Stolen">
                                    <field name="items_description" nolabel="1" placeholder="List all items that were lost or stolen..."/>
                                </group>
                                <group>
                                    <group string="Witness Information">
                                        <field name="witness_present"/>
                                        <field name="witness_details" invisible="not witness_present" placeholder="Names and contact details..."/>
                                    </group>
                                    <group string="Circumstances">
                                        <field name="circumstances" nolabel="1" placeholder="Circumstances leading to incident..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Vehicle Information" name="vehicle_info">
                                <group>
                                    <group string="Vehicle Details">
                                        <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="license_plate"/>
                                        <field name="vehicle_model"/>
                                        <field name="vehicle_vin"/>
                                        <field name="engine_number"/>
                                    </group>
                                    <group string="Vehicle Condition">
                                        <field name="odometer_reading"/>
                                        <field name="fuel_level"/>
                                        <field name="vehicle_keys_status"/>
                                        <field name="vehicle_documents_status"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Security Measures">
                                        <field name="was_vehicle_locked"/>
                                        <field name="alarm_fitted"/>
                                        <field name="was_alarm_active" invisible="not alarm_fitted"/>
                                        <field name="tracking_device_fitted"/>
                                        <field name="tracking_company" invisible="not tracking_device_fitted"/>
                                        <field name="tracking_reference" invisible="not tracking_device_fitted"/>
                                    </group>
                                    <group string="CCTV Footage">
                                        <field name="cctv_footage_available"/>
                                        <field name="cctv_footage_description" invisible="not cctv_footage_available" placeholder="Describe footage details..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Driver Information" name="driver_info">
                                <group>
                                    <group string="Driver">
                                        <field name="driver_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="driver_name"/>
                                        <field name="driver_contact"/>
                                        <field name="driver_license_number"/>
                                        <field name="was_driver_present"/>
                                    </group>
                                    <group string="Trip Details">
                                        <field name="trip_authority_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                        <field name="was_vehicle_in_use"/>
                                        <field name="trip_purpose" invisible="not was_vehicle_in_use" placeholder="Purpose of trip..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Police Report" name="police">
                                <group>
                                    <group string="Police Details">
                                        <field name="police_reported"/>
                                        <field name="police_station" invisible="not police_reported"/>
                                        <field name="police_case_number" invisible="not police_reported"/>
                                        <field name="police_officer_name" invisible="not police_reported"/>
                                        <field name="police_report_date" invisible="not police_reported"/>
                                    </group>
                                    <group string="Security at Incident Location">
                                        <field name="items_are_state_property" invisible="not police_reported"/>
                                        <field name="entrance_of_building" invisible="not police_reported"/>
                                        <field name="cupboard_locked" invisible="not police_reported"/>
                                        <field name="office_dor_locked" invisible="not police_reported"/>
                                        <field name="drawer_locked" invisible="not police_reported"/>
                                        <field name="cabinet_locked" invisible="not police_reported"/>
                                        <field name="safebox_locked" invisible="not police_reported"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Insurance" name="insurance">
                                <group>
                                    <group string="Insurance Details">
                                        <field name="insurance_notified"/>
                                        <field name="insurance_company"/>
                                        <field name="insurance_policy_number"/>
                                        <field name="insurance_claim_number"/>
                                    </group>
                                    <group string="Claim Details">
                                        <field name="insurance_claim_date"/>
                                        <field name="insurance_status"/>
                                        <field name="insurance_assessor"/>
                                        <field name="insurance_payout_amount" widget="monetary"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Investigation" name="investigation">
                                <group>
                                    <group string="Investigation">
                                        <field name="investigation_officer_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                    </group>
                                </group>
                                <group string="Investigation Notes">
                                    <field name="investigation_notes" nolabel="1" placeholder="Investigation notes and details..."/>
                                </group>
                                <group string="Investigation Findings">
                                    <field name="investigation_findings" nolabel="1" placeholder="Summary of investigation findings..."/>
                                </group>
                            </page>
                            <page string="Signatures" name="signatures">
                                <group>
                                    <field name="reporter_signature" widget="signature"/>
                                    <field name="fleet_manager_signature" widget="signature"/>
                                    <field name="transport_manager_signature" widget="signature"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Lost & Theft Kanban View -->
        <record id="view_fleet_lost_theft_kanban" model="ir.ui.view">
            <field name="name">fleet.lost.theft.kanban</field>
            <field name="model">fleet.lost.theft</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                    <field name="reference"/>
                    <field name="incident_date"/>
                    <field name="incident_type"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="license_plate"/>
                    <field name="incident_location"/>
                    <field name="state"/>
                    <field name="police_reported"/>
                    <field name="estimated_value"/>
                    <field name="vehicle_stolen"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="reference"/></strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <i class="fa fa-car"/> <field name="license_plate"/>
                                        </span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a type="edit" role="menuitem" class="dropdown-item">Edit</a></li>
                                            <li><a type="delete" role="menuitem" class="dropdown-item">Delete</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="incident_date" widget="date"/>
                                    <br/>
                                    <field name="incident_location"/>
                                    <div class="mt-1">
                                        <span class="badge" t-attf-class="badge-#{incident_type == 'theft' or incident_type == 'hijacking' ? 'danger' : 'warning'}">
                                            <field name="incident_type"/>
                                        </span>
                                        <t t-if="record.vehicle_stolen.raw_value">
                                            <span class="badge badge-danger ms-1">
                                                <i class="fa fa-exclamation-triangle"/> Vehicle Stolen
                                            </span>
                                        </t>
                                    </div>
                                    <t t-if="record.estimated_value.raw_value">
                                        <div class="mt-1">
                                            <strong>Value:</strong> R <field name="estimated_value" widget="float"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <t t-if="record.police_reported.raw_value">
                                            <span class="badge badge-info" title="Police Reported">
                                                <i class="fa fa-shield"/>
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Lost & Theft Search View -->
        <record id="view_fleet_lost_theft_search" model="ir.ui.view">
            <field name="name">fleet.lost.theft.search</field>
            <field name="model">fleet.lost.theft</field>
            <field name="arch" type="xml">
                <search string="Search Lost &amp; Theft Reports">
                    <field name="reference"/>
                    <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                    <field name="incident_location"/>
                    <filter string="My Reports" name="my_reports" domain="[('reported_by_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Reported" name="reported" domain="[('state', '=', 'reported')]"/>
                    <filter string="Under Investigation" name="investigation" domain="[('state', '=', 'under_investigation')]"/>
                    <filter string="Police Reported" name="police_reported_filter" domain="[('police_reported', '=', True)]"/>
                    <separator/>
                    <filter string="Theft" name="theft" domain="[('incident_type', '=', 'theft')]"/>
                    <filter string="Hijacking" name="hijacking" domain="[('incident_type', '=', 'hijacking')]"/>
                    <filter string="Lost" name="lost" domain="[('incident_type', '=', 'lost')]"/>
                    <filter string="Vehicle Stolen" name="vehicle_stolen_filter" domain="[('vehicle_stolen', '=', True)]"/>
                    <separator/>
                    <filter string="Incident Date" name="incident_date" date="incident_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Incident Type" name="group_type" context="{'group_by': 'incident_type'}"/>
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                        <filter string="Incident Date" name="group_date" context="{'group_by': 'incident_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Lost & Theft Action -->
        <record id="action_fleet_lost_theft" model="ir.actions.act_window">
            <field name="name">Lost &amp; Theft Reports</field>
            <field name="res_model">fleet.lost.theft</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_my_reports': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No lost or theft reports found
                </p>
                <p>
                    Create a lost/theft report to document incidents involving missing or stolen vehicles and items.
                </p>
            </field>
        </record>

    </data></odoo>