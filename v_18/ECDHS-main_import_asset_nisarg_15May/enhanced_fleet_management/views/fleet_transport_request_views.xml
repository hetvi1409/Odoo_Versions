<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Transport Request list View -->
    <record id="view_fleet_transport_request_list" model="ir.ui.view">
        <field name="name">fleet.transport.request.list</field>
        <field name="model">fleet.transport.request</field>
        <field name="arch" type="xml">
            <list string="Transport Requests" decoration-success="state=='completed'"
                  decoration-danger="state=='cancelled'" decoration-info="state=='approved'">
                <field name="reference"/>
                                <field name="requester_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="date_required"/>
                <field name="destination"/>
                                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="state" widget="badge"
                       decoration-success="state in ['approved', 'completed']"
                       decoration-warning="state=='submitted'"
                       decoration-info="state in ['vehicle_assigned', 'in_progress']"/>
                <field name="priority" widget="priority"/>
            </list>
        </field>
    </record>

    <!-- Transport Request Form View -->
    <record id="view_fleet_transport_request_form" model="ir.ui.view">
        <field name="name">fleet.transport.request.form</field>
        <field name="model">fleet.transport.request</field>
        <field name="arch" type="xml">
            <form string="Transport Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve_manager" string="Approve (Manager)" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="enhanced_fleet_management.group_fleet_manager"/>
                    <button name="action_approve_fleet" string="Assign Vehicle &amp; Approve" type="object"
                            class="oe_highlight" invisible="state != 'approved'"
                            groups="enhanced_fleet_management.group_fleet_manager"/>
                    <button name="action_start_trip" string="Start Trip" type="object"
                            invisible="state != 'vehicle_assigned'"/>
                    <button name="action_complete" string="Complete" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['completed', 'cancelled']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"
                            groups="enhanced_fleet_management.group_fleet_manager"/>
                    <button name="action_print_request" string="Print Request" type="object" icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,vehicle_assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_trip_authority)d" type="action"
                                class="oe_stat_button" icon="fa-car"
                                invisible="not trip_authority_id"
                                context="{'default_transport_request_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Trip</span>
                                <span class="o_stat_text">Authority</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="purpose" placeholder="Purpose of trip..." readonly="state != 'draft'"/>
                        </h2>
                    </div>
                    <group>
                        <group name="requester_info" string="Requester Information">
                            <field name="requester_id" readonly="state != 'draft'"
                                options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="employee_id" readonly="1"
                                options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="department_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="job_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group name="trip_details" string="Trip Details">
                            <field name="date_required" readonly="state != 'draft'"/>
                            <field name="time_required" widget="float_time" readonly="state != 'draft'"/>
                            <field name="transport_type" readonly="state != 'draft'"/>
                            <field name="return_date" invisible="transport_type == 'one_way'" readonly="state != 'draft'"/>
                            <field name="return_time" widget="float_time" invisible="transport_type == 'one_way'" readonly="state != 'draft'"/>
                            <field name="duration_days" invisible="transport_type == 'one_way'"/>
                            <field name="is_urgent"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group>
                        <group name="location_info" string="Location &amp; Distance">
                            <field name="pickup_location" readonly="state != 'draft'"/>
                            <field name="destination" readonly="state != 'draft'"/>
                            <field name="distance_km"/>
                        </group>
                        <group name="passengers" string="Passengers">
                            <field name="number_of_passengers" readonly="state != 'draft'"/>
                            <field name="passenger_names" readonly="state != 'draft'"/>
                            <field name="passenger_id_documents" filename="passenger_id_filenames"
                                string="Passenger ID Documents" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group name="vehicle_assignment" string="Vehicle Assignment" invisible="state == 'draft'">
                            <field name="vehicle_id" readonly="state not in ['approved']"
                                options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="driver_id" readonly="state not in ['approved']" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                        </group>
                        <group name="approval" string="Approval Details" invisible="state == 'draft'">
                            <field name="manager_id" readonly="1" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="manager_approval_date" readonly="1" invisible="not manager_approval_date"/>
                            <field name="fleet_manager_id" readonly="1" invisible="state not in ['vehicle_assigned', 'in_progress', 'completed']" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="fleet_approval_date" readonly="1" invisible="not fleet_approval_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="additional_info" string="Additional Information">
                            <group>
                                <field name="special_requirements" nolabel="1" placeholder="Any special requirements..."/>
                                <field name="manager_comments" nolabel="1" placeholder="Manager comments..." readonly="1"/>
                                <field name="fleet_manager_comments" nolabel="1" placeholder="Fleet manager comments..." readonly="1"/>
                            </group>
                        </page>
                        <page name="checklists" string="Vehicle Checklists" invisible="not vehicle_checklist_ids">
                            <field name="vehicle_checklist_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="inspection_type"/>
                                    <field name="inspection_date"/>
                                    <field name="overall_condition" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Transport Request Kanban View -->
    <record id="view_fleet_transport_request_kanban" model="ir.ui.view">
        <field name="name">fleet.transport.request.kanban</field>
        <field name="model">fleet.transport.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="reference"/>
                <field name="requester_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="date_required"/>
                <field name="destination"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="is_urgent"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="reference"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                    <t t-if="record.is_urgent.raw_value">
                                        <span class="badge badge-danger">Urgent</span>
                                    </t>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="destination"/>
                                <div class="text-muted">
                                    <i class="fa fa-user"/> <field name="requester_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar"/> <field name="date_required"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Transport Request Search View -->
    <record id="view_fleet_transport_request_search" model="ir.ui.view">
        <field name="name">fleet.transport.request.search</field>
        <field name="model">fleet.transport.request</field>
        <field name="arch" type="xml">
            <search string="Transport Requests">
                <field name="reference"/>
                <field name="requester_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="destination"/>
                <field name="vehicle_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <field name="department_id" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="Urgent" name="urgent"
                        domain="[('is_urgent', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <separator/>
                <filter string="This Week" name="this_week"
                        domain="[('date_required', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date_required', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Date Required" name="group_date" context="{'group_by': 'date_required'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Transport Request Action -->
    <record id="action_fleet_transport_request" model="ir.actions.act_window">
        <field name="name">Transport Requests</field>
        <field name="res_model">fleet.transport.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Transport Request
            </p>
            <p>
                Submit a request for vehicle transport. Your request will be reviewed
                and approved by your manager and the fleet manager.
            </p>
        </field>
    </record>

</odoo>
