<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_charter_wizard_revert_view_form" model="ir.ui.view">
        <field name="name">audit.charter.wizard.revert.view.form</field>
        <field name="model">internal.audit.charter.wizard</field>
        <field name="arch" type="xml">
            <form create="0" duplicate="0">
                <header>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="comments"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit_revert"
                            string="Revert"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>