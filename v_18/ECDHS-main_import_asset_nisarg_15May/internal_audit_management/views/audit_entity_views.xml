<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_entity_type" model="ir.actions.act_window">
        <field name="name">Entity Type</field>
        <field name="res_model">entity.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Audit Universe
            </p>
            <p>
                Create and manage the Audit Universe;
            </p>
        </field>
    </record>
    <record id="entity_type_view_tree" model="ir.ui.view">
        <field name="name">entity.type.view.tree</field>
        <field name="model">entity.type</field>
        <field name="arch" type="xml">
            <list string="Team" class="o_enquiry" editable="bottom"
                  duplicate="0">
                <field name="name"/>
            </list>
        </field>
    </record>
    <menuitem id="entity_type_menu"
              name="Entity Type"
              parent="internal_audit_management.menu_internal_audit_config"
              action="action_entity_type"
              sequence="20"/>
</odoo>