<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_audit_strategy" model="ir.actions.act_window">
        <field name="name">Audit Strategy</field>
        <field name="res_model">audit.strategy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Strategy
            </p>
            <p>
                Create and manage the Audit Strategy;
            </p>
        </field>
    </record>
    <record id="audit_strategy_view_form" model="ir.ui.view">
        <field name="name">audit.strategy.view.form</field>
        <field name="model">audit.strategy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object" invisible="state != 'preparer' or uid not in user_reviewer_1_ids" string="1st Review" class="oe_highlight"/>
                    <button name="action_2nd_review" type="object" invisible="state != 'first_reviewer' or uid not in user_reviewer_2_ids" string="2nd Review" class="oe_highlight"/>
                    <button name="action_revert" type="object" invisible="state != 'first_reviewer' or uid not in user_reviewer_2_ids or state != 'first_reviewer'" string="Revert" class="oe_highlight"/>
                    <button name="action_approve" type="object" invisible="state != 'second_reviewer' or uid not in user_approver_ids" string="Approve" class="oe_highlight"/>
                    <button name="action_reject" type="object" invisible="state != 'second_reviewer' or uid not in user_approver_ids" string="Reject" class="oe_highlight"/>
                    <button name="action_update" type="object"
                            invisible="state != 'reverted' or uid not in user_preparer_ids"
                            string="Updated" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"
                                   readonly="state in ['approved', 'rejected']"/>
                            <field name="requirements"
                                   readonly="state in ['approved', 'rejected']"/>
                            <field name="user_id"
                                   readonly="state in ['approved', 'rejected']"/>
                            <field name="record_work_done"
                                   readonly="state in ['approved', 'rejected']"/>
                            <field name="conclusion"
                                   readonly="state in ['approved', 'rejected']"/>
                        </group>
                        <group>
                            <field name="user_ids" invisible="1"/>
                            <field name="team_id"
                                   readonly="state in ['approved', 'rejected']"/>
                            <field name="user_preparer_ids"
                                   widget="many2one_avatar_user"/>
<!--                            <field name="user_reviewer_1_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   readonly="state == 'approved'"/>-->
<!--                            <field name="user_reviewer_2_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   readonly="state == 'approved'"/>-->
<!--                            <field name="user_approver_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   readonly="state == 'approved'"/>-->
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"
                               readonly="state in ['approved', 'rejected']"/>
                        <field name="feedback"
                               invisible="state not in ['reverted']"/>
                    </group>
                    <notebook>
                        <page string="Tracking"
                              name="audit_strategy_tracking_ids">
                            <field name="audit_strategy_tracking_ids"
                                   options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}">
                                <list editable="bottom" create="0" edit="0">
                                    <field name="user_id"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="comment"/>
                                    <field name="date"/>
                                </list>
                               </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="audit_strategy_view_tree" model="ir.ui.view">
        <field name="name">audit.strategy.view.form</field>
        <field name="model">audit.strategy</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="requirements"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('preparer')"
                       decoration-warning="state in ('reverted')"
                       decoration-success="state in ('approved')"/>
            </list>
        </field>
    </record>
    <menuitem id="audit_strategy_menu"
              name="Audit Strategy"
              parent="internal_audit_management.high_level_documents_menu"
              action="action_audit_strategy"
              sequence="20"/>
</odoo>
