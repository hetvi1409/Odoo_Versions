<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_audit_assignment_category" model="ir.actions.act_window">
        <field name="name">Assignment Category</field>
        <field name="res_model">audit.assignment.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Assignment Category
            </p>
            <p>
                Create and manage the Assignment Categories;
            </p>
        </field>
    </record>
    <record id="audit_assignment_category_view_tree" model="ir.ui.view">
        <field name="name">audit.assignment.category.view.form</field>
        <field name="model">audit.assignment.category</field>
        <field name="arch" type="xml">
            <list duplicate="0" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <menuitem id="audit_assignment_category_menu"
              name="Assignment Category"
              parent="internal_audit_management.menu_internal_audit_config"
              action="action_audit_assignment_category"
              sequence="7"/>
</odoo>