<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_audit_methodology" model="ir.actions.act_window">
        <field name="name">Internal Audit Methodology</field>
        <field name="res_model">audit.methodology</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Methodology
            </p>
            <p>
                Create and manage the Internal Audit Methodology and other
                information;
            </p>
        </field>
    </record>
    <record id="audit_methodology_view_form" model="ir.ui.view">
        <field name="name">audit.methodology.view.form</field>
        <field name="model">audit.methodology</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!--                    <button name="action_review" type="object"-->
                    <!--                            invisible="state != 'new'"-->
                    <!--                            string="Review" class="oe_highlight"/>-->
                    <button name="action_review" type="object"
                            invisible="state != 'new' or uid not in user_reviewer_ids"
                            string="Review" class="oe_highlight"/>
                    <button name="action_approve" type="object"
                            invisible="state != 'review' or uid not in user_approver_ids"
                            string="Approve" class="oe_highlight"/>
                    <button name="action_mark_discrepancy" type="object"
                            invisible="state != 'review' or uid not in user_approver_ids"
                            string="Refuse"/>
                    <button name="action_send_back_review" type="object"
                            invisible="state != 'refuse'"
                            string="Move To Review" class="oe_highlight"/>
                    <button name="action_send_back_new" type="object"
                            invisible="state != 'refuse'"
                            string="Move To New" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="financial_year_id"/>
                            <field name="name"
                                   readonly="state in ['approve', 'refuse']"/>
                            <!--                            <field name="requirements"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                            <!--                            <field name="record_work_done"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                            <!--                            <field name="conclusion"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                        </group>
                        <group>
                            <field name="team_id"
                                   readonly="state in ['approve', 'refuse']"/>
                            <!--                            <field name="user_id"-->
                            <!--                                   domain="[('id', 'in', user_ids)]"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                            <!--                            <field name="team_reviewer_id"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                            <!--                            <field name="user_reviewer_id"-->
                            <!--                                   domain="[('id', 'in', user_reviewer_ids)]"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                            <!--                            <field name="team_approver_id"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                            <field name="user_ids" widget="many2many_tags"
                                   invisible="0"/>
                            <field name="user_reviewer_ids"
                                   widget="many2many_tags" invisible="0"/>
                            <field name="user_approver_ids"
                                   widget="many2many_tags" invisible="0"/>
                            <!--                            <field name="role_id" domain="[('team_id', '=', team_id)]"-->
                            <!--                                   readonly="state in ['approve', 'refuse']"/>-->
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"
                               readonly="state in ['approve', 'refuse']"/>
                        <field name="feedback"
                               readonly="state not in ['refuse']"/>
                    </group>
                    <notebook>
                        <page string="Document Name">
                            <group>
                                <field name="document_ids"
                                       widget="many2many_binary">
                                </field>
                            </group>
                        </page>
<!--                        <page string="Comments">-->
<!--                            <field name="comment_ids"-->
<!--                                   readonly="state not in ['new']">-->
<!--                                <tree editable="bottom">-->
<!--                                    <field name="name"/>-->
<!--                                </tree>-->
<!--                            </field>-->
<!--                        </page>-->
                        <page string="Internal Audit Methodology Template">
                            <div class="d-flex justify-content-end">
                                <button name="action_edit_note"
                                        type="object"
                                        invisible="not note_id"
                                        string="Edit"
                                        class="btn btn-primary oe_rightalign"/>
                                <button name="action_create_note"
                                        type="object"
                                        invisible="note_id != False"
                                        string="Create"
                                        class="btn btn-primary oe_rightalign"/>
                            </div>
                            <group>
                                <field name="note_id" invisible="1"/>
                                <field name="notes"/>
                            </group>
                        </page>

                        <!--                        <page string="Tracking"-->
<!--                              name="audit_methodology_tracking">-->
<!--                            <field name="audit_methodology_tracking_ids"-->
<!--                                   options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}">-->
<!--                                <tree editable="bottom" create="0" edit="0">-->
<!--                                    <field name="user_id"/>-->
<!--                                    <field name="previous_stage_id"/>-->
<!--                                    <field name="new_stage_id"/>-->
<!--                                    <field name="comment"/>-->
<!--                                    <field name="date"/>-->
<!--                                </tree>-->
<!--                                &lt;!&ndash;                                <form>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                    <group>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                        <field name="section"/>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                        <field name="user_id"/>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                        <field name="previous_stage_id"/>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                        <field name="new_stage_id"/>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                        <field name="comment"/>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                        <field name="date"/>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                    </group>&ndash;&gt;-->
<!--                                &lt;!&ndash;                                </form>&ndash;&gt;-->
<!--                            </field>-->
<!--                        </page>-->

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="audit_methodology_view_tree" model="ir.ui.view">
        <field name="name">audit.methodology.view.form</field>
        <field name="model">audit.methodology</field>
        <field name="arch" type="xml">
            <list string="Methodology" duplicate="0">
                <field name="financial_year_id"/>
                <field name="team_id"/>
                <field name="user_ids" widget="many2many_tags"
                       invisible="0"/>
                <field name="user_reviewer_ids"
                       widget="many2many_tags" invisible="0"/>
                <field name="user_approver_ids"
                       widget="many2many_tags" invisible="0"/>
                <field name="approved_date"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('new')"
                       decoration-warning="state in ('review')"
                       decoration-success="state in ('approve')"/>
            </list>
        </field>
    </record>

    <record id="action_audit_methodology_note" model="ir.actions.act_window">
        <field name="name">Audit Methodology Report</field>
        <field name="res_model">audit.methodology.note</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Methodology Report
            </p>
            <p>
                Create and manage the Internal Audit Methodology Report;
            </p>
        </field>
    </record>
    <record id="audit_methodology_note_view_form" model="ir.ui.view">
        <field name="name">audit.methodology.note.view.form</field>
        <field name="model">audit.methodology.note</field>
        <field name="arch" type="xml">
            <form string="Methodology" duplicate="0">
                <header>
                    <button name="action_review" type="object"
                            invisible="state != 'new' or uid not in user_reviewer_ids"
                            string="Review" class="oe_highlight"/>
                    <button name="action_approve" type="object"
                            invisible="state != 'review' or uid not in user_approver_ids"
                            string="Approve" class="oe_highlight"/>
                    <button name="action_mark_discrepancy" type="object"
                            invisible="state != 'review' or uid not in user_approver_ids"
                            string="Refuse"/>
                    <button name="action_send_back_review" type="object"
                            invisible="state != 'refuse'"
                            string="Move To Review" class="oe_highlight"/>
                    <button name="action_send_back_new" type="object"
                            invisible="state != 'refuse'"
                            string="Move To New" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="audit_methodology_id"
                                   readonly="state != 'new'"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="team_reviewer_id"
                                   readonly="state != 'new'"/>
<!--                            <field name="team_approver_id"-->
<!--                                   readonly="state != 'new'"/>-->
                            <field name="approver_id"/>
                            <field name="user_reviewer_ids"
                                   widget="many2many_tags" invisible="0"/>
                            <field name="user_approver_ids"
                                   widget="many2many_tags" invisible="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="audit_methodology_note_view_tree" model="ir.ui.view">
        <field name="name">audit.methodology.note.view.tree</field>
        <field name="model">audit.methodology.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="audit_methodology_id"/>
                <field name="create_uid"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('new')"
                       decoration-warning="state in ('review', 'refuse')"
                       decoration-success="state in ('approve')"/>
            </list>
        </field>
    </record>
    <menuitem id="audit_methodology_menu" name="Overall Internal Audit Methodology" parent="high_level_documents_menu" action="action_audit_methodology" sequence="2"/>
</odoo>