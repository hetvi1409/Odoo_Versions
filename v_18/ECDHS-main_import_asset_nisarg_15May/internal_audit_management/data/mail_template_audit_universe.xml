<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_audit_universe_to_review" model="mail.template">
        <field name="name">Audit Universe</field>
        <field name="model_id"
               ref="internal_audit_management.model_audit_universe"/>
        <field name="subject">Audit Universe : Review</field>
        <field name="description">send to the users.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi
                    <br/>
                    Audit Universe was created
                    <b>
                        <t t-out="object.period"/>
                    </b>Please review this.
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_list_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        <t>
                            Open
                            <t t-out="object.period"/>
                        </t>
                    </a>
                </div>
            </div>
        </field>
    </record>

