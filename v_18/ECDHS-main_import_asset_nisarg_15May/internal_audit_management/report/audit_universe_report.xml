<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="internal_audit_method_report_action" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">audit.universe</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.audi_universe_report</field>
        <field name="report_file">internal_audit_management.audi_universe_report</field>
        <field name="binding_model_id" ref="model_audit_universe"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Audit Universe - %s' % object.name
        </field>
    </record>

    <template id="audi_universe_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="col-xs-4" style="padding:0;">
                            <center>
                                <h2 t-esc="doc.name"/>
                            </center>

                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Sequence No:</strong>
                                    </td>
                                    <td>
                                        <t t-esc="doc.sequence_no"/>
                                    </td>
                                    <td>
                                        <strong>Period:</strong>
                                    </td>
                                    <td>
                                        <t t-esc="doc.period"/>
                                    </td>
                                    <td>
                                        <strong>State:</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.stages"/>
                                    </td>
                                </tr>
                            </table>
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Start Date:</strong>
                                    </td>
                                    <td>
                                        <t t-esc="doc.start_date"/>
                                    </td>
                                    <td>
                                        <strong>End Date:</strong>
                                    </td>
                                    <td>
                                        <t t-esc="doc.end_date"/>
                                    </td>
                                    <td>
                                        <strong>Preparer:</strong>
                                    </td>
                                    <td>
                                        <t t-foreach="doc.user_preparer_ids"
                                           t-as="preparer">
                                            <span t-field="preparer.name"/>,
                                        </t>
                                    </td>
                                </tr>
                            </table>
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>First Reviewer:</strong>
                                    </td>
                                    <td>
                                        <t t-foreach="doc.user_reviewer_1_ids"
                                           t-as="user">
                                            <span t-field="user.name"/>,
                                        </t>
                                    </td>
                                    <td>
                                        <strong>Second Reviewer:</strong>
                                    </td>
                                    <td>
                                        <t t-foreach="doc.user_reviewer_2_ids"
                                           t-as="user">
                                            <span t-field="user.name"/>,
                                        </t>
                                    </td>
                                    <td>
                                        <strong>Approver:</strong>
                                    </td>
                                    <td>
                                        <t t-foreach="doc.user_approver_ids"
                                           t-as="user">
                                            <span t-field="user.name"/>,
                                        </t>
                                    </td>
                                </tr>
                            </table>
                            <center>
                                <h4>Lines</h4>
                            </center>
                            <t t-if="doc.audit_line_ids">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Number</th>
                                            <th>Process / Activity</th>
                                            <th>Department</th>
                                            <th>Head Of Department</th>
                                            <th>Unit</th>
                                            <th>Unit Head</th>
                                            <th>Identifiable Area Of Audit
                                                Interest
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.audit_line_ids"
                                            t-as="line">
                                            <td>
                                                <t t-esc="line.sequence"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.activity"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.department_id.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.department_head_id.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.unit.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.unit_head.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.audit_interest"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <center>
                                <h4>Revert Details</h4>
                            </center>
                            <t t-if="doc.feedback">
                                <table class="table table-striped align_center">
                                    <tr>
                                        <td>
                                            <strong>Feedback:</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.feedback"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                            <t t-set="reverts"
                               t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                            <t t-if="reverts">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Revert Name</th>
                                            <th>Created Date</th>
                                            <th>Review Comments</th>
                                            <th>Audit Proposal</th>
                                            <th>State</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="reverts" t-as="revert">
                                            <td>
                                                <t t-esc="revert.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="revert.date"/>
                                            </td>
                                            <td>
                                                <t t-esc="revert.comments"/>
                                            </td>
                                            <td>
                                                <t t-esc="revert.audit_findings"/>
                                            </td>
                                            <td>
                                                <span t-field="revert.state"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
