<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_action_plan_report_action" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">audit.action.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.audit_action_plan_report</field>
        <field name="report_file">internal_audit_management.audit_action_plan_report</field>
        <field name="binding_model_id" ref="model_audit_action_plan"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s' % object.name</field>
    </record>

    <template id="audit_action_plan_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <table style="width:100%; border-collapse: collapse;">
                            <tr>
                                <td>
                                    <strong>Type:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.type"/>
                                </td>
                                <td>
                                    <strong>Preparer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_preparer_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Requirements:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.requirements"/>
                                </td>
                                <td>
                                    <strong>First Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_1_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Responsible User:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_id.name"/>
                                </td>
                                <td>
                                    <strong>Second Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_2_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Team:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.team_id.name"/>
                                </td>
                                <td>
                                    <strong>Approver:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_approver_ids.name"/>
                                </td>

                            </tr>
                            <tr>
                                <td>
                                    <strong>Work Done:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.record_work_done"/>
                                </td>
                                <td>
                                    <strong>Conclusion:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.conclusion"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Audit Finding:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.finding"/>
                                </td>
                                <td>
                                    <strong>Auditor's Impact:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.impact"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Auditor's Recommendation:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.recommendation"/>
                                </td>
                                <td>
                                    <strong>Section:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.section"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.reviewer"/>
                                </td>
                                <td>
                                    <strong>Targeted Completion Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.completion_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Resolved:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.resolved"/>
                                </td>
                                <td>
                                    <strong>Auditor's Rating:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.rating"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Auditor's Internal Control Deficiency:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.deficiency"/>
                                </td>
                                <td>
                                    <strong>Department:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.department_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Start Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.start_date"/>
                                </td>
                                <td>
                                    <strong>Manager:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.manager_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Project:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.project_id.name"/>
                                </td>
                                <td>
                                    <strong>Project Task:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.project_task.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Audit Type:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.audit_type"/>
                                </td>
                                <td>
                                    <strong>Blockages:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.blockages"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Proposed Revised Completion Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.proposed_completion_date"/>
                                </td>
                                <td>
                                    <strong>Auditor's Conclusion:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.auditor_conclusion"/>
                                </td>
                            </tr>
                        </table>

                        <center>
                            <h4>Revert Details</h4>
                        </center>
                        <t t-if="doc.feedback">
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Feedback:</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.feedback"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <t t-set="reverts"
                           t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                        <t t-if="reverts">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Revert Name</th>
                                        <th>Created Date</th>
                                        <th>Review Comments</th>
                                        <th>Audit Proposal</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="reverts"
                                        t-as="revert">
                                        <td>
                                            <t t-esc="revert.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.date"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.comments"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.audit_findings"/>
                                        </td>
                                        <td>
                                            <span t-field="revert.state"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
