                            <h4 class="mb-3" style="text-align:right;">Memo
                            </h4>
                        </t>
                        <t t-if="memo.submission_type == 'circular'">
                            <h4 class="mb-3" style="text-align:right;">Circular
                            </h4>
                        </t>
                        <t t-if="memo.submission_type == 'procurement'">
                            <h4 class="mb-3" style="text-align:right;">Procurement
                            </h4>
                        </t>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <img src="/e_system/static/description/line.png" style="height:5px;width: 850px;"/>
                    </div>
