<odoo>
    <template id="report_memo_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="memo">
                <!-- Custom External Layout Start -->
                <div class="header o_company_custom_layout" style="padding-top: 5px;">
                    <t t-set="company" t-value="memo.company_id"/>
