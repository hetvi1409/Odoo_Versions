        <record id="memo_record_rule_view" model="ir.rule">
            <field name="name">Memo - Record View</field>
            <field name="model_id" ref="e_system.model_memo_memo"/>
            <field name="active" eval="False"/>
            <field name="groups"
                   eval="[(4, ref('group_memo_requester')),(4, ref('group_memo_quality_assurance')),(4, ref('group_memo_recommenders')),(4, ref('e_system.group_memo_approver')),(4, ref('base.group_user'))]"/>
            <!--            <field name="domain_force">user.id in [1, 2] and [(1, '=', 1)] or ['|', ('create_uid','=', user.id), '|',-->
            <!--                ('requester_id','=', user.id), '|', ('approver_id','=', user.id), '|',-->
            <!--                ('quality_assurance_ids.user_id','=', user.id),('recommender_ids.user_id','=', user.id) ]-->
            <!--            </field>-->
            <field name="domain_force">user.id in [1, 2] and [(1, '=', 1)] or ['|',('create_uid','=',
                user.id),'|',('requester_id','=', user.id),'|',('approver_id','=',
                user.id),'|',('quality_assurance_ids.user_id','=', user.id),'|',('recommender_ids.user_id','=',
                user.id),('acknowledged_ids','in', [user.id])]
            </field>
        </record>

        <record id="memo_rule_turn_based_access" model="ir.rule">
            <field name="name">Memo: turn-based access</field>
            <field name="model_id" ref="e_system.model_memo_memo"/>
            <field name="groups"
                   eval="[(4, ref('group_memo_requester')),(4, ref('group_memo_quality_assurance')),(4, ref('group_memo_recommenders')),(4, ref('e_system.group_memo_approver')),(4, ref('base.group_user'))]"/>
            <!-- let superusers bypass (adapt IDs if your DB differs) -->
            <field name="domain_force">user.id in [1, 2] and [(1,'=',1)] or ['|','|','|',('create_uid','=',
                user.id),('requester_id','=', user.id),('allowed_user_ids','in', [user.id]),('message_partner_ids', 'in', [user.partner_id.id])]
            </field>
        </record>

