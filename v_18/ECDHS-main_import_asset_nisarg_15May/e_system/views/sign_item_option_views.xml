<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action window for Sign Item Options -->
    <record id="sign_item_option_action_config" model="ir.actions.act_window">
        <field name="name">Sign Item Options</field>
        <field name="res_model">sign.item.option</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sign item options defined yet.
            </p>
            <p>
                Create selection field options that can be used in signable documents.
            </p>
        </field>
    </record>

    <!-- Menu item under Digital Signature > Configuration -->
    <menuitem
        id="sign_item_option_menu"
        name="Sign Item Options"
        parent="sign.menu_sign_configuration"
        action="sign_item_option_action_config"
        sequence="50"
        groups="sign.group_sign_manager,base.group_system"/>

</odoo>
