<odoo>
    <!-- Form View -->
    <record id="view_sign_item_role_form_inherit" model="ir.ui.view">
        <field name="name">sign.item.role.form.inherit.user</field>
        <field name="model">sign.item.role</field>
        <field name="inherit_id" ref="sign.sign_item_role_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="user_id"/>
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_sign_item_role_list_inherit" model="ir.ui.view">
        <field name="name">sign.item.role.list.inherit.user</field>
        <field name="model">sign.item.role</field>
        <field name="inherit_id" ref="sign.sign_item_role_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="user_id"/>
            </xpath>
        </field>
    </record>
</odoo>
