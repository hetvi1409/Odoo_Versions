<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Website Menu: Home -->
        <record id="menu_home" model="website.menu">
            <field name="name">Home</field>
            <field name="url">/</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">1</field>
        </record>
        <!-- Website Menu: About Us -->
        <record id="menu_mec" model="website.menu">
            <field name="name">MEC</field>
            <field name="url">/mec</field>
            <field name="sequence">20</field>
        </record>
        <record id="menu_hod" model="website.menu">
            <field name="name">HOD</field>
            <field name="url">/hod</field>
            <field name="sequence">3</field>
        </record>

        <record id="menu_about_us" model="website.menu">
            <field name="name">About Us</field>
            <field name="url">/about-us</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">2</field>
            <field name="child_id" eval="[
                ref('custom_website_design.menu_mec'),
                ref('custom_website_design.menu_hod'),
            ]"/>
        </record>

        <!-- Website Menu: Products (Dropdown) -->
        <record id="menu_products" model="website.menu">
            <field name="name">Products</field>
            <field name="url">#</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">3</field>
        </record>

        <!-- Website Menu: News (Dropdown) -->
        <record id="menu_news" model="website.menu">
            <field name="name">News</field>
            <field name="url">#</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">4</field>
        </record>

        <!-- Website Menu: Documents Library (Dropdown) -->
        <record id="menu_documents_library" model="website.menu">
            <field name="name">Documents Library</field>
            <field name="url">#</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">5</field>
        </record>

        <!-- Website Menu: Gallery -->
        <record id="menu_gallery" model="website.menu">
            <field name="name">Gallery</field>
            <field name="url">/gallery</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">6</field>
        </record>

        <!-- Website Menu: Tenders -->
        <record id="menu_tenders" model="website.menu">
            <field name="name">Tenders</field>
