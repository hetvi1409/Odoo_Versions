        </record>

        <!-- Website Menu: Careers -->
        <record id="menu_careers" model="website.menu">
            <field name="name">Careers</field>
            <field name="url">/careers</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">9</field>
        </record>

