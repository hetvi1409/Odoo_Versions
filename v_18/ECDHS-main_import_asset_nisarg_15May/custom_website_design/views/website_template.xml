<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_header_stretch_eastern" inherit_id="website.template_header_stretch"
              name="Template Header Stretch Custom">
        <xpath expr="//t[@t-call='website.navbar']" position="before">
            <div id="top-header" class=""
                 style="top: 0;left: 0;right: 0;background-color: #009933;line-height: 1em;font-size: 12px;z-index: 100000;color: #fff;margin: 0;padding: 0;border: 0;outline: 0;-webkit-text-size-adjust: 100%;vertical-align: baseline;">
                <div class="container clearfix"
                     style="line-height: 1em;padding-top: .75em;font-weight: 600;    text-align: left;position: relative;    width: 80%;max-width: 1080px;margin: auto;">
                    <div id="et-info" style="line-height: 1em;padding-bottom: .75em;display: block;float: left;">
                        <span id="et-info-phone" style="margin-right: 13px;position: relative;">Customer Care: 086 000
                            0039 / sms: 43619
                        </span>
                        <a href="mailto:info@ecdhs.gov.za" style="color: #fff;text-decoration: none;">
                            <span id="et-info-email" style="position: relative;">info@ecdhs.gov.za</span>
                        </a>
                    </div> <!-- #et-info -->

                    <div id="et-secondary-menu"></div> <!-- #et-secondary-menu -->
                </div> <!-- .container -->
            </div>
        </xpath>
        <xpath expr="//t[@t-call='website.submenu']/t[@t-set='item_class']" position="attributes">
            <attribute name="t-valuef">nav-item h-100 o_border_contrast</attribute>
        </xpath>
    </template>


</odoo>