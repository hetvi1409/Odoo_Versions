<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="oi_risk_management.control_assessment_view_list">
        <field name="name">oi_risk_management.risk.view.list</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" />
                <field name="name" string="Risk Name" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="oi_risk_management.control_assessment_view_form">
        <field name="name">oi_risk_management.risk.view.form</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>

                    <group>
                        <h1 class="font-weight-bold text-center my-2" style="color: #666" colspan="2">Control Assessment</h1>
                    </group>
                    <group>
                        <group>
                            <field name="activity_id" string="Risk Factor" readonly="1"/>
                            <field name="factor_sequence"/>
                        </group>
                        <group>
                            <field name="name" string="Risk Name"
                                   readonly="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="evaluation" string="Control Assessment">
                            <group string="Current Control" colspan="2">
                                <field name="current_control_ids" nolabel="1">
                                    <list editable="bottom" default_order="sequence">
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
<!--                                        <button name="action_view_documents" type="object"-->
<!--                                                string="Open Document"-->
<!--                                                class="float-right btn-primary"-->
<!--                                                invisible="not attachment_ids"/>-->
                                    </list>
                                </field>
                            </group>
                            <group>
                                <group string="Control Effectiveness">
                                    <field name="main_risk_total_score"/>
                                    <field name="control_effectiveness_id"
                                           string="Score"
                                           options="{'no_create': True, 'no_edit': True}"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="control_effectiveness_risk_criteria_ids"
                                           readonly="1" nolabel="1" >
                                        <list>
                                            <field name="score"></field>
                                            <field name="color"
                                                   widget="color_picker"
                                                   nolabel="1" readonly="1"/>
                                            <field name="name"></field>
                                            <field name="description"></field>
                                        </list>
                                    </field>
                                </group>

                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="oi_risk_management.action_control_assessment_view">
        <field name="name">Control Assessment</field>
        <field name="res_model">oi_risk_management.risk</field>
        <field name="view_mode">list,form,graph,pivot,activity</field>
        <field name="context">{'create': False, 'delete': False, }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('oi_risk_management.control_assessment_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('oi_risk_management.control_assessment_view_form')})]"/>
    </record>
    <menuitem name="Control Assessment" id="oi_risk_management.action_control_assessment_menu"
              parent="oi_risk_management.menu_root"
              action="oi_risk_management.action_control_assessment_view" sequence="5"/>

</odoo>