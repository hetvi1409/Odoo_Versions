<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherent.oi_risk_management</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Risk Management" string="Risk" name="oi_risk_management">
                    <block title="Risks" name="oi_risk_management" >
                        <setting string="Evaluation" company_dependent="1" >
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="evaluation_system" string="The type of system to use for evaluation" class="col-2 o_light_label"/>
                                        <field name="evaluation_system" />
                                    </div>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="main_risk_type" string="Main risk type used in calculations" class="col-2 o_light_label"/>
                                        <field name="main_risk_type" />
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Evaluation" company_dependent="1" invisible="evaluation_system == 'symmetric'">
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="asymmetric_evaluation_very_high_ids" string="The criteria for very high evaluation score" class="col-2 o_light_label"/>
                                        <field name="asymmetric_evaluation_very_high_ids" widget="many2many_tags"/>
                                        <field name="asymmetric_evaluation_very_high_str" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="asymmetric_evaluation_high_ids" string="The criteria for high evaluation score" class="col-2 o_light_label"/>
                                        <field name="asymmetric_evaluation_high_ids" widget="many2many_tags"/>
                                        <field name="asymmetric_evaluation_high_str" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="asymmetric_evaluation_medium_ids" string="The criteria for medium evaluation score" class="col-2 o_light_label"/>
                                        <field name="asymmetric_evaluation_medium_ids" widget="many2many_tags"/>
                                        <field name="asymmetric_evaluation_medium_str" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="asymmetric_evaluation_low_ids" string="The criteria for low evaluation score" class="col-2 o_light_label"/>
                                        <field name="asymmetric_evaluation_low_ids" widget="many2many_tags"/>
                                        <field name="asymmetric_evaluation_low_str" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Risk Treatments" company_dependent="1" >
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="do_risk_treatments_have_owner" string="Treatments can have an owner" class="col-2 o_light_label"/>
                                        <field name="do_risk_treatments_have_owner" />
                                    </div>
                                </div>
                            </div>
                        </setting>

                    </block>
                </app>
            </xpath>
