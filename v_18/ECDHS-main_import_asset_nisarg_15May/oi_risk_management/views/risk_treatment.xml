<odoo>
    <data>

        <!-- risk treatment form view  -->
        <record model="ir.ui.view" id="oi_risk_management.risk_treatment_form">
            <field name="name">oi_risk_management.risk.treatment.view.form</field>
            <field name="model">oi_risk_management.risk_treatment</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="risk_state" invisible="1"/>
                            <field name="name"
                                   readonly="risk_state != 'draft'"/>
<!--                                   attrs="{'readonly': [('risk_state', '!=', ''draft'')]}"/>-->
                            <field name="target_date"
                                   readonly="risk_state != 'draft'"/>
                            <field name="status"/>
                            <field name="owner_id"
                                   readonly="risk_state != 'draft'" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="attachment_line_ids">
                                <list editable="bottom">
                                    <field name="datas" filename="name"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="attachment_id" column_invisible="1"/>
                                </list>
                            </field>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>