<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_sequence_risk_activity" model="ir.sequence">
        <field name="name">Risk Activity Sequence</field>
        <field name="code">risk.activity</field>
        <field name="prefix">RSK-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>


    <record id="ir_sequence_risk_risk" model="ir.sequence">
        <field name="name">Risk Sequence</field>
        <field name="code">risk.risk</field>
        <field name="prefix">RS-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</odoo>