<odoo>
    <data>
        <record id="group_asset_disposal_user" model="res.groups">
            <field name="name">Asset Disposal User</field>
        </record>

        <record id="group_asset_disposal_manager" model="res.groups">
            <field name="name">Asset Disposal Manager</field>
        </record>

        <record id="rule_asset_disposal_manager" model="ir.rule">
            <field name="name">Asset Disposal Manager</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="groups" eval="[(4, ref('group_asset_disposal_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_asset_disposal_user" model="ir.rule">
            <field name="name">Asset Disposal User</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="groups" eval="[(4, ref('group_asset_disposal_user'))]"/>
            <field name="domain_force">[('disposal_state', '=', 'draft')]</field>
        </record>
    </data>
</odoo>
