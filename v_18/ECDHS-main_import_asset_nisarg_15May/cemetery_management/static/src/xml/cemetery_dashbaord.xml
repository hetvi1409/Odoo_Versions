                                <div class="card-icon" >
                                    <i class="fa fa-list-alt"/>
                                </div>
                                <div>
                                    <h4 style="font-size: 20px;  padding: 0px 0px 10px">Burial Application</h4>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <span style="font-size: 44px; font-family: serif;">
                                    <div id="burial_application_count"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-12 col-md-3">
