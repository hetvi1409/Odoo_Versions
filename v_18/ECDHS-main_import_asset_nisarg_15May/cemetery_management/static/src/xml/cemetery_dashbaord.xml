<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="cemetery_management.CemeteryDashboard">
        <section class="dashboard_main_section" id="main_section_login">
            <div class="row">
                <div class="col-sm-12 dashboard-header">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-8">
                            <h2 class="section-header">Cemetery Dashboard</h2>
                        </div>
                        <div class="col-12 col-sm-12 col-md-4">
                        </div>
                    </div>
                    <hr/>
                </div>
            </div>
        </section>
        <div class="o_governance_dashboard"/>
        <t t-call="cemetery_management.CemeteryData"/>
    </t>
    <t t-name="cemetery_management.CemeteryData">
        <section class="dashboard_main_section" id="main_section_manager">
            <div class="cemetery_dashboard_card row">
                <div class="col-sm-12 col-md-3">
                    <div class="dashboard-card card-shadow my_lead"
                         t-on-click="(e) => this.OpenCemetery(e)">
                        <div class="row" style="padding: 0px 10px 0px 10px">
                            <div class="col-sm-8" >
                                <div class="card-icon" >
                                    <i class="fa fa-hospital-o"></i>
                                </div>
                                <div>
                                    <h4 style="font-size: 20px;  padding: 0px 0px 10px">Cemeteries</h4>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <span style="font-size: 44px; font-family: serif;">
                                    <div id="cemetery_count"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 col-md-3">
                    <div class="dashboard-card card-shadow my_lead"
                         t-on-click="(e) => this.OpenCemeterySection(e)">
                        <div class="row" style="padding: 0px 10px 0px 10px">
                            <div class="col-sm-8" >
                                <div class="card-icon" >
                                    <i class="fa fa-list-alt"/>
                                </div>
                                <div>
                                    <h4 style="font-size: 20px;  padding: 0px 0px 10px">Cemetery Sections</h4>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <span style="font-size: 44px; font-family: serif;">
                                    <div id="cemetery_section_count"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 col-md-3">
                    <div class="dashboard-card card-shadow my_lead"
                         t-on-click="(e) => this.OpenGrave(e)">
                        <div class="row" style="padding: 0px 10px 0px 10px">
                            <div class="col-sm-8" >
                                <div class="card-icon" >
                                    <i class="fa fa-list-alt"/>
                                </div>
                                <div>
                                    <h4 style="font-size: 20px;  padding: 0px 0px 10px">Graves</h4>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <span style="font-size: 44px; font-family: serif;">
                                    <div id="grave_count"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br/>
