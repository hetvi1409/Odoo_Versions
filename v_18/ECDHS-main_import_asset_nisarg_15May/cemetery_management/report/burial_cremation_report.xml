<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_burial_cremation">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <h2 style="text-align: center; margin-bottom: 20px;">Burial Cremation Report</h2>
                    <br/>
                    <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                        <tbody>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Name</td>
                                <td style="padding: 10px;"><span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Application Date</td>
                                <td style="padding: 10px;"><span t-field="o.date_issue"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Type</td>
                                <td style="padding: 10px;"><span t-field="o.interment_type"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Cemetery</td>
                                <td style="padding: 10px;"><span t-field="o.cemetery_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Section</td>
                                <td style="padding: 10px;"><span t-field="o.section_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Grave</td>
                                <td style="padding: 10px;"><span t-field="o.grave_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Status</td>
                                <td style="padding: 10px;"><span t-field="o.state"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h3 style="margin-top: 20px;">Applicant’s Details</h3>
                    <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                        <tbody>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Applicant Name</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Email</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_email"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Phone Number</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_phone"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Street</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_street"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Street 2</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_street2"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Postal Code</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_zip"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">City</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_city"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Country</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_country_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Province</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_province_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Municipality</td>
                                <td style="padding: 10px;"><span t-field="o.arranger_municipality_id.name"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h3 style="margin-top: 20px;">Deceased’s Details</h3>
                    <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                        <tbody>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Surname</td>
                                <td style="padding: 10px;"><span t-field="o.deceased_surname"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">First Name</td>
                                <td style="padding: 10px;"><span t-field="o.deceased_firstname"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Preferred Name</td>
                                <td style="padding: 10px;"><span t-field="o.deceased_preferred_name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Street</td>
                                <td style="padding: 10px;"><span t-field="o.street"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Street 2</td>
                                <td style="padding: 10px;"><span t-field="o.street2"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Postal Code</td>
                                <td style="padding: 10px;"><span t-field="o.zip"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">City</td>
                                <td style="padding: 10px;"><span t-field="o.city"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Country</td>
                                <td style="padding: 10px;"><span t-field="o.country_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Province</td>
                                <td style="padding: 10px;"><span t-field="o.province_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Municipality</td>
                                <td style="padding: 10px;"><span t-field="o.municipality_id.name"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h3 style="margin-top: 20px;">Interment Details</h3>
                    <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                        <tbody>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Date of Burial/Cremation</td>
                                <td style="padding: 10px;"><span t-field="o.interment_date"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Time of Burial/Cremation</td>
                                <td style="padding: 10px;"><span t-field="o.interment_time"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Grave Preparation</td>
                                <td style="padding: 10px;"><span t-field="o.grave_preparation"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Memorial Epitaph</td>
                                <td style="padding: 10px;"><span t-field="o.memorial_epitaph"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; font-weight: bold;">Other Instructions</td>
                                <td style="padding: 10px;"><span t-field="o.other_instructions"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </t>
</template>

