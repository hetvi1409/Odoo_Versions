<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cemetery_burial_report_view_list" model="ir.ui.view">
        <field name="name">cemetery.burial.report.view.list</field>
        <field name="model">cemetery.burial.report</field>
            <field name="arch" type="xml">
                <list string="Sales Analysis">
                    <field name="cemetery_id" optional="show"/>
                    <field name="burial_total_count" optional="show"/>
                    <field name="submitted_burial_total_count" optional="show"/>
                    <field name="verified_burial_total_count" optional="show"/>
                    <field name="approved_burial_total_count" optional="show"/>
                    <field name="rejected_burial_total_count" optional="show"/>
                    <field name="application_id" optional="show"/>
                    <field name="date_of_birth" optional="show"/>
                    <field name="age" optional="show"/>
                </list>
            </field>
    </record>

    <record id="cemetery_burial_report_view_pivot" model="ir.ui.view">
         <field name="name">cemetery.burial.report.view.pivot</field>
         <field name="model">cemetery.burial.report</field>
         <field name="arch" type="xml">
             <pivot string="Sales Analysis" sample="1">
                 <field name="cemetery_id" type="row"/>
                 <field name="burial_total_count" type="measure"/>
                 <field name="submitted_burial_total_count" type="measure"/>
                 <field name="verified_burial_total_count" type="measure"/>
                 <field name="approved_burial_total_count" type="measure"/>
                 <field name="rejected_burial_total_count" type="measure"/>
             </pivot>
         </field>
    </record>

    <record id="cemetery_burial_report_view_search" model="ir.ui.view">
        <field name="name">cemetery.burial.report.view.search</field>
        <field name="model">cemetery.burial.report</field>
        <field name="arch" type="xml">
            <search string="Total Burial per Cemetery">
                <group expand="0" string="Extended Filters">
                    <filter string="Cemetery" name="group_cemetery_id" domain="[]"
                            context="{'group_by':'cemetery_id'}"/>
                </group>

            </search>
        </field>
    </record>
    <record id="action_cemetery_burial_report" model="ir.actions.act_window">
        <field name="name">Total Burial Per Cemetery</field>
        <field name="res_model">cemetery.burial.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="cemetery_burial_report_view_search"/>
        <field name="context">{'search_default_group_cemetery_id':1}</field>
    </record>
</odoo>