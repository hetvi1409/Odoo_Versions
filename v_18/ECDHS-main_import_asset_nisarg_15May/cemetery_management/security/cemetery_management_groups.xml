<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_module_category_cemetery" model="ir.module.category">
        <field name="name">Cemetery</field>
    </record>

    <record id="group_undertaken" model="res.groups">
        <field name="name">Undertaker</field>
        <field name="category_id" ref="ir_module_category_cemetery"/>
    </record>

    <record id="group_cemetery_clerk" model="res.groups">
        <field name="name">Cemetery Clerk</field>
        <field name="category_id" ref="ir_module_category_cemetery"/>
        <field name="implied_ids" eval="[(4, ref('group_undertaken'))]"/>
    </record>
    <record id="group_cemetery_admin" model="res.groups">
        <field name="name">Cemetery Admin</field>
        <field name="category_id" ref="ir_module_category_cemetery"/>
        <field name="implied_ids" eval="[(4, ref('group_cemetery_clerk'))]"/>
    </record>
    <record id="group_cemetery_office_manager" model="res.groups">
        <field name="name">Office Manager</field>
        <field name="category_id" ref="ir_module_category_cemetery"/>
        <field name="implied_ids" eval="[(4, ref('group_cemetery_admin'))]"/>
    </record>

    <record id="cemetery_cemetery_multi_company_rule" model="ir.rule">
        <field name="name">Cemetery: multi-company</field>
        <field name="model_id" ref="model_cemetery_cemetery"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="cemetery_section_multi_company_rule" model="ir.rule">
        <field name="name">Cemetery Section: multi-company</field>
        <field name="model_id" ref="model_cemetery_section"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="grave_grave_multi_company_rule" model="ir.rule">
        <field name="name">Grave: multi-company</field>
        <field name="model_id" ref="model_grave_grave"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="cemetery_application_multi_company_rule" model="ir.rule">
        <field name="name">Application: multi-company</field>
        <field name="model_id" ref="model_cemetery_application"/>
        <field name="domain_force">[('company_id', 'in', company_ids  + [False])]</field>
    </record>
    <record id="grave_booking_multi_company_rule" model="ir.rule">
        <field name="name">Grave: multi-company</field>
        <field name="model_id" ref="model_grave_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids  + [False])]</field>
    </record>


</odoo>
