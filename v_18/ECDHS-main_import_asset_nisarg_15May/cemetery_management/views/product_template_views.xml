<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_tree" model="ir.ui.view">
        <field name="name">product.template.view.list</field>
        <field name="model">product.template</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="default_code"/>
                <field name="description"/>
                <field name="categ_id"/>
                <field name="list_price"/>
                <field name="standard_price"/>
            </list>
        </field>
    </record>

    <record id="product_template_tariff_action" model="ir.actions.act_window">
        <field name="name">Burial Services List</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_template_view_tree"/>
        <field name="domain">[('is_cemetery', '=', True)]</field>
        <field name="help" type="xml">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Tariffs
            </p>
        </field>
    </record>


</odoo>
