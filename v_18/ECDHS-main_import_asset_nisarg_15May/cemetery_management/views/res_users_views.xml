<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.cemetery.management</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reset_password']"
                   position="after">
                <button string="Create Invoice" type="object" invisible="not undertaker or (under_taker_invoice_id != False)"
                        name="action_create_undertaker_invoice"/>
                <button string="Create Undertaker" type="object" invisible="was_undertaker"
                        name="action_mark_as_undertaker"/>
            </xpath>

            <xpath expr="//field[@name='share']" position="after">
                <field name="undertaker"/>
                <field name="under_taker_invoice_id"/>
                <field name="was_undertaker"/>
            </xpath>
        </field>
    </record>
    <record id="undertaker_user_view_form" model="ir.ui.view">
        <field name="name">undertaker.user.form.view</field>
        <field name="model">undertaker.user</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id" readonly="1"/>
                        <field name="full_name"/>
                        <field name="date_of_birth"/>
                        <field name="gender"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>