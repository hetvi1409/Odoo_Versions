<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view definition -->
    <record id="view_cause_death_form" model="ir.ui.view">
        <field name="name">cause.death.form</field>
        <field name="model">cause.death</field>
        <field name="arch" type="xml">
            <form string="Cause of Death">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Tree view definition -->
    <record id="view_cause_death_tree" model="ir.ui.view">
        <field name="name">cause.death.list</field>
        <field name="model">cause.death</field>
        <field name="arch" type="xml">
            <list string="Cause of Death">
                <field name="name"/>
                <field name="category"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <!-- Action definition -->
    <record id="action_cause_death" model="ir.actions.act_window">
        <field name="name">Cause of Death</field>
        <field name="res_model">cause.death</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new record.
            </p>
        </field>
    </record>
    <menuitem id="cemetery_cause_death" name="Cause of Death"
              parent="menu_cemetery_configuration" sequence="6"
              action="action_cause_death"/>

</odoo>
