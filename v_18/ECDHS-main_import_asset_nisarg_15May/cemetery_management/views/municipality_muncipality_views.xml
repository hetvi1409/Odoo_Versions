<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view -->
    <record id="municipality_municipality_view_form" model="ir.ui.view">
        <field name="name">municipality.municipality.view.form</field>
        <field name="model">municipality.municipality</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="province_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_municipality_municipality" model="ir.ui.view">
        <field name="name">municipality.municipality.config</field>
        <field name="model">municipality.municipality</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="province_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <!-- Action -->
    <record id="action_municipality_municipality" model="ir.actions.act_window">
        <field name="name">Municipality</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">municipality.municipality</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Municipality
            </p>
        </field>
    </record>

</odoo>
