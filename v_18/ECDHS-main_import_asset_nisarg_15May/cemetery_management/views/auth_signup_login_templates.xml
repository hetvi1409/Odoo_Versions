<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="fields" name="Auth Signup/ResetPassword form fields"
              inherit_id="auth_signup.fields"
              priority="30">
        <xpath expr="//div[hasclass('field-password')]" position="before">
            <div class="mb-3 field-undertaken">
                <input type="checkbox" name="undertaker" t-att-value="undertaker" id="undertaker" autofocus="autofocus"
                    autocapitalize="off" class="form-check-input" t-att-readonly="'readonly' if only_passwords else None"/>
                <label for="undertaker">Is UnderTaker Account</label>
            </div>
        </xpath>
    </template>

</odoo>
