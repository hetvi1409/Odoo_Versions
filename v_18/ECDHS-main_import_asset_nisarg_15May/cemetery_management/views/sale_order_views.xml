<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.cemetery.management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_reporting']"
                   position="after">
                <group string="Burial Details">
                    <field name="type_of_death" widget="radio" options="{'horizontal': True}"/>
                    <field name="cause_death_id" invisible="type_of_death != 'natural'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>