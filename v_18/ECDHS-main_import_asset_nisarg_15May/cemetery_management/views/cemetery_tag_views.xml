<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cemetery_tag_view_tree" model="ir.ui.view">
        <field name="name">cemetery.tag.view.form</field>
        <field name="model">cemetery.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_cemetery_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cemetery.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Tags
            </p>
        </field>
    </record>
</odoo>