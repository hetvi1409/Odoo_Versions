    <record id="grave_allocation_view_form" model="ir.ui.view">
        <field name="name">grave.allocation.view.form</field>
        <field name="model">grave.allocation</field>
        <field name="arch" type="xml">
            <form string="allocation">
                <group>
                    <group>
                        <field name="cemetery_id"/>
                        <field name="booking_id"/>
                        <field name="type" widget="radio"
                               options="{'horizontal': True}"/>

                    </group>
                    <group>
                        <field name="section_id"/>
                        <field name="grave_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_submit" string="Confirm" type="object"
                            default_focus="1" class="oe_highlight"/>

                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

