<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cemetery_application_form" model="ir.ui.view">
        <field name="name">cemetery.application.form</field>
        <field name="model">cemetery.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,verified,approved"/>
                    <button name="action_submit"
                            string="Submit" invisible="state != 'draft'"
                            type="object" class="oe_highlight"/>
                    <!--                    <button name="action_approve"-->
                    <!--                            string="Approve" invisible="state != 'quotation_generated'"-->
                    <!--                            type="object" class="oe_highlight"/>-->
                    <button name="action_verify"
                            string="Verify" invisible="state != 'submitted'"
                            type="object" class="oe_highlight"
                            groups="cemetery_management.group_cemetery_clerk"/>
<!--                    <button name="create_quotation" string="Create Quotation"-->
<!--                            class="oe_highlight"-->
<!--                            type="object"-->
<!--                            data-hotkey="q"-->
<!--                            invisible="state != 'verified'"/>-->
                    <button name="action_approve" string="Approve"
                            class="oe_highlight"
                            type="object"
                            data-hotkey="q"
                            invisible="state != 'verified'"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            data-hotkey="q"
                            invisible="state != 'quotation_generated'"/>

                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                    </style>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_calender"
                                icon="fa-calendar"
                                invisible="state == 'draft'">
                            Calendar
                        </button>

                        <button class="oe_stat_button"
                                name="action_view_quotation"
                                type="object"
                                icon="fa-pencil-square-o"
                                invisible="not has_quotation">
                            Quotation
                        </button>
                        <button class="oe_stat_button"
                                name="action_view_invoice"
                                type="object"
                                icon="fa-pencil-square-o"
                                invisible="not has_invoice">
                            Invoice
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Paid" invisible="not burial_invoice_paid"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="True" placeholder="Name"/>
                        </h1>
                    </div>
                    <group string="Death Register" invisible="state != 'approved'">
                        <group>
                            <field name="death_register_id"/>
                        </group>
                    </group>
                    <group string="Deceased Details">
                        <group>
                            <field name="deceased_surname"/>
                            <field name="deceased_firstname"/>
                            <field name="deceased_preferred_name"/>
                        </group>
                        <group>
                            <label for="street" string="Last Location"/>
                            <div class="o_address_format">
                                <field name="street"
                                       placeholder="Street..."
                                       class="o_address_street"/>
                                <field name="street2"
                                       placeholder="Street 2..."
                                       class="o_address_street"/>
                                <field name="city" placeholder="City"
                                       class="o_address_city"/>
                                <field name="municipality_id"
                                       placeholder="Municipality"
                                       class="o_address_city"
                                       options='{"no_open": True}'/>
                                <field name="province_id"
                                       class="o_address_state"
                                       placeholder="Province"
                                       options='{"no_open": True}'/>
                                <field name="zip" placeholder="Postal Code"
                                       class="o_address_zip"/>
                                <field name="country_id"
                                       placeholder="Country"
                                       class="o_address_country"
                                       options='{"no_open": True}'/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_of_birth"/>
<!--                            <field name="religion"/>-->
                            <field name="id_number"/>
                            <field name="undertaker_id"/>
                        </group>
                        <group>
                            <field name="gender" widget="radio"
                                   options="{'horizontal': True}"/>
                            <field name="foreigner"
                                   widget="boolean_toggle"/>
                            <field name="passport_number"
                                   invisible="not foreigner"/>
                            <field name="citizenship_id"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <group>
                            <field name="burial_order"/>
                            <field name="next_of_kin_id"/>
                        </group>
                        <group>
                            <field name="deceased_id"/>
                            <field name="death_certificate"/>
                        </group>
                    </group>
                    <group string="Details Of Death">
                        <group>
                            <field name="date_of_death"/>
                            <field name="place_of_burial"/>
                            <field name="burial_province_id"/>
<!--                            <field name="grave_number_memorial" invisible="interment_type != 'burial'"/>-->
                        </group>
                        <group>
                            <field name="cause_of_death_id"/>
                            <field name="place_of_death"/>
                            <field name="death_province_id"/>

                        </group>
                    </group>

                    <notebook>
                        <page name="deceased"
                              string="Interment/Burial/Grave Details">
                            <group>
                        <!-- Hidden technical fields -->
                        <field name="has_quotation" invisible="1"/>
                        <field name="has_invoice" invisible="1"/>
                        <field name="burial_invoice_paid" invisible="1"/>

                        <!-- Interment Information -->
                        <group string="Interment Details">
                            <field name="interment_type"/>
                            <field name="crematorium_id" invisible="interment_type != 'cremation'"/>
                            <field name="date_issue"/>
                            <field name="undertaker_id_number"/>
                            <field name="company_id"/>
                        </group>

                        <!-- Burial Details -->
                        <group string="Burial" invisible="interment_type != 'burial'">
                            <group>
                                <field name="serial_number"/>
                                <field name="is_deceased" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="barcode_number"/>
                            </group>
                        </group>

                        <!-- Grave Details for Undertakers Only -->
                        <group string="Grave Details"
                               invisible="interment_type != 'burial'">
                            <group>
                                <field name="cemetery_id"/>
                                <field name="section_id"/>
                            </group>
                            <group>
                                <field name="grave_id"/>
                            </group>
                        </group>
                    </group>

                        </page>
                        <page name="instructions" string="Instructions">
                            <group string="Burial/Memorial/Cremation Instructions">
                                <group>
                                    <field name="interment_date"/>
                                    <field name="grave_preparation"
                                           widget="radio"
                                           options="{'horizontal': True}"/>
                                </group>
                                <group>
