    <record id="view_cemetery_application_view_tree" model="ir.ui.view">
        <field name="name">cemetery.application.form</field>
        <field name="model">cemetery.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="undertaker_id"/>
                <field name="interment_type"/>
                <field name="state"/>
                <field name="burial_status"
                       invisible="interment_type != 'burial'"
                       widget="badge"
                       decoration-danger="burial_status == 'incomplete'"
                       decoration-success="burial_status == 'complete'"/>
            </list>
        </field>
    </record>

    <record id="action_application" model="ir.actions.act_window">
        <field name="name">All Applications</field>
        <field name="res_model">cemetery.application</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_burial_application" model="ir.actions.act_window">
        <field name="name">Burial Applications</field>
        <field name="res_model">cemetery.application</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('interment_type', '=', 'burial')]</field>
        <field name="context">{'default_interment_type': 'burial'}</field>
    </record>
    <record id="action_cremation_application" model="ir.actions.act_window">
        <field name="name">Cremation Applications</field>
        <field name="res_model">cemetery.application</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('interment_type', '=', 'cremation')]</field>
        <field name="context">{'default_interment_type': 'cremation'}</field>
    </record>

</odoo>
