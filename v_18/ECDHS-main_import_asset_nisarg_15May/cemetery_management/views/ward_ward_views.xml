<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view -->
    <record id="ward_ward_view_form" model="ir.ui.view">
        <field name="name">ward.ward.view.form</field>
        <field name="model">ward.ward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="province_id"/>
                            <field name="district"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                            <field name="municipality_id"/>
                            <field name="city"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ward_ward" model="ir.ui.view">
        <field name="name">ward.ward.config</field>
        <field name="model">ward.ward</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <!-- Action -->
    <record id="action_ward_ward" model="ir.actions.act_window">
        <field name="name">ward</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ward.ward</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new ward
            </p>
        </field>
    </record>
</odoo>
