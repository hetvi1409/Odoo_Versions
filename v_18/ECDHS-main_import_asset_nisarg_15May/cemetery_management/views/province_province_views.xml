<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view -->
    <record id="province_province_view_form" model="ir.ui.view">
        <field name="name">province.province.view.form</field>
        <field name="model">province.province</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_province_province" model="ir.ui.view">
        <field name="name">province.province.config</field>
        <field name="model">province.province</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <!-- Action -->
    <record id="action_province_province" model="ir.actions.act_window">
        <field name="name">Province</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">province.province</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Province
            </p>
        </field>
    </record>
</odoo>
