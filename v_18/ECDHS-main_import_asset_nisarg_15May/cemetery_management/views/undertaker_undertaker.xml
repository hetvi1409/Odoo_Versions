<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Define the tree view for the Undertaker model -->
    <record id="view_undertaker_list" model="ir.ui.view">
        <field name="name">undertaker.undertaker.list</field>
        <field name="model">undertaker.undertaker</field>
        <field name="arch" type="xml">
            <list>
                <field name="full_name"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
                <field name="nationality"/>
                <field name="phone_number"/>
                <field name="email_address"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Define the form view for the Undertaker model -->
    <record id="view_undertaker_form" model="ir.ui.view">
        <field name="name">undertaker.undertaker.form</field>
        <field name="model">undertaker.undertaker</field>
        <field name="arch" type="xml">
            <form string="Undertaker">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"
                           options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>

                    <!--                        <group>-->
                    <group string="Personal Information">
                        <group>
                        <field name="surname"/>
                        <field name="forename"/>
                        <field name="full_name"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="nationality"/>
                            <field name="id_number"/>
                        </group>
                    </group>
                    <group string="Contact Information">
                        <field name="phone_number"/>
                        <field name="email_address"/>
                        <!--                                <field name="address"/>-->
                        <label for="undertaker_street" string="Address"
                               />
                        <div class="o_address_format">
                            <field name="undertaker_street"
                                   placeholder="Street..."
                                   class="o_address_street"/>
                            <field name="undertaker_street2"
                                   placeholder="Street 2..."
                                   class="o_address_street"/>
                            <field name="undertaker_city" placeholder="City"
                                   class="o_address_city"/>
                            <field name="undertaker_municipality_id"
                                   placeholder="Municipality"
                                   class="o_address_city"
                                   options='{"no_open": True}'/>
                            <field name="undertaker_province_id"
                                   class="o_address_state"
                                   placeholder="Province"
                                   options='{"no_open": True}'/>
                            <field name="undertaker_zip"
                                   placeholder="Postal Code"
                                   class="o_address_zip"/>
                            <field name="undertaker_country_id"
                                   placeholder="Country"
                                   class="o_address_country"
                                   options='{"no_open": True}'/>
                        </div>
                        <field name="emergency_contact_name"
                               string="Emergency Contact Name"/>
                        <field name="emergency_contact_phone"
                               string="Emergency Contact Phone"/>
                        <field name="emergency_contact_relationship"
                               string="Emergency Contact Relationship"/>
                    </group>
                    <group>
                        <field name="user_id"/>
                        <field name="portal_user_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Define the action to open the Undertaker model -->
    <record id="action_undertaker_model" model="ir.actions.act_window">
        <field name="name">Undertakers</field>
        <field name="res_model">undertaker.undertaker</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first undertaker
            </p>
        </field>
    </record>

    <!-- Add the menu item for the Undertaker model -->
    <menuitem id="menu_undertaker" name="Undertakers"
              parent="menu_cemetery_configuration" sequence="10"
              action="action_undertaker_model"/>
</odoo>
