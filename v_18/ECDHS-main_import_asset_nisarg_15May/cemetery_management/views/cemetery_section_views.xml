<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cemetery_section_form" model="ir.ui.view">
        <field name="name">cemetery.section.form</field>
        <field name="model">cemetery.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cemetery_id"/>
                        </group>
                        <group>
                            <field name="square_meter"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Graves">
                            <field name="grave_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="number"/>
                                    <field name="cemetery_id" invisible="1"/>
                                    <field name="grave_type"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="section_id"/>
                                            <field name="cemetery_id"/>
                                            <field name="municipality_id"/>
                                        </group>
                                        <group>
                                            <field name="grave_type"/>
                                            <field name="occupied"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cemetery_section_tree" model="ir.ui.view">
        <field name="name">cemetery.section.list</field>
        <field name="model">cemetery.section</field>
        <field name="arch" type="xml">
            <list string="Section Records">
                <field name="name"/>
                <field name="cemetery_id"/>
                <field name="graves_count"/>
                <field name="adult_graves_count"/>
                <field name="infant_graves_count"/>
            </list>
        </field>
    </record>

    <record id="action_cemetery_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">cemetery.section</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
