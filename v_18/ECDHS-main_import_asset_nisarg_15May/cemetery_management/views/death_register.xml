    <record id="view_death_register_tree" model="ir.ui.view">
        <field name="name">death.register.list</field>
        <field name="model">death.register</field>
        <field name="arch" type="xml">
            <list string="Death Registers">
                <field name="surname"/>
                <field name="forenames"/>
                <field name="date_of_death"/>
                <field name="date_of_birth"/>
                <field name="place_of_death"/>
                <field name="interment_type"/>
