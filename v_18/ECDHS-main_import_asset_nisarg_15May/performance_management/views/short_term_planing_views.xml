<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="short_term_planing_view_search" model="ir.ui.view">
        <field name="name">short.term.planing.view.search</field>
        <field name="model">short.term.planing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="portfolio_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="programme_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="sub_programme_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="outcome_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="output_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="indicator_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="long_term_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="medium_term_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <separator/>
<!--                <filter date="date" name="filter_date" string="Date"/>-->
                <separator/>
                <filter name="groupby_short_term" string="Short Term Planning"
                        context="{'group_by': 'medium_term_id'}" domain="[]"/>
                <filter name="groupby_long_term" string="Long Term Planning"
                        context="{'group_by': 'long_term_id'}" domain="[]"/>
                <filter name="groupby_indicator" string="Indicator"
                        context="{'group_by': 'indicator_id'}" domain="[]"/>
                <filter name="groupby_output" string="Output"
                        context="{'group_by': 'output_id'}" domain="[]"/>
                <filter name="groupby_outcome" string="Outcome"
                        context="{'group_by': 'outcome_id'}" domain="[]"/>
                <filter name="groupby_sub_programme" string="Sub-Programme"
                        context="{'group_by': 'sub_programme_id'}" domain="[]"/>
                <filter name="groupby_programme" string="Programme"
                        context="{'group_by': 'programme_id'}" domain="[]"/>
                <filter name="groupby_performance" string="Performance"
                        context="{'group_by': 'portfolio_id'}" domain="[]"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="short_term_planing_view_form" model="ir.ui.view">
        <field name="name">short.term.planing.view.form</field>
        <field name="model">short.term.planing</field>
        <field name="arch" type="xml">
            <form string="short_term_planing">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="long_term_id"
                                   domain="[('indicator_id', '=?', indicator_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="programme_id"
                                   domain="[('portfolio_id', '=?', portfolio_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="sub_programme_id"
                                   domain="[('programme_id', '=?', programme_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="medium_term_id"
                                   domain="[('long_term_id', '=?', long_term_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="indicator_id"
                                   domain="[('output_id', '=?', output_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="outcome_id"
                                   domain="[('sub_programme_id', '=?', sub_programme_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="output_id"
                                   domain="[('outcome_id', '=?', outcome_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="short_term_planing_view_list" model="ir.ui.view">
        <field name="name">short.term.planing.view.list</field>
        <field name="model">short.term.planing</field>
        <field name="arch" type="xml">
            <list class="performance_management">
                <field name="name"/>
                <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="sub_programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="outcome_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="output_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="indicator_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="long_term_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="medium_term_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="short_term_planing_action" model="ir.actions.act_window">
        <field name="name">Short Term Planing</field>
        <field name="res_model">short.term.planing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Short term planing!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="short_term_planing_menu"
              name="Short Term Planning"
              action="short_term_planing_action"
              parent="performance_management.outcome_levels_menu"
              sequence="10"/>
</odoo>