<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="performance_programme_view_search" model="ir.ui.view">
        <field name="name">performance.programme.view.search</field>
        <field name="model">performance.programme</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="portfolio_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <separator/>
                <filter date="start_date" name="filter_date" string="Start Date"/>
                <filter date="end_date" name="filter_end_date" string="End Date"/>
                <separator/>
                <filter name="groupby_performance" string="Performance"
                        context="{'group_by': 'portfolio_id'}" domain="[]"/>
                <filter name="groupby_user" string="Responsible"
                        context="{'group_by': 'user_id'}" domain="[]"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="programmes_view_form" model="ir.ui.view">
        <field name="name">performance.programme.view.form</field>
        <field name="model">performance.programme</field>
        <field name="arch" type="xml">
            <form string="Programme">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <label for="start_date"/>
                            <div class="oe_inline">
                                <field name="start_date" class="oe_inline" placeholder="Start Date"/>
                                <field name="end_date" class="oe_inline" placeholder="End Date"/>
                            </div>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="value"/>
                            <field name="res_model_id" invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub-Programmes">
                            <field name="sub_programme_ids" context="{'default_portfolio_id': portfolio_id}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                    <field name="parent_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Child Sub-Programmes">
                            <field name="sub_programme_child_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="parent_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id"
                                        domain="[('portfolio_id', '=', portfolio_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outcomes">
                            <field name="outcome_ids" context="{'default_portfolio_id': portfolio_id}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_description"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outputs">
                            <field name="output_ids" context="{'default_portfolio_id': portfolio_id}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Output Indicators">
                            <field name="indicator_ids" context="{'default_portfolio_id': portfolio_id, 'group_by': 'name'}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="output_id"
                                        domain="[('outcome_id', '=?', outcome_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="period"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="source_of_data"/>
                                    <field name="method_of_calculation"/>
                                    <field name="calculation_type"/>
                                    <field name="desired_performance"/>
                                    <field name="means_of_verification"/>
                                    <field name="assumptions"/>
                                    <field name="spatial_transformation"/>
                                    <field name="department_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="section"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activities">
                            <field name="activity_ids" context="{'default_res_model_id': res_model_id}" string="Activities">
                                <list class="performance_management" editable="bottom">
                                    <field name="res_model_id" column_invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="res_name"/>
                                    <field name="activity_type_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="summary"/>
                                    <field name="date_deadline"/>
                                    <field name="note"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="programme_view_list" model="ir.ui.view">
        <field name="name">performance.programme.view.list</field>
        <field name="model">performance.programme</field>
        <field name="arch" type="xml">
            <list class="performance_management" string="Programme" expand="1">
                <field name="name"/>
                <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="programme_action" model="ir.actions.act_window">
        <field name="name">Programme</field>
        <field name="res_model">performance.programme</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first programme!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="programmes_menu"
              name="Programmes"
              parent="governance.menu_governance_root"
              sequence="10"/>

    <menuitem id="programme_menu"
              name="Programme"
              action="programme_action"
              parent="performance_management.programmes_menu"
              sequence="10"/>

    <record id="sub_programme_view_search" model="ir.ui.view">
        <field name="name">sub.programme.view.search</field>
        <field name="model">sub.programme</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="programme_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <separator/>
                <filter date="start_date" name="filter_date" string="Start Date"/>
                <filter date="end_date" name="filter_end_date" string="End Date"/>
                <separator/>
                <filter name="groupby_programme" string="Programme"
                        context="{'group_by': 'programme_id'}" domain="[]"/>
                <filter name="groupby_subprogramme" string="Sub-Programme"
                        context="{'group_by': 'parent_id'}" domain="[]"/>
                <filter name="groupby_performance" string="Performance"
                        context="{'group_by': 'portfolio_id'}" domain="[]"/>
                <filter name="groupby_user" string="Responsible"
                        context="{'group_by': 'user_id'}" domain="[]"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="sub_programme_view_form" model="ir.ui.view">
        <field name="name">sub.programme.view.form</field>
        <field name="model">sub.programme</field>
        <field name="arch" type="xml">
            <form string="Programme">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="parent_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="programme_id"
                                   domain="[('portfolio_id', '=?', portfolio_id)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <label for="start_date"/>
                            <div class="oe_inline">
                                <field name="start_date" class="oe_inline" placeholder="Start Date"/>
                                <field name="end_date" class="oe_inline" placeholder="End Date"/>
                            </div>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="value"/>
                            <field name="res_model_id" invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Child Sub-Programmes" invisible="parent_id != False">
                            <field name="sub_programme_child_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="programme_id"
                                        domain="[('portfolio_id', '=', portfolio_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="parent_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Child Sub-Programmes" invisible="parent_id != False">
                            <field name="sub_programme_child_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="programme_id"
                                        domain="[('portfolio_id', '=', portfolio_id)]"
                                        options="{'no_create': True, 'no_open': True}"/>
                                    <field name="portfolio_id"/>
                                    <field name="parent_id"/>
                                    <field name="user_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outcome">
                            <field name="outcome_ids" context="{'default_portfolio_id': portfolio_id,
                                                                'default_programme_id': programme_id}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Output">
                            <field name="output_ids" context="{'default_portfolio_id': portfolio_id}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Output Indicator">
                            <field name="indicator_ids" context="{'default_portfolio_id': portfolio_id}">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="output_id"
                                        domain="[('outcome_id', '=?', outcome_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="period"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="source_of_data"/>
                                    <field name="method_of_calculation"/>
                                    <field name="calculation_type"/>
                                    <field name="desired_performance"/>
                                    <field name="means_of_verification"/>
                                    <field name="assumptions"/>
                                    <field name="spatial_transformation"/>
                                    <field name="department_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="section"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activities">
                            <field name="activity_ids" context="{'default_res_model_id': res_model_id}">
                                <list class="performance_management" editable="bottom">
                                    <field name="res_model_id" column_invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="res_name"/>
                                    <field name="activity_type_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="summary"/>
                                    <field name="date_deadline"/>
                                    <field name="note"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="sub_programme_view_list" model="ir.ui.view">
        <field name="name">sub.programme.view.list</field>
        <field name="model">sub.programme</field>
        <field name="arch" type="xml">
            <list class="performance_management" expand="1">
                <field name="name"/>
                <field name="parent_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="sub_programme_action" model="ir.actions.act_window">
        <field name="name">Sub-Programme</field>
        <field name="res_model">sub.programme</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_programme': 1}</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sub-programme!
            </p>
        </field>
    </record>

    <!-- Action -->
    <record id="sub_programme_child_action" model="ir.actions.act_window">
        <field name="name">Child Sub-Programme</field>
        <field name="res_model">sub.programme</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_subprogramme': 1}</field>
        <field name="domain">[('parent_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first function!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="sub_programme_menu"
              name="Sub-Programme"
              action="sub_programme_action"
              parent="performance_management.programmes_menu"
              sequence="10"/>

    <!-- Menu -->
    <menuitem id="sub_programme_child_menu"
              name="Child Sub-Programme"
              action="sub_programme_child_action"
              parent="performance_management.programmes_menu"
              sequence="11"/>

</odoo>