<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="output_indicator_view_search" model="ir.ui.view">
        <field name="name">output.indicator.view.search</field>
        <field name="model">output.indicator</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="portfolio_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="programme_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="sub_programme_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="outcome_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="output_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <separator/>
<!--                <filter date="date" name="filter_date" string="Date"/>-->
                <separator/>
                <filter name="groupby_output" string="Output"
                        context="{'group_by': 'output_id'}" domain="[]"/>
                <filter name="groupby_outcome" string="Outcome"
                        context="{'group_by': 'outcome_id'}" domain="[]"/>
                <filter name="groupby_sub_programme" string="Sub-Programme"
                        context="{'group_by': 'sub_programme_id'}" domain="[]"/>
                <filter name="groupby_programme" string="Programme"
                        context="{'group_by': 'programme_id'}" domain="[]"/>
                <filter name="groupby_performance" string="Performance"
                        context="{'group_by': 'portfolio_id'}" domain="[]"/>
                <filter name="groupby_user" string="Responsible"
                        context="{'group_by': 'user_id'}" domain="[]"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_output_indicator_form" model="ir.ui.view">
        <field name="name">output.indicator.form</field>
        <field name="model">output.indicator</field>
        <field name="arch" type="xml">
            <form string="Output Indicator">
                <header>
                </header>
                <sheet>
                    <div class="oe_title pe-0">
                        <h1 class="d-flex flex-row justify-content-between">
                            <field name="name" placeholder="Indicator Title..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="group_programme_details" string="Programme Details">
                            <field name="portfolio_id" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="programme_id"
                                   domain="[('portfolio_id', '=?', portfolio_id)]" required="1" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="sub_programme_id"
                                   domain="[('programme_id', '=?', programme_id)]" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="outcome_id"
                                   domain="[('sub_programme_id', '=?', sub_programme_id)]" required="1" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="output_id"
                                   domain="[('outcome_id', '=?', outcome_id)]" required="1" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="">
                            <field name="period" required="1"/>
                            <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}" required="0"/>
                            <field name="user_id" required="0" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="res_model_id" invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="end_date" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group name="group_indicator_details" string="Indicator Details">
                            <field name="source_of_data"/>
                            <field name="method_of_calculation"/>
                            <field name="calculation_type"/>
                            <field name="spatial_transformation"/>
                        </group>
                        <group string="">
                            <field name="desired_performance"/>
                            <field name="means_of_verification"/>
                            <field name="assumptions"/>
                            <field name="department_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="section"/>
                            <field name="res_model_id" invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Disaggregations">
                            <field name="dimension_ids">
                                <list class="performance_management" editable="bottom">
                                    <field name="description" required="1"/>
                                    <field name="name" required="1"/>
                                    <field name="type" required="1"/>
                                    <field name="option_ids" widget="many2many_tags" required="1"/>
                                    <field name="date"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Annual Targets">
                            <field name="target_ids">
                                <list class="performance_management" editable="bottom" default_order="write_date asc">
                                    <field name="target_name_id" required="1" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="target_numeric" required="1" readonly="0"/>
                                    <field name="target"/>
                                    <field name="achieved_target_numeric" required="0" readonly="1"/>
                                    <field name="total_achieved_target_numeric"/>
                                    <field name="variance_numeric" required="0" readonly="1"/>
                                    <field name="start_date" required="0"/>
                                    <field name="end_date" required="0"/>
                                    <field name="user_id" required="0" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="name" required="1" readonly="1" force_save="1" column_invisible="1"/>
                                    <field name="indicator_id" column_invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Quarterly Targets">
                            <group>
                                <button name="action_compute_quarterly_targets"
                                        type="object"
                                        string="Compute Quarterly Targets"
                                        class="oe_highlight"/>
                            </group>
                            <field name="target_quarter_ids">
                                <list class="performance_management" editable="bottom" default_order="write_date asc">
                                    <field name="annual_target_id" required="1" force_save="1"
                                           options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="quarter" required="1" index="1"/>
                                    <field name="value_numeric"/>
                                    <field name="value_text"/>
                                    <field name="achieved_numeric" compute="_compute_achieved" store="True"/>
                                    <field name="variance_numeric" compute="_compute_achieved" store="True"/>
                                    <field name="due_date"/>
                                    <field name="name" required="1" readonly="0" force_save="1" column_invisible="1"/>
                                    <field name="indicator_id" column_invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sequence" default="10" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reporting (Submission)">
                            <field name="reporting_collection_ids">
                                <list class="performance_management" default_order="target_id desc" editable="bottom" open_form_view="1">
                                    <field name="dimension_id" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="target_id" required="1" force_save="1"
                                           options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="quarter_target_id" domain="[('annual_target_id','=', target_id)]"
                                           options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="name" required="0" readonly="1" force_save="1"/>
                                    <field name="achievement" required="1"/>
                                    <field name="achieved_target_numeric" required="1"/>
                                    <field name="target_numeric"/>
                                    <field name="variance_numeric"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="evidence" required="1" force_save="1"/>
                                    <button name="action_preview_document"
                                            type="object"
                                            string="Preview"
                                            class="btn-primary"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="residual_performance"/>
                                    <field name="blockages"/>
                                    <field name="remedial_measures"/>
                                    <field name="timeframe"/>
                                    <field name="comments"/>
                                    <field name="indicator_id" column_invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="achieved_value" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activities">
                            <field name="activity_ids" context="{'default_res_model_id': res_model_id}" string="Activities">
                                <list class="performance_management" editable="bottom">
                                    <field name="res_name"/>
                                    <field name="activity_type_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="summary"/>
                                    <field name="date_deadline"/>
                                    <field name="note"/>
                                    <field name="state"/>
                                    <field name="res_model_id" column_invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="create_date"/>
                                    <field name="write_date" string="Last Modified"/>
                                </list>
                            </field>
                        </page>
                        <page string="Long Term Planning">
                            <field name="long_planing_ids" context="{'default_portfolio_id': portfolio_id,
                                                                'default_programme_id': programme_id,
                                                                'default_sub_programme_id': sub_programme_id,
                                                                'default_outcome_id': outcome_id,
                                                                'default_output_id': output_id,
                                                                }">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="output_id"
                                        domain="[('outcome_id', '=?', outcome_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="indicator_id"
                                        domain="[('output_id', '=?', output_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Medium Term Planning">
                            <field name="medium_planing_ids" context="{'default_portfolio_id': portfolio_id,
                                                                'default_programme_id': programme_id,
                                                                'default_sub_programme_id': sub_programme_id,
                                                                'default_outcome_id': outcome_id,
                                                                'default_output_id': output_id,
                                                                }">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="output_id"
                                        domain="[('outcome_id', '=?', outcome_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="indicator_id"
                                        domain="[('output_id', '=?', output_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="long_term_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Short Term Planning">
                            <field name="short_planing_ids" context="{'default_portfolio_id': portfolio_id,
                                                                'default_programme_id': programme_id,
                                                                'default_sub_programme_id': sub_programme_id,
                                                                'default_outcome_id': outcome_id,
                                                                'default_output_id': output_id,
                                                                }">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" required="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="output_id"
                                        domain="[('outcome_id', '=?', outcome_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="indicator_id"
                                        domain="[('output_id', '=?', output_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="output_indicator_view_list" model="ir.ui.view">
        <field name="name">output.indicator.view.list</field>
        <field name="model">output.indicator</field>
        <field name="arch" type="xml">
            <list class="performance_management">
                <field name="name"/>
                <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="sub_programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="outcome_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="output_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="output_indicator_action" model="ir.actions.act_window">
        <field name="name">Output Indicator</field>
        <field name="res_model">output.indicator</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Output Indicator!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="output_indicator_menu"
              name="Output Indicators"
              action="output_indicator_action"
              parent="performance_management.performance_outcomes_menu"
              sequence="10"/>
</odoo>