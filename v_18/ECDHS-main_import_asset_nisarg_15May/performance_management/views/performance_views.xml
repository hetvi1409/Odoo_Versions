<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="performance_performance_view_search" model="ir.ui.view">
        <field name="name">performance.portfolio.view.search</field>
        <field name="model">performance.portfolio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id" operator="child_of" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <separator/>
                <filter date="start_date" name="filter_date" string="Start Date"/>
                <filter date="end_date" name="filter_end_date" string="End Date"/>
                <separator/>
                <filter name="groupby_user" string="Responsible"
                        context="{'group_by': 'user_id'}" domain="[]"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="performance_performance_view_form" model="ir.ui.view">
        <field name="name">performance.portfolio.view.form</field>
        <field name="model">performance.portfolio</field>
        <field name="arch" type="xml">
            <form string="performance_performance">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <label for="start_date"/>
                            <div class="oe_inline">
                                <field name="start_date" class="oe_inline" placeholder="Start Date"/>
                                <field name="end_date" class="oe_inline" placeholder="End Date"/>
                            </div>

                        </group>
                        <group>
                            <field name="value"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Programmes" name="lines">
                            <field name="programme_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub-Programmes">
                            <field name="sub_programme_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="programme_id"
                                        domain="[('portfolio_id', '=', portfolio_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Child Sub-Programmes">
                            <field name="sub_programme_child_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="parent_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id"
                                        domain="[('portfolio_id', '=', portfolio_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="value"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outcomes">
                            <field name="outcome_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_description"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outputs">
                            <field name="output_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" readonly="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Output Indicators">
                            <field name="indicator_ids">
                                <list class="performance_management">
                                    <field name="name"/>
                                    <field name="output_id"
                                        domain="[('outcome_id', '=?', outcome_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="outcome_id"
                                        domain="[('sub_programme_id', '=?', sub_programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="sub_programme_id"
                                        domain="[('programme_id', '=?', programme_id)]"
                                        options="{'no_create': True, 'no_open': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="programme_id" readonly="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="period"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="source_of_data"/>
                                    <field name="method_of_calculation"/>
                                    <field name="calculation_type"/>
                                    <field name="desired_performance"/>
                                    <field name="means_of_verification"/>
                                    <field name="assumptions"/>
                                    <field name="spatial_transformation"/>
                                    <field name="department_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="section"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="portfolio_description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="performance_performance_view_list" model="ir.ui.view">
        <field name="name">performance.portfolio.view.list</field>
        <field name="model">performance.portfolio</field>
        <field name="arch" type="xml">
            <list class="performance_management" string="performance_performance">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="performance_performance_action" model="ir.actions.act_window">
        <field name="name">Portfolio</field>
        <field name="res_model">performance.portfolio</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Portfolio!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="performance_performance_menu"
              name="Portfolio"
              parent="governance.menu_governance_root"
              action="performance_performance_action"
              sequence="10"/>
</odoo>