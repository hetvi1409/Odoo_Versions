<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="indicator_target_quarter_view_form" model="ir.ui.view">
        <field name="name">indicator.target.quarter.view.form</field>
        <field name="model">indicator.target.quarter</field>
        <field name="arch" type="xml">
            <form string="Indicator Quarterly Target">
                <sheet>
                    <group>
                        <!-- <field name="target_name_id" required="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/> -->
                        <field name="name" required="1"/>
                    </group>
                    <group>
                        <group>
                            <!-- <label for="start_date"/> -->
                            <div class="oe_inline">
                                <!-- <field name="start_date" class="oe_inline" placeholder="Start Date"/>
                                <field name="end_date" class="oe_inline" placeholder="End Date"/> -->
                            </div>
                            <field name="indicator_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <!-- <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/> -->
                        </group>
                        <group>
                            <!-- <field name="target_numeric"/>
                            <field name="achieved_target_numeric"/>
                            <field name="variance_numeric"/>
                            <field name="target"/>
                            <field name="total_achieved_target_numeric"/> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Reporting">
                            <!-- <field name="line_ids">
                                <list class="performance_management" default_order="id desc" editable="bottom"  open_form_view="1">
                                    <field name="name" required="1"/>
                                    <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="achievement" required="1"/>
                                    <field name="achieved_target_numeric" required="1"/>
                                </list>
                            </field> -->
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="indicator_target_quarter_view_list" model="ir.ui.view">
        <field name="name">indicator.target.quarter.view.list</field>
        <field name="model">indicator.target.quarter</field>
        <field name="arch" type="xml">
            <list class="performance_management" string="indicator_target">
                <field name="name"/>
                <!-- <field name="indicator_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="target_numeric" />
                <field name="achieved_target_numeric" />
                <field name="variance_numeric" /> -->
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="indicator_target_quarter_action" model="ir.actions.act_window">
        <field name="name">Indicator Quarterly Target</field>
        <field name="res_model">indicator.target.quarter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Indicator Quarterly Target!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="indicator_target_quarter_menu"
              name="Indicator Quarterly Targets"
              action="indicator_target_quarter_action"
              parent="governance.menu_configuration"
              sequence="4"/>
</odoo>