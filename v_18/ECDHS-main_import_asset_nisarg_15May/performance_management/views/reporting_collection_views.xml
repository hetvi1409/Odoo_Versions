<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="reporting_collection_view_form" model="ir.ui.view">
        <field name="name">reporting.collection.view.form</field>
        <field name="model">reporting.collection</field>
        <field name="arch" type="xml">
            <form string="Reporting Collection">
                <sheet>
                    <group>
                        <field name="name" required="0" readonly="1" force_save="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="indicator_id" required="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="target_id" required="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <label for="start_date"/>
                            <div class="oe_inline">
                                <field name="start_date" class="oe_inline" placeholder="Start Date"/>
                                <field name="end_date" class="oe_inline" placeholder="End Date"/>
                            </div>
                            <field name="blockages" />
                            <field name="timeframe" />
                        </group>
                        <group>
                            <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="achieved_target_numeric" required="1"/>
                            <field name="achieved_value" required="1"/>
                            <field name="residual_performance"/>
                            <field name="remedial_measures" />
                            <field name="comments" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Portfolio Description" name="lines">
                            <field name="line_ids">
                                <list class="performance_management" >
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="reporting_collection_view_list" model="ir.ui.view">
        <field name="name">reporting.collection.view.list</field>
        <field name="model">reporting.collection</field>
        <field name="arch" type="xml">
            <list class="performance_management" string="reporting_collection" editable="bottom"  open_form_view="1">
                <!-- <button name="open_view"
                        type="object"
                        string="View"
                        class="oe_link"/>
                <button name="action_view_reporting_collection_form" type="object" string="View" class="btn-primary"/> -->
                <field name="dimension_id" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="name" required="0" readonly="1" force_save="1"/>
                <field name="indicator_id" invisible="0" required="1" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="target_id" required="1" force_save="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="achievement" required="1"/>
                <field name="achieved_target_numeric" required="1"/>
                <field name="achieved_value" required="1"/>
                <field name="user_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="evidence" required="1"/>
                <button name="action_preview_document"
                        type="object"
                        string="Preview"
                        class="btn-primary"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="residual_performance"/>
                <field name="blockages" />
                <field name="remedial_measures" />
                <field name="timeframe" />
                <field name="comments" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="reporting_collection_action" model="ir.actions.act_window">
        <field name="name">Reporting Collection</field>
        <field name="res_model">reporting.collection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Reporting Collection!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="reporting_collection_menu"
              name="Reporting Submission(Data Collection)"
              action="reporting_collection_action"
              parent="governance.menu_configuration"
              sequence="0"/>
</odoo>