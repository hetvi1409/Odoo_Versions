<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_target_targets_form" model="ir.ui.view">
            <field name="name">target.targets.form</field>
            <field name="model">target.targets</field>
            <field name="arch" type="xml">
                <form string="Target Submission">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
    </record>

    <!-- Action -->
    <record id="action_target_targets" model="ir.actions.act_window">
        <field name="name">Target Submission</field>
        <field name="res_model">target.targets</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Target Submission!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_target_targets"
              name="Target Submissions"
              action="action_target_targets"
              parent="governance.menu_configuration"
              sequence="5"/>
</odoo>