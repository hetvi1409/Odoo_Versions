<odoo>
    <record id="view_app_quarterly_report_wizard_form" model="ir.ui.view">
        <field name="name">app.quarterly.report.wizard.form</field>
        <field name="model">app.quarterly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Application Quarterly Report">
                <group>
                    <field name="portfolio_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                    <field name="target"/>
                </group>
                <footer>
                    <button name="action_print_quarterly_report" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

        <record id="report_app_quarterly_action" model="ir.actions.act_window">
        <field name="name">APP Quarterly Report</field>
        <field name="res_model">app.quarterly.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="app_quarterly_report_menu"
              name="APP Quarterly Report"
              action="report_app_quarterly_action"
              sequence="5"
              parent="performance_management.report_menu"/>
</odoo>
