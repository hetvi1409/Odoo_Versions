<odoo>
    <record id="view_risk_register_import_wizard_form" model="ir.ui.view">
        <field name="name">risk.register.import.form</field>
        <field name="model">risk.register.import</field>
        <field name="arch" type="xml">
            <form string="Import Risk Register" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="risk_register_type"/>
                        <field name="file" filename="file_name"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_xlsx" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_risk_register_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Risk Register</field>
        <field name="res_model">risk.register.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_risk_register_import_wizard"
              name="Import Risk Register"
              parent="oi_risk_management.menu_root"
              action="action_risk_register_import_wizard"
              sequence="13"/>
</odoo>