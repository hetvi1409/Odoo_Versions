                <attribute name="readonly">state not in ['draft'] or not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='consequences']" position="attributes">
                <attribute name="readonly">state not in ['draft'] or not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='consequences']" position="after">
                <field name="link_to_outcome" readonly="not can_edit"/>
                <field name="chief_directorate_id" readonly="not can_edit"/>
                <field name="directorate_id" readonly="not can_edit"/>
                <field name="impact_value" readonly="not can_edit"/>
                <field name="likelihood_value" readonly="not can_edit"/>
                <field name="inherent_risk_value" readonly="not can_edit"/>
                <field name="current_controls" readonly="not can_edit"/>
            </xpath>
            <xpath expr="//field[@name='activity_id']" position="attributes">
