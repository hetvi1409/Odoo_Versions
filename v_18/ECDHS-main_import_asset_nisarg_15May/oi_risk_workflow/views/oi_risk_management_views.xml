<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="risk_treatment_view_form" model="ir.ui.view">
        <field name="name">oi_risk_management.risk.view.form.</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="oi_risk_management.risk_treatment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <field name="risk_treatment_state" widget="statusbar" options="{'clickable': '1'}"/>

                    <button name="action_risk_treatment_prepare" type="object" string="Prepare"
                            class="oe_highlight"
                            invisible="risk_treatment_state != 'draft'  or uid != preparer_id"/>
                    <button name="action_risk_treatment_reviewed" type="object" string="Reviewed"
                            class="oe_highlight"
                            invisible="risk_treatment_state != 'prepared' or uid != reviewer_id"/>
                    <button name="action_risk_treatment_approved" type="object" string="Approved"
                            class="oe_highlight"
                            invisible="risk_treatment_state != 'reviewed' or uid != approver_id"/>
                    <button name="action_risk_treatment_rejected" type="object" string="Rejected"
                            class="oe_highlight"
                            invisible="risk_treatment_state != 'reviewed' or uid != approver_id"/>
                    <button name="action_treatment_revert" type="object"
                            invisible="risk_treatment_state not in ['prepared','reviewed']"
                            string="Revert" class="oe_highlight"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Approvers">
                    <group>
                        <group>
                            <field name="can_edit" invisible="1"/>
                            <field name="preparer_id" widget="many2one_avatar_user"/>
                            <field name="reviewer_id" widget="many2one_avatar_user"/>
                            <field name="approver_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                </page>
                <page string="Reverts/ Review Notes">
                    <group>
                        <field name="feedback" readonly="not can_edit"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_records" type="object"
                            class="oe_stat_button" icon="fa-book">Revert Records
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='activity_id']" position="attributes">
                <attribute name="readonly">state not in ['draft'] or not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='factor_sequence']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">state not in ['draft'] or not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='risk_treatment_ids']" position="attributes">
                <attribute name="readonly">not can_edit</attribute>
            </xpath>
        </field>
    </record>
