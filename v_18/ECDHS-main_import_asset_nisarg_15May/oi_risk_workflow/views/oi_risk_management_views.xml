    <record id="risk_form" model="ir.ui.view">
        <field name="name">oi_risk_management.risk.view.form.</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="oi_risk_management.risk_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_risk_prepare']" position="replace">
                <button name="action_risk_prepare" type="object" string="Prepare"
                        class="oe_highlight"
                        invisible="risk_state != 'draft' or uid != preparer_id"/>
            </xpath>
            <xpath expr="//button[@name='action_risk_reviewed']" position="replace">
                <button name="action_risk_reviewed" type="object" string="Reviewed"
                        class="oe_highlight"
                        invisible="risk_state != 'prepared' or uid != reviewer_id"/>
                <button name="action_risk_revert" type="object"
