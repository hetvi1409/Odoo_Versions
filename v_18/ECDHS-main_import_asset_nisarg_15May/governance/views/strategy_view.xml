<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_strategic_planning_tree" model="ir.ui.view">
        <field name="name">strategic.planning.tree</field>
        <field name="model">strategic.planning</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref" readonly="1"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_strategic_planning_form" model="ir.ui.view">
        <field name="name">strategic.planning.form</field>
        <field name="model">strategic.planning</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_objectives" icon="fa-star">
                            <field string="Objectives" name="objectives_count"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="ref" readonly="(1 == 1)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Strategy Description" name="strategy">
                            <field name="strategy"
                                   placeholder="Enter Your Strategy Description"
                                   options="{'collaborative': true, 'resizable':true, 'codeview':true}"/>
                        </page>
                        <page string="Goals" name="goals">
                            <field name="goal" readonly="(1 == 1)"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_strategic_planning" model="ir.actions.act_window">
        <field name="name">Strategic Planning</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">strategic.planning</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">

            <p class="'o_view_nocontent_smiling_face">
                Create your strategy!
            </p>
        </field>
    </record>
    <menuitem
            id="menu_strategic_planning"
            name="Strategy"
            action="action_strategic_planning"
            parent="menu_strategy"
            sequence="30"/>
</odoo>