<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_objectives_tree" model="ir.ui.view">
        <field name="name">business.objectives.tree</field>
        <field name="model">business.objectives</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref" readonly="1"/>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="goal"/>
            </list>
        </field>
    </record>
    <record id="view_business_objectives_form" model="ir.ui.view">
        <field name="name">business.objectives.form</field>
        <field name="model">business.objectives</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ref" readonly="(1 == 1)"/>
                        </h1>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="goal"/>
                    </group>
                    <notebook>
                        <page string="Objectives Description" name="objectives">
                            <field name="objectives" placeholder="Enter_Your_Objectives Description"
                                   options="{'collaborative': true, 'resizable':true, 'codeview':true}"/>
                        </page>
                        <page string="Projects" name="projects">
                             <attribute name="default_sort"/>
                            <field name="projects"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_business_objectives" model="ir.actions.act_window">
        <field name="name">Objectives</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">business.objectives</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">

            <p class="'o_view_nocontent_smiling_face">
                Create your Objectives!
            </p>
        </field>
    </record>
    <menuitem
            id="menu_business_objectives"
            name="Objectives"
            action="action_business_objectives"
            parent="menu_strategy"
            sequence="50"/>
</odoo>