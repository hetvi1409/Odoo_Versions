<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_action_log_tree" model="ir.ui.view">
        <field name="name">action.log.tree</field>
        <field name="model">action.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee"/>
                <field name="target_date"/>
                <field name="close_date"/>
            </list>
        </field>
    </record>
    <record id="view_action_log_form" model="ir.ui.view">
        <field name="name">action.log.form</field>
        <field name="model">action.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                            <field name="level"/>

                        </group>
                    <group>
                          <field name="employee"/>
                            <field name="target_date"/>
                            <field name="close_date"/>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_action_log" model="ir.actions.act_window">
        <field name="name">Action Log</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">action.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">

            <p class="'o_view_nocontent_smiling_face">
                Create your first Action !
            </p>
        </field>
    </record>
    <menuitem
            id="menu_action_log"
            name="Actions"
            action="action_action_log"
            parent="menu_problem"
            sequence="30"/>

</odoo>