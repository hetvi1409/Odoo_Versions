<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_risk_category_tree" model="ir.ui.view">
        <field name="name">risk.category.tree</field>
        <field name="model">risk.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_risk_category_form" model="ir.ui.view">
        <field name="name">risk.category.form</field>
        <field name="model">risk.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="color_2" widget="color" groups="base.group_no_one"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_risk_category" model="ir.actions.act_window">
        <field name="name">Risk Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">risk.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">

            <p class="'o_view_nocontent_smiling_face">
                Create your first Risk Category !
            </p>
        </field>
    </record>

    <menuitem
            id="menu_risk_category"
            name="Risk Categories"
            action="action_risk_category"
            parent="menu_register"
            sequence="10"/>


</odoo>