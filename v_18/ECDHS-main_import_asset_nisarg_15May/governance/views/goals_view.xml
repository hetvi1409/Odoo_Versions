<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_goals_tree" model="ir.ui.view">
        <field name="name">business.goals.tree</field>
        <field name="model">business.goals</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref" readonly="1"/>
                <field name="name"/>
                <field name="strategy" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_business_goals_form" model="ir.ui.view">
        <field name="name">business.goals.form</field>
        <field name="model">business.goals</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ref" readonly="(1 == 1)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="strategy"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goal Description" name="goal">
                            <field name="goal"
                                   placeholder="Enter_Your_Goal Description"
                                   options="{'collaborative': true, 'resizable':true, 'codeview':true}"/>
                        </page>
                        <page string="Objectives" name="objectives">
                            <field name="objectives" readonly="(1 == 1)"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_business_goals" model="ir.actions.act_window">
        <field name="name">Goals</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">business.goals</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="xml">

            <p class="'o_view_nocontent_smiling_face">
                Create your Goals!
            </p>
        </field>
    </record>
    <menuitem
            id="menu_business_goals"
            name="Goals"
            action="action_business_goals"
            parent="menu_strategy"
            sequence="40"/>
</odoo>