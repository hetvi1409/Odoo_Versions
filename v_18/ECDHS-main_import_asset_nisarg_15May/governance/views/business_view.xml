<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_register_business_tree" model="ir.ui.view">
        <field name="name">register.business.tree</field>
        <field name="model">register.business</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" readonly="1"/>
                <field name="challenge"/>
                <field name="impact"/>
                <field name="cause"/>
                <field name="solution"/>
                <field name="owner"/>
            </list>
        </field>
    </record>


    <record id="view_register_business_form" model="ir.ui.view">
        <field name="name">register.business.form</field>
        <field name="model">register.business</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="challenge"/>
                            <field name="impact"/>
                            <field name="cause"/>
                        </group>
                        <group>
                            <field name="solution" optional="show"/>
                            <field name="owner"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

       <record id="view_register_business_search" model="ir.ui.view">
        <field name="name">register.business.search</field>
        <field name="model">register.business</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tag_ids"/>
                <field name="owner"/>
                 <filter name="group_by_owner" context="{'group_by': 'owner'}"/>
            </search>
        </field>
    </record>

    <record id="action_register_business" model="ir.actions.act_window">
        <field name="name">Challenges</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">register.business</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">

            <p class="'o_view_nocontent_smiling_face">
                Create your Business Challenges !
            </p>
        </field>
    </record>
    <menuitem
            id="menu_business"
            name="Challenges"
            action="action_register_business"
            parent="menu_register"
            sequence="20"/>


</odoo>