<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_problem_analysis_tree" model="ir.ui.view">
        <field name="name">problem.analysis.tree</field>
        <field name="model">problem.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref" readonly="1"/>
                <field name="name"/>
                <field name="event_date"/>
                <field name="report_date" optional="show"/>
                <field name="employee"/>
            </list>
        </field>
    </record>


    <record id="view_problem_analysis_form" model="ir.ui.view">
        <field name="name">problem.analysis.form</field>
        <field name="model">problem.analysis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ref" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="event_date"/>
                            <field name="report_date" optional="show"/>
                            <field name="event_type"/>
                            <field name="employee"/>
                        </group>
                        <group>
                            <field name="consequence"/>
                            <field name="issue"/>
                            <field name="affect"/>
                            <field name="risk"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="Enter Your Problem Description"/>
                        </page>
                        <page string="Suggestions" name="suggestions">
                            <field name="suggestions"
                                   placeholder="Enter Your Suggestions"/>
                        </page>
                        <page string="Actions" name="actions">
                            <field name="action_log"/>
                        </page>

                        <page string="Root Cause" name="root_cause">
                            <field name="root_cause"/>
                        </page>

                        <page string="Lot Details" name="lot">
                            <field name="lot"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_problem_analysis_search" model="ir.ui.view">
        <field name="name">problem.analysis.search</field>
        <field name="model">problem.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref"/>
                <field name="event_type"/>
                <field name="employee"/>
                <filter name="group_by_employee"
                        context="{'group_by': 'employee'}"/>
            </search>
        </field>
    </record>

    <record id="action_problem_analysis" model="ir.actions.act_window">
        <field name="name">Problem</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">problem.analysis</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">

            <p class="'o_view_nocontent_smiling_face">
                Create your Defect Problem !
            </p>
        </field>
    </record>
    <menuitem
            id="menu_defect"
            name="Problem"
            action="action_problem_analysis"
            parent="menu_problem"
            sequence="50"/>


</odoo>