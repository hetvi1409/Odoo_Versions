<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_strategy_details">
        <t t-call="web.html_container">

            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h1>Strategy Details</h1>
                        <p>Title of the strategy is <b><span  t-field="o.name"/> </b></p>

                        <table class="table table-condensed">
                            <tr>
                                <td>
                                    Strategy Id
                                </td>
                                <td>
                                    <span t-field="o.ref"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Strategy Description
                                </td>
                                <td>
                                    <span t-field="o.strategy"/>
                                </td>
                            </tr>
                        </table>

                        <t t-if="o.goal">
                            <table class="table table-condensed">
                                <tr><th><b>Reference</b></th>
                                    <th><b>Goals</b></th></tr>
                                <t t-foreach="o.goal" t-as="line">
                                    <tr>
                                        <td>
                                            <b><span t-field="line.ref"/></b>
                                        </td>
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <t t-foreach="line.objectives" t-as="obj">
                                        <tr>
                                            <td>
                                                <span t-field="obj.ref"/>
                                            </td>
                                            <td>
                                                <span t-field="obj.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr><td></td><td></td></tr>
                                </t>
                            </table>
                        </t>


                    </div>
                </t>
            </t>
        </t>

    </template>
</odoo>
