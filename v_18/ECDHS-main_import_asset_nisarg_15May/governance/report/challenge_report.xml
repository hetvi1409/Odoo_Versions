<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_challenge_details">
        <t t-call="web.html_container">

            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h1>Challenge Details</h1>
                        <p>Title of the challenge is <b><span  t-field="o.challenge"/> </b></p>

                        <table class="table table-condensed">
                            <tr>
                                <td>
                                   Challenge ID
                                </td>
                                <td>
                                    <span t-field="o.name"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Impact
                                </td>
                                <td>
                                    <span t-field="o.impact"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                  Cause
                                </td>
                                <td>
                                    <span t-field="o.cause"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                Solution
                                </td>
                                <td>
                                    <span t-field="o.solution"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                  Owner
                                </td>
                                <td>
                                    <span t-field="o.owner"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                   Category Tag
                                </td>
                                <td>
                                    <span t-field="o.tag_ids"/>
                                </td>
                            </tr>

                        </table>
                    </div>
                </t>
            </t>
        </t>

    </template>
</odoo>
