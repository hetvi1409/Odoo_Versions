<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_problem_report">
        <t t-call="web.html_container">

                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="oe_structure"/>
<!--                            <div class="col-xs-8">-->
                                    <h1>Problem Details</h1>
                                    <p>Title of the problem is <b><span  t-field="o.name"/> </b></p>

                                    <table class="table table-condensed">
                                        <tr>
                                            <td>
                                                Report Number
                                            </td>
                                            <td>
                                                <span t-field="o.ref"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                Event date
                                            </td>
                                            <td>
                                                <span t-field="o.event_date"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                Report date
                                            </td>
                                            <td>
                                                <span t-field="o.report_date"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                Employee reporting Event
                                            </td>
                                            <td>
                                                <span t-field="o.employee"/>
                                            </td>
                                        </tr>
                                    </table>

                            </div>
<!--                        </div>-->
                </t>
            </t>
        </t>

    </template>
</odoo>
