<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_risk_details">
        <t t-call="web.html_container">

            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h1>Risk Details</h1>
                        <p>Title of the risk is <b><span  t-field="o.summary"/> </b></p>

                        <table class="table table-condensed">
                            <tr>
                                <td>
                                    Risk ID
                                </td>
                                <td>
                                    <span t-field="o.name"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Owner
                                </td>
                                <td>
                                    <span t-field="o.owner"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                   Risk Severity
                                </td>
                                <td>
                                    <span t-field="o.severity"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                 Risk Status
                                </td>
                                <td>
                                    <span t-field="o.status"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Next Review
                                </td>
                                <td>
                                    <span t-field="o.next_date"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                   Category Tag
                                </td>
                                <td>
                                    <span t-field="o.category"/>
                                </td>
                            </tr>

                        </table>
                    </div>
                </t>
            </t>
        </t>

    </template>
</odoo>
