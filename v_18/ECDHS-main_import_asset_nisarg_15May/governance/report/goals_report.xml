<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_goal_details">
        <t t-call="web.html_container">

            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h1>Goal Details</h1>
                        <p>Title of the goal is <b><span  t-field="o.name"/> </b></p>

                        <table class="table table-condensed">
                            <tr>
                                <td>
                                    Goal
                                </td>
                                <td>
                                    <span t-field="o.goal"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Strategy
                                </td>
                                <td>
                                    <span t-field="o.strategy"/>
                                </td>
                            </tr>
                        </table>
                        <t t-if="o.objectives">
                            <table class="table table-condensed">
                                <tr><th><b>Reference</b></th>
                                    <th><b>Objectives</b></th></tr>
                                <t t-foreach="o.objectives" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.ref"/>
                                        </td>
                                        <td>
                                            <span t-field="line.name"/>

                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>

    </template>
</odoo>
