<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Sequence for Tender -->
        <record id="seq_tender" model="ir.sequence">
            <field name="name">Tender Sequence</field>
            <field name="code">tender.tender</field>
            <field name="prefix">TND</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
        <record id="demand_request_sequence" model="ir.sequence">
            <field name="name">Demand Request</field>
            <field name="code">demand.management</field>
            <field name="prefix">DM</field>
            <field name="padding">10</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>