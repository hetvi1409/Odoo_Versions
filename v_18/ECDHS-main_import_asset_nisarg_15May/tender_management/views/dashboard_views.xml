    <!-- Adding CRM Dashboard to the CRM Menu -->
    <menuitem name="Overview" id="tender_dashboard_menu"
              parent="tender_management.menu_tender_management_root"
              sequence="0" action="action_tender_management_dashboard"/>
</odoo>
