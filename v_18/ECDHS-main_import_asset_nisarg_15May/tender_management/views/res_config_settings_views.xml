<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tender</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tender Management" string="Tender Management" name="tender_management">
                    <block title="Tender Management">
                        <setting id="folder_id" string="Folder" help="Folder For Tender">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field class="w-50" name="folder_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

