<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="housing_grant_review_view_form" model="ir.ui.view">
        <field name="name">housing.grant.review.view.form</field>
        <field name="model">housing.grant.review</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="comments"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>