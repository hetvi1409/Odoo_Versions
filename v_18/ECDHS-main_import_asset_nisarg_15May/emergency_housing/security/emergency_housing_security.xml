<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_emergency_housing" model="ir.module.category">
        <field name="name">Emergency Housing</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_emergency_housing_municipality_officer" model="res.groups">
        <field name="name">Emergency Housing: Municipality Officer</field>
        <field name="category_id" ref="emergency_housing.module_category_emergency_housing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_emergency_housing_province_officer" model="res.groups">
        <field name="name">Emergency Housing: Province Officer</field>
        <field name="category_id" ref="emergency_housing.module_category_emergency_housing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>