<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record model="ir.ui.view" id="res_country_city_view_list">
        <field name="name">res.country.city.list</field>
        <field name="model">res.country.city</field>
        <field name="priority">1</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="country_id" options="{'no_create_edit': 1, 'no_quick_create': 1}"/>
                <field name="province_id" options="{'no_create_edit': 1, 'no_quick_create': 1}"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </list>
        </field>
    </record>
    
    <record id="res_country_city_action" model="ir.actions.act_window">
        <field name="name">City</field>
        <field name="res_model">res.country.city</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new City
            </p>
        </field>
    </record>

    <menuitem id="res_country_city_menu" name="City"
              action="res_country_city_action"
              parent="emergency_housing.menu_house_configuration"/>

</odoo>