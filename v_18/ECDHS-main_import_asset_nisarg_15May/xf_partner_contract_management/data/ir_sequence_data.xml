<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- sequence for employee purchase requisition -->
        <record id="sequence_contract_memo" model="ir.sequence">
            <field name="name">Memo</field>
            <field name="code">contract.memo</field>
            <field name="prefix">MEMO/%(day)s/%(month)s/%(year)s:</field>
            <field name="padding">3</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
        <record id="sequence_contract_procurement" model="ir.sequence">
            <field name="name">Memo</field>
            <field name="code">contract.procurement.request</field>
            <field name="prefix">Prop/%(day)s/%(month)s/%(year)s:</field>
            <field name="padding">4</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
        <record id="sequence_contract_amendment" model="ir.sequence">
            <field name="name">Contract Amendment</field>
            <field name="code">contract.amendment</field>
            <field name="prefix">AMEND/%(year)s/</field>
            <field name="padding">4</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
    </data>
</odoo>