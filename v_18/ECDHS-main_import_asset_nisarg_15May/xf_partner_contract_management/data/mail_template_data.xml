    <record id="email_template_non_compliance" model="mail.template">
        <field name="name">Non-Compliance Notification</field>
        <field name="model_id" ref="xf_partner_contract_management.model_contract_monitoring_report"/>
        <field name="email_from">{{ object.company_id.email or '' }}</field>
        <field name="email_to">{{ object.partner_id.email or '' }}</field>
        <field name="subject">Contract Non-Compliance Notification: {{ object.contract_id.name or 'n/a' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.partner_id.name or 'Sir/Madam'"/>,</p>
                <p>We have identified non-compliance issues in contract
                    <strong><t t-out="object.contract_id.name"/></strong>.
                </p>
                <p>Please address these issues within 7 days.</p>
            </div>
        </field>
    </record>

    <record id="email_template_contract_expiry_notice" model="mail.template">
        <field name="name">Contract Expiry Notice (6 Months)</field>
        <field name="model_id" ref="xf_partner_contract_management.model_xf_partner_contract"/>
        <field name="subject">Contract {{ object.name or 'n/a' }} expires on {{ object.date_end or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.user_id.name or 'Colleague'"/>,</p>
                <p>The contract <strong><t t-out="object.name"/></strong> is due to expire on
                    <strong><t t-out="object.date_end"/></strong>.
                </p>
                <p>Please complete the SOP expiry checklist and start procurement in time where continuation is required.</p>
                <p>
                    <a t-att-href="object.get_list_url()">Open Contract</a>
                </p>
            </div>
        </field>
    </record>
