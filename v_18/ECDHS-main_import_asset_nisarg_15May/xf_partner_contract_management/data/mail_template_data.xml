<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_send_contract" model="mail.template">
        <field name="name">Send Contract</field>
        <field name="model_id"
               ref="xf_partner_contract_management.model_xf_partner_contract"/>
        <field name="subject">The Contract {{ object.name or 'n/a' }} is
            Verified.
        </field>
        <field name="description">send to the customers.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi<t t-out="object.partner_id.name"/>,
                    <br/>
                    The Contract
                    <t t-out="object.name"/>
                    was Verified.
                </p>
            </div>
            <div style="margin: 16px 0px 16px 0px;">
                <a t-att-href="(object.get_list_url())"
                   style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                    <t>
                        Open
                        <t t-out="object.name"/>
                    </t>
                </a>
            </div>

        </field>
    </record>
