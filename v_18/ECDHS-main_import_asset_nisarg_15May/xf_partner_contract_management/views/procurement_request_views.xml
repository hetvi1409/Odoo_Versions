<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Contract Form View Extension -->

    <!-- Procurement Request Form View -->
    <record id="view_procurement_request_form" model="ir.ui.view">
        <field name="name">procurement.request.form</field>
        <field name="model">contract.procurement.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_completed"
                            type="object"
                            string="Mark Completed"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="contract_id" readonly="True"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="end_user_id"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="user_id"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <field name="notes"/>
                        </page>
                        <page string="Related Documents">
                            <p class="text-muted">See the chatter below for related messages and attachments.</p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Procurement Request list View -->
    <record id="view_procurement_request_list" model="ir.ui.view">
        <field name="name">procurement.request.list</field>
        <field name="model">contract.procurement.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state in ['submitted','in_progress']"
                  decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="request_date"/>
                <field name="reason"/>
                <field name="user_id"/>
                <field name="end_user_id"/>
                                <field name="notes" optional="show"/>
                                <field name="create_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ['submitted','in_progress']"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="action_contract_procurement_request"
            model="ir.actions.act_window">
        <field name="name">Procurement Requests</field>
        <field name="res_model">contract.procurement.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_contract_procurement"
              name="Procurement Requests"
              parent="xf_partner_contract.xf_partner_contract_root_menuitem"
              sequence="30"
              action="action_contract_procurement_request"/>

</odoo>