<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="contract_memo_action" model="ir.actions.act_window">
        <field name="name">RFQ Memo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">contract.memo</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <record id="contract_memo_view_form" model="ir.ui.view">
        <field name="name">contract.memo.view.form</field>
        <field name="model">contract.memo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget='statusbar'
                           statusbar_visible='draft,approve'/>
                    <button name="action_submit"
                            class="oe_highlight" invisible="state != 'draft'"
                            string="Submit" type="object"/>
                    <button name="action_documents"
                            class="oe_highlight" invisible="state != 'submit'"
                            string="Supporting Document" type="object"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="view_contract_details" type="object"
                                class="oe_stat_button"
                                invisible="contract_id == False">
                            <i class="fa fa-edit o_button_icon text-success" title="Contract Details"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Contract</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="New"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="type"/>
                            <field name="date_start"/>
                            <field name="total_amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="contract_amount_type"/>
                            <field name="date_end"/>
                            <field name="company_id"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="contract_id" invisible="True"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="budget_id"
                               options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="contract_memo_view_tree" model="ir.ui.view">
        <field name="name">contract.memo.view.tree</field>
        <field name="model">contract.memo</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'submit'"
                  decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="type"/>
                <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="date_start" optional="show"/>
                                <field name="date_end" optional="show"/>
                                <field name="company_id" optional="show"/>
                <field name="state" decoration-info="state == 'draft'"
                       decoration-warning="state == 'submit'"
                       decoration-success="state == 'approved'" widget="badge"/>
            </list>
        </field>
    </record>
    <menuitem id="contract_memo_menu"
              name="RFQ Memo"
              parent="xf_partner_contract.xf_partner_contract_root_menuitem"
              action="contract_memo_action"/>
<!--              groups="supply_chain_management.purchase_requisition_user"/>-->
</odoo>
