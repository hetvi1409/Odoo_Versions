<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="contract_amendment_view_form" model="ir.ui.view">
        <field name="name">contract.amendment.view.form</field>
        <field name="model">contract.amendment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="xf_partner_contract.group_xf_partner_contract_manager"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            invisible="state not in ['submitted', 'draft']"
                            groups="xf_partner_contract.group_xf_partner_contract_manager"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="version_number" readonly="True"/>
                            <field name="amendment_type"
                                   readonly="state != 'draft'"/>
                            <field name="requested_by"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="True"
                                options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                   invisible="state not in ['approved']"/>
                            <field name="date_approved" readonly="True"
                                   invisible="state not in ['approved']"/>
                            <field name="rejection_reason" readonly="True"
                                   invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <group string="Description / Motivation">
                        <field name="description" nolabel="1" widget="html"
                               readonly="state != 'draft'"/>
                    </group>
                    <group string="Supporting Documents">
                        <field name="attachment_ids" nolabel="1"
                               widget="many2many_binary"
                               readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="contract_amendment_view_list" model="ir.ui.view">
        <field name="name">contract.amendment.view.list</field>
        <field name="model">contract.amendment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="version_number"/>
                <field name="amendment_type"/>
                <field name="requested_by"/>
                <field name="approved_by" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'rejected'"/>
                <field name="date_approved" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="contract_amendment_action" model="ir.actions.act_window">
        <field name="name">Contract Amendments</field>
        <field name="res_model">contract.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No amendments yet
            </p>
        </field>
    </record>

    <menuitem id="menu_contract_amendments"
              name="Amendments"
              action="contract_amendment_action"
              parent="xf_partner_contract.xf_partner_contract_root_menuitem"
              sequence="25"/>

</odoo>
