<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edc_evaluation_view_form" model="ir.ui.view">
        <field name="name">edc.evaluation.view.form</field>
        <field name="model">memo.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="memo_id" readonly="True"/>
                    <field name="status"/>
                    <field name="reason"/>
                    <field name="supplier_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit" type="object"
                            default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>