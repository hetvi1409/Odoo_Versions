<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_opms_submission_reminder" model="mail.template">
            <field name="name">OPMS: Submission Reminder</field>
            <field name="model_id" ref="model_opms_quarter"/>
            <field name="subject">OPMS Submission Reminder – ${object.code and object.code.upper() or object.name or ''}: ${ctx.get('opms_reminder_label') or 'Submission Reminder'}</field>
            <field name="email_from">${(user.email_formatted or '')|safe}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html">
                <![CDATA[
<div style="background-color:#e8f0fe;border:1px solid #aac0e8;border-radius:8px;padding:18px 24px;color:#1a2b4a;font-family:Arial,Helvetica,sans-serif;max-width:680px;">

    <h3 style="margin:0 0 4px 0;color:#1a2b4a;font-size:17px;font-weight:bold;">ECDHS OPMS &ndash; Submission Reminder</h3>
    <p style="margin:0 0 14px 0;font-size:13px;color:#4a5a6a;">Operational Performance Management System</p>

    <p style="margin:0 0 12px 0;">Please be advised of the following submission window notification:</p>

    <table border="0" cellpadding="7" cellspacing="0" style="margin:12px 0;border-collapse:collapse;width:100%;font-size:14px;">
        <tr style="background-color:#d0ddf8;">
            <td style="font-weight:bold;width:220px;padding:7px 14px 7px 8px;border:1px solid #b0c4e8;">Reminder Type</td>
            <td style="padding:7px 8px;border:1px solid #b0c4e8;">${ctx.get('opms_reminder_label') or '-'}</td>
        </tr>
        <tr>
            <td style="font-weight:bold;padding:7px 14px 7px 8px;border:1px solid #b0c4e8;">Quarter</td>
            <td style="padding:7px 8px;border:1px solid #b0c4e8;">${object.code and object.code.upper() or object.name or '-'}${' - ' + (object.financial_year.name or '') if object.financial_year else ''}</td>
        </tr>
        <tr style="background-color:#d0ddf8;">
            <td style="font-weight:bold;padding:7px 14px 7px 8px;border:1px solid #b0c4e8;">Notification Date</td>
            <td style="padding:7px 8px;border:1px solid #b0c4e8;">${ctx.get('opms_notification_date') or '-'}</td>
        </tr>
        <tr>
            <td style="font-weight:bold;padding:7px 14px 7px 8px;border:1px solid #b0c4e8;">Submission Opens</td>
            <td style="padding:7px 8px;border:1px solid #b0c4e8;"><strong>${ctx.get('opms_submission_open_date') or '-'}</strong></td>
        </tr>
        <tr style="background-color:#d0ddf8;">
            <td style="font-weight:bold;padding:7px 14px 7px 8px;border:1px solid #b0c4e8;">Submission Closes</td>
            <td style="padding:7px 8px;border:1px solid #b0c4e8;"><strong>${ctx.get('opms_submission_close_date') or '-'}</strong></td>
        </tr>
        % if ctx.get('opms_custom_note'):
        <tr>
            <td style="font-weight:bold;padding:7px 14px 7px 8px;border:1px solid #b0c4e8;color:#8a3a00;">Additional Note</td>
            <td style="padding:7px 8px;border:1px solid #b0c4e8;">${ctx.get('opms_custom_note')}</td>
        </tr>
        % endif
    </table>

    <p style="margin:12px 0;">Please ensure all reporting submissions are completed within the submission window.</p>

    <p style="margin:20px 0 8px 0;">
        <a href="/odoo/opms" style="display:inline-block;padding:9px 20px;background-color:#3b5ea6;color:#ffffff;text-decoration:none;border-radius:4px;font-weight:bold;font-family:Arial,sans-serif;font-size:14px;">Open OPMS Portal</a>
    </p>

    <p style="margin:20px 0 0 0;font-size:13px;">Kind regards,<br/><strong>ECDHS OPMS System</strong><br/><em>Eastern Cape Department of Human Settlements</em></p>
</div>
                ]]>
            </field>
        </record>

    </data>
</odoo>
