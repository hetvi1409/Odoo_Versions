<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_opms" model="ir.module.category">
            <field name="name">OPMS</field>
            <field name="description">Operational Performance Management System access groups.</field>
            <field name="sequence">35</field>
        </record>

        <record id="group_opms_submissions_user" model="res.groups">
