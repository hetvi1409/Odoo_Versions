<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_opms_app_annual_report_wizard_form" model="ir.ui.view">
            <field name="name">opms.app.annual.report.wizard.form</field>
            <field name="model">opms.app.annual.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Print OPMS APP Annual Report">
                    <group>
                        <field name="programme_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                    </group>
                    <footer>
                        <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_opms_app_annual_report_wizard" model="ir.actions.act_window">
            <field name="name">APP Annual Report</field>
            <field name="res_model">opms.app.annual.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
