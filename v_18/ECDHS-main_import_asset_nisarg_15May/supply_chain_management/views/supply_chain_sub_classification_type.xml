<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="supply_sub_classification_type_view_order_form"
            model="ir.ui.view">
        <field name="name">supply.chain.sub.classification.type.form</field>
        <field name="model">supply.chain.sub.classification.type</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
<!--                    <field name="parent_id"/>-->
<!--                    <field name="child_ids" editble="bottom"/>-->
                </group>
            </form>
        </field>
    </record>

    <record id="supply_sub_classification_type_view_order_tree" model="ir.ui.view">
            <field name="name">supply.chain.sub.classification.type.tree</field>
            <field name="model">supply.chain.sub.classification.type</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                    <list>
                        <field name="name"/>
                    </list>
            </field>
        </record>

    <record model="ir.actions.act_window" id="supply_sub_classification_type_action">
            <field name="name">Supply Chain Sub Classification Type</field>
            <field name="res_model">supply.chain.sub.classification.type</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="supply_sub_classification_type_view_order_tree"/>
        </record>

    <menuitem id="supply_sub_chain_classification_type"
              name="Supply Chain Sub Classification Type"
              action="supply_sub_classification_type_action"
              parent="purchase.menu_product_in_config_purchase"/>
</odoo>