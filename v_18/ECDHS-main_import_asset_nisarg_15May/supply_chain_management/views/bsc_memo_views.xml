<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bsc_memo_action" model="ir.actions.act_window">
        <field name="name">RFQ Memo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bsc.memo</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <record id="bsc_memo_view_form" model="ir.ui.view">
        <field name="name">bsc.memo.view.tree</field>
        <field name="model">bsc.memo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget='statusbar'
                           statusbar_visible='draft,approve'/>
                    <button name="action_approve"
                            class="oe_highlight" invisible="state != 'draft'"
                            string="Approve" type="object"
                            groups="supply_chain_management.purchase_requisition_scm_ceo"/>
                    <button name="action_refuse"
                            class="btn btn-secondary"
                            invisible="state != 'draft'"
                            string="Refuse" type="object"
                            groups="supply_chain_management.purchase_requisition_scm_ceo"/>
                    <button name="reset_drafts"
                            class="btn btn-secondary"  invisible="state != 'cancelled'"
                            string="Reset to Draft" type="object"
                            groups="supply_chain_management.purchase_requisition_scm_ceo"/>
                    <button name="action_create_purchase_requisition"
                            class="btn btn-secondary" invisible="state != 'approve'"
                            string="Create Purchase Requisition" type="object"
                            groups="supply_chain_management.purchase_requisition_scm_ceo"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="get_purchase_requisition_details"
                                icon="fa-credit-card">
                            Purchase Requisition
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="New"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="total_amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <group>
                        <field name="description" widget="html"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="bsc_memo_view_tree" model="ir.ui.view">
        <field name="name">bsc.memo.view.tree</field>
        <field name="model">bsc.memo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_amount"/>
                <field name="state" decoration-info="state == 'draft'"
                       decoration-success="state == 'approve'"
                       decoration-danger="state == 'cancelled'" widget="badge"/>
            </list>
        </field>
    </record>
    <menuitem id="bsc_memo_menu"
              name="RFQ Memo"
              parent="purchase.menu_procurement_management"
              action="bsc_memo_action"
              groups="supply_chain_management.purchase_requisition_user"/>
</odoo>
