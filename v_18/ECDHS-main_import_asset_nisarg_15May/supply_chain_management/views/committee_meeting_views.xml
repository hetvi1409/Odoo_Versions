<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_committee_meeting_form">
        <field name="name">committee.meeting.view.tree</field>
        <field name="model">committee.meeting</field>
        <field name="inherit_id" ref="oi_committee.view_committee_meeting_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stop_date']" position="after">
                <field name="purchase_requisition_id"/>
                <field name="eac"/>
            </xpath>
        </field>
    </record>

</odoo>