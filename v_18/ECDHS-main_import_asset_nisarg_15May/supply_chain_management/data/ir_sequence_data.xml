<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- sequence for employee purchase requisition -->
        <record id="sequence_purchase_requisition" model="ir.sequence">
            <field name="name">Purchase Requisition</field>
            <field name="code">purchase.requisition</field>
            <field name="prefix">SCM/%(day)s/%(month)s/%(year)s</field>
            <field name="padding">0</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
        <record id="sequence_bsc_memo" model="ir.sequence">
            <field name="name">Purchase Requisition</field>
            <field name="code">bsc.memo</field>
            <field name="prefix">Memo/%(day)s/%(month)s/%(year)s:</field>
            <field name="padding">3</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
        </record>
    </data>
</odoo>