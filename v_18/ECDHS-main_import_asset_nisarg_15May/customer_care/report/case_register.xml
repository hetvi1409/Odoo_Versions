<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_care_case_register_report">
        <t t-call="web.html_container">
            <!-- <t t-call="web.external_layout"> -->

                <div class="page">

                    <!-- Custom HEADER -->
                    <div class="header o_company_custom_layout" style="padding-top: 5px;">
                        <t t-set="company" t-value="docs.company_id"/>
                        <div class="d-flex justify-content-between align-items-center">
                            <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)"
                                alt="Logo"/>
                        </div>
                    </div>

                    <div style="text-align: center; width: 100%; margin: 10px 0;">
                        <img src="/customer_care/static/description/line.png" style="height:5px; width: 1200px; display: inline-block;"/>
                    </div>

                    <div class="company-info" style="text-align: center; margin-bottom: 20px;">
                        <t t-if="company">
                            <div><strong t-esc="company.name"/></div>
                            <div>
                                <t t-if="company.street">
                                    <t t-esc="company.street"/>
                                </t>
                                <t t-if="company.street2">
                                    <t t-esc="company.street2"/>
                                </t>
                                <t t-if="company.zip">
                                    <t t-esc="company.zip"/>
                                </t>
                                <t t-if="company.state_id">
                                    <t t-esc="company.state_id.name"/>
                                </t>
                                <t t-if="company.country_id">
                                    <t t-esc="company.country_id.name"/>
                                </t>
                                <t t-if="company.city">
                                    <t t-esc="company.city"/>
                                </t>
                                <t t-if="company.phone">
                                    <t t-esc="company.phone"/>
                                </t>
                                <t t-if="company.email">
                                    <t t-esc="company.email"/>
                                </t>
                            </div>
                        </t>
                    </div>

                    <!-- TITLE -->
                    <t t-set="quarter_label"
                        t-value="dict([('1','1st'),('2','2nd'),('3','3rd'),('4','4th')]).get(data.get('quarter'))"/>

                        <h2 style="text-align:center; margin-top:10px; margin-bottom:15px;">
                            Customer Care Case Register -
                            <span t-esc="quarter_label"/> Quarter
                            <span t-esc="data.get('year')"/>
                        </h2>
                    <br/>
                    <!-- TABLE -->
                    <table style="width:100%; border-collapse:collapse; font-size:16px;">

                        <thead>
                            <tr>
                                <th class="border">NO.</th>
                                <th class="border">Date Received</th>
                                <th class="border">Beneficiary<br/>(Name and Surname)</th>
                                <th class="border">ID Number</th>
                                <th class="border">Contact No.</th>
                                <th class="border">Municipality</th>
                                <th class="border">Case Description</th>
                            </tr>
                        </thead>

                        <tbody>

                            <!-- Initialize counter -->
                            <t t-set="count" t-value="1"/>

                            <t t-foreach="docs" t-as="rec">

                                <tr>
                                    <td class="border" style="text-align:center;">
                                        <t t-esc="count"/>
                                    </td>

                                    <td class="border">
                                        <span t-esc="rec.create_date.strftime('%d/%m/%Y') if rec.create_date else ''"/>
                                    </td>

                                    <td class="border">
                                        <span t-esc="rec.partner_name or rec.partner_id.name"/>
                                    </td>

                                    <td class="border">
                                        <span t-esc="rec.ticket_ref or ''"/>
                                    </td>

                                    <td class="border">
                                        <span t-esc="rec.partner_phone or ''"/>
                                    </td>

                                    <td class="border">
                                        <span t-esc="rec.region.municipality if rec.region else ''"/>
                                    </td>

                                    <td class="border">
                                        <span t-esc="rec.description or rec.name"/>
                                    </td>
                                </tr>

                                <t t-set="count" t-value="count + 1"/>

                            </t>

                        </tbody>
                    </table>

                </div>

                <!-- Footer -->
                <div class="footer o_company_custom_layout text-muted">
                        <div style="margin-top: 20px; display: flex; justify-content: center;">
                            <img src="/customer_care/static/description/line.png" style="height:5px;" loading="lazy"/>
                        </div>
                    <div style="margin-top: 20px; display: flex; justify-content: end; height: 100px;">
                        <img src="/customer_care/static/description/footer.png" loading="lazy"/>
                    </div>
                </div>

                <!-- STYLE -->
                <style>
                    .border {
                        border: 1px solid black;
                        padding: 6px;
                        vertical-align: top;
                    }

                    table th {
                        text-align: left;
                    }
                </style>

            <!-- </t> -->
        </t>
    </template>


    <record id="action_customer_care_case_register_report" model="ir.actions.report">
        <field name="name">Customer Care Case Register</field>
        <field name="model">helpdesk.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_care.customer_care_case_register_report</field>
        <!-- <field name="binding_model_id" ref="model_helpdesk_ticket"/> -->
    </record>

</odoo>