<?xml version="1.0" ?>
<odoo>

    <!-- Customer care category -->
    <record model="ir.module.category" id="module_customer_care_category">
        <field name="name">Customer Care</field>
        <field name="description">Access to customer care module</field>
        <field name="sequence">16</field>
    </record>

    <record id="group_customer_care_capturer" model="res.groups">
        <field name="name">Capturer</field>
        <field name="category_id" ref="customer_care.module_customer_care_category"/>
        <field name="users" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_customer_care_qa" model="res.groups">
        <field name="name">QA</field>
        <field name="category_id" ref="customer_care.module_customer_care_category"/>
        <field name="users" eval="[(4, ref('base.group_user'))]"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_manager'))]"/>
    </record>

</odoo>
