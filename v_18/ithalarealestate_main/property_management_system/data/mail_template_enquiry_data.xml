<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_template_enquiry_ack" model="mail.template">
        <field name="name">Property Enquiry Acknowledgement</field>
        <field name="model_id" ref="model_property_enquiry"/>
        <field name="subject">Thank You for Your Enquiry - Ref: {{object.name}}</field>
        <field name="email_to">{{ object.name or 'n/a' }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi
                    <t t-out="object.title_id.name"/>
                    <t t-out="object.contact_surname"/>,
                    <br/>
                </p>
                <p>Thank you for contacting us. We have received your enquiry
                    and assigned it the reference number
                    <strong>
                        <t t-out="object.name"/>
                    </strong>
                    .
                </p>
                <p>Our team will review your request and get back to you
                    shortly.
                </p>

                <p>
                    <strong>Summary:</strong>
                    <br/>
                    - Enquiry Date:
                    <t t-out="object.date"/>
                    <br/>
                    - Property Type:
                    <span t-field="object.property_type"/>
                    <br/>
                    - District:
                    <t t-out="object.district_id.name"/>
                    <br/>
                    - Town/Suburb:
                    <t t-out="object.city_id.name"/>
                    <br/>
                    - Property:
                    <t t-out="object.property_id.name"/>
                    <br/>
                    - Building Unit:
                    <t t-out="object.building_id.name"/>
                </p>
            </div>
        </field>
    </record>
