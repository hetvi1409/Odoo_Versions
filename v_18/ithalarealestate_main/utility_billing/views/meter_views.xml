<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_utility_meter_form" model="ir.ui.view">
        <field name="name">utility.meter.form</field>
        <field name="model">utility.meter</field>
        <field name="arch" type="xml">
            <form string="Meter">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="utility_type"/>
                            <field name="company_id"/>
                            <field name="tariff_id" domain="[('utility_type','=',utility_type)]"/>
                            <field name="start_reading"/>
                            <field name="move_in_date"/>
                            <field name="move_out_date"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="unit_reference"/>
                            <field name="service_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readings">
                            <field name="reading_ids">
                                <list>
                                    <field name="reading_date"/>
                                    <field name="billing_period_start"/>
                                    <field name="billing_period_end"/>
                                    <field name="previous_reading"/>
                                    <field name="reading"/>
                                    <field name="consumption"/>
<!--                                    <field name="invoiced"/>-->
                                    <field name="invoice_amount" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_meter_list" model="ir.ui.view">
        <field name="name">utility.meter.list</field>
        <field name="model">utility.meter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="utility_type"/>
                <field name="partner_id"/>
                <field name="unit_reference"/>
                <field name="tariff_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_utility_meters" model="ir.actions.act_window">
        <field name="name">Meters</field>
        <field name="res_model">utility.meter</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
