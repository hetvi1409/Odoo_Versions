<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rental_contract_list_view" model="ir.ui.view">
            <field name="name">rental.contract.list</field>
            <field name="model">rental.contract</field>
            <field name="arch" type="xml">
                <list  decoration-danger="date_to &lt;= (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')
                    and date_to &gt; context_today().strftime('%%Y-%%m-%%d')"
                 decoration-muted="date_to &lt; context_today().strftime('%Y-%m-%d')" count_limit = "9999999">
                    <field name="name"/>
<!--                    <field name="date"/>-->
                    <field name="date_from"/>
                    <field name="date_to"/>
<!--                    <field name="date"/>-->
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="building" />
                    <field name="building_unit"/>
                    <field name="floor"/>
                    <field name="rental_fee"/>
                    <field name="insurance_fee"/>
                    <field name="address"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state in ('confirmed','renew','running')" decoration-danger="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <record id="rental_contract_filter" model="ir.ui.view">
            <field name="name">rental.contract.list.filter</field>
            <field name="model">rental.contract</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Top Search">
                    <group>
                        <field name="name"/>
                        <field name="ref"/>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="building"/>
                        <field name="building_code"/>
                        <field name="building_unit" options="{'no_create': True, 'no_open': True}"/>
                        <field name="unit_code"/>
                    </group>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter name="user_id" string="Responsible" domain="[]"  context="{'group_by':'user_id'}"/>
                        <filter name="partner_id" string="Partner" domain="[]"  context="{'group_by':'partner_id'}"/>
                        <filter name="building" string="Building" domain="[]"  context="{'group_by':'building'}"/>
                        <filter name="state" string="State" domain="[]"  context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="rental_contract_form_view" model="ir.ui.view">
            <field name="name">rental.contract.form</field>
            <field name="model">rental.contract</field>
            <field name="arch" type="xml">
                <form string="rental Contract">
                    <header>
                        <button name="action_confirm" type="object"
                                invisible="state in ['cancel','confirmed','renew']" string="Confirm" class="oe_highlight"/>
                        <button name="action_calculate" type="object"
                                invisible="state in ['cancel','confirmed','renew']"  string="Calculate " class="oe_highlight"/>
                        <button name="action_cancel" type="object"
                                invisible="state in ['cancel','draft']"  string="Cancel" class="oe_highlight"/>
                        <button name="%(action_customer_rental_renew_check)d" type="action"
                                invisible="state != 'confirmed'" string="Renew Contract" class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,open,confirmed,cancel" />
                    </header>
                    <sheet>
                         <style>
                    .o_form_view:not(.o_field_highlight)
                    .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                    .o_input:not(:hover):not(:focus) {
                              --o-input-border-color: black !important;
                              }
                  </style>
                        <div class="oe_button_box" name="button_box">

                        </div>
                        <group string="Rental Contract Data">
                            <group>
                                <field name="name"/>
                                <field name="ref"/>
                                <field name="date"
                                       readonly="state != 'draft'" required="1"/>
                                <field name="user_id"/>
                                <field name="partner_id"
                                 context="{'res_partner_search_mode': 'is_tenant', 'default_is_tenant':True,}"
                                 domain="[('is_tenant','=',True)]"

                                       readonly="state != 'draft'" />
                                <field name="account_analytic_id"
                                       readonly="state != 'draft'"  />
                                <field name="origin" readonly="state != 'draft'" />
                                <field name="reservation_id" readonly="state != 'draft'" />
                                <field name="apply_tax" />
                            </group>
                            <group>
                                <field name="date_from" readonly="state != 'draft'" />
                                <field name="date_to" readonly="state != 'draft'" />
                                <label for="recurring_interval"/>
                                <div class="o_row">
                                    <span class="mr-1">Every</span>
                                    <field name="recurring_interval" required="1" readonly="state != 'draft'" />
                                    <field name="periodicity" class="field_rule_type" required="1" readonly="state != 'draft'" />
                                </div>
                                <field name="rental_fee" readonly="state != 'draft'" />
                                <field name="insurance_fee" readonly="state != 'draft'" />
                                <field name="account_income" />
                                <field name="account_security_deposit" readonly="state != 'draft'"  />
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Location">
                            <group>
                                <field name="building" readonly="state != 'draft'" />
                                <field name="building_code" readonly="state != 'draft'" />
                                <field name="no_of_floors" readonly="state != 'draft'" />
                            </group>
                            <group>
					            <field name="property_owner_id" options="{'no_create_edit': True}" />
                                <field name="region" readonly="state != 'draft'"  />
                            </group>
                        </group>
                        <separator string="Building Unit" colspan="4"/>
                        <group>
                            <group>
                                <field name="building_unit" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'" />
                                <field name="unit_code" readonly="state != 'draft'" />
                                <field name="floor" readonly="state != 'draft'" />
                                <field name="address" readonly="state != 'draft'" />
                            </group>
                            <group>
                                <field name="type" readonly="state != 'draft'" />
                                <field name="status" readonly="state != 'draft'" />
                                <field name="building_area" readonly="state != 'draft'" />
                            </group>

                        </group>
                        <separator string="Energy Unit" colspan="4"/>
                        <group>
                            <group>
                                <field name="energy_budget" />
                                <field name="energy_consumption_total" />
                                <field name="energy_cost_total" />
                                <field name="integration_enabled" />
                                <field name="external_system_id" />
                                <field name="energy_budget_variance" />
                                <field name="energy_budget_percent" />
                            </group>
                        </group>
                        <notebook colspan="2">
                            <page string="Billings">
                                <field name="loan_line" readonly="state != 'draft'" >
                                    <list string="Billings" editable="bottom" default_order="date asc, id asc">
                                        <field widget="handle" name="serial" required="1" />
                                        <field name="date" required="1" />
                                        <field name="name" required="1" />
                                        <field name="amount" required="1" />
                                        <field name="amount_residual"/>
                                        <field name="line_account" />
                                        <field name="invoice_id" readonly="1"/>
                                        <field name="invoice_state" widget="badge" decoration-success="invoice_state == 'posted'"
                                               decoration-info="invoice_state == 'draft'" optional="show"/>
                                        <field name="payment_state" widget="badge"
                                               decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')"
                                               decoration-success="payment_state in ('paid', 'reversed')"
                                               invisible="payment_state == 'invoicing_legacy'"/>
                                        <button string="Make Invoice" name="make_invoice"
                                                type="object" icon="fa-money"
                                                invisible="(invoice_id != False) or (parent.state != 'confirmed')"
                                                groups="itsys_real_estate.group_payments"/>
                                        <button string="View Invoice" name="view_invoice" type="object" style="background-color:rgba(0, 160, 74, 0.5);color: #333;"
                                                invisible="invoice_id == False" groups="itsys_real_estate.group_payments"/>
                                    </list>
                                </field>
                                <group>
                                    <field name="amount_total"/>
                                </group>
                            </page>
                            <page string="Documents">
                                <field name="attach_line">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="file"/>
                                        <button name="download_file" type="object" string="Download" class="oe-highlight"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Escalation">
                                <group>
                                    <field name="select_type"/>
                                    <field name="date_type" invisible="select_type != 'date'"/>
                                    <field name="month_type" invisible="select_type != 'months'"/>
                                    <field name="percentage"/>
                                </group>
                                <button name="process_escalation" type="object" string="Process Escalation" class="oe_highlight"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="rental_contract_form_action" model="ir.actions.act_window">
            <field name="name">Lease Management</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rental.contract</field>
            <field name="view_id" ref="rental_contract_list_view"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to add a new rental Contract
                </p>
            </field>
        </record>
        <menuitem
                id="menu_contracts_main"
                name="Contracts"
                parent="itsys_real_estate.menu_itsys_real_estate"
                sequence="23"/>

        <menuitem action="rental_contract_form_action"
                  id="menu_rental_contract_form_action"
                  parent="itsys_real_estate.menu_contracts_main" sequence="40" />

        <record model="ir.cron" id="auto_rental_invoice_sync">
            <field name="name">Auto Generate Rental Invoices</field>
            <field name="model_id" ref="model_rental_contract"/>
            <field name="state">code</field>
            <field name="code">model.auto_rental_invoice()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
<!--            <field name="numbercall">-1</field>-->
<!--            <field name="doall" eval="False"/>-->
        </record>

    </data>
</odoo>
