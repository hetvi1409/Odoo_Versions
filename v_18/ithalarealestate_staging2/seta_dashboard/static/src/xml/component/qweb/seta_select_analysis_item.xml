<template>
    <div t-name="SETASelectAnalysisItem" class="seta_select_analysis_item seta_select_item"
        t-att-data-id="id" 
        t-att-data-name="name" 
        t-att-data-table_id="table_id" 
        t-att-data-table_name="table_name" 
        t-att-data-source_id="source_id" 
        t-att-data-source_name="source_name"
        t-att-data-visual_type="visual_type">
        <div class="seta_title" t-esc="name">Select Analysis</div>
        <div class="seta_subtitle" t-esc="source_table">
            Data Source / Table
        </div>
        <div class="seta_visual_type_icon">
            <span class="material-icons"><t t-esc="visual_type_icon"/></span>
        </div>
        <div t-if="category_name" class="seta_category" t-esc="category_name"></div>
        <div class="seta_edit_analysis_item seta_select_item_icon" title="Configuration">
            <span class="material-icons" t-esc="'edit'"/>
        </div>
    </div>
</template>