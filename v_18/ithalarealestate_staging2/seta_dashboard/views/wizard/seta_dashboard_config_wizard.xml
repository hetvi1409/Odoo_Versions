<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="seta_dashboard_config_wizard" model="ir.ui.view">
      <field name="name">seta.dashboard.config.wizard</field>
      <field name="model">seta.dashboard.config.wizard</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="dashboard_id" />
              <field name="code_file" filename="code_filename" />
              <field name="code_filename" invisible="1" />
              <field name="code" widget="ace" options="{'mode': 'python'}"
                invisible="code_file != False" />
            </group>
          </sheet>
          <footer>
            <button name="process_wizard"
              string="Process"
              type="object"
              class="oe_highlight"
            /> or <button string="Cancel" class="oe_link" special="cancel" />
          </footer>
        </form>
      </field>
    </record>

    <!-- Action Window -->
    <record id="action_seta_dashboard_config_wizard" model="ir.actions.act_window">
      <field name="name">Dashboard Config Wizard</field>
      <field name="res_model">seta.dashboard.config.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

    <!-- Menu -->
    <!-- <menuitem id="menu_seta_dashboard_config_wizard"
      name="Config"
      parent="seta_data.seta_dashboard_root"
      action="action_seta_dashboard_config_wizard"
      sequence="1"
      /> -->
  </data>
</odoo>