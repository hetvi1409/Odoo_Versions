<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_asset_location_list" model="ir.ui.view">
        <field name="name">asset.verification.job.location.list</field>
        <field name="model">asset.verification.job.location</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="asset_location_action" model="ir.actions.act_window">
        <field name="name">Asset Location</field>
        <field name="res_model">asset.verification.job.location</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Asset Location
            </p>
        </field>
    </record>

    <menuitem id="asset_location_menuitem"
            name="Asset Location"
            action="asset_location_action"
            parent="accountant.menu_accounting"
            sequence="2"
    />
</odoo>