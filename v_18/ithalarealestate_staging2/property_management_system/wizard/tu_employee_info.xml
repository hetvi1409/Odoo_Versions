<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TU Employment Info Wizard Form -->
    <record id="view_tu_employment_info_wizard_form" model="ir.ui.view">
        <field name="name">tu.employment.info.wizard.form</field>
        <field name="model">tu.employment.info.wizard</field>
        <field name="arch" type="xml">
            <form string="Create TU Employment Info">
                <sheet>

                    <group>
                        <field name="name"
                               placeholder="Name..."
                               class="oe_inline"/>
                    </group>

                    <group>
                        <group>
                            <field name="employer"/>
                            <field name="occupation"/>
                            <field name="date"/>
                            <field name="employment_period"/>
                        </group>

                        <group>
                            <field name="score_card" />
                            <field name="company_id"/>
                        </group>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_tu_employment_info_wizard" model="ir.actions.act_window">
        <field name="name">Create TU Employment Info</field>
        <field name="res_model">tu.employment.info.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
