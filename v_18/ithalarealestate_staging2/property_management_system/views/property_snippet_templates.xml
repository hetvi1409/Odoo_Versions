<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="before">
            <t t-snippet="property_management_system.property_snippet"
               string="Properties Type"/>
            <t t-snippet="property_management_system.services_section_snippet"
               string="Service Property"/>
        </xpath>
    </template>

    <template id="property_snippet" name="Properties To Lease">
        <section class="my-5 text-center"
                 style="font-family: 'Poppins', sans-serif;">
            <!-- Section Title -->
            <h2 class="fw-bold mb-5" style="color: #003DA5; font-size: 2.5rem;">
                Properties To Lease
            </h2>

            <!-- Property Cards -->
            <div class="row justify-content-center">
                <!-- Card 1 -->
                <div class="col-md-2 col-6 mb-4">
                    <div class="property-card">
                        <a href="/property_management_system/property/large-industrial">
                            <div class="property-image">
                                <img src="/property_management_system/static/src/img/large.png"
                                     alt="Large Industrial Portfolio"
                                     class="img-fluid rounded-4 shadow-lg uniform-img"/>
                            </div>
                            <div class="property-text">
                                <p class="fw-bold">Large Industrial Portfolio
                                </p>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="col-md-2 col-6 mb-4">
                    <div class="property-card">
                        <a href="/property_management_system/property/light-industrial">
                            <div class="property-image">
                                <img src="/property_management_system/static/src/img/small.png"
                                     alt="Light Industrial Portfolio"
                                     class="img-fluid rounded-4 shadow-lg uniform-img"/>
                            </div>
                            <div class="property-text">
                                <p class="fw-bold">Light Industrial Portfolio
                                </p>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="col-md-2 col-6 mb-4">
                    <div class="property-card">
                        <a href="/property_management_system/property/retail">
                            <div class="property-image">
                                <img src="/property_management_system/static/src/img/retail.png"
                                     alt="Retail Portfolio"
                                     class="img-fluid rounded-4 shadow-lg uniform-img"/>
                            </div>
                            <div class="property-text">
                                <p class="fw-bold">Retail Portfolio</p>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Card 4 -->
                <div class="col-md-2 col-6 mb-4">
                    <div class="property-card">
                        <a href="/property_management_system/property/smme">
                            <div class="property-image">
                                <img src="/property_management_system/static/src/img/smme.png"
                                     alt="SMME Portfolio"
                                     class="img-fluid rounded-4 shadow-lg uniform-img"/>
                            </div>
                            <div class="property-text">
                                <p class="fw-bold">SMME Portfolio</p>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Card 5 -->
                <div class="col-md-2 col-6 mb-4">
                    <div class="property-card">
                        <a href="/property_management_system/property/application-form">
                            <div class="property-image">
                                <img src="/property_management_system/static/src/img/application.png"
                                     alt="Property Lease Application Form"
                                     class="img-fluid rounded-4 shadow-lg uniform-img"/>
                            </div>
                            <div class="property-text">
                                <p class="fw-bold">Property Lease Application
                                    Form
                                </p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

        </section>
    </template>
    <template id="services_section_snippet" name="Services Section">
    <section class="py-5 text-center" style="background-color: #1a009c; font-family: 'Poppins', sans-serif;">
        <!-- Section Title -->
        <div class="container mb-5">
            <h2 class="fw-bold text-white mb-2">Services</h2>
            <div class="underline mx-auto"></div>
        </div>

        <!-- Service Icons -->
        <div class="row justify-content-center text-white">
            <!-- Service 1 -->
            <div class="col-md-3 col-6 mb-4">
                <div class="service-card">
                    <div class="icon-circle mb-3 mx-auto">
                        <img src="/property_management_system/static/src/img/icon_property.png"
                             alt="Properties" class="service-icon"/>
                    </div>
                    <p class="fw-semibold service-title">Properties</p>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="col-md-3 col-6 mb-4">
                <div class="service-card">
                    <div class="icon-circle mb-3 mx-auto">
                        <img src="/property_management_system/static/src/img/icon_finance.png"
                             alt="Business Finance" class="service-icon"/>
                    </div>
                    <p class="fw-semibold service-title">Business Finance</p>
                </div>
            </div>

            <!-- Service 3 -->
            <div class="col-md-3 col-6 mb-4">
                <div class="service-card">
                    <div class="icon-circle mb-3 mx-auto">
                        <img src="/property_management_system/static/src/img/icon_banking.png"
                             alt="Banking" class="service-icon"/>
                    </div>
                    <p class="fw-semibold service-title">Banking</p>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>