<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="rental_contract_form_view" model="ir.ui.view">
        <field name="name">rental.contract.view.form</field>
        <field name="model">rental.contract</field>
        <field name="inherit_id" ref="itsys_real_estate.rental_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='apply_tax']" position="after">
                <field name="active" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
            </xpath>

            <xpath expr="//button[@name='action_calculate']" position="before">
                <button name="action_archive" type="object"
                        invisible="not active or state not in ['cancel']"
                        string="Archive Contract" class="oe_highlight"/>
            </xpath>
        </field>
    </record>

</odoo>