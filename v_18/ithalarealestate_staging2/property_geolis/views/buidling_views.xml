<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="building_base_pages_form" model="ir.ui.view">
        <field name="name">building.base_pages.form.geolis</field>
        <field name="model">building</field>
        <field name="inherit_id"
               ref="itsys_real_estate.building_base_pages_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='geolocation']" position="after">
                <page string="GEOLIS" name="geolis">
                    <field name="open_map" invisible="1"/>
                    <button name="action_open_map" string="Open Map"
                            type="object"/>
                    <iframe id="custom_src" name="custom_src"
                            invisible="open_map == False"
                            src="https://ags.joburg.org.za/cgis/index.aspx"
                            width="100%" height="500"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>