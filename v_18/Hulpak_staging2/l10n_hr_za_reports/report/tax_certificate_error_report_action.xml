<odoo>
    <record id="paperformat_payroll_emp_report" model="report.paperformat">
        <field name="name">Letter B3</field>
        <field name="default" eval="True"/>
        <field name="format">B3</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">32</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_tax_certificate_error_pdf_report" model="ir.actions.report">
        <field name="name">Tax Certificate Error Report</field>
        <field name="model">tax.certificate.error.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_hr_za_reports.tax_certificate_report</field>
        <field name="report_file">l10n_hr_za_reports.tax_certificate_report</field>
        <field name="print_report_name">'Tax_Certificate_Error_Report_' + object.payment_period</field>
        <field name="paperformat_id" ref="l10n_hr_za_reports.paperformat_payroll_emp_report"/>
    </record>
</odoo>