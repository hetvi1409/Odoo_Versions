<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_company_form_za">
        <field name="name">res.company.form.inherit.za</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="inside">
                <field name="paye_number"/>
                <field name="uif_number"/>
                <field name="sdl_number"/>
            </xpath>
        </field>
    </record>
</odoo>
