<odoo>
    <record id="view_etax_certificate_error_report_wizard_form" model="ir.ui.view">
        <field name="name">tax.certificate.error.report.wizard.form</field>
        <field name="model">tax.certificate.error.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Tax Certificate Error Report Wizard">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="print_pdf" type="object" string="Print PDF" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tax_certificate_error_report_wizard" model="ir.actions.act_window">
        <field name="name">Tax Certificate Error Report</field>
        <field name="res_model">tax.certificate.error.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>