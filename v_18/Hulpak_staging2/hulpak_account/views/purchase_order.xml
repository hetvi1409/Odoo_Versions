<odoo>
    <record id="view_purchase_order_form_branch" model="ir.ui.view">
        <field name="name">purchase.order.form.branch</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="department" required="1" domain="[('plan_id.name', 'ilike', 'Department')]" options="{'no_open': True, 'no_create': True}"/>
                <field name="region" required="1" domain="[('plan_id.name', 'ilike', 'Region')]" options="{'no_open': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{"no_create":true}</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_id']" position="attributes">
                <attribute name="options">{"no_create":true,"no_open":true}</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='taxes_id']" position="attributes">
                <attribute name="required">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>