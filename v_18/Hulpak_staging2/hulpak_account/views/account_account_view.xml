<odoo>
    <record id="view_account_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.account.form.inherit.custom</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[2]" position="inside">
                <div class="row">
                    <div class="col col-md-auto">
                        <label for="account_code" string="Account Code"/>
                        <div>
                            <field name="account_code" placeholder="e.g. 001001" class="oe_inline"/>
                        </div>
                    </div>
                    <div class="col col-md-auto">
                        <label for="account_name" string="Account Name"/>
                        <div>
                            <field name="account_name" string="Account Name" class="oe_inline"/>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col col-md-auto">
                        <label for="department" string="Department"/>
                        <div>
                            <field name="department" class="oe_inline"/>
                        </div>
                    </div>
                    <div class="col col-md-auto">
                        <label for="product" string="Attached to Machine"/>
                        <div>
                            <field name="product" class="oe_inline"/>
                        </div>
                    </div>
                    <div class="col col-md-auto">
                        <label for="region" string="Region"/>
                        <div>
                            <field name="region" class="oe_inline"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
