<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="stock_picking_report" inherit_id="stock.report_picking">
        <xpath expr="//table" position="after">
            <div>

                <div style="padding: 8px 20px;">

                    <table style=" width:90%; ">
                        <tr>
                            <td style="margin: 5px; padding: 4px 40px 4px 0; ">
                                <input type="checkbox"
                                       style="margin: 0 20px 0 5px;"/>
                                Pest Free
                            </td>

                            <td style="margin: 5px; padding: 4px 0; ">
                                <input type="checkbox"
                                       style="margin: 0 20px 0 5px;"/>
                                Free of Foil Deposit
                            </td>
                        </tr>

                        <tr>
                            <td style="margin: 5px; padding: 4px 40px 4px 0; ">
                                <input type="checkbox"
                                       style="margin: 0 20px 0 5px;"/>
                                Product conforms to specification
                            </td>

                            <td style="margin: 5px; padding: 4px 0; ">
                                <input type="checkbox"
                                       style="margin: 0 20px 0 5px;"/>
                                Condition of Delivery Vehicle
                            </td>
                        </tr>
                    </table>
                </div>

                <div style="height: 40px;"></div>

                <!-- Signature Section -->
                <table style="width:90%; border-collapse:collapse; margin-top:20px;"
                       border="0">
                    <tr>
                        <!-- Signed By -->
                        <td style="width:33%; border:none; padding:0 10px;">
                            <div style="font-size:13px; margin-bottom:3px;">
                                Signed By
                            </div>
                            <div style="border-bottom:1px solid #000; width:160px;"></div>
                        </td>

                        <!-- Date -->
                        <td style="width:33%; border:none; padding:0 10px;">
                            <div style="font-size:13px; margin-bottom:3px;">
                                Date
                            </div>
                            <div style="border-bottom:1px solid #000; width:160px;"></div>
                        </td>

                        <!-- Signature -->
                        <td style="width:33%; border:none; padding:0 10px;">
                            <div style="font-size:13px; margin-bottom:3px;">
                                Signature
                            </div>
                            <div style="border-bottom:1px solid #000; width:160px;"></div>
                        </td>
                    </tr>
                </table>

            </div>
        </xpath>
    </template>
