<odoo>
    <!-- Inherit sale.report tree view to add website_id field -->
    <record id="sale_report_view_tree" model="ir.ui.view">
        <field name="name">sale.report.view.list.inherit.hulpak.sale</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="before">
                    <field name="commercial_partner_ref" optional="show"/>
                    <field name="customer_ref" optional="show"/>
                    <xpath expr="//field[@name='partner_id']" position="move"/>
                </xpath>
                <xpath expr="//field[@name='date']" position="after">
                    <field name="delivery_date" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='order_reference']" position="after">
                    <field name="default_code" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="warehouse_id" optional="show"/>
                    <field name="warehouse_qty_summary" optional="show" widget="text"/>
                </xpath>
                <xpath expr="//field[@name='product_uom_qty']" position="after">
                    <field name="qty_to_deliver" optional="show"/>
                    <field name="qty_delivered" optional="show"/>
                    <field name="weight" optional="show"/>
                    <field name="net_weight" optional="show"/>
                    <xpath expr="//field[@name='price_unit']" position="move"/>
                </xpath>
            <!-- </field> -->
        </field>
    </record>
</odoo>