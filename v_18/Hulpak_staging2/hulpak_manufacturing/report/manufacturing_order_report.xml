<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_mo_container_label" model="ir.actions.report">
        <field name="name">MO Container Label</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hulpak_manufacturing.report_mo_container_label</field>
        <field name="report_file">hulpak_manufacturing.report_mo_container_label</field>
        <field name="print_report_name">'MO_Label_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_mrp_production"/>
    </record>

    <template id="hulpak_manufacturing.report_mo_container_label">
        <t t-call="web.basic_layout">
            <style>
                @page { size: 115mm 170mm; margin: 0mm; }
                .label { border: 1px solid #000; padding: 2px; font-family: Arial, sans-serif; font-size: 17px; }
                .row { display: flex; justify-content: space-between; }
                .center { text-align: center; }
                .big-code { font-size: 92px; font-weight: bold; margin: 0px 0; }
                .qty { font-size: 20px; font-weight: bold; }
                .grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2px; }
                .right { text-align: right; }
            </style>

            <t t-foreach="docs" t-as="o">

                <t t-foreach="range(2)" t-as="i">
                    <div class="label" style="page-break-after: always;">
                        <div class="col" style="text-align: center; font-size: 12px;">
                                    <t t-esc="o.product_id.name"/>
                                </div>
                        <div class="row">
                            <div class="col">
                                <span t-esc="o.product_id.default_code"/>
                            </div>
                            <div class="col">
                                <span t-esc="o.name"/>
                            </div>
                            <div class="col">
                                <span t-esc="o.date_start.strftime('%d/%m/%Y') if o.date_start else ''"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <div class="center big-code">
                                    <t t-esc="(o.product_id.default_code.split('-')[-1]).strip() if o.product_id.default_code else ''"/>
                                </div>


                                <div class="center qty"> Quantity:
                                    <t t-esc="int(o.product_qty)"/> UNITS
                                </div>
                                <div class="center qty"> No Of Quantity:
                                    <t t-esc="int(o.bom_id.not_quantity_unit)"/> UNITS
                                </div>
                            </div>
                            <div class="col right">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 115px !important;" alt="Logo"/>
                            </div>
                        </div>
                        <div class="row" style=" font-size: 25px;">
                            <div class="col">
                                <div>

                                    <strong>Case Number:</strong>
                                    <t t-esc="o.x_studio_case or ''"/>
                                    <t t-if="o.x_studio_case">
                                        <img t-att-src="'/report/barcode/Code128/%s' % o.x_studio_case" style="width:100%; height:25px;"/>
                                    </t>

                                    <br/>
                                    <strong>Lot Number:</strong>
                                    <t t-esc="o.lot_producing_id.name or ''"/>
                                    <t t-if="o.lot_producing_id">
                                        <img t-att-src="'/report/barcode/Code128/%s' % o.lot_producing_id.name" style="width:100%; height:55px;"/>
                                    </t>
                                </div>
                            </div>
                            <div class="col">

                                <!-- <div class="logo"> -->
                                <!-- </div> -->
                                <div class="right">
                                    <!--<img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 75px !important;" alt="Logo"/>-->
                                    <div>
                                        <strong t-esc="o.company_id.name"/>
                                    </div>
                                    <div t-esc="o.company_id.partner_id.street"/>
                                    <div t-esc="o.company_id.partner_id.city"/>
                                    <div t-esc="o.company_id.partner_id.phone"/>
                                    <div>Country of Origin:
                                        <strong>RSA</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>

        </t>
    </template>

</odoo>