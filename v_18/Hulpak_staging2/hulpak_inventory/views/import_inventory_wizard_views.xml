<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Wizard form -->
  <record id="view_import_inventory_wizard" model="ir.ui.view">
    <field name="name">import.inventory.wizard.form</field>
    <field name="model">import.inventory.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Excel">
        <group>
          <field name="batch_id" invisible="1"/>
          <field name="file" filename="filename"/>
          <field name="filename" invisible="1"/>
        </group>
        <footer>
          <button string="Import" type="object" name="action_import" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Window action referenced by the form header button -->
  <act_window id="action_import_inventory_wizard"
              name="Import Excel"
              res_model="import.inventory.wizard"
              view_mode="form"
              target="new"
              context="{'default_batch_id': active_id}"/>
</odoo>
