<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form_rs" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="itsys_real_estate.res_config_settings_view_form_rs"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='reservations']" position="before">
                <block title="Sign" name="sign">
                    <setting string="Sign Templates"
                             company_dependent="1">
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="sign_template_id"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="sign_template_id"
                                           options="{'no_create_edit': True, 'no_open': True}"/>
                                </div>
                            </div>
                            <div class="mt16">
                                <div>
                                    <label for="otl_sign_template_id"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="otl_sign_template_id"
                                           options="{'no_create_edit': True, 'no_open': True}"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting string="Terms and Condition">
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="property_terms_condition_id"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="property_terms_condition_id"
                                           options="{'no_open': False, 'open_target': 'dialog'}"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
                <block title="Tenant" name="tenant">
                    <setting string="Tenant Application">
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label for="tenant_application_form_id"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="tenant_application_form_id"
                                           options="{'no_open': False}"/>
                                </div>
                            </div>
                        </div>
                    </setting>

                </block>
            </xpath>
        </field>
    </record>

</odoo>