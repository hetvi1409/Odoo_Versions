<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_interest_rate_table_list" model="ir.ui.view">
        <field name="name">property.interset.list</field>
        <field name="model">property.interset</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Interest Table">
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="interest_rate" widget="percentage"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_interest_rate_table" model="ir.actions.act_window">
        <field name="name">Interest Rate Table</field>
        <field name="res_model">property.interset</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
            id="interest_rate_table_menu"
            name="Interest Rate Table"
            parent="itsys_real_estate.menu_itsys_real_estate"
            action="action_interest_rate_table"
            sequence="20"/>
</odoo>