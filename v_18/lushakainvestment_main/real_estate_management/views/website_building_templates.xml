<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="website_menu_properties" model="website.menu">
        <field name="name">Properties</field>
        <field name="url">/properties</field>
        <field name="sequence" eval="10"/>
    </record>

    <!-- Property List Page -->
    <template id="property_list_template" name="Property List">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="text-center mb-5">
                    <h1 class="display-4 fw-bold text-primary mb-2">Available Properties</h1>
                    <p class="lead text-muted">Explore our latest buildings and units for sale or rent</p>
                    <hr class="mx-auto" style="width: 30%; border-top: 3px solid #6394dd;"/>
                </div>

                <!-- View Toggle Buttons -->
                <div class="d-flex justify-content-end mb-4">
                    <div class="btn-group shadow-sm rounded-3" role="group">
                        <a t-att-href="'/properties?view=kanban'"
                           t-attf-class="btn #{'btn-primary' if view_type=='kanban' else 'btn-outline-primary'} d-flex align-items-center">
                            <i class="fa fa-th-large me-2"></i> Kanban
                        </a>
                        <a t-att-href="'/properties?view=tree'"
                           t-attf-class="btn #{'btn-primary' if view_type=='tree' else 'btn-outline-primary'} d-flex align-items-center">
                            <i class="fa fa-list me-2"></i> List
                        </a>
                    </div>
                </div>

                <!-- Kanban/Grid View -->
                <t t-if="view_type == 'kanban'">
                    <div class="row g-4">
                        <t t-foreach="units" t-as="unit"> <!-- Only first 4 units -->
                            <div class="col-md-3"> <!-- 4 cards per row -->
                                <div class="card shadow-sm border-0 rounded-4 overflow-hidden hover-shadow d-flex flex-row align-items-center">
                                    <!-- Details on the left -->
                                    <div class="card-body flex-grow-1 pe-3">
                                        <h5 class="card-title text-truncate"><t t-esc="unit.name"/></h5>
                                        <p class="text-muted mb-1">Code: <t t-esc="unit.code"/></p>
                                        <p class="fw-bold mb-2">Price: <t t-esc="unit.pricing"/> USD</p>
                                        <p class="mb-1">Floor: <t t-esc="unit.floor"/></p>
                                        <p class="mb-1">Rooms: <t t-esc="unit.rooms"/> | Bathrooms: <t t-esc="unit.bathrooms"/></p>
                                        <p class="mb-2">Building: <t t-esc="unit.building_id.name if unit.building_id else '-'"/></p>
                                    </div>

                                    <!-- Image & View Details Button on the right -->
                                    <div class="d-flex flex-column align-items-center">
                                        <t t-set="img_url">
                                            <t t-if="unit.image_1920">
                                                <t t-esc="'/web/image/product.template/' + str(unit.id) + '/image_1920'"/>
                                            </t>
                                            <t t-else="'/web/static/src/img/placeholder.png'"/>
                                        </t>
                                        <img t-att-src="img_url" class="img-fluid rounded" style="width:120px; height:120px; object-fit:cover;"/>
                                        <a t-att-href="'/properties/%s' % unit.id" class="btn btn-sm btn-outline-primary mt-2">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Tree/List View -->
                <t t-if="view_type == 'tree'">
                    <div class="table-responsive shadow-sm rounded-4 overflow-hidden">
                        <table class="table table-hover table-bordered align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Floor</th>
                                    <th>Price</th>
                                    <th>Building</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="units" t-as="unit">
                                    <tr class="align-middle" >
                                        <!-- Image Column -->
                                        <td>
                                            <t t-if="unit.image_1920">
                                                <img t-att-src="'/web/image/product.template/%s/image_1920' % unit.id"
                                                     class="img-thumbnail" style="width:60px; height:60px; object-fit:cover; border-radius:8px;"/>
                                            </t>
                                            <t t-if="not unit.image_1920">
                                                <img src="/web/static/src/img/placeholder.png"
                                                     class="img-thumbnail" style="width:60px; height:60px; object-fit:cover; border-radius:8px;"/>
                                            </t>
                                        </td>

                                        <!-- Other Columns -->
                                        <td><t t-esc="unit.name"/></td>
                                        <td><t t-esc="unit.code"/></td>
                                        <td><t t-esc="unit.floor"/></td>
                                        <td><t t-esc="unit.pricing"/></td>
                                        <td><t t-esc="unit.building_id.name if unit.building_id else ''"/></td>
                                        <td>
                                            <a t-att-href="'/properties/%s' % unit.id" class="btn btn-sm btn-primary">
                                                <i class="fa fa-eye me-1"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Property Detail Page -->
<template id="property_detail_template" name="Property Detail">
    <t t-call="website.layout">
        <div class="container mt-5 mb-5">
            <div class="border rounded-4 p-5 shadow-sm bg-white">

                <!-- Back Button -->
                <div class="d-flex justify-content-between mb-4">
                    <a href="/properties" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i> Back to Properties
                    </a>

                    <a t-att-href="'/property/enquiry?property_id=%s' % unit.id" class="btn btn-outline-primary">
                        <i class="fa fa-envelope me-2"></i> Enquiry
                    </a>
                </div>

                <div class="row g-5 align-items-start">

                    <!-- Left: Property Details -->
                    <div class="col-lg-5">
                        <h1 class="fw-bold text-primary mb-3">
                            <t t-esc="unit.name"/>
                        </h1>
                        <p class="text-muted mb-1">Code: <t t-esc="unit.code"/></p>
                        <p class="fw-bold mb-3 text-success fs-5">
                            Price: <t t-esc="unit.pricing"/> USD
                        </p>
                        <p><strong>Floor:</strong> <t t-esc="unit.floor"/></p>
                        <p>
                            <strong>Rooms:</strong> <t t-esc="unit.rooms"/> |
                            <strong>Bathrooms:</strong> <t t-esc="unit.bathrooms"/>
                        </p>
                        <p><strong>Building:</strong> <t t-esc="unit.building_id.name if unit.building_id else '-'"/></p>

                        <p class="mt-3"><strong>Description:</strong></p>
                        <p class="text-muted"><t t-esc="unit.description or '-'"/></p>

                        <!-- Video -->
                        <t t-if="unit.video_url">
                            <h5 class="mt-4">Property Video</h5>
                            <div class="mt-2 ratio ratio-16x9">
                                <iframe t-att-src="unit.video_url" frameborder="0"></iframe>
                            </div>
                        </t>

                        <!-- Documents -->
                    </div>

                    <!-- Right: Images -->
                    <div class="col-lg-7 text-center">
                        <!-- Main Image -->

                        <t t-if="unit.image_1920">
                            <img t-att-src="'/web/image/product.template/' + str(unit.id) + '/image_1920'"
                                 class="img-fluid rounded-4 shadow-sm mb-4 border"
                                 style="width:70%; height:300px; object-fit:cover;"/>
                        </t>
                        <t t-if="not unit.image_1920">
                            <img src="/web/static/src/img/placeholder.png"
                                 class="img-fluid rounded-4 shadow-sm mb-4 border"
                                 style="width:70%; height:300px; object-fit:cover;"/>
                        </t>
                    </div>

                    <!-- Full Gallery -->
                    <div>
                        <t t-if="unit.property_template_image_ids and len(unit.property_template_image_ids) > 1">
                            <h5 class="d-flex justify-content-center mb-3 text-secondary fw-semibold">More Images</h5>
                            <hr class="mx-auto" style="width: 50%; border-top: 3px solid #6394dd;"/>
                            <div class="d-flex justify-content-center flex-wrap gap-4">
                                <t t-foreach="unit.property_template_image_ids" t-as="img">
                                    <div class="overflow-hidden rounded-3 shadow-sm border"
                                         style="max-width: 350px; transition: transform .3s;">
                                        <img t-att-src="'/web/image/property.image/' + str(img.id) + '/image_1920'"
                                             class="img-fluid rounded-3"
                                             style="object-fit: contain; width:100%; height:auto;"
                                             onmouseover="this.parentElement.style.transform='scale(1.05)'"
                                             onmouseout="this.parentElement.style.transform='scale(1)'"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>

                </div>

                <!-- Back Button -->
                <div class="d-flex justify-content-between mb-4">
                    <a href="/properties" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i> Back to Properties
                    </a>

                    <a t-att-href="'/property/enquiry?property_id=%s' % unit.id" class="btn btn-outline-primary">
                        <i class="fa fa-envelope me-2"></i> Enquiry
                    </a>
                </div>
            </div>
        </div>
    </t>
</template>

</odoo>
