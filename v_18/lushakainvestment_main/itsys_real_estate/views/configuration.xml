<odoo>
    <record id="res_config_settings_view_form_rs" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.rs</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Risk Management" string="Real Estate" name="itsys_real_estate">
                    <block title="Reservations" name="reservations" >
                        <setting string="Units Reservation" company_dependent="1" >
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="reservation_hours" class="col-2 o_light_label"/>
                                        <field name="reservation_hours" />
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Ownership Contracts" name="reservations" >
                        <setting string="Contracts Income Account" company_dependent="1" >
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="income_account" class="col-lg-3 o_light_label"/>
                                        <field name="income_account" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Rental Contracts" name="reservations" >
                        <setting string="Security Deposit" company_dependent="1" >
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="security_deposit_account" class="col-lg-3 o_light_label"/>
                                        <field name="security_deposit_account" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Revenue" company_dependent="1" >
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label for="revenue_account" class="col-lg-3 o_light_label"/>
                                        <field name="revenue_account" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
