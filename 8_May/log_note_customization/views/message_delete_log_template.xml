<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="message_delete_log_template">
        <div style="margin:8px 0;max-width:630px;">
            <div style="background:#f6f8fa;border:1px solid #dfe3e8;border-radius:12px;padding:14px 16px;box-shadow:0 1px 2px rgba(0, 0, 0, 0.06); background-color:aliceblue;">
                <div style="display:inline-block;padding:4px 10px;border-radius:999px;background:#fdecec;color:#c0392b;font-size:12px;font-weight:700;margin-bottom:10px;">
                    Message Deleted
                </div>

                <div style="margin:0 0 12px;font-size:13px;color:#4b525a;line-height:1.5;">
                    <span style="display:inline-block;margin:0 8px 8px 0;padding:5px 10px;background:#ffffff;border:1px solid #e3e6ea;border-radius:999px;">
                        <strong>Deleted by:</strong>
                        <t t-esc="deleted_by"/>
                    </span>
                    <span style="display:inline-block;margin:0 0 8px;padding:5px 10px;background:#ffffff;border:1px solid #e3e6ea;border-radius:999px;">
                        <strong>Deleted on:</strong>
                        <t t-esc="deleted_on"/>
                    </span>
                </div>

                <t t-if="reason">
                    <div style="margin-top:10px;">
                        <div style="margin:0 0 6px;font-size:12px;font-weight:600;color:#5f6368;">Reason:
                            <span style="background:#ffffff;color:#2f3337;line-height:1.5;word-break:break-word;">
                                <t t-esc="reason"/>
                            </span>
                        </div>
                    </div>
                </t>

                <div style="margin-top:12px;">
                    <div style="font-size:12px;font-weight:600;color:#5f6368;">Original content:
                        <span style="background:#ffffff;color:#2f3337;line-height:1.5;word-break:break-word;">
                            <t t-out="original_content"/>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
