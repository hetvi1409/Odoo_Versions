<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_calendar_fsm_assigned_filter" model="ir.ui.view">
        <field name="name">project.task.calendar.fsm.assigned.filter</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm.project_task_view_calendar_fsm"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="attributes">
                <attribute name="filters">1</attribute>
                <attribute name="string">Assigned To</attribute>
            </field>
        </field>
    </record>

    <record id="industry_fsm.project_task_action_fsm" model="ir.actions.act_window">
        <field name="context">{'fsm_mode': True,'default_scale': 'day',}</field>
    </record>

    <record id="industry_fsm.project_task_action_fsm2" model="ir.actions.act_window">
        <field name="context">{'fsm_mode': True,'default_scale': 'day',}</field>
    </record>

</odoo>
