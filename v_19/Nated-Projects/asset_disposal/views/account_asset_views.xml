<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">account.asset.view.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="asset_registry.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='asset_impairment']" position="inside">
                    <group>
                            <field name="fv_c2s"/>
                            <field name="value_in_use"/>
                            <field name="recoverable_amount" readonly="1"/>
                            <field name="carrying_amount"/>
                            <field name="impairment_loss" readonly="1"/>
                        </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="compute_impairment_loss" string="Check Impairment" type="object" class="oe_highlight"
                        groups="asset_impairment.group_asset_impairment_manager"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_asset_purchase_tree" model="ir.ui.view">
        <field name="name">account.asset.view.tree</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_purchase_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acquisition_date']" position="after">
                <field name="recoverable_amount"/>
                <field name="impairment_loss"/>
            </xpath>
        </field>
    </record>
</odoo>