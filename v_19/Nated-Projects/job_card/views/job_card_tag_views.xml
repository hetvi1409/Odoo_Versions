<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="job_card_tag_view_tree" model="ir.ui.view">
        <field name="name">job.card.tag.view.tree</field>
        <field name="model">job.card.tag</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>
    <record id="job_card_tag_action" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">job.card.tag</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a new Team</p>
        </field>
    </record>
    <menuitem parent="menu_job_card_configuration"
              id="menu_job_card_tag_action" name="Job Card Tag"
              action="job_card_tag_action" sequence="101"/>

</odoo>