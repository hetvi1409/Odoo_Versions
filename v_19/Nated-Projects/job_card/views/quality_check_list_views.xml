<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="quality_check_list_view_tree" model="ir.ui.view">
        <field name="name">quality.check.list.view.tree</field>
        <field name="model">quality.check.list</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <record id="quality_check_list_action" model="ir.actions.act_window">
        <field name="name">Quality Check List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">quality.check.list</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a new Quality
                CheckList
            </p>
        </field>
    </record>
    <menuitem parent="menu_job_card_configuration"
              id="menu_quality_check_list" name="Quality Check List"
              action="quality_check_list_action" sequence="101"/>

</odoo>