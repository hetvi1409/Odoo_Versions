<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="material_requisition_tree_view" model="ir.ui.view">
            <field name="name">Material Requisition</field>
            <field name="model">material.requisition</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="material_requisition_form_view" model="ir.ui.view">
            <field name="name">Material Requisition</field>
            <field name="model">material.requisition</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Submit" name="action_submit"
                                type="object" class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button string="Approve" name="action_approve"
                                type="object" class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'submit')]}"/>
                        <button string="Material Requisition" name="create_purchase_order"
                                type="object" class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'approve')]}"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submit,approve"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        <button name="get_purchase_order" class="oe_stat_button" icon="fa-pencil-square-o" type="object">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">PO</span>
                            </div>
                        </button>
                    </div>
                        <div class="oe_title">
                            <h1 class="d-flex">
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                                <field name="po_order_ids" widget="many2many_tags" invisible="1"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="job_card_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Requisition lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="uom"/>
                                        <field name="vendor_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_material_requisition" model="ir.actions.act_window">
            <field name="name">Material Requisition</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">material.requisition</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define a new Material
                    Requisition
                </p>
            </field>
        </record>
        <menuitem parent="maintenance.menu_m_request"
              id="menu_material_requisition" name="Material Requisition"
              action="action_material_requisition" sequence="101"/>

</odoo>