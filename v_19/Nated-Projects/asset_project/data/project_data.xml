<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="project_task_type_wip_to_do" model="project.task.type">
            <field name="name">Not Started</field>
        </record>
        <record id="project_task_type_wip_in_progress" model="project.task.type">
            <field name="name">In Progress</field>
        </record>
        <record id="project_task_type_wip_done" model="project.task.type">
            <field name="name">Completion</field>
        </record>

        <record id="project_task_type_asset" model="project.task.type">
            <field name="name">Asset</field>
        </record>
        <record id="project_project_wip" model="project.project">
            <field name="name">WIP</field>
            <field name="label_tasks">WIP Items</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="type_ids" eval="[Command.link(ref('project_task_type_wip_to_do')),Command.link(ref('project_task_type_wip_in_progress')),Command.link(ref('project_task_type_wip_done')),Command.link(ref('project_task_type_asset'))]"/>
        </record>


    </data>
</odoo>