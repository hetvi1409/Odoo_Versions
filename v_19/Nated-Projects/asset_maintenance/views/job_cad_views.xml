<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="job_card_view_tree" model="ir.ui.view">
        <field name="name">job.card.tree.view</field>
        <field name="model">job.card</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="name"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="job_card_view_form" model="ir.ui.view">
        <field name="name">job.card.view.form</field>
        <field name="model">job.card</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Confirm" name="action_submit" states="draft" type="object"
                            class="oe_highlight"/>

                    <button string="Approve" name="action_approve" states="submitted" type="object"
                            class="oe_highlight"/>

                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="sequence" string="Sequence"/>
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="deadline"/>
                            <field name="maintenance_id"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="project_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="job_card_action" model="ir.actions.act_window">
        <field name="name">Job Card</field>
        <field name="res_model">job.card</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Asset Type.
            </p>
        </field>
    </record>
    <menuitem parent="maintenance.menu_m_request"
              id="menu_job_card" name="Job Card"
              action="job_card_action" sequence="101"/>
</odoo>