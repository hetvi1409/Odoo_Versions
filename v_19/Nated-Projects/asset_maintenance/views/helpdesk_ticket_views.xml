<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.inherit.maintenance</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='assign_ticket_to_self']"
                   position="after">
                <button type="object" name="action_create_maintenance"
                        string="Create Maintenance Request"/>
            </xpath>
        </field>
    </record>
</odoo>