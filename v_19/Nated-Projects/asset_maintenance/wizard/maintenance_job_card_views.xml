<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="maintenance_job_card_view_form" model="ir.ui.view">
       <field name="name">maintenance.job.card.view.form</field>
       <field name="model">maintenance.job.card</field>
       <field name="arch" type="xml">
           <form string="Report Options">
               <group>
                   <field name="name"/>
                   <field name="maintenance_id"/>
                   <field name="start_date"/>
                   <field name="planned_hours"/>
               </group>
               <footer>
                   <button name="action_create_job_card" string="Create Job Card" type="object"
                             default_focus="1" class="oe_highlight"/>
                   <button string="Cancel" class="btn btn-default" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
</odoo>