<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_department_tree_view" model="ir.ui.view">
        <field name="name">helpdesk.department.tree.view</field>
        <field name="model">helpdesk.department</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="helpdesk_department_action" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">helpdesk.department</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Department.
            </p>
        </field>
    </record>
        <menuitem parent="helpdesk.helpdesk_menu_config"
              id="menu_helpdesk_department" name="Department"
              action="helpdesk_department_action" sequence="101"/>

</odoo>