<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_sub_category_tree_view" model="ir.ui.view">
        <field name="name">helpdesk.sub.category.tree.view</field>
        <field name="model">helpdesk.sub.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="category_id"/>
                <field name="department_id"/>
            </tree>
        </field>
    </record>
    <record id="helpdesk_sub_category_action" model="ir.actions.act_window">
        <field name="name">Sub Category</field>
        <field name="res_model">helpdesk.sub.category</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Sub Category.
            </p>
        </field>
    </record>
    <menuitem parent="helpdesk.helpdesk_menu_config"
              id="menu_helpdesk_sub_category" name="Sub Category"
              action="helpdesk_sub_category_action" sequence="101"/>
</odoo>
