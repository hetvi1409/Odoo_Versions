<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_cc']" position="after">
                <!--                <field name="assignee_id"/>-->
                <field name="department_id"/>
                <field name="category_id"/>
                <field name="sub_category_id"/>
                <field name="is_internal_resolve"/>
                <field name="is_reviewed" invisible="0"/>
                <field name="inventory_required"/>

            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="operation_area"/>
                <field name="location"/>
                <field name="town"/>
                <field name="date_attended"/>
                <field name="date_completed"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        attrs="{'invisible': [('stock_request_count', '=', 0)]}"
                        name="action_stock_request" icon="fa-random">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="stock_request_count" nolabel="1"/>
                            <span class="text-secondary fw-normal">Stock
                                Request
                            </span>
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//button[@name='assign_ticket_to_self']"
                   position="before">
                <button name="action_review_incidents" string="Review"
                        type="object" class="oe_highlight"
                        groups="helpdesk_field_service_data.group_area_manager"
                        attrs="{'invisible': [('is_reviewed', '=', True)]}"
                        data-hotkey="q"/>
                <button name="action_request_stock" string="Requesting Stock"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': [('stock_request', '=', False)]}"
                        groups="helpdesk_field_service_data.group_buyer_scm"
                        data-hotkey="q"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Comments">
                        <field name="comments"
                               placeholder="Comments of the ticket..."/>
                    </page>
                    <page string="Inventory Details"
                          attrs="{'invisible': [('inventory_required', '=', False)]}">
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="qty_available"/>
                                <field name="stock_request_ids"
                                       widget="many2many_tags"/>
                            </group>
                            <group>
                                <button name="action_inventory_available"
                                        string="Is Inventory Available"
                                        type="object" class="oe_highlight"
                                        groups="helpdesk_field_service_data.group_buyer_scm"
                                        data-hotkey="q"/>
                                <field name="stock_request_count" invisible="" />
                                <field name="stock_request"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
