                                <th class="text-right">Cancelled</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data"
                                t-as="rec">
                                <td>
                                    <t t-esc="rec[0]"/>
                                </td>
                                <td>
                                    <span t-esc="rec[1]"/>:
                                    <span t-esc="rec[2]"/>
                                </td>
