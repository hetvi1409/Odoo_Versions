                <div calss="page">
                    <img class="img"
                         src="/asset_reports/static/src/img/report_icon.png"/>
                    <br/>
                    <h3>Impairment</h3>
                    <table class="table">
                        <tbody class="order_body">
                            <tr>
                                <td>
                                    From date:
