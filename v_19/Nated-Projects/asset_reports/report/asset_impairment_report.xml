                                </td>
                                <td>
                                    <span t-esc="rec[8]"/>
                                </td>
                                <td>
                                    <t t-if="rec[9] == 'cancelled'">
                                        True
                                    </t>
                                    <t t-if="rec[9] != 'cancelled'">
                                        False
                                    </t>
                                </td>
                            </tr>
