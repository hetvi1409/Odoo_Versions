<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_asset_impairment" model="ir.actions.report">
        <field name="name">Asset Impairment</field>
        <field name="model">asset.impairment.reports</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">asset_reports.report_asset_impairment</field>
        <field name="report_file">asset_reports.report_asset_impairment</field>
        <field name="print_report_name">'Asset Impairment - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_asset_impairment_reports"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_asset_impairment">
        <t t-call="web.html_container">
            <!--            <t t-foreach="docs" t-as="doc">-->
