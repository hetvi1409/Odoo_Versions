<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View for asset transfer department -->
    <record id="asset_transfer_department_tree_view" model="ir.ui.view">
        <field name="name">asset.transfer.department.tree.view</field>
        <field name="model">asset.transfer.department</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="asset_transfer_department_action" model="ir.actions.act_window">
        <field name="name">Asset Transfer Department</field>
        <field name="res_model">asset.transfer.department</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Asset Department.
            </p>
        </field>
    </record>
        <!-- View for asset transfer division -->
    <record id="asset_transfer_division_tree_view" model="ir.ui.view">
        <field name="name">asset.transfer.division.tree.view</field>
        <field name="model">asset.transfer.division</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="asset_transfer_division_action" model="ir.actions.act_window">
        <field name="name">Asset Transfer Division</field>
        <field name="res_model">asset.transfer.division</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Asset Division.
            </p>
        </field>
    </record>
        <!-- View for asset transfer ownership -->
    <record id="asset_transfer_ownership_tree_view" model="ir.ui.view">
        <field name="name">asset.transfer.ownership.tree.view</field>
        <field name="model">asset.transfer.ownership</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="asset_transfer_ownership_action" model="ir.actions.act_window">
        <field name="name">Asset Transfer Ownership</field>
        <field name="res_model">asset.transfer.ownership</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Asset Ownership.
            </p>
        </field>
    </record>
    <menuitem parent="account.menu_finance_entries_management"
              id="menu_asset_transfer_department" name="Asset Department"
              action="asset_transfer_department_action" sequence="101"/>
    <menuitem parent="account.menu_finance_entries_management"
              id="menu_asset_transfer_division" name="Asset Division"
              action="asset_transfer_division_action" sequence="101"/>
    <menuitem parent="account.menu_finance_entries_management"
              id="menu_asset_transfer_ownership" name="Asset Ownership"
              action="asset_transfer_ownership_action" sequence="101"/>
</odoo>