<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="asset_lose_view_form" model="ir.ui.view">
        <field name="name">asset.lose.view.form</field>
        <field name="model">asset.lose</field>
        <field name="arch" type="xml">
            <form string="Import Assets">
                <group>
                    <field name="asset_reason"/>
                    <field name="description"/>
                    <group>
                        <field name="asset_id" readonly="1"/>
                        <field name="asset_ids" widget="many2many_tags"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="cash_type"
                               attrs="{'invisible': [('type', '!=', 'cash')], 'required': [('type', '=', 'cash')]}"/>
                        <field name="non_cash_type"
                               attrs="{'invisible': [('type', '!=', 'non_cash')], 'required': [('type', '=', 'non_cash')]}"/>
                        <field name="direct_disposal_amount"/>

                    </group>
                    <group>
                        <field name="asset_id_no"/>
                        <field name="type"/>
                        <field name="direct_attachement_ids" widget="many2many_binary"/>
                    </group>
                </group>
                <footer>
                    <button name="action_submit" string="Submit"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="asset_disposal_action" model="ir.actions.act_window">
        <field name="name">Asset Disposal</field>
        <field name="res_model">asset.lose</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_lose_view_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_asset_disposal"
              name="Asset Disposal"
              action="asset_disposal_action"
              parent="account.menu_finance_entries_management"/>
</odoo>