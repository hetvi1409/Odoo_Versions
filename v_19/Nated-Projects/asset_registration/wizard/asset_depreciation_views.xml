<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="asset_depreciation_view_form" model="ir.ui.view">
        <field name="name">asset.depreciation.view.form</field>
        <field name="model">asset.depreciation</field>
        <field name="arch" type="xml">
            <form string="Import Assets">
                <group>
                    <group>
                        <field name="asset_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="asset_id_no"/>
                    </group>
                </group>
                <footer>
                    <button name="action_asset_depreciation" string="Asset Depreciation"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="asset_depreciation_action" model="ir.actions.act_window">
        <field name="name">Asset Depreciation</field>
        <field name="res_model">asset.depreciation</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_depreciation_view_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_asset_depreciation"
              name="Asset Depreciation"
              action="asset_depreciation_action"
              parent="account.menu_finance_entries_management"/>
</odoo>