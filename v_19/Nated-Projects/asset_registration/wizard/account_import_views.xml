<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="account_import_view_form" model="ir.ui.view">
       <field name="name">Account Import</field>
       <field name="model">account.import</field>
       <field name="arch" type="xml">
           <form string="Report Options">
               <group col="4">
                   <field name="file"/>
               </group>
               <footer>
                   <button name="action_import_xlsx" string="PRINT" type="object"
                             default_focus="1" class="oe_highlight"/>
                   <button string="Cancel" class="btn btn-default" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
   <record id="account_import_action" model="ir.actions.act_window">
       <field name="name">Account Import</field>
       <field name="res_model">account.import</field>
       <field name="type">ir.actions.act_window</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
   </record>
   <menuitem id="account_import_menu" name="Account Import"
              parent="account.menu_finance_entries_management" action="account_import_action" />
</odoo>