<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="footer_copyright_company_name" inherit_id="website.layout">
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
            <t t-set="footer_company_name" t-value="request.env['ir.config_parameter'].sudo().get_param('powered_by_odoo_remove.powered_by_text') or res_company.name"/>
            <span class="o_footer_copyright_name me-2 small">Copyright &amp;copy; <t t-esc="footer_company_name"/></span>
        </xpath>
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
            <attribute name="class" add="d-flex flex-column-reverse gap-2" separator=" "/>
        </xpath>
    </template>
</odoo>
