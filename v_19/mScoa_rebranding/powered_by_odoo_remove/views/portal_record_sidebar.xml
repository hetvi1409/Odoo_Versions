<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="remove_powered_by_portal" inherit_id="portal.portal_record_sidebar">
        <xpath expr="//div[contains(@class, 'text-muted') and contains(., 'Powered by')]" position="replace">
            <t t-set="powered_by_text" t-value="request.env['ir.config_parameter'].sudo().get_param('powered_by_odoo_remove.powered_by_text', '')"/>
            <div t-if="powered_by_text" class="d-none d-lg-block mt-5 small text-center text-muted">
                <t t-esc="powered_by_text"/>
            </div>
        </xpath>
    </template>
</odoo>