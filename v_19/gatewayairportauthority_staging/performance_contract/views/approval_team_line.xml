<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="approval_team_list_view_form" model="ir.ui.view">
        <field name="name">approval.team.list.view.form</field>
        <field name="model">approval.team.line</field>
        <field name="arch" type="xml">
            <form string="Approval Team list">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="team_id"/>
                        <field name="approval_date"/>
                        <field name="status" widget="badge" decoration-success="status == 'approved'"
                        decoration-info="status =='pending'" decoration-danger="status =='rejected'"/>
                        <field name="approved"/>
                        <field name="reject_reason"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="approval_team_list_view" model="ir.ui.view">
        <field name="name">approval.team.list.view</field>
        <field name="model">approval.team.line</field>
        <field name="arch" type="xml">
            <list string="Approval Team lists">
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_approval_list" model="ir.actions.act_window">
        <field name="name">Approval lists</field>
        <field name="res_model">approval.team.line</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>

