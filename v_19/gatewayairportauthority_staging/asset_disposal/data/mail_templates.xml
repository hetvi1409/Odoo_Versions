<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="email_template_asset_impairment" model="mail.template">
            <field name="name">Asset Impairment Notification</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="subject">Impairment Alert: Asset {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email or '' }}</field>
           <field name="body_html" type="html">
    <div>
        <p>The asset <t t-esc="object.name"/> has been impaired with a loss of <t t-esc="object.impairment_loss"/>.</p>
        <p>Please review the asset details.</p>
    </div>
</field>

        </record>
    </data>
</odoo>