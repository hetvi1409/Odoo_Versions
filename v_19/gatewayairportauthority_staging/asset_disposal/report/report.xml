<odoo>
    <report
        id="action_report_asset_impairment"
        model="account.asset"
        string="Asset Impairment Report"
        report_type="qweb-pdf"
        name="asset_impairment.report_asset_impairment"
        file="asset_impairment.report_asset_impairment"
        print_report_name="'Asset Impairment Report - %s' % (object.name)"
    />

<odoo>
    <template id="report_asset_disposal_audit">
        <t t-call="web.basic_layout">
            <div class="page">
                <h2>Asset Disposal Audit Report</h2>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Asset Name</th>
                            <th>Disposal Method</th>
                            <th>Disposal Date</th>
                            <th>Carrying Amount</th>
                            <th>Selling Price</th>
                            <th>Profit/Loss</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="o">
                            <tr>
                                <td><span t-field="o.name"/></td>
                                <td><span t-field="o.disposal_method"/></td>
                                <td><span t-field="o.disposal_date"/></td>
                                <td><span t-field="o.carrying_amount"/></td>
                                <td><span t-field="o.selling_price"/></td>
                                <td><span t-field="o.audit_log" /></td>
                                <td><span t-field="o.disposal_state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>

</odoo>