<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_meter_manufacturer_form" model="ir.ui.view">
        <field name="name">Meter Manufacturer Form</field>
        <field name="model">x.meter.manufacturer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
<!--                        <field name="x_active" invisible="1"/>-->
<!--                        <field name="x_studio_image" widget="image" class="oe_avatar"/>-->
                        <field name="x_name" required="1" placeholder="Name.."/>
<!--                        <field name="x_studio_company_id" readonly="True" force_save="1"/>-->
                        <field name="x_studio_sequence" />
                    </group>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meter_manufacturer_tree" model="ir.ui.view">
        <field name="name">Meter Manufacturer Tree</field>
        <field name="model">x.meter.manufacturer</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_studio_sequence" widget="handle"/>
                <field name="x_name"/>
            </list>
        </field>
    </record>

