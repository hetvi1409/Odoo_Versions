<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_property_category_form" model="ir.ui.view">
        <field name="name">Property Category Form</field>
        <field name="model">x.property.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_active" invisible="1"/>
                        <field name="x_name" required="1"/>
<!--                        <field name="x_studio_company_id" groups="base.group_multi_company"-->
<!--                               options="{'no_create': True}" readonly="1"/>-->
                    </group>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_property_category_tree" model="ir.ui.view">
        <field name="name">Property Category Tree</field>
        <field name="model">x.property.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_sequence" widget="handle"/>
                <field name="x_name"/>
<!--                <field name="x_studio_company_id" groups="base.group_multi_company" column_invisible="1"/>-->
            </list>
        </field>
    </record>

