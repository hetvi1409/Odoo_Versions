<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="meter_audit_main_menu"
              name="Meter Audit" groups="base.group_system"
    />
    <record id="action_meter_audit" model="ir.actions.act_window">
        <field name="name">Meter Audit</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_x_studio_meter_audit': True}</field>
        <field name="domain">[('x_studio_meter_audit', '=', True)]</field>
    </record>


    <menuitem id="meter_audit_menu"
              name="Meter Audit" groups="base.group_system"
              sequence="0"
              action="action_meter_audit"
              parent="meter_audit_main_menu"/>

    <menuitem id="audit_meter_report_conf"
              name="Configuration" groups="base.group_system"
              sequence="10"
              parent="meter_audit_main_menu"/>


    <!-- ======================
         DWELLING TYPES
    ========================== -->
    <record id="action_dwelling_types" model="ir.actions.act_window">
        <field name="name">Dwelling Types</field>
        <field name="res_model">x.dwelling.types</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dwelling_types"
              name="Dwelling Types"
              parent="audit_meter_report_conf"
              action="action_dwelling_types"
              sequence="1"
    />


    <!-- ======================
         PROPERTY CATEGORY
    ========================== -->
    <record id="action_property_category" model="ir.actions.act_window">
        <field name="name">Property Category</field>
        <field name="res_model">x.property.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_property_category"
              name="Property Categories"
              parent="audit_meter_report_conf"
              action="action_property_category"
              sequence="2"/>


    <!-- ======================
         METER MANUFACTURER
    ========================== -->
    <record id="action_meter_manufacturer" model="ir.actions.act_window">
        <field name="name">Meter Manufacturer</field>
        <field name="res_model">x.meter.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_meter_manufacturer"
              name="Meter Manufacturer"
              parent="audit_meter_report_conf"
              action="action_meter_manufacturer"
              sequence="3"/>


    <!-- ======================
         METER CONDITION
    ========================== -->
    <record id="action_meter_condition" model="ir.actions.act_window">
        <field name="name">Meter Condition</field>
        <field name="res_model">x.meter.condition</field>
        <field name="view_mode">list,form,map</field>
    </record>

    <menuitem id="menu_meter_condition"
              name="Meter Condition"
              parent="audit_meter_report_conf"
              action="action_meter_condition"
              sequence="4"/>

</odoo>
