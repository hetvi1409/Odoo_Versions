<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_meter_condition_form" model="ir.ui.view">
        <field name="name">Meter Condition Form</field>
        <field name="model">x.meter.condition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
<!--                        <field name="x_active" invisible="1"/>-->
                        <field name="x_name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meter_condition_tree" model="ir.ui.view">
        <field name="name">Meter Condition Tree</field>
        <field name="model">x.meter.condition</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
            </list>
        </field>
    </record>

