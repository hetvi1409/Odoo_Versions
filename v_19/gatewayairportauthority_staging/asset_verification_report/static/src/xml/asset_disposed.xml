<?xml version="1.0" encoding="UTF-8" ?>
<templates>
   <t t-name="AssetDisposedReport" owl="1">
       <!-- Section contains a structure for the purchase report, including a filter
       view and a table view. It has div elements for the filter view and table view,
       with respective classes for styling. -->
       <div class="">
           <div>
               <center>
                   <h1 style="margin: 20px;">Asset Disposed Report</h1>
               </center>
           </div>
       </div>
       <div class="print-btns">
           <div class="sub_container_left print-actions">
               <button type="button" class="btn btn-primary action-btn"
                       t-on-click="printPdf">
                   Print (PDF)
               </button>

               <button type="button" class="btn btn-primary action-btn"
                       t-on-click="print_xlsx">
                   Export (XLSX)
               </button>
           </div>
           <br/>
           <div class="sub_container_right filter-container">

               <!-- Custodian Filter -->
               <div class="filter-item">
                   <label>
                       <strong>Custodian</strong>
                   </label>
                   <select class="form-control" t-ref="custodian">
                       <option value="">-- Select Custodian --</option>
                       <t t-foreach="state.custodian_list" t-as="c"
                          t-key="c['id']">
                           <option t-att-value="c.id">
                               <t t-esc="c.name"/>
                           </option>
                       </t>
                   </select>
               </div>

               <!-- Department Filter -->
               <div class="filter-item">
                   <label>
                       <strong>Department</strong>
                   </label>
                   <select class="form-control" t-ref="department">
                       <option value="">-- Select Department --</option>
                       <t t-foreach="state.department_list" t-as="d"
                          t-key="d['id']">
                           <option t-att-value="d.id">
                               <t t-esc="d.name"/>
                           </option>
                       </t>
                   </select>
               </div>

               <!-- Type Filter -->
               <div class="filter-item">
                   <label>
                       <strong>Type</strong>
                   </label>
                   <select class="form-control" t-ref="type">
                       <option value="">-- Select Type --</option>
                       <option value="minor">Minor</option>
                       <option value="major">Major</option>
                   </select>
               </div>

               <!-- Filter Button -->
               <div class="filter-button">
                   <button type="button" class="btn btn-primary"
                           t-on-click="load_data">
                       Filter
                   </button>
               </div>

           </div>
       </div>

       <div class="overflow-auto" style="height: 70vh; padding:10px">
           <div>
               <div class="table_main_view">
                   <table cellspacing="0" width="100%">
                       <thead>
                           <tr class="table_pr_head">
                               <th class="mon_fld">Asset</th>
                               <th class="mon_fld">Barcode</th>
                               <th class="mon_fld">Disposal Date</th>
                               <th class="mon_fld">Disposal Method</th>
                               <th class="mon_fld">Disposal Value</th>
                               <th class="mon_fld">Department</th>
                               <th class="mon_fld">Custodian</th>
                           </tr>
                       </thead>
                       <tbody>
                           <t t-foreach="state.assets"
                              t-as="asset"
                              t-key="asset['id']">
                               <tr style="border: 1.5px solid black;"
                                   class="pr-line"
                                   t-att-data-account-id="asset['id']"
                                   t-attf-data-target=".a{{asset['id']}}">
                                   <td>
                                       <t t-if="asset['id']">
                                           <div>
                                               <a>
                                                   <span class="caret"/>
                                                   <span>
                                                       <t t-esc="asset['name']"/>
                                                   </span>
                                               </a>
<!--                                               <ul class="dropdown-menu"-->
<!--                                                   role="menu"-->
<!--                                                   aria-labelledby="table_toggle_btn">-->
<!--                                                   <li>-->
<!--                                                       <a class="view_purchase_order"-->
<!--                                                          tabindex="-1"-->
<!--                                                          href="#"-->
<!--                                                          t-att-id="asset['id']"-->
<!--                                                          t-on-click="viewPurchaseOrder">-->
<!--                                                           View Purchase Order-->
<!--                                                       </a>-->
<!--                                                   </li>-->
<!--                                               </ul>-->
                                           </div>
                                       </t>
                                   </td>
                                   <td style="text-align:center;">
                                       <span>
                                           <t t-esc="asset['alternative_ref'] or ''"/>
                                       </span>
                                   </td>
                                   <td style="text-align:center;">
                                       <span>
                                           <t t-esc="asset['disposal_date']"/>
                                       </span>
                                   </td>
                                   <td style="text-align:center;">
                                       <span>
                                           <t t-esc="asset['disposal_method']"/>
                                       </span>
                                   </td>
                                   <td style="text-align:center;">
                                       <span>
                                           <t t-esc="asset['disposal_price']"/>
                                       </span>
                                   </td>
                                   <td style="text-align:center;">
                                       <span>
                                           <t t-if="asset['custodian_department_id']">
                                               <t t-esc="asset['custodian_department_id'][1]"/>
                                           </t>
                                       </span>
                                   </td>
                                   <td style="text-align:center;">
                                       <span>
                                           <t t-if="asset['custodian_id']">
                                               <t t-esc="asset['custodian_id'][1]"/>
                                           </t>
                                       </span>
                                   </td>
                               </tr>
                           </t>
                       </tbody>
                   </table>
               </div>
           </div>
       </div>
   </t>
</templates>
