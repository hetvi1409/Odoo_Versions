<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_asset_category_list" model="ir.ui.view">
        <field name="name">asset.category.list</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="is_movable"/>
                <field name="is_immovable"/>
                <field name="is_intangible"/>
            </list>
        </field>
    </record>

    <record id="view_asset_category_search" model="ir.ui.view">
        <field name="name">asset.category.search.view</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="is_movable"/>
                <field name="is_immovable"/>
                <field name="is_intangible"/>
                <filter string="Movables" name="filter_movables" domain="[('is_movable','=', True)]" />
                <filter string="Immovables" name="filter_immovables" domain="[('is_immovable','=', True)]" />
                <filter string="Intangibles" name="filter_intangibles" domain="[('is_intangible','=', True)]" />
                <group>
                    <filter string="Movables" name="group_movables"
                            context="{'group_by':'is_movable'}"/>
                    <filter string="Immovables" name="group_immovables"
                            context="{'group_by':'is_immovable'}"/>
                    <filter string="Intangibles" name="group_intangibles"
                            context="{'group_by':'is_intangible'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_category_action" model="ir.actions.act_window">
        <field name="name">Asset Category</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">list,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Asset Category
            </p>
        </field>
    </record>




    <menuitem id="asset_category_menuitem"
            name="Asset Category"
            action="asset_category_action"
            parent="accountant.menu_accounting"
            sequence="1"
    />
</odoo>