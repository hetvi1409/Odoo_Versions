<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="category_fixed_asset" model="ir.module.category">
            <field name="name">Fixed Asset Manager</field>
        </record>
        <record model="res.groups.privilege" id="module_category_fixed_asset_privilege">
            <field name="name">Fixed Asset</field>
            <field name="category_id" ref="category_fixed_asset"/>
            <field name="sequence">7</field>
        </record>

        <record id="group_fixed_asset_capturer" model="res.groups">
            <field name="name">Fixed Assets - Capturer</field>
            <field name="privilege_id" ref="module_category_fixed_asset_privilege"/>
        </record>

        <!-- Approver (1st level reviewer) -->
        <record id="group_fixed_asset_approver" model="res.groups">
            <field name="name">Fixed Asset Manager</field>
            <field name="implied_ids" eval="[(4, ref('fixed_assets.group_fixed_asset_capturer'))]"/>
            <field name="privilege_id" ref="module_category_fixed_asset_privilege"/>
        </record>

        <!-- Final Reviewer (CFO) -->
        <record id="group_fixed_asset_final_reviewer" model="res.groups">
            <field name="name">Fixed Assets - Final Reviewer &amp; CFO</field>
            <field name="implied_ids" eval="[(4, ref('fixed_assets.group_fixed_asset_approver'))]"/>
            <field name="privilege_id" ref="module_category_fixed_asset_privilege"/>
        </record>

        <!-- Rule: Capturer can create -->
        <record id="rule_asset_capturer_create" model="ir.rule">
            <field name="name">Asset Capturer – Create</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="groups" eval="[(4, ref('group_fixed_asset_capturer'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
