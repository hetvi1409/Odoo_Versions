<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_asset_verification_job" model="ir.actions.act_window">
    <field name="name">Asset Verification Jobs</field>
    <field name="res_model">asset.verification.job</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="oe_view_nocontent_create">
            Create your first asset verification job.
        </p>
    </field>
</record>

    <record id="action_asset_verification_staging" model="ir.actions.act_window">
    <field name="name">Unverified Assets</field>
    <field name="res_model">asset.verification.staging</field>
    <field name="view_mode">list,form</field>
</record>

    <!-- Client action for the  dashboard    -->
    <record id="account_asset_action_barcode_search"
            model="ir.actions.client">
        <field name="name">Find Asset</field>
        <field name="tag">account_alternative_ref</field>
    </record>


               <record model="ir.ui.view" id="asset_removal_form_approval">
            <field name="name">asset.removal.approval.form</field>
            <field name="model">asset.removal.approval</field>
            <field name="priority">1</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Asset Removal Approval">
                    <header>
                        <button name="action_approve" string="Approve" type="object"
                                class="oe_highlight"
                                invisible="state != 'send'" groups="asset_verification.group_staging_approval_manager"/>
                        <button name="action_reject" string="Reject" type="object"
                                invisible="state != 'send'" groups="asset_verification.group_staging_approval_manager"/>
                        <button name="action_submit_for_approval" string="Submit For Approval" type="object"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="asset_id" string="Asset"/>
                                <field name="removal_reason" string="Reason for Removal" widget="text"/>
                                <field name="document_id"/>
                            </group>
                            <group>
                                <field name="user_id" string="Submitted By" readonly="1"/>
                                <field name="removal_date" string="Removal Date"/>
                            </group>
                        </group>

                        <notebook colspan="4">
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- list View for Asset Removal Approval -->
        <record model="ir.ui.view" id="asset_removal_list_approval">
            <field name="name">asset.removal.approval.list</field>
            <field name="model">asset.removal.approval</field>
            <field name="priority">1</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Asset Removal Approval">
                    <field name="asset_id" string="Asset"/>
                    <field name="state" string="Status"/>
                </list>
            </field>
        </record>

        <!-- Action for Building Removal Approval -->
        <record id="action_asset_removal_approval" model="ir.actions.act_window">
            <field name="name">Asset Removal Approval</field>
            <field name="res_model">asset.removal.approval</field>
            <field name="view_mode">list,form</field>
        </record>

    <!--     Menu item for the find product -->
    <menuitem id="product_detail_search_barcode_menu" name="Asset Verification"
              action="account_asset_action_barcode_search"
              parent="accountant.menu_accounting" sequence="1"/>

    <menuitem id="menu_asset_verification_job" name="Verification Jobs"
          parent="accountant.menu_accounting" action="action_asset_verification_job" sequence="10"/>

    <menuitem id="menu_asset_verification_staging" name="Unverified Assets" parent="accountant.menu_accounting"
              action="action_asset_verification_staging"/>

<!--        <menuitem id="menu_asset_verification_approval_removal" name="Assets Removal Approval" parent="accountant.menu_accounting"-->
<!--              action="action_asset_removal_approval"/>-->


<!--    <menuitem id="menu_asset_verification_job_location" name="Job Locations"-->
<!--              parent="accountant.menu_accounting" action="action_asset_verification_job_location" sequence="11"/>-->


</odoo>