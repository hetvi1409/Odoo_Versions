<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_asset_condition_form" model="ir.ui.view">
        <field name="name">asset.condition.form</field>
        <field name="model">asset.condition</field>
        <field name="arch" type="xml">
            <form string="Asset Condition">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list view -->
    <record id="view_asset_condition_list" model="ir.ui.view">
        <field name="name">asset.condition.list</field>
        <field name="model">asset.condition</field>
        <field name="arch" type="xml">
            <list string="Asset Condition">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_asset_condition" model="ir.actions.act_window">
        <field name="name">Asset Conditions</field>
        <field name="res_model">asset.condition</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>