<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="folder_view_form_inherit" model="ir.ui.view">
        <field name="name">documents.document.view.form.eastern</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_upload_url_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='folder_id']" position="after">
                <field name="sharepoint_base_url"/>
                <field name="sharepoint_site_name"/>
            </xpath>
        </field>
    </record>

</odoo>