                                </td>
                                <td>
                                    -
                                </td>
                            </tr>


                        </tbody>
                    </table>
                    <table class="table table-condensed">
                        <thead>
                            <tr class="text-center">
                                <th class="text-right">Asset Description
                                </th>
                                <th class="text-right">Disposal Income</th>
                                <th class="text-right">Disposal Expense</th>
                                <th class="text-right">Disposal Depreciation
                                </th>
                                <th class="text-right">Profit / Loss</th>
                                <th class="text-right">Date</th>
                                <th class="text-right">Captured By</th>
                                <th class="text-right">Cancelled</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data" t-as="rec">
                                <td>
                                    <t t-esc="rec[0]"/>
                                </td>
                                <td>
                                    <span t-esc="rec[1]"/>:
                                    <span t-esc="rec[2]"/>
                                </td>
                                <td>
                                    <span t-esc="rec[3]"/>
                                </td>
                                <td>
                                    <t t-if="len(rec) > 4">
                                        <span t-esc="rec[4]"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="len(rec) > 5">
                                        <span t-esc="rec[5]"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="len(rec) > 6">
                                        <t t-if="rec[6] == 'cancelled'">True</t>
                                        <t t-else="">False</t>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
