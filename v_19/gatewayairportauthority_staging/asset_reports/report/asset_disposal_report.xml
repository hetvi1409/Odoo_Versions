<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_asset_disposal" model="ir.actions.report">
        <field name="name">Asset Disposal</field>
        <field name="model">asset.disposal.reports</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">asset_reports.report_asset_disposal</field>
        <field name="report_file">asset_reports.report_asset_disposal</field>
        <field name="print_report_name">'Asset Disposal - %s' % (object.name)
        </field>
        <field name="binding_model_id" ref="model_asset_acquisition_reports"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_asset_disposal">
        <t t-call="web.html_container">
            <!--            <t t-foreach="docs" t-as="doc">-->
            <t t-call="web.external_layout">
                <div calss="page">
                    <img class="img"
                         src="/asset_reports/static/src/img/report_icon.png"/>
                    <br/>
                    <h3>Disposal</h3>
                    <table class="table">
                        <tbody class="order_body">
                            <tr>
                                <td>
                                    From date:
                                </td>
                                <td>
                                    <t t-esc="from_date"/>
                                </td>
                                <td>
                                    Cost Centre:
                                </td>
                                <td>
                                    -
                                </td>
                                <td>
                                    Facility:
                                </td>
                                <td>
                                    -
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    To Date:
                                </td>
                                <td>
                                    <t t-esc="to_date"/>
                                </td>
                                <td>
                                    Department:
                                </td>
                                <td>
                                    -
                                </td>
                                <td>
                                    Function:
                                </td>
                                <td>
                                    -
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Is Approved:
                                </td>
                                <td>
                                    _
                                </td>
                                <td>
                                    Class:
                                </td>
                                <td>
                                    -
                                </td>
                                <td>
                                    Fund:
                                </td>
                                <td>
                                    -
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Date Type:
                                </td>
                                <td>
                                    _
                                </td>
                                <td>
                                    Item:
                                </td>
                                <td>
                                    -
                                </td>
                                <td>
                                    Region:
                                </td>
                                <td>
                                    -
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Class:
                                </td>
                                <td>
                                    _
                                </td>
                                <td>
                                    Project:
                                </td>
                                <td>
                                    -
                                </td>
                                <td>
                                    Dim 12:
                                </td>
                                <td>
                                    -
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    CompType:
                                </td>
                                <td>
                                    _
                                </td>
                                <td>
                                    Supplier:
                                </td>
                                <td>
                                    -
                                </td>
                                <td>
                                    Dim 13:
                                </td>
                                <td>
                                    -
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Cost Center:
                                </td>
