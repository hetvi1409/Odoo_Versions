<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Asset Register views -->
    <record id="asset_register_report_view_form" model="ir.ui.view">
        <field name="name">asset.register.report.view.form</field>
        <field name="model">asset.register.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="to_date"/>
                    </group>
                    <group>
                        <field name="from_date"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xlsx" string="Print report"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="asset_register_report_action" model="ir.actions.act_window">
        <field name="name">Asset Register</field>
        <field name="res_model">asset.register.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="asset_register_report_menu"
              name="Asset Register Report"
              action="asset_register_report_action"
              parent="account.account_reports_management_menu"/>
</odoo>
