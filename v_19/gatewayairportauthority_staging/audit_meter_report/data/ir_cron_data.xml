<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_cron_send_followup_mail" model="ir.cron">
        <field name="name">Inspection Status: Successful</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="code">model.action_inspection_status_check()</field>
        <field name="state">code</field>
    </record>

    <odoo>
    <data noupdate="1">
        <record id="ir_cron_manual_update_customer_status" model="ir.cron">
            <field name="name">Manual: Update Customer Status</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.update_customer_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field> <!-- Disable automatic triggering -->
        </record>
    </data>
</odoo>
</odoo>