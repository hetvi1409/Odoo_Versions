<odoo>
    <!-- Tree View for audit.line -->
    <record id="view_audit_line_tree" model="ir.ui.view">
        <field name="name">audit.line.tree</field>
        <field name="model">audit.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="audit_user_id"/>
                <field name="inspection_status"/>
            </list>
        </field>
    </record>

    <!-- Form View for audit.line -->
    <record id="view_audit_line_form" model="ir.ui.view">
        <field name="name">audit.line.form</field>
        <field name="model">audit.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="audit_user_id"/>
                        <field name="inspection_status"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
