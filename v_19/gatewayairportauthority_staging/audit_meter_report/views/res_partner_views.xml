<odoo>
    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.tree.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
<!--                <filter name="Audited"-->
<!--                        domain="[('x_studio_selection_field_1oh_1i5pnt5e5', '=', 'audited')]"-->
<!--                />-->
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_audit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.audit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>  <!-- Reference the existing partner form view -->
        <field name="arch" type="xml">

            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_audit_lines"
                        icon="fa-pencil-square-o" invisible="audit_line_count == 0">
                    <field string="Audit Lines" name="audit_line_count" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//div[@name='warning_tax']" position="before">
                <header>
<!--                    <field widget="statusbar" options="{'clickable': '1'}"-->
<!--                           name="x_studio_selection_field_1oh_1i5pnt5e5"/>-->
                    <button name="action_create_audit_line"
                            type="object"
                            string="Create Audit Line"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
