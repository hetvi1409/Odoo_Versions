        <record model="res.groups.privilege" id="res_groups_privilege_asset">
        <field name="name">Fixed Asset</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">7</field>
    </record>
    <record id="group_account_capturer" model="res.groups">
        <field name="name">Capturer</field>
        <field name="sequence">20</field>
        <field name="comment">Capturer</field>
        <field name="privilege_id" ref="res_groups_privilege_asset"/>
    </record>
    <record id="group_account_reviewer" model="res.groups">
        <field name="name">1st Reviewer &amp; Approver</field>
        <field name="sequence">20</field>
        <field name="comment">1st Reviewer &amp; Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_account_capturer'))]"/>
    </record>
    <record id="group_account_final_reviewer" model="res.groups">
        <field name="name">Final Reviewer &amp; CFO</field>
        <field name="comment">Final Reviewer &amp; CFO</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_account_reviewer'))]"/>
    </record>

