<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="custom_report_product_label" model="ir.actions.report">
            <field name="name">Barcode</field>
            <field name="model">product.template</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">TOMS.report_productlabel_custom</field>
            <field name="report_file">TOMS.report_productlabel_custom</field>
            <field name="print_report_name">'Products Labels - %s' % (object.name)</field>
            <field name="paperformat_id" ref="paperformat_humint_barcode_label"/>
        </record>

        <record id="custom_report_product_label_shipment" model="ir.actions.report">
            <field name="name">Barcode Label Page</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">TOMS.report_productlabel_shipment</field>
            <field name="report_file">TOMS.report_productlabel_shipment</field>
            <field name="print_report_name">'Products Labels - %s' % (object.name)</field>
            <field name="paperformat_id" ref="paperformat_humint_barcode_label"/>
        </record>

    </data>
</odoo>