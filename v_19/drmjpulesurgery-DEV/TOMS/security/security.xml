<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="humint_category">
            <field name="name" >Humint</field>
            <field name="sequence">200</field>
        </record>

        <record model="res.groups.privilege" id="module_humint_category_privilege">
            <field name="name">Humint</field>
            <field name="category_id" ref="humint_category"/>
            <field name="sequence">7</field>
        </record>

        <record id="group_humint_secondary_db" model="res.groups">
            <field name="name">Secondary Databases</field>
            <field name="privilege_id" ref="module_humint_category_privilege"/>
<!--            <field name="category_id" ref="TOMS.humint_category"/>-->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Access to Secondary Databases</field>
        </record>

        <record id="group_clinical_other" model="res.groups">
            <field name="name">other group</field>
            <field name="privilege_id" ref="module_humint_category_privilege"/>
<!--            <field name="category_id" ref="TOMS.humint_category"/>-->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <record model="ir.module.category" id="clinical_category">
            <field name="name">Clinical</field>
            <field name="sequence">20</field>
        </record>

        <record model="res.groups.privilege" id="module_clinical_category_privilege">
            <field name="name">Humint</field>
            <field name="category_id" ref="clinical_category"/>
            <field name="sequence">7</field>
        </record>

        <record id="group_clinical_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
<!--            <field name="category_id" ref="TOMS.clinical_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
        </record>

        <record id="group_clinical_frontline" model="res.groups">
            <field name="name">Frontline</field>
            <field name="implied_ids" eval="[(4, ref('TOMS.group_clinical_user'))]"/>
<!--            <field name="category_id" ref="TOMS.clinical_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
        </record>

        <record id="group_clinical_dispenser" model="res.groups">
            <field name="name">Dispenser</field>
<!--            <field name="category_id" ref="TOMS.clinical_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_clinical_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <record id="group_clinical_manager" model="res.groups">
            <field name="name">Manager</field>
<!--            <field name="category_id" ref="TOMS.clinical_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_clinical_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <record id="group_humint_see_gp_percent" model="res.groups">
            <field name="name">See GP's in List View</field>
<!--            <field name="category_id" ref="TOMS.humint_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">See GP's on list and form view</field>
        </record>

        <record id="group_pricelist_humint" model="res.groups">
            <field name="name">Pricelist Access for User</field>
<!--            <field name="category_id" ref="TOMS.clinical_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
        </record>
        
        <record id="group_debtors_humint" model="res.groups">
            <field name="name">Virtual Bank</field>
<!--            <field name="category_id" ref="TOMS.clinical_category"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
        </record>
        
        <record id="group_invoice_date" model="res.groups">
            <field name="name">Ability to Change Invoice Date</field>
<!--            <field name="category_id" ref="base.module_category_hidden"/>-->
            <field name="privilege_id" ref="module_clinical_category_privilege"/>
        </record>
        
    </data>
</odoo>
