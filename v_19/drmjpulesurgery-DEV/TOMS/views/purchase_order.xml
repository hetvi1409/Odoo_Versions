<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="inherit_purchase_order_form" model="ir.ui.view">
            <field name="name">Purchase Orders</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <field name="date_order" position="after">
                    <field name="clinical_exam_id" />
                    <field name="final_rx_id" />
                    <field name="project_task_id" />
                    <field name="job_number"/>
                </field>
            </field>
        </record>

        <record id="view_purchase_order_filter_inherit" model="ir.ui.view">
            <field name="name">purchase.order.select.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="px_name" string="Patient"/>
                </xpath>
            </field>
        </record>

        <record id="inherit_purchase_order_list" model="ir.ui.view">
            <field name="name">Purchase Orders</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="after">
                    <field name="job_number"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="px_name"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>