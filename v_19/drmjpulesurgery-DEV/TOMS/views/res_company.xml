<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="toms_inherit_res_company_form" model="ir.ui.view">
            <field name="name">res.company</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet//notebook//page[1]//div[hasclass('o_address_format')]" position="after">
                    <field name="anglo_saxon_accounting" groups="base.group_no_one"/>
                </xpath>
                <xpath expr="//notebook" postion="inside">
                <page string="Virtual bank">
                <h2>Virtual Bank Accounts</h2>
                        <div class="row mt16 o_settings_container" name="external_links">
                            <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="enable_virtual_bank"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label string="Virtual Bank Accounts" for="enable_virtual_bank"/>
                                        <div class="text-muted">
                                            Virtual bank accounts for isolating transactions
                                        </div>
                                        <div class="text-muted" invisible="enable_virtual_bank != True">
                                            <field name="enable_virtual_bank" invisible="1"/>
                                            <field name="virtual_suspense"/>
                                            <label string="Virtual Suspense Account" for="virtual_suspense"/>
                                            <field name="virtual_bank"/>
                                            <label string="Virtual Bank Account" for="virtual_bank"/>
                                        </div>
                                    </div>
                            </div>
                        </div>
                    <!-- <field name="enable_virtual_bank"/>
                    <field name="virtual_suspense"/>
                    <field name="virtual_bank"/> -->
                </page>
                </xpath>
            </field>
        </record>

        </data>
</odoo>