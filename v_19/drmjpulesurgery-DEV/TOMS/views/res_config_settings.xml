<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="humint_res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                    <div class="app_settings_block" data-string="Clinical" string="Clinical" data-key="TOMS">
                        <h2>External Links</h2>
                        <div class="row mt16 o_settings_container" name="external_links">
                            <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="external_links"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label string="External Links" for="external_links"/>
                                        <div class="text-muted">
                                            Enable external Link Buttons
                                        </div>
                                        <div class="text-muted" invisible="external_links != True">
                                            <field name="aeye_url"/>
                                            <label string="A eye url" for="aeye_url"/>
                                            <field name="disc_url"/>
                                            <label string="Discovery url" for="disc_url"/>
                                            <field name="isoleso_url"/>
                                            <label string="Isoleso url" for="isoleso_url"/>
                                        </div>
                                    </div>
                            </div>
                        </div>
                        <h2>Recall Settings</h2>
                        <div class="row mt16 o_settings_container" name="external_links">
                            <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="recall_date_delta"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label string="Recall Time Delta" for="recall_date_delta"/>
                                        <div class="text-muted">
                                            Number of months before recall notifications
                                        </div>
                                    </div>
                            </div>
                        </div>
                        <h2>User Interface Settings</h2>
                        <div class="row mt16 o_settings_container" name="external_links">
                            <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="show_mono_in_refraction"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label string="Show Monos" for="show_mono_in_refraction"/>
                                        <div class="text-muted">
                                            Show Mono PD's in Refraction Screen
                                        </div>
                                    </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="show_seg_heights_in_refraction"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label string="Show Seg heights" for="show_seg_heights_in_refraction"/>
                                        <div class="text-muted">
                                            Show Seg Heights in Refraction Screen
                                        </div>
                                    </div>
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
    </data>
</odoo>