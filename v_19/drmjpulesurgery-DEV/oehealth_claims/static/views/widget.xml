<?xml version="1.0" encoding="UTF-8" ?>
    <templates>
<t t-name="oehealth_claims.VoiceRecorderWidget">
    <div class="o_voice_recorder d-flex align-items-center gap-2">
        <button type="button" class="btn btn-primary oe_kanban_action" t-on-click="toggleRecording" >
            <t t-esc="state.recording ? 'Stop' : ' 🎙️ Record'"/>
        </button>
        <span class="text-muted">
            <t t-esc="state.elapsed"/>
        </span>
    </div>
</t>
    </templates>
