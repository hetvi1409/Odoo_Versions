<odoo>
    <record id="view_health_claim_tree" model="ir.ui.view">
        <field name="name">health.claim.tree</field>
        <field name="model">health.claim</field>
        <field name="arch" type="xml">
            <list string="Claims">
                 <field name="claim_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="charged"/>
                <field name="total_claim_amount"/>
            </list>
        </field>
    </record>
    <record id="view_health_claim_form" model="ir.ui.view">
        <field name="name">health.claim.form</field>
        <field name="model">health.claim</field>
        <field name="arch" type="xml">
            <form string="Health Claim">
                 <header>
                         <button name="action_create_claim_invoice" type="object"
                        string="Create Claim Invoice"/>

<!--                     <button name="action_view_invoices" type="object"-->
<!--                        string="Invoices"-->
<!--                        class="oe_stat_button" icon="fa-file-invoice"/>-->

                    </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                         <button type="object" class="oe_stat_button" name="action_claim_invoice"
                                icon="fa-pencil-square-o" string="Claim Invoice">
                             <field string="Claim Invoice" name="claim_count" widget="statinfo"/>

                     </button>
                    </div>
                    <group>
                        <field name="patient_id"/>
                        <field name="id_number"/>
                        <field name="dob"/>
                        <field name="gender"/>
                        <field name="medical_aid"/>
                        <field name="medical_aid_option"/>
                        <field name="medical_aid_number"/>
                    </group>

                    <!-- Notebook for Visit -->
                    <notebook>
                        <page string="Visit Information">
                            <field name="visit_line_ids">
                                <list editable="bottom">
                                    <field name="visit_date"/>
                                    <field name="type"/>
                                    <field name="qty"/>
                                    <field name="icd10_id"/>
                                    <field name="code"/>
                                    <field name="tariff"/>
                                    <field name="charged"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

<!--                        <page string="Financials">-->
<!--                            <group>-->
<!--                                <field name="total_claim_amount" readonly="1"/>-->
<!--                            </group>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


