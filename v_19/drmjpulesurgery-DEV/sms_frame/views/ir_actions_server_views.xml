<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_server_action_form_inherit_sms_frame" model="ir.ui.view">
            <field name="name">ir.actions.server.form.sms</field>
            <field name="model">ir.actions.server</field>
            <field name="inherit_id" ref="base.view_server_action_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[1]" position="after">
                    <page string="SMS" autofocus="autofocus" invisible="state != 'sms'">
                        <p invisible="model_id != False">
                            Please set the Base Model before setting the action details.
                        </p>
                        <group invisible="model_id == False">
                            <field name="sms_template_id" required="state == 'sms'"/>
                            <p colspan="2" invisible="sms_template_id != False">
                                Choose a SMS template.
                            </p>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
