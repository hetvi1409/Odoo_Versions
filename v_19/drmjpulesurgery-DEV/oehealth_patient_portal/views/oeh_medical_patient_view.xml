<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Request Authorization VIEWS -->
    <record model="ir.ui.view" id="oeh_medical_request_authorization_view">
        <field name="name">Request Authorization</field>
        <field name="model">oeh.medical.patient.request.authorization</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Request Authorization">
                <header>
                    <button name="action_send" invisible="[('state', '!=', 'draft')]" class="oe_highlight" type="object" string="Send"/>
                    <button name="action_approve" invisible="[('state', '!=', 'sent')]" class="oe_highlight" type="object" string="Approve"/>
                    <button name="action_reject" invisible="[('state', '!=', 'sent')]" class="oe_highlight" type="object" string="Reject"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approve,reject"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="details"/>
                        </group>
                        <group>
                            <field name="patient"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="oeh_medical_request_authorization_tree_view">
        <field name="name">Request Authorization</field>
        <field name="model">oeh.medical.patient.request.authorization</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string='Request Authorization'>
                <field name="name"/>
                <field name="details"/>
                <field name="patient"/>
            </list>
        </field>
    </record>

    <record id="oeh_medical_request_authorization_action_tree" model="ir.actions.act_window">
        <field name="name">Request Authorization</field>
        <field name="res_model">oeh.medical.patient.request.authorization</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="view_id" eval="False"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Click to add a new Request Authorization records.
          </p>
        </field>
    </record>

    <!-- Doctor Opinion VIEWS -->
    <record model="ir.ui.view" id="oeh_medical_request_opinion_view">
        <field name="name">Request Opinion</field>
        <field name="model">oeh.medical.doctor.opinion</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Request Opinion">
                <header>
                    <button name="action_opinion_send" invisible="[('state', '!=', 'draft')]" class="oe_highlight" type="object" string="Send"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,seen,answered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="link" invisible="1"/>
                        <button name="preview_request_opinion"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-globe icon" invisible="[('link', '=', False)]">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Opinion</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" class="oe_inline" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request" required="1"/>
                            <field name="request_type" required="1"/>
                            <field name="emergency"/>
                        </group>
                        <group>
                            <field name="patient" required="1"/>
                            <field name="doctor" required="[('request_type', '=', 'medicasure')]" invisible="[('request_type', '!=', 'medicasure')]"/>
                            <field name="external_doctor_email" required="[('request_type', '=', 'external')]" invisible="[('request_type', '!=', 'external')]" widget="email"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" required="1" nolabel="1"/>
                    </group>
                    <group string="Advice from Doctor">
                        <field name="advice" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="oeh_medical_request_opinion_tree_view">
        <field name="name">Request Opinion</field>
        <field name="model">oeh.medical.doctor.opinion</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string='Request Opinion'>
                <field name="name"/>
                <field name="patient"/>
                <field name="request"/>
                <field name="request_type"/>
                <field name="emergency"/>
                <field name="doctor"/>
                <field name="external_doctor_email"/>
            </list>
        </field>
    </record>

    <record id="action_oeh_medical_doctor_opinion" model="ir.actions.act_window">
        <field name="name">Request Opinion</field>
        <field name="res_model">oeh.medical.doctor.opinion</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="view_id" eval="False"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Click to add a new Doctor Opinion.
          </p>
        </field>
    </record>

</odoo>
