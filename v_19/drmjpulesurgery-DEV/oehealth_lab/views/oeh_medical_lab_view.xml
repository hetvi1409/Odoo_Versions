        </record>

        <record id="oeh_medical_lab_test_tree_view" model="ir.ui.view">
            <field name="name">Lab Technician</field>
            <field name="model">oeh.medical.lab.test</field>
            <field name="inherit_id" ref="oehealth_lab.oeh_medical_lab_test_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='pathologist']" position="after">
                    <field name="lab_technician_id"/>
                </xpath>
            </field>
        </record>

        <record id="account_move_view_for_labtest_inherit" model="ir.ui.view">
            <field name="name">account.move.view.for.labtest.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="before">
                    <field name="labtest_id"/>
                </xpath>
            </field>
        </record>

        <record id="account_move_view_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.view.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="labtest_id" invisible="1"/>
                </xpath>
            </field>
        </record>


        <!-- Laboratory Management -->
