        <record model="ir.ui.view" id="oeh_medical_lab_test_tree">
            <field name="name">Lab Tests</field>
            <field name="model">oeh.medical.lab.test</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string='Lab Tests' decoration-muted="state=='Invoiced'"
                      decoration-info="state=='Test In Progress'" decoration-success="state=='Completed'"
                      decoration-danger="state=='Cancelled'">
                    <field name="name"/>
                    <field name="lab_request"/>
                    <field name="patient"/>
                    <field name="pathologist"/>
                    <field name="requestor"/>
                    <field name="date_requested"/>
                    <field name="date_analysis"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="oeh_medical_lab_test_form">
            <field name="name">Lab Tests</field>
            <field name="model">oeh.medical.lab.test</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Lab Tests">
                    <header>
                        <button confirm="Are you sure you want to start the test?" name="set_to_test_inprogress"
                                string="Start Test" type="object" class="oe_highlight"
                                groups="oehealth.group_oeh_medical_physician,oehealth.group_oeh_medical_manager"/>
                        <button confirm="Are you sure you want to complete the test?" name="set_to_test_complete"
                                string="Complete Test" type="object" class="oe_highlight"
                                groups="oehealth.group_oeh_medical_physician,oehealth.group_oeh_medical_manager"/>
                        <button name="print_patient_labtest"
                                string="Print Lab Test" type="object"
                                groups="oehealth.group_oeh_medical_physician,oehealth.group_oeh_medical_manager"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="Draft,Test In Progress,Completed"/>
                    </header>
                    <sheet>
                        <div class="oe_left" style="width: 500px;">
                            <div class="oe_title" style="width: 390px;">
                                <label class="oe_edit_only" for="name"/>
                                <h1>
                                    <field name="name" class="oe_inline"/>
                                </h1>
                            </div>
                        </div>
                        <group class="col-12">
                            <group class="col-6">
                                <!--                                <field name="lab_department" required="1"/>-->
                                <field name="institution"/>
                                <field name="patient" options="{'no_create': True}"/>
                            </group>
                            <group class="col-6">
                                <field name="lab_request" readonly="1"/>
                                <field name="move_id" readonly="1" invisible="[('move_id','=', False)]"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="date_requested"/>
                                <field name="requestor" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="pathologist" options="{'no_create': True}"/>
                                <field name="date_analysis"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lab Tests">
                                <group>
                                    <field name="lab_test_type_ids" colspan="2" nolabel="1" readonly="1">
                                        <list string="Lab Tests" editable="bottom">
                                            <field name="name"/>
                                            <field name="code"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Lab Test Cases">
                                <group>
                                    <field name="lab_test_criteria"
                                           widget="section_and_note_one2many"
                                           colspan="2" nolabel="1">
                                        <list string="Lab Test Cases" editable="bottom">
                                            <control>
                                                <create name="add_line_control" string="Add a line"/>
                                                <create name="add_section_control" string="Add a section"
                                                        context="{'default_display_type': 'line_section'}"/>
                                                <create name="add_note_control" string="Add a note"
                                                        context="{'default_display_type': 'line_note'}"/>
                                            </control>
                                            <field name="name" widget="section_and_note_text" optional="show"/>

                                            <field name="display_type" invisible="1"/>
                                            <field name="seq"/>
                                            <field name="sequence" invisible="1"/>
                                            <field name="result"/>
                                            <field name="normal_range"/>
                                            <field name="units"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Test Results">
                                <group>
                                    <field name="results"/>
                                </group>
                                <group>
                                    <field name="diagnosis"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="oeh_medical_lab_test_action_tree" model="ir.actions.act_window">
            <field name="name">Lab Tests</field>
            <field name="res_model">oeh.medical.lab.test</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to add a new lab tests.
                </p>
            </field>
        </record>


        <record model="ir.ui.view" id="oeh_medical_lab_request_form">
            <field name="name">Lab Requests</field>
            <field name="model">oeh.medical.lab.request</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Lab Requests">
                    <header>
                        <button name="add_sample" class="oe_highlight"
                                string="Add Sample" type="object"/>

                        <button name="finished_sample" class="oe_highlight"
                                string="Finished Taking Sample" type="object"/>

                        <button name="create_invoice" class="oe_highlight"
                                string="Create Invoice" type="object"/>

                        <button name="push_for_testing" class="oe_highlight"
                                string="Push For Testing" type="object"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="Draft,Sample Taken,Invoiced,Pushed For Testing"/>
                    </header>
                    <sheet>
                        <!-- <div class="oe_button_box" name="button_box">
                            <button type="action" name="%(account.action_move_out_invoice_type)d" string="View Invoice"
                                    context="{'search_default_labtest_id': active_id, 'default_labtest_id': active_id}"
                                    class="oe_stat_button" icon="fa-pencil-square-o"
                                    />
                        </div> -->
                        <div class="oe_left" style="width: 500px;">
                            <div class="oe_title" style="width: 390px;">
                                <label class="oe_edit_only" for="name"/>
                                <h1>
                                    <field name="name" class="oe_inline"/>
                                </h1>
                            </div>
                        </div>
                        <group class="col-12">
                            <group class="col-6">
                                <field name="patient" options="{'no_create': True}" required="1"/>
                                <field name="date_requested"/>
                            </group>
                            <group class="col-6">
                                <field name="institution"/>
                                <field name="requestor" options="{'no_create': True}"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lab Tests">
                                <group>
                                    <field name="lab_test_ids" colspan="2" nolabel="1">
                                        <list string="Lab Test Types" editable="bottom">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="currency_id" invisible="1"/>
                                            <field name="test_charge" class="oe_inline" widget="monetary"
                                                   options="{'currency_field': 'currency_id'}"/>
                                        </list>
                                    </field>
                                </group>
                                <group class="oe_subtotal_footer oe_right" name="charge_total">
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="total"/>
                                    </div>
                                    <field name="total" nolabel="1" class="oe_subtotal_footer_separator oe_inline"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </page>
                            <page string="Samples">
                                <group>
                                    <field name="lab_sample_ids" colspan="2" nolabel="1">
                                        <list string="Samples" editable="bottom">
                                            <field name="sample_type"/>
                                            <field name="comments"/>
                                            <field name="samples_ids" string="Lab Tests" widget="many2many_tags"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Chief Complaint">
                                <group>
                                    <field name="chief_complaint" colspan="2" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="oeh_medical_lab_request_tree">
            <field name="name">Lab Requests</field>
            <field name="model">oeh.medical.lab.request</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Lab Requests">
                    <field name="name"/>
                    <field name="patient"/>
                    <field name="date_requested"/>
                    <field name="institution"/>
                    <field name="requestor"/>
                    <field name="state"/>
