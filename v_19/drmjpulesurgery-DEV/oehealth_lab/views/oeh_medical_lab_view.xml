                <p class="o_view_nocontent_smiling_face">
                    Click to add a new Lab Test department.
                </p>
            </field>
        </record>


        <!-- Inheriting Lab screen to display patient's labtest reference -->

        <record id="oeh_medical_patient_lab_view" model="ir.ui.view">
            <field name="name">Patient</field>
            <field name="model">oeh.medical.patient</field>
            <field name="inherit_id" ref="oehealth.oeh_medical_patient_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Lab Tests">
                        <field name="lab_test_ids" readonly="1">
                            <list string='Lab Tests' decoration-muted="state=='Invoiced'"
                                  decoration-info="state=='Test In Progress'" decoration-success="state=='Completed'"
                                  decoration-danger="state=='Cancelled'">
                                <field name="name"/>
                                <!--                                <field name="test_type"/>-->
                                <field name="pathologist"/>
                                <field name="requestor"/>
                                <field name="date_requested"/>
                                <field name="date_analysis"/>
                                <field name="state"/>
                                <field name="patient" invisible="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Inheriting Lab screen to display Labtest switch -->

        <record id="oeh_medical_patient_lab_button_count_view" model="ir.ui.view">
            <field name="name">Patient</field>
            <field name="model">oeh.medical.patient</field>
            <field name="inherit_id" ref="oehealth.oeh_medical_patient_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='%(account.action_move_out_invoice_type)d']" position="after">
                    <!-- <button type="action" class="oe_stat_button" name="%(oeh_medical_lab_test_action_tree)d"
                            context="{'search_default_patient': active_id,'default_patient': active_id}"
                            icon="fa-flask"> -->
                        <field string="Lab Tests" name="labs_count" widget="statinfo"/>
                    <!-- </button> -->
                </xpath>
            </field>
        </record>

        <record id="oeh_medical_appointment_lab_view" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">oeh.medical.appointment</field>
            <field name="inherit_id" ref="oehealth.oeh_medical_appointment_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Lab Test">
                        <field name="labtest_line" widget="one2many_list" nolabel="1"
                               context="{'default_patient':patient, 'default_pathologist':doctor, 'default_appointment': id}"/>
                    </page>
                </xpath>
            </field>
        </record>


        <record id="oeh_medical_lab_technician_action_tree" model="ir.actions.act_window">
            <field name="name">Lab Technician</field>
            <field name="res_model">oeh.medical.physician</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('staff_type', '=', 'lab technician')]</field>
            <field name="context">{'default_staff_type': 'lab technician'}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to add a new Lab Technician.
                </p>
                <p>
                    Add all the Lab Technician and manage their weekly schedules
                </p>
            </field>
        </record>


        <record id="oeh_medical_lab_test_view" model="ir.ui.view">
            <field name="name">Lab Technician</field>
            <field name="model">oeh.medical.physician</field>
            <field name="inherit_id" ref="oehealth.oeh_medical_staff_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='print_medical_staff_badge']" position="after">
                    <button name="%(oeh_medical_lab_test_action_tree)d" type="action" class="oe_stat_button"
                            icon="fa-flask" groups="oehealth_lab.group_oeh_medical_lab_technician">
                        <field string="Lab Tests" name="lab_test" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="oeh_medical_lab_test_form_view" model="ir.ui.view">
