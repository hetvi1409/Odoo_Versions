<?xml version="1.0"?>
<odoo>
    <data>
        <record id="daily_invoice_wizard" model="ir.ui.view">
            <field name="name">daily.invoice.form</field>
            <field name="model">daily.invoice</field>
            <field name="arch" type="xml">
                <form string="Daily Invoice">
                    <group>
                        <field name="start_date" required="1"/>
                        <field name="end_date" required="1"/>
                    </group>
                    <footer>
                        <button name="export_pdf" string="Submit" type="object" class="btn btn-sm btn-primary"/>
                        <button string="Cancel" class="btn btn-sm btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="daily_invoice_action_view" model="ir.actions.act_window">
            <field name="name">Daily Invoice</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">daily.invoice</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


        <menuitem id="clinical_menu_reportings" name="Reporting" parent="TOMS.main_menu_clinical_app" sequence="5"/>
                    <menuitem id="clinical_menu_daily_invoice" name="Daily Invoice" parent="clinical_menu_reportings" sequence="1" action="daily_invoice_action_view"/>

    </data>
</odoo>
