            <field name="invoice_origin" position="after">
                <field name="claim_level_mediswitch_status"></field>
<!--                <field name="payment_term_id"/>-->
            </field>
        </field>
    </record>


    <record id="action_partner_msv1" model="ir.actions.act_window">
