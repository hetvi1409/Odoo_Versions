<?xml version="1.0" encoding="utf-8"?>
<odoo>
          <record id="view_sketch_notes_tree" model="ir.ui.view">
            <field name="name">sketch.notes.list</field>
            <field name="model">patient.sketch.note</field>
            <field name="arch" type="xml">
                <list string="Sketch Notes">

                    <field name="sketch_note_date"/>
                    <field name="sketch_notes"/>
                </list>
            </field>
        </record>
    <record id="view_sketch_notes_form" model="ir.ui.view">
    <field name="name">sketch.notes.form</field>
    <field name="model">patient.sketch.note</field>
    <field name="arch" type="xml">
        <form string="Sketch Notes">
            <sheet>
                 <style>
                .o-we-hint {
                    height: 200px;
                }
                 </style>
                <group>
                    <field name="patient_sketch_note_id"/>
                    <field name="sketch_note_date"/>
                </group>
                <group>
                    <field name="sketch_notes" widget="html"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

</odoo>