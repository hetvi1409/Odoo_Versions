<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medicines Form View -->
    <record model="ir.ui.view" id="oeh_medical_medicines_view">
        <field name="name">Medicines</field>
        <field name="model">oeh.medical.medicines</field>
        <field name="arch" type="xml">
            <form string="Medicines">
                <sheet>
                    <div class="oe_left" style="width: 500px;">
                        <div class="oe_title" style="width: 390px;">
                            <label class="oe_edit_only" for="name" string="Medicine Name"/>
                            <h1><field name="name" class="oe_inline"/></h1>
                        </div>
                    </div>
                    <group class="col-12">
                        <group class="col-6">
                            <field name="medicament_type" required="1"/>
                            <field name="therapeutic_action" invisible="[('medicament_type', '=', 'Medicine')]"/>
                            <field name="qty_available" invisible="[('medicament_type', '=', 'Medicine')]"/>
                        </group>
                        <group class="col-6">
                            <field name="lst_price"/>
                            <field name="pregnancy_warning" invisible="[('medicament_type', '=', 'Medicine')]"/>
                        </group>
                    </group>
                    <group class="col-12" invisible="[('medicament_type', '=', 'Vaccine')]">
                        <group class="col-6">
                            <field name="pregnancy"/>
                            <field name="composition"/>
                            <field name="dosage"/>
                            <field name="adverse_reaction"/>
                        </group>
                        <group class="col-6">
                            <field name="indications"/>
                            <field name="overdosage"/>
                            <field name="storage"/>
                            <field name="info"/>
                        </group>
                    </group>
                    <group invisible="[('medicament_type', '=', 'Medicine')]">
                        <field name="info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medicines Tree View -->
    <record model="ir.ui.view" id="oeh_medical_medicines_tree">
        <field name="name">Medicines</field>
        <field name="model">oeh.medical.medicines</field>
        <field name="arch" type="xml">
            <list string="Medicines">
                <field name="name"/>
                <field name="medicament_type"/>
                <field name="therapeutic_action"/>
                <field name="pregnancy_warning"/>
                <field name="lst_price"/>
                <field name="qty_available"/>
            </list>
        </field>
    </record>

