<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_credict_clerk" model="res.groups">
        <field name="name">Credict Clerk</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
