<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <record id="bill_interest_view_form" model="ir.ui.view">
       <field name="name">bill.interest.view.form</field>
       <field name="model">bill.interest</field>
       <field name="arch" type="xml">
           <form>
               <group>
<!--                   <group>-->
                       <field name="bill_ids" widget="many2many_tags"/>
<!--                       <field name="payment_state"/>-->
<!--                   </group>-->
<!--                   <group>-->
<!--                       <field name="partner_id"/>-->
<!--                   </group>-->

               </group>
               <footer>
                   <button name="action_submit" string="Submit" type="object"
                              class="oe_highlight"/>
                   <button string="Cancel" class="btn btn-default" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
   <record id="bill_interest_action" model="ir.actions.act_window">
       <field name="name">Bill Interest</field>
       <field name="res_model">bill.interest</field>
       <field name="type">ir.actions.act_window</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
   </record>
   <menuitem id="bill_interest_menu" name="Bill interest"
              parent="account.menu_finance_payables" action="bill_interest_action" />
</odoo>
