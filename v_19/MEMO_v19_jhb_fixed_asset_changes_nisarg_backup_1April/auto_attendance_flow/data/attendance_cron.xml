<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_hr_overtime_number"
                model="ir.sequence">
            <field name="name">Overtime Number</field>
            <field name="code">hr.overtime</field>
            <field name="prefix">OT: %(day)s-%(month)s-%(year)s-</field>
            <field name="padding">3</field>
        </record>

        <record id="ir_cron_data_checkout_attendance" model="ir.cron">
            <field name="name">HR Attendance: Auto Checkout</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.emp_auto_checkout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="DateTime.now().replace(hour=16, minute=0)"/>
        </record>

        <record id="ir_cron_send_attendance_report" model="ir.cron">
            <field name="name">HR Attendance: Send Attendance Report</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.send_emp_attendance_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall"
                   eval="(datetime.now().replace(day=1, hour=4, minute=0, second=0, microsecond=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="send_mail_employee_attendance_report" model="mail.template">
            <field name="name">Employee Attendance Report mail</field>
            <field name="subject">Employee Attendance Report</field>
            <field name="auto_delete" eval="False"/>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="body_html" type="html">
                <p>Please review attached Employees Monthly Attendance Report.
                </p>
            </field>
        </record>

        <record id="overtime_alert_email_template" model="mail.template">
            <field name="name">Overtime Alert Email</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="subject">Overtime Limit Exceeded</field>
            <field name="email_to">{{ (object.employee_id.user_id.email_formatted or object.employee_id.work_email) }}
            </field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello
                    <t t-out="object.employee_id.name or ''"></t>
                    <br/>
                    <br/>
                    <p>You have exceeded your overtime limit for this week.</p>
                    <p>
                        <strong>Total Hours:</strong>
                        <t t-out="ctx.get('total_hours')"/>
                    </p>
                    <p>Please get in touch with your manager or HR.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
