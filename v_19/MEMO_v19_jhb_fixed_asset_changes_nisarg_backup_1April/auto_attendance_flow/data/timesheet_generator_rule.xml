<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_attendance_employee_own" model="ir.rule">
            <field name="name">Attendance: own</field>
            <field name="model_id" ref="auto_attendance_flow.model_hr_timesheet_generator"/>
            <field name="domain_force">[('employee_id.user_id','=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_attendance_manager_team" model="ir.rule">
            <field name="name">Attendance: manager team</field>
            <field name="model_id" ref="auto_attendance_flow.model_hr_timesheet_generator"/>
            <field name="domain_force">['|',('employee_id.user_id','=', user.id),('employee_id.parent_id.user_id','=',
                user.id)]
            </field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="mail_template_timesheet_approved" model="mail.template">
            <field name="name">Timesheet Approved</field>
            <field name="model_id" ref="auto_attendance_flow.model_hr_timesheet_generator"/>
            <field name="subject">{{ object.name }} : Timesheet Approved</field>
            <field name="email_from">{{ object.manager_id.work_email or 'noreply@example.com' }}</field>
            <field name="partner_to">{{ ctx.get('partner_ids') }}</field>
            <field name="email_cc">{{ object.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="ctx.get('approve_user', 'Approve User')">Employee</t>,
                        <br/>
                        <br/>
                        <p>You have received a notification for your timesheet had approved.
                            <strong>
                                <t t-out="object.name or ''">Memo-Title</t>
                            </strong>
                            <br/>
                            You can find the timesheet document link below.
                            <br/>
                            <br/>
                            <a t-att-href="ctx.get('url')"
                                    style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                    Open Timesheet Document
                                </a>
                        </p>
                        <br/>
                        Best regards,
                        <br/>
                        <t t-out="object.manager_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>