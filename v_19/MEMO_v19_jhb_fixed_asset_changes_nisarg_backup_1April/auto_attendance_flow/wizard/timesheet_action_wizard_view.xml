<odoo>
    <record id="view_timesheet_action_wizard_form" model="ir.ui.view">
        <field name="name">timesheet.action.wizard.form</field>
        <field name="model">timesheet.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Timesheet Action">
                <group>
                    <field name="action_type" invisible="1"/>
                    <field name="reject_reason" invisible="action_type != 'reject'"/>
                    <field name="change_reason" invisible="action_type != 'change'"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="confirm_action" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>