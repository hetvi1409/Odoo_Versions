<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherited_view_attendance_tree_jhb" model="ir.ui.view">
        <field name="name">inherited view attendance list jhb</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="time_off_type_id" string="Leave Type"/>
                <field name="overtime_approved"/>
                <field name="approved_document_id" invisible="overtime_approved == False" required="overtime_approved == True"/>
            </xpath>
        </field>
    </record>
</odoo>