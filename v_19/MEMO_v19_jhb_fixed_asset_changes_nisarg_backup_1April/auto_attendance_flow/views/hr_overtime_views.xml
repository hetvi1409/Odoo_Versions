<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view"
                id="jhb_hr_overtime_search_view">
            <field name="name">Overtime Search View JHB</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <search string="Overtime Entry Search">
                    <field name="employee_id"/>
                    <filter string="Employee" name="group_by_employee_id"
                            context="{'group_by':'employee_id'}"/>
                    <filter string="Date" name="group_by_date"
                            context="{'group_by':'date'}"/>
                </search>
            </field>
        </record>

        <record id="hr_overtime_from_view_jhb"
                model="ir.ui.view">
            <field name="name">Overtime Form View JHB</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <form create="0" edit="1" delete="1">
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" readonly="1"
                                       required="1" force_save="1"/>
                                <field name="date" readonly="1" force_save="1"/>
                                <field name="based_on" readonly="1"/>
                            </group>
                            <group>
                                <field name="ot_rate" readonly="1"/>
                                <field name="overtime" readonly="1"/>
                                <field name="payslip_id" readonly="1"/>
                            </group>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="aspl_hr_employee_overtime_tree_view"
                model="ir.ui.view">
            <field name="name">Employee Overtime</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <list string="Employee Overtime" create="0" delete="1">
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="overtime"/>
                    <field name="ot_rate"/>
                </list>
            </field>
        </record>

        <record id="action_hr_overtime_jhb"
                model="ir.actions.act_window">
            <field name="name">Overtime</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.overtime</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_hr_hr_attendance_view_attendances" name="Attendances"
                  parent="hr_attendance.menu_hr_attendance_view_attendances_management" sequence="30"
                  groups="hr_attendance.group_hr_attendance_user" action="hr_attendance.hr_attendance_management_action"/>

        <menuitem id="menu_overtime" name="Overtime" action="auto_attendance_flow.action_hr_overtime_jhb"
                  groups="hr_attendance.menu_hr_attendance_view_attendances_management"
                  parent="hr_attendance.menu_hr_attendance_root" sequence="32"/>

    </data>
</odoo>