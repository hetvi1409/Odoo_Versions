<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cloudBaseAttachment" t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <a t-if="attachment.type === 'url'" position="attributes">
            <attribute name="t-if">attachment.type === 'url' and !attachment.cloudURL</attribute>
        </a>
        <xpath expr="//div[hasclass('o-mail-AttachmentCard-aside')]" position="inside">
            <t t-if="attachment.cloudURL">
                <button class="o_AttachmentCard_asideItem o_AttachmentCard_cloud btn d-flex justify-content-center align-items-center w-100 h-100 rounded-0 bg-300" t-on-click="attachmentCard.onOpenCloudLink" title="Open in clouds">
                    <i class="fa fa-cloud"/>
                </button>
            </t>
        </xpath>
    </t>

</templates>
