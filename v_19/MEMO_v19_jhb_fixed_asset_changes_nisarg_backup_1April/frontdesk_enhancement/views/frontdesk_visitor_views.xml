<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="frontdesk_visitor_inh_form" model="ir.ui.view">
        <field name="name">frontdesk.visitor.inh.form</field>
        <field name="model">frontdesk.visitor</field>
        <field name="inherit_id" ref="frontdesk.frontdesk_visitor_view_form"/>
        <field name="arch" type="xml">
            <field name="company" position="after">
                <field name="department_id"/>
                <field name="type"/>
            </field>
            <xpath expr="//sheet//group" position="before">
                <group>
                    <field name="sequence" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>