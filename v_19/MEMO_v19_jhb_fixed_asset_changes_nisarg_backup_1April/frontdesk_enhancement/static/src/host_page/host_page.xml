<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="frontdesk.HostPage" owl="1">

        <!-- MANUAL HOST SELECTION -->
        <t t-if="state.showManualSelection">
            <HostManualSelection
                    stationId="props.stationId"
                    token="props.token"
                    theme="props.theme"
                    onSelectHost.bind="selectedHost"
                    onClickBack.bind="goBackFromManualSelection"
            />
        </t>

        <!-- MAIN HOST + ENQUIRY PAGE -->
        <t t-else="">
            <div class="d-flex flex-column justify-content-center h-100">
                <div class="container-fluid">
                    <div class="row g-0 d-flex justify-content-center">
                        <div class="col-lg-6">
                            <form t-on-submit.prevent="_onConfirm" class="d-grid gap-3">
                                <div>
                                    <label class="form-label fw-semibold">
                                        Type of enquiry <span class="text-danger">*</span>
                                    </label>

                                    <select
                                            class="form-select"
                                            required="true"
                                            t-model="state.enquiryType">

                                        <option value="">Select enquiry type</option>
                                        <option value="social_lease">Social Lease / Sale</option>
                                        <option value="commercial_lease">Commercial Lease / Sale</option>
                                        <option value="registration">Registration / Cancellation of Servitude</option>
                                        <option value="land">Land Regularisation Matter</option>
                                        <option value="road">Road Reserve</option>
                                        <option value="user_agreement">User Agreement</option>
                                        <option value="lanes">Sanitary Lanes</option>
                                        <option value="encroachment">Encroachment / Parking</option>
                                        <option value="outdoor">Outdoor Advertising</option>
                                    </select>
                                </div>
                            </form>
                        </div>
                        <div class="col-lg-6">
                            <div class="text-center mb-4">
                                <h2>Select Host</h2>
                                <p class="text-muted">Choose who you would like to visit</p>
                            </div>
                            <div class="d-grid gap-3">
                                <t t-if="state.hostName">
                                    <div class="alert alert-success d-flex align-items-center">
                                        <i class="oi oi-check-circle me-2"></i>
                                        Selected host:
                                        <strong class="ms-1" t-out="state.hostName"/>
                                    </div>
                                </t>
                                <button
                                        class="btn btn-primary"
                                        t-on-click="showManualSelection">
                                    <i class="oi oi-group me-2"></i>
                                    Browse All Hosts
                                </button>
                                <button
                                        class="btn btn-secondary"
                                        t-att-disabled="!state.hostName"
                                        t-on-click="_onConfirm">
                                    <i class="oi oi-chevron-right me-2"></i>
                                    Continue
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>

    </t>
        </templates>
