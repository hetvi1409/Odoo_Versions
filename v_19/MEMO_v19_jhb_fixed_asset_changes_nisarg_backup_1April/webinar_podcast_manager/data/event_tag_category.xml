<odoo>
    <record id="event_tag_webinar" model="event.tag.category">
        <field name="name">Webinar</field>
        <field name="is_published">True</field>
    </record>
    <record id="event_tag_podcast" model="event.tag.category">
        <field name="name">Podcast</field>
        <field name="is_published">True</field>
    </record>

    <!-- Create a Tag and link it to the category -->
    <record id="webinar_tag_1" model="event.tag">
        <field name="name">Webinar</field>
        <field name="category_id" ref="event_tag_webinar"/>
    </record>
    <record id="podcast_tag_1" model="event.tag">
        <field name="name">Podcast</field>
        <field name="category_id" ref="event_tag_podcast"/>
    </record>

</odoo>