<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="AuditDashboard">
        <div class="oh_dashboards">
            <div class="container-fluid my-5 o_hr_dashboard"/>
        </div>
    </t>
    <t t-name="MainSection">
   <section class="dashboard_main" id="main_section">
       <div class="col-sm-12 mb-4">
           <div class="row">
               <div class="col-12 col-sm-12 col-md-8">
                   <h2 class="section-header">Dashboard</h2>
               </div>
               <!--      Tiles    -->
               <div class="">
                   <div class="row">
                       <div class="audit_content">
                           <div class="audit_main">
                               <div class="row">
                                   <div class="content_audit_external col audit_other_info"
                                        id="audit_vehicles">
                                       <div class="row">
                                           <div class="col-md-3 align_center audit_icon-div">
                                               <i class="fa fa-list-alt"
                                                  style="margin-top:6vh"/>
                                           </div>
                                           <div class="col-md-9 content-div audit_border-content"
                                                style="border-color: transparent;">
                                               <div class="align_center">
                                                   <h5 class="card-title"
                                                       style="margin-top:5vh">
                                                       All Audits
                                                   </h5>
                                                   <p class="card-text align_center"
                                                      id="total_vehicles">
                                                       All Audits Total
                                                       <a id="all_audit_count"
                                                          style="font-size: 25px; font-weight: bold; margin-left: 70px; color: black;"/>
                                                   </p>
                                               </div>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="content_audit_external col audit_other_info"
                                        id="audit_vehicles">
                                       <div class="row">
                                           <div class="col-md-3 align_center my_audit_icon-div">
                                               <i class="fa fa-list-alt"
                                                  style="margin-top:6vh"/>
                                           </div>
                                           <div class="col-md-9 content-div audit_border-content"
                                                style="border-color: transparent;">
                                               <div class="align_center">
                                                   <h5 class="card-title"
                                                       style="margin-top:5vh">
                                                       My Audits
                                                   </h5>
                                                   <p class="card-text align_center"
                                                      id="total_vehicles">
                                                       My Audits Total
                                                       <a id="my_audit_count"
                                                          style="font-size: 25px; font-weight: bold; margin-left: 70px; color: black;"/>
                                                   </p>
                                               </div>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="content_audit_external col audit_other_info"
                                        id="audit_vehicles">
                                       <div class="row">
                                           <div class="col-md-3 align_center my_audit_to_icon-div">
                                               <i class="fa fa-list-alt"
                                                  style="margin-top:6vh"/>
                                           </div>
                                           <div class="col-md-9 content-div audit_border-content"
                                                style="border-color: transparent;">
                                               <div class="align_center">
                                                   <h5 class="card-title"
                                                       style="margin-top:5vh">
                                                       Audits To Approve
                                                   </h5>
                                                   <p class="card-text align_center"
                                                      id="total_vehicles">
                                                       Audits To Approve Total
                                                       <a id="to_approve_count"
                                                          style="font-size: 25px; font-weight: bold; margin-left: 70px; color: black;"/>
                                                   </p>
                                               </div>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="content_audit_external col audit_other_info"
                                        id="audit_vehicles">
                                       <div class="row">
                                           <div class="col-md-3 align_center my_audit_to_complete_icon-div">
                                               <i class="fa fa-list"
                                                  style="margin-top:6vh"/>
                                           </div>
                                           <div class="col-md-9 content-div audit_border-content"
                                                style="border-color: transparent;">
                                               <div class="align_center">
                                                   <h5 class="card-title"
                                                       style="margin-top:5vh">
                                                       Audits To Complete
                                                   </h5>
                                                   <p class="card-text align_center"
                                                      id="total_vehicles">
                                                       Audits To Complete Total
                                                       <a id="to_complete_count"
                                                          style="font-size: 25px; font-weight: bold; margin-left: 70px; color: black;"/>
                                                   </p>
                                               </div>
                                           </div>
                                       </div>
                                   </div>
                               </div>
                           </div>
                           <br/>
                           <div class="col-xs-12 col-sm-12" style="display:flex;">
                                   <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                                       <div class="leads_month_pie_div half_chart chart-container card-shadow"
                                            style="height: 528px;">
                                           <h2>
                                               <center>Audits Bar Chart</center>
                                           </h2>
                                           <div class="graph_canvas bar_canvas">
                                               <canvas id="most_rented_cars"/>
                                           </div>
                                       </div>
                                   </div>
                                   <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                                   <div class="leads_month_pie_div half_chart chart-container card-shadow"
                                        style="height: 528px;">
                                       <h2>
                                           <center>Audits Doughnut Chart</center>
                                       </h2>
                                       <div class="graph_canvas line_canvas">
                                           <canvas id="audit_doughnut"/>
                                       </div>
                                   </div>
                               </div>
                           </div>
                           <div class="col-12 col-sm-12" style="display:flex;">
                               <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                                   <div class="leads_month_pie_div half_chart chart-container card-shadow"
                                        style="height: 528px;">
                                       <h2>
                                           <center>Audits Pie Chart</center>
                                       </h2>
                                       <div class="graph_canvas pie_canvas">
                                           <canvas id="audit_pie"/>
                                       </div>
                                   </div>
                               </div>
                               <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                                   <div class="leads_month_pie_div half_chart chart-container card-shadow"
                                        style="height: 528px;">
                                       <h2>
                                           <center>Audits Line Chart</center>
                                       </h2>
                                       <div class="graph_canvas line_canvas">
                                           <canvas id="audit_line"/>
                                       </div>
                                   </div>
                               </div>
                       </div>
                   </div>
               </div>
       </div>
       </div>
       </div>
   </section>
    </t>
</templates>