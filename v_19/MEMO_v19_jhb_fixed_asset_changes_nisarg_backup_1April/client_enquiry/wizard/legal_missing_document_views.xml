<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="legal_missing_view_form" model="ir.ui.view">
        <field name="name">legal.missing.form.view</field>
        <field name="model">legal.missing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="legal_id" readonly="1"/>
                        <field name="is_missing"/>
                        <field name="comments"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>