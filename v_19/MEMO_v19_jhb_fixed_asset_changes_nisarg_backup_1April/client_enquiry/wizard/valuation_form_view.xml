<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="assessment_valuation_wizard_view_form" model="ir.ui.view">
        <field name="name">assessment.valuation.wizard.form.view</field>
        <field name="model">assessment.valuation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="assessment_id"/>
                        <field name="property_number"/>
                        <field name="jmc_number"/>
                        <field name="property_description"/>
                        <field name="address"/>
                        <field name="only_portion"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <iframe id="giolis_frame" name="giolis_frame" invisible="only_portion != 'yes'"
                            src="https://ags.joburg.org.za/cgis/index.aspx"
                            width="100%" height="500"/>
                    <group invisible="only_portion != 'yes'">
                        <field name="property_category"/>
                        <field name="contract_ids" widget="many2many_tags"/>
                        <field name="size"/>
                        <field name="purpose_valuation"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>