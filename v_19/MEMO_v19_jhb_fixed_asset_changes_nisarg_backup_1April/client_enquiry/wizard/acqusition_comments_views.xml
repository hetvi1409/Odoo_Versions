<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="acquisition_comments_view_form" model="ir.ui.view">
        <field name="name">acquisition.comments.form.view</field>
        <field name="model">acquisition.comments</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="acquisition_id" readonly="1"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <field name="comments"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>