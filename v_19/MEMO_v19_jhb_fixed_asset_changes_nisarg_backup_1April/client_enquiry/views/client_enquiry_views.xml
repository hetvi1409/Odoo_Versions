    <record id="client_enquiry_view_tree" model="ir.ui.view">
        <field name="name">Client Enquiry</field>
        <field name="model">client.enquiry</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field name="name"/>
                <field name="date"/>
                <field name="assessment_id"/>
                <field name="team_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft')"
                       decoration-warning="state in ('assessment', 'ongoing')"
                       decoration-success="state in ('completed')"
                       decoration-danger="state in ('cancelled')"/>
                <field name="assessment_state" widget="badge"
                       decoration-info="assessment_state in ('draft', 'ownership')"
                       decoration-warning="assessment_state in ('compile', 'objection')"
                       decoration-primary="assessment_state in ('transition', 'valuation', 'internal_meeting')"
                       decoration-success="assessment_state in ('approve', 'valuation_completed', 'internal_meeting_approved', 'mayoral_approved', 'council_approved', 'council_79_approved')"
                       decoration-danger="assessment_state in ('PTOB', 'negotiation', 'terminate', 'refused')"/>

            </list>
        </field>
    </record>

    <record id="client_enquiry_view_search" model="ir.ui.view">
        <field name="name">client.enquiry.view.search</field>
        <field name="model">client.enquiry</field>
        <field name="arch" type="xml">
            <search string="Client Enquiry">
                <field name="name" string="Enquiry"/>
                <field name="stand_number" string="Stand Number"/>
                <field name="asset_number"/>
                <field name="property_id"/>
                <filter string="My Enquiry" domain="[('user_id','=',uid)]" name="my_ticket"/>
                <filter string="Unassigned Tickets" domain="[('user_id','=',False)]" name="unassigned"/>
                <separator/>
                <filter string="Draft" domain="[('state', '=', 'draft')]" name="state_draft"/>
                <filter string="Submitted" domain="[('state', '=', 'submit')]" name="state_submit"/>
                <filter string="Assessment Started" domain="[('state', '=', 'assessment')]" name="assessment_started"/>
                <filter string="Assessment Ongoing" domain="[('state', '=', 'ongoing')]" name="assessment_ongoing"/>
                <filter string="Assessment Completed" domain="[('state', '=', 'completed')]" name="assessment_completed"/>
                <filter string="Cancelled" domain="[('state', '=', 'cancelled')]" name="assessment_cancelled"/>
                <separator/>
                <filter string="Urgent" domain="[('priority', '=', 3)]" name="urgent_priority"/>
                <filter string="High Priority" domain="[('priority', '=', 2)]" name="high_priority"/>
                <filter string="Medium Priority" domain="[('priority', '=', 1)]" name="low_priority"/>
                <filter string="Low Priority" domain="[('priority', '=', 0)]" name="all_priority"/>
                <separator/>
                    <filter string="Type" name="group_by_type" domain="[]"
                            context="{'group_by':'type'}"/>
                    <filter string="Stand Number" name="group_by_stand_number"
                            domain="[]" context="{'group_by':'stand_number'}"/>
            </search>
        </field>
    </record>

    <record id="action_client_enquiry" model="ir.actions.act_window">
        <field name="name">Property Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.enquiry</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_client_enquiry_my" model="ir.actions.act_window">
        <field name="name">Property Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.enquiry</field>
        <field name="context">{
            'default_user_id': uid,
            'search_default_my_ticket': true }
        </field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="quick_create_client_enquiry_form" model="ir.ui.view">
        <field name="name">client.enquiry.form.quick_create</field>
        <field name="model">client.enquiry</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="e.g. Product arrived damaged"/>
                    <field name="team_id" required="1" options="{'no_open': True}" />
                    <field name="user_id" options="{'no_open': True}"/>
                    <field name="partner_id" options="{'no_open': True}" widget="res_partner_many2one"/>
                </group>
            </form>
        </field>
    </record>

    <record id="enquiry_helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_enquiry','=', True)]</field>
        <field name="context">{'default_is_enquiry': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
                No teams found. Let's create one!
            </p>
            <p>
                Create teams to organize your tickets by expertise or geographical region, and define a different workflow for each team.
            </p>
        </field>
    </record>

    <record id="helpdesk.helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_enquiry','=', False)]</field>
        <field name="context">{'default_is_enquiry': False}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
                No teams found. Let's create one!
            </p>
            <p>
                Create teams to organize your tickets by expertise or geographical region, and define a different workflow for each team.
            </p>
        </field>
    </record>


