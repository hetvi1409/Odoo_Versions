<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">client.enquiry.view.kanban</field>
        <field name="model">client.enquiry</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" action="action_view_enquiry" type="object"  class="o_kanban_small_column o_kanban_helpdesk_ticket" quick_create_view="client_enquiry.quick_create_client_enquiry_form" sample="1">
                <field name="state"/>
                <field name="user_id"/>
                <field name="priority"/>
                <field name="property_id"/>
                <field name="assessment_id"/>
                <field name="team_id"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <span class="oe_kanban_color_help" role="img" />
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a type="edit" class="dropdown-item" role="menuitem">Edit</a></t>
                                    <t t-if="widget.deletable"><a type="delete" class="dropdown-item" role="menuitem">Delete</a></t>
                                </div>
                            </div>
                            <div class="oe_kanban_content text-break">
                                <div>
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <div>
                                    <field name="property_id"/>
                                </div>
                                <div>
                                    <field name="assessment_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field t-if="record.user_id.raw_value" name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="client_enquiry_view_form" model="ir.ui.view">
        <field name="name">Client Enquiry</field>
        <field name="model">client.enquiry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,assessment,circulation_comments,valuation,transaction,public_participation,section_advert,bide_specification,scm_process,legal_agreement,Take_on"/>
                    <button name="action_assigne_to_me"
                            string="Assign to me" type="object" class="btn btn-secondary"
                            groups="client_enquiry.group_cbo" invisible="state != 'submit' or user_id != False"/>
<!--                    <button name="action_check_ownership" states="submit"-->
<!--                            groups="client_enquiry.group_property_manager"-->
<!--                            string="Check Property" type="object"/>-->
                    <button name="action_submit" invisible="state != 'draft'"
                            string="Submit" type="object" groups="client_enquiry.group_cbo"/>

                    <button name="action_reset_to_draft" invisible="state != 'submit'"
                            string="Reset to Draft" type="object" groups="client_enquiry.group_cbo"/>
                    <button name="action_create_assessment" invisible="state != 'submit'"
                            groups="client_enquiry.group_cbo"
                            string="Request Assessment" type="object"/>
                    <button name="action_send_cancelled_mail" invisible="state != 'cancelled'"
                            groups="client_enquiry.group_cbo"
                            string="Send Mail to Enquirer" type="object"/>
                    <button name="action_send_assessment_started_mail" invisible="state not in ['assessment','completed']"
                            groups="client_enquiry.group_cbo"
                            string="Send Mail to Enquirer" type="object"/>
                    <button name="action_circulation_comment" invisible="state != 'assessment' or circulation_id != False"
                            groups="client_enquiry.group_cbo"
                            string="Send Circulation Comment" type="object"/>
                    <button name="action_reset_to_draft_ownership" invisible="state != 'not_verified'"
                            groups="client_enquiry.group_cbo"
                            string="Reset to Draft" type="object"/>
                </header>
                <sheet>
                    <style>
                    .o_form_view:not(.o_field_highlight)
                    .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                    .o_input:not(:hover):not(:focus) {
                              --o-input-border-color: black !important;
                              }
                  </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_eac" type="object"
                                class="oe_stat_button" invisible="eac_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">EAC Process</span>
                            </div>
                        </button>
                        <button name="action_view_valuation" type="object"
                                class="oe_stat_button" invisible="valuation_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Valuation</span>
                            </div>
                        </button>
                        <button name="action_view_transaction" type="object"
                                class="oe_stat_button" invisible="transaction_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Transaction</span>
                            </div>
                        </button>
                        <button name="action_view_circulation" type="object"
                                class="oe_stat_button" invisible="circulation_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Circulation</span>
                            </div>
                        </button>
                        <button name="action_view_land_regularization" type="object"
                                class="oe_stat_button" invisible="land_regularisation_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Land Regularisation</span>
                            </div>
                        </button>
                        <button name="action_view_assessment" type="object"
                                class="oe_stat_button" invisible="assessment_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Assessment</span>
                            </div>
                        </button>
                        <button name="action_view_property" type="object"
                                class="oe_stat_button" invisible="property_id == False">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Property</span>
                            </div>
                        </button>
                    </div>
                    <field name="support_state" widget="badge"
                           decoration-success="support_state in ('supported')"
                           decoration-danger="support_state in ('not_supported')"
                           style="display: flex;align-items: center;justify-content: flex-end;" />
                    <div class="oe_title">
                        <field name="company_type" widget="radio" options="{'horizontal': true}"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="sla_policy_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': True}" readonly="1"  invisible="1"/>
                        <span invisible="sla_deadline == False" class="mx-2 text-muted">
                            <i class="fa fa-lg fa-clock-o me-2" aria-label="Sla Deadline" title="Sla Deadline"  invisible="1"/>
                            <field name="sla_deadline" widget="remaining_days"  invisible="1"/>
                        </span>
                    </div>
                    <group>
                        <group>
                            <field name="support_state" invisible="1"/>
