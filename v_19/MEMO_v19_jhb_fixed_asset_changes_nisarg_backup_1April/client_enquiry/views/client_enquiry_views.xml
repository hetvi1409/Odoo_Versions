                            <field name="valuation_id" readonly="1" invisible="1"/>
                            <field name="eac_id" readonly="1" invisible="1"/>
                            <field name="transaction_id" readonly="1" invisible="1"/>
                            <field name="assessment_state" widget="badge" invisible="state in ['draft', 'submit']"
