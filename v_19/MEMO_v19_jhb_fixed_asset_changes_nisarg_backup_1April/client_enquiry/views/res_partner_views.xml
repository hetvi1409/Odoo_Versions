<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.list.form</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                    <div class="oe_title mb24">
                        <field name="is_company" invisible="1"/>
                        <field name="commercial_partner_id" invisible="1"/>
                        <field name="active" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="country_code" invisible="1"/>
                        <field name="company_type" widget="radio" options="{'horizontal': true}"/>
<!--                        <h1>-->
<!--                            <label for="name">Surname</label>-->
<!--                            <field id="company" class="text-break" name="name" default_focus="1" placeholder="e.g. Lumber Inc" attrs="{'required' : [('type', '=', 'contact')], 'invisible': [('is_company','=', False)]}"/>-->
<!--                            <field id="individual" class="text-break" name="name" default_focus="1" placeholder="e.g. Brandom Freeman" attrs="{'required' : [('type', '=', 'contact')], 'invisible': [('is_company','=', True)]}"/>-->
<!--                        </h1>-->
                    </div>
                    <group>
                        <group>
                            <field name="name" invisible="1"/>
                            <field name="name" string="Surname"/>
                            <field name="company_name" invisible="company_type != 'company'"/>
                            <field name="first_name"/>
                            <field name="type" invisible="1"/>
                            <field name="phone" string="Tel" widget="phone"/>
<!--                            <field name="mobile" widget="phone"/>-->
                        </group>
                        <group>
                            <field name="user_ids" invisible="1"/>
                            <field name="email" widget="email" context="{'gravatar_image': True}" required="user_ids != []"/>
<!--                            <field name="title" placeholder="e.g. Mister" />-->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>