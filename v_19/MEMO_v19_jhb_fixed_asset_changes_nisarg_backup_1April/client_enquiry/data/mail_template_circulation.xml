    <record id="email_template_circulation_enquiry_report" model="mail.template">
            <field name="name">Enquiry: Enquiry</field>
            <field name="model_id" ref="client_enquiry.model_client_enquiry"/>
<!--            <field name="subject">Enquiry {{ object.enquiry_id.name }}</field>-->
<!--            <field name="partner_to">{{ object.enquiry_id.partner_id.id }}</field>-->
            <field name="description">Send to the external users.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <div>
                            Hi,
                            <table class="table table-bordered" style="width: 50%;" >
                                <tr>
                                    <td><b>Property Name:</b></td>
                                    <td><t t-out="object.property_id.sudo().name"/></td>
                                </tr>
                                <tr>
                                    <td><b>Address:</b></td>
                                    <td><t t-out="object.property_id.sudo().address"/></td>
                                </tr>
                                <tr>
                                    <td><b>JMC Number:</b></td>
                                    <td><t t-out="object.jmc_number"/></td>
                                </tr>
                                <tr>
                                    <td><b>Township Name:</b></td>
                                    <td><t t-out="object.property_id.sudo().address"/></td>
                                </tr>
                                <tr>
                                    <td><b>Stand Number:</b></td>
                                    <td><t t-out="object.stand_number"/> </td>
                                </tr>
                                <tr>
                                    <td><b>Zoning:</b></td>
                                    <td><t t-out="object.property_id.sudo().zoning_id.name"/></td>
                                </tr>
                                <tr>
                                    <td><b>Proposal:</b></td>
                                    <td>...</td>
                                </tr>

                            </table>
                         In terms of Section 14(2) of Municipal Finance
                         Management Act (MFMA), you are requested to comment
                         on the subject property indicating whether the
                         proposal is supported or not by your Department and
                         advice if any services will be affected by this
                         proposal.
                            <br/>
                        Should your comment not be received by the
                         %s, JPC will proceed to obtain Council
                         approval for alienation.
                            <div style = "text-align: center; margin-top: 16px;"><a href = '/my/assessment'
                         style = "padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF;
                         border-color:#875A7B;text-decoration: none; display: inline-block;
                         margin-bottom: 0px; font-weight: 400;text-align: center; vertical-align: middle;
                         cursor: pointer; white-space: nowrap; background-image: none;
                         background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px;">
                         View <t t-out="object.name"/> </a></div>
                        </div>
                    </p>
                </div>
            </field>
<!--            <field name="report_name">Assessment{{ (object.name or '').replace('/','_') }}</field>-->
<!--            <field name="lang">{{ object.enquiry_id.partner_id.lang }}</field>-->
            <field name="auto_delete" eval="True"/>
        </record>

