            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hi <t t-out="object.partner_id.name" />,<br/>
                        The Enquiry <t t-out="object.name"/> is cancelled.
                        The Assessment <t t-out="object.assessment_id.name"/> is not supported in JPC.
