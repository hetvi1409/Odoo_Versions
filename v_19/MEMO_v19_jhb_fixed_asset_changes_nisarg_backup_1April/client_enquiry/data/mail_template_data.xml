<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="email_template_enquiry" model="mail.template">
            <field name="name">Enquiry</field>
            <field name="model_id" ref="client_enquiry.model_client_enquiry"/>
            <field name="subject"> The Property in the enquiry {{ object.name or 'n/a' }} is not available.</field>
            <field name="description">send to the customers.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hi <t t-out="object.partner_id.name" />,<br/>
                        The Enquiry <t t-out="object.name"/> is not available in JPC Company.
                    </p>
                </div>
            </field>
        </record>
        <record id="email_template_enquiry_submitted" model="mail.template">
            <field name="name">Enquiry</field>
            <field name="model_id" ref="client_enquiry.model_client_enquiry"/>
            <field name="subject"> The enquiry {{ object.name or 'n/a' }} is submitted.</field>
            <field name="description">send to the customers.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hi <t t-out="object.partner_id.name" />,<br/>
                        The Enquiry <t t-out="object.name"/> is Submitted to the CBO team.
                    </p>
                </div>
            </field>
        </record>
        <record id="email_template_enquiry_assigned" model="mail.template">
            <field name="name">Enquiry Assigned</field>
            <field name="model_id" ref="client_enquiry.model_client_enquiry"/>
            <field name="subject"> The Enquiry {{ object.name or 'n/a' }} is Assigned.</field>
            <field name="email_to">{{object.user_id.partner_id.email}}</field>
            <field name="description">send to the users.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hi <t t-out="object.user_id.name" /><br/>
                        The Enquiry <t t-out="object.name"/> is assigned for you.
                    </p>
                    <div style="margin: 16px 0px 16px 0px;">
                        <a t-att-href="(object.get_list_url())"
                           style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                            <t>
                                Open <t t-out="object.name"/>
                            </t>
                        </a>
                    </div>

                </div>
            </field>
        </record>
