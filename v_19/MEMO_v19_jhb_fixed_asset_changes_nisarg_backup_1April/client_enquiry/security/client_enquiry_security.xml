<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="category_assessment" model="ir.module.category">
            <field name="name">Land Process</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_privilege_category_assessment">
            <field name="name">Land Process</field>
            <field name="sequence">19</field>
            <field name="category_id" ref="client_enquiry.category_assessment"/>
        </record>

        <record id="group_asset_evaluator" model="res.groups">
            <field name="name">Assets Evaluator</field>
            <field name="privilege_id" ref="res_groups_privilege_category_assessment"/>
        </record>
        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_category_assessment"/>
        <field name="implied_ids" eval="[(4, ref('client_enquiry.group_asset_evaluator'))]"/>
        </record>
        <record id="group_cbo" model="res.groups">
            <field name="name">CBO</field>
            <field name="privilege_id" ref="res_groups_privilege_category_assessment"/>
        <field name="implied_ids" eval="[(4, ref('client_enquiry.group_asset_evaluator')), (4, ref('client_enquiry.group_manager'))]"/>
        </record>
        <record id="group_property_management" model="res.groups">
            <field name="name">Property Management</field>
            <field name="privilege_id" ref="res_groups_privilege_category_assessment"/>
            <field name="implied_ids" eval="[(4, ref('client_enquiry.group_asset_evaluator')), (4, ref('client_enquiry.group_manager')), (4, ref('client_enquiry.group_cbo'))]"/>
<!--        <field name="implied_ids" eval="[(4, ref('client_enquiry.group_cbo'))]"/>-->
        </record>
        <record id="group_property_manager" model="res.groups">
            <field name="name">Property Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_category_assessment"/>
            <field name="implied_ids" eval="[(4, ref('client_enquiry.group_asset_evaluator')), (4, ref('client_enquiry.group_manager')),
            (4, ref('client_enquiry.group_cbo')), (4, ref('client_enquiry.group_property_management'))]"/>
<!--        <field name="implied_ids" eval="[(4, ref('client_enquiry.group_property_management'))]"/>-->
        </record>
        <record id="group_general_manager" model="res.groups">
            <field name="name">General Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_category_assessment"/>
            <field name="implied_ids" eval="[(4, ref('client_enquiry.group_asset_evaluator')), (4, ref('client_enquiry.group_manager')),
            (4, ref('client_enquiry.group_cbo')), (4, ref('client_enquiry.group_property_management')), (4, ref('client_enquiry.group_property_manager'))]"/>
<!--        <field name="implied_ids" eval="[(4, ref('client_enquiry.group_property_manager'))]"/>-->
        </record>

        <record id="client_enquiry_company_rule" model="ir.rule">
            <field name="name">Enquiry multi company rule</field>
            <field name="model_id" ref="model_client_enquiry"/>
            <field name="domain_force">['|',('company_id','=',False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="oi_committee.rule_committee_meeting_system" model="ir.rule">
		<field name="name">Committee Meeting System</field>
		<field name="model_id" ref="model_committee_meeting" />
		<field name="groups" eval="[Command.link(ref('base.group_system')), Command.link(ref('client_enquiry.group_property_manager'))]"/>
		<field name="domain_force">[(1,'=', 1)]</field>
	</record>

    </data>
</odoo>