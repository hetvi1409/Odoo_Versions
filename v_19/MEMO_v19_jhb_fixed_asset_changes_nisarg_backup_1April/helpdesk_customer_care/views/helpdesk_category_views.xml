<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="helpdesk_category_view_tree">
        <field name="name">helpdesk.category.list</field>
        <field name="model">helpdesk.category</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list >
                <field name="name"/>
                <field name="team_id"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_category_action" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">helpdesk.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new City
            </p>
        </field>
    </record>
    <record model="ir.ui.view" id="helpdesk_sub_category_view_tree">
        <field name="name">helpdesk.sub.category.list</field>
        <field name="model">helpdesk.sub.category</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="category_id"/>
                <field name="team_id"/>
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="helpdesk_category_view_form">
        <field name="name">helpdesk.category.form</field>
        <field name="model">helpdesk.category</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="team_id"/>
                    </group>
                    <notebook>
                        <page string="Sub Category">
                            <field name="sub_category_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="team_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_sub_category_action" model="ir.actions.act_window">
        <field name="name">Sub Category</field>
        <field name="res_model">helpdesk.sub.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new City
            </p>
        </field>
    </record>

    <menuitem id="helpdesk_category_menu"
            name="Category"
            action="helpdesk_category_action"
            parent="helpdesk.helpdesk_menu_config"
            sequence="4"/>
    <menuitem id="helpdesk_sub_category_menu"
            name="Sub Category"
            action="helpdesk_sub_category_action"
            parent="helpdesk.helpdesk_menu_config"
            sequence="4"/>
</odoo>