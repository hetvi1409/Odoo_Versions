<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form.view</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_open_ticket_view']" position="after">
                <button name="action_open_category" type="object" icon="fa-tasks" class="oe_stat_button">
                    <field name="category_count" string="Category" widget="statinfo"/>
                </button>
                <button name="action_open_sub_category" type="object" icon="fa-tasks" class="oe_stat_button">
                    <field name="sub_category_count" string="Sub-Category" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id"
               ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="replace"/>
            <xpath expr="//field[@name='company_id']" position="replace"/>
            <xpath expr="//field[@name='domain_user_ids']" position="after">
                <field name="category_id"/>
                <field name="sub_category_id"/>
            </xpath>
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="company_id"/>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_tickets_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.view</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id"
               ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="category_id"/>
                <field name="sub_category_id"/>
            </xpath>
        </field>
    </record>
