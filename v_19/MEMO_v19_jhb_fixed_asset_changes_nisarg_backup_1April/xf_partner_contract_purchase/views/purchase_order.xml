<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_contract_form" model="ir.ui.view">
            <field name="name">purchase_order_contract_form</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_title')]" position="after">
                    <group invisible="use_purchase_contract == 'no'">
                        <field name="use_purchase_contract" invisible="True"/>
                        <label for="contract_id"/>
                        <div class="o_row">
                            <span>
                                <field name="contract_id"
                                       required="use_purchase_contract == 'required'"/>
                            </span>
                            <button type="object" name="action_apply_contract"
                                    invisible="contract_id == False and state != 'draft'"
                                    class="btn btn-primary"
                                    help="Apply Contract"
                                    confirm="Please confirm that you want to apply contract details">
                                <span>Apply</span>
                            </button>
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>