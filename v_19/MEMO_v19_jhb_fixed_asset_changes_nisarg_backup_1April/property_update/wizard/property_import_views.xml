<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="property_import_view_form" model="ir.ui.view">
       <field name="name">Property Import</field>
       <field name="model">property.import</field>
       <field name="arch" type="xml">
           <form>
               <group col="4">
                   <field name="file"/>
               </group>
               <footer>
                   <button name="action_import_xlsx" string="Import" type="object"
                             default_focus="1" class="oe_highlight"/>
                   <button string="Cancel" class="btn btn-default" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
   <record id="property_import_action" model="ir.actions.act_window">
       <field name="name">Property Import</field>
       <field name="res_model">property.import</field>
       <field name="type">ir.actions.act_window</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
   </record>
   <menuitem id="property_import_menu" name="Property Import"
              parent="itsys_real_estate.menu_settings" action="property_import_action" />
</odoo>