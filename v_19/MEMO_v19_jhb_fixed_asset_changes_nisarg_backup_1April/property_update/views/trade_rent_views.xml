<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="trade_rent_view_form" model="ir.ui.view">
        <field name="name">trade.rent.view.form</field>
        <field name="model">trade.rent</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="name">Prem. No</label>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="bldg_code"/>
                            <field name="ref"/>
                            <field name="lease_exp_date"/>
                            <field name="opening"/>
                            <field name="total_charges"/>
                        </group>
                        <group>
                            <field name="bldg_name"/>
                            <field name="ten_name"/>
                            <field name="rentroll"/>
                            <field name="commercial"/>
                            <field name="closing_balance"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="trade_rent_action" model="ir.actions.act_window">
        <field name="name">Trade Rent</field>
        <field name="res_model">trade.rent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Trade.
            </p>
        </field>
    </record>
    <record id="trade_rent_view_tree" model="ir.ui.view">
        <field name="name">trade.rent.view.list</field>
        <field name="model">trade.rent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" readonly="1"/>
                <field name="bldg_code"/>
                <field name="bldg_name"/>
                <field name="ref"/>
            </list>
        </field>
    </record>
    <menuitem parent="itsys_real_estate.menu_building_list"
              id="trade_rent_menu" name="Trade Rent"
              action="trade_rent_action" sequence="20"/>
</odoo>