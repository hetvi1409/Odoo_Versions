<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="property_zoning_view_tree" model="ir.ui.view">
        <field name="name">property.zoning.view.list</field>
        <field name="model">property.zoning</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="property_zoning_action" model="ir.actions.act_window">
        <field name="name">Property Zoning</field>
        <field name="res_model">property.zoning</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Zoning.
            </p>
        </field>
    </record>
    <record id="property_department_view_tree" model="ir.ui.view">
        <field name="name">property.department.view.list</field>
        <field name="model">property.department</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="property_department_action" model="ir.actions.act_window">
        <field name="name">Property Department</field>
        <field name="res_model">property.department</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Department.
            </p>
        </field>
    </record>
    <menuitem parent="itsys_real_estate.menu_settings"
              id="menu_property_zoning" name="Zoning"
              action="property_zoning_action" sequence="20"/>
    <record id="property_category_view_tree" model="ir.ui.view">
        <field name="name">property.category.view.list</field>
        <field name="model">property.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="property_category_action" model="ir.actions.act_window">
        <field name="name">Property Category</field>
        <field name="res_model">property.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Category.
            </p>
        </field>
    </record>
    <menuitem parent="itsys_real_estate.menu_settings"
              id="menu_property_category" name="Category"
              action="property_category_action" sequence="20"/>
    <record id="property_category_amp_view_tree" model="ir.ui.view">
        <field name="name">property.category.amp.view.list</field>
        <field name="model">property.category.amp</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="category_name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>
    <record id="property_category_amp_action" model="ir.actions.act_window">
        <field name="name">Property Category AMP</field>
        <field name="res_model">property.category.amp</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Category.
            </p>
        </field>
    </record>
    <menuitem parent="itsys_real_estate.menu_settings"
              id="menu_property_category_amp" name="Category AMP"
              action="property_category_amp_action" sequence="20"/>

    <menuitem parent="itsys_real_estate.menu_settings"
              id="menu_property_department" name="Department"
              action="property_department_action" sequence="20"/>
</odoo>