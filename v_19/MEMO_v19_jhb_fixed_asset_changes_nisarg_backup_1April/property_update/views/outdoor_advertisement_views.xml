                                       mode="kanban"
                                       options="{'create_text':'Add a Media'}"
                                       nolabel="1"/>
                            </group>
                        </page>
                        <page string="Documents">
                            <field name="attach_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
