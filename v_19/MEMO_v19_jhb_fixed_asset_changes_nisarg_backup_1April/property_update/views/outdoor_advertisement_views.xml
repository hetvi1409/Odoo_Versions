    <record id="outdoor_advertisement_view_search" model="ir.ui.view">
        <field name="name">outdoor.advertisement.view.search</field>
        <field name="model">outdoor.advertisement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="ref" string="Reference"/>
                    <filter string="Company" name="group_company_id" domain="[]"
                            context="{'group_by':'company_id'}"/>
            </search>
        </field>
    </record>
    <record id="outdoor_advertisement_action" model="ir.actions.act_window">
        <field name="name">Outdoor Advertisement</field>
        <field name="res_model">outdoor.advertisement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_company_id': true }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Outdoor Advertisement.
            </p>
        </field>
    </record>
    <record id="outdoor_advertisement_view_tree" model="ir.ui.view">
        <field name="name">outdoor.advertisement.view.list</field>
        <field name="model">outdoor.advertisement</field>
        <field name="arch" type="xml">
            <list>
                <field name="township_id"/>
                <field name="region_id"/>
                <field name="zoning_id"/>
                <field name="jmc_number"/>
                <field name="company_id"/>
                <field name="attach_line_ids" string="Lease Document"/>
            </list>
        </field>
    </record>
    <menuitem parent="itsys_real_estate.menu_building_list"
              id="menu_outdoor_advertisement" name="Outdoor Advertisement"
              action="outdoor_advertisement_action" sequence="20"/>
</odoo>