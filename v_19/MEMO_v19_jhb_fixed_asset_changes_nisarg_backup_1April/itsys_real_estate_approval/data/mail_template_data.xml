<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_to_confirm" model="mail.template">
    <field name="name">Approval Request Submitted</field>
    <field name="model_id" ref="model_building_approval"/>
    <field name="subject">Approved: {{object.name}}</field>
    <field name="body_html" type="html">
            <p>Dear,</p>
            <p><strong><t t-esc="object.name"/></strong> has been request for approval.</p>
            <p>Please process this request accordingly!</p>
            <p>Best regards,</p>
        <div style="margin: 16px 0px 16px 0px;">
                            <a t-att-href="object.redirect_url"
                                style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                View Request
                            </a>
                        </div>
<!--            <p>${user.name}</p>-->
    </field>
</record>

        <record id="email_template_approval_confirmed" model="mail.template">
    <field name="name">Approval Confirmed</field>
    <field name="model_id" ref="model_building_approval"/>
    <field name="subject">Approved: {{object.name}}</field>
    <field name="body_html" type="html">
            <p>We are pleased to inform you that the form <strong><t t-esc="object.name"/></strong> has been approved.</p>
            <p>Thank you for your submission!</p>
            <p>Best regards,</p>
        <div style="margin: 16px 0px 16px 0px;">
                            <a t-att-href="object.redirect_url"
                                style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                View Property
                            </a>
                        </div>
<!--            <p>${user.name}</p>-->
    </field>
</record>

        <record id="email_template_rejected" model="mail.template">
    <field name="name">Approval Rejected</field>
    <field name="model_id" ref="model_building_approval"/>
    <field name="subject">Rejected: {{object.name}}</field>
    <field name="body_html" type="html">
            <p>We regret to inform you that the form <strong><t t-esc="object.name"/></strong> has been rejected.</p>
            <p>For more details, please contact us.</p>
            <p>Best regards,</p>
        <div style="margin: 16px 0px 16px 0px;">
                            <a t-att-href="object.redirect_url"
                                style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                View Request
                            </a>
                        </div>
<!--            <p>${user.name}</p>-->
    </field>
</record>

        <record id="email_template_removal_to_confirm" model="mail.template">
            <field name="name">Removal Request Submitted</field>
            <field name="model_id" ref="model_building_removal_approval"/>
            <field name="subject">Removal Request: {{object.building_id.name}}</field>
            <field name="body_html" type="html">
                <p>Dear,</p>
                <p><strong><t t-esc="object.building_id.name"/></strong> has been requested for removal.</p>
                <p>Please process this request accordingly!</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                        style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Removal Request
                    </a>
                </div>
            </field>
        </record>

        <!-- Email Template for Removal Approval Confirmation -->
        <record id="email_template_removal_approved" model="mail.template">
            <field name="name">Removal Approved</field>
            <field name="model_id" ref="model_building_removal_approval"/>
            <field name="subject">Approved: Removal of {{object.building_id.name}}</field>
            <field name="body_html" type="html">
                <p>We are pleased to inform you that the removal request for <strong><t t-esc="object.building_id.name"/></strong> has been approved.</p>
                <p>The building has been marked as removed from the system.</p>
                <p>Thank you for your submission!</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                        style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Removed Building
                    </a>
                </div>
            </field>
        </record>

        <!-- Email Template for Removal Rejection -->
        <record id="email_template_removal_rejected" model="mail.template">
            <field name="name">Removal Rejected</field>
            <field name="model_id" ref="model_building_removal_approval"/>
            <field name="subject">Rejected: Removal of {{object.building_id.name}}</field>
            <field name="body_html" type="html">
                <p>We regret to inform you that the removal request for <strong><t t-esc="object.building_id.name"/></strong> has been rejected.</p>
                <p>Please contact us for further details.</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                        style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Request
                    </a>
                </div>
            </field>
        </record>

    </data>
</odoo>
