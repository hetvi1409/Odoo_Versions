<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="building_form_approval">
            <field name="name">building.approval.form</field>
            <field name="model">building.approval</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Real Estate">
                    <header>
                        <button name="action_approve" string="Approve"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'send'"
                                groups="itsys_real_estate_approval.group_property_approval_manager"/>
                        <button name="action_reject" string="Reject"
                                type="object"
                                invisible="state != 'send'"
                                groups="itsys_real_estate_approval.group_property_approval_manager"/>
                        <button name="action_submit_for_approval"
                                string="Submit For Approval" type="object"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                          <style>
                    .o_form_view:not(.o_field_highlight)
                    .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                    .o_input:not(:hover):not(:focus) {
                              --o-input-border-color: black !important;
                              }
                  </style>
                        <field name="asset_id" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <!-- Smart button to view the created building -->
                            <button name="action_view_building" type="object"
                                    class="oe_stat_button" invisible="asset_id == False"
                                    icon="fa-building">
                                <span>Building</span>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code" requied="1"/>
                                <field name="region_id"/>
                                <field name="partner_id"
                                       context="{'res_partner_search_mode': 'is_owner', 'default_is_owner':True,}"
                                       domain="[('is_owner','=',True)]"/>
                            </group>
                            <group>
                                <field name="purchase_date"/>
                                <field name="launch_date"/>

                                <field name="account_analytic_id"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
<!--                                <field name="company_id"/>-->
                                <field name="latitude"/>
                                <field name="longitude"/>
                                <field name="document_id"/>


                            </group>
                        </group>

                        <notebook colspan="4">
                            <page string="invisible" invisible="1"/>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="building_tree_approval">
            <field name="name">building.approval.list</field>
            <field name="model">building.approval</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <list string="Real Estate">
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record id="action_building_approval" model="ir.actions.act_window">
            <field name="name">Building Approval</field>
            <field name="res_model">building.approval</field>
            <field name="view_mode">list,form</field>
        </record>


        <record model="ir.ui.view" id="building_removal_form_approval">
            <field name="name">building.removal.approval.form</field>
            <field name="model">building.removal.approval</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Building Removal Approval">
                    <header>
                        <button name="action_approve" string="Approve"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'send'"
                                groups="itsys_real_estate_approval.group_property_approval_manager"/>
                        <button name="action_reject" string="Reject"
                                type="object"
                                invisible="state != 'send'"
                                groups="itsys_real_estate_approval.group_property_approval_manager"/>
                        <button name="action_submit_for_approval"
                                string="Submit For Approval" type="object"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="building_id" string="Building"/>
                                <field name="removal_reason"
                                       string="Reason for Removal"
                                       widget="text"/>
                                        <field name="disposal_method" widget="radio"  options="{'horizontal': true}"/>
                                                <field name="selling_input" invisible="disposal_method != 'sale'"/>

                                <field name="document_id"/>
                                <field name="attachment_id"/>
                            </group>
                            <group>
                                <field name="user_id" string="Submitted By"
                                       readonly="1"/>
                                <field name="removal_date"
                                       string="Removal Date"/>
                            </group>
                        </group>

                        <notebook colspan="4">
                            <page string="Condition of Property">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Tree View for Building Removal Approval -->
        <record model="ir.ui.view" id="building_removal_tree_approval">
            <field name="name">building.removal.approval.list</field>
            <field name="model">building.removal.approval</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <list string="Building Removal Approval">
                    <field name="building_id" string="Building"/>
                    <field name="state" string="Status"/>
                </list>
            </field>
        </record>

        <!-- Action for Building Removal Approval -->
        <record id="action_building_removal_approval"
                model="ir.actions.act_window">
            <field name="name">Building Removal Approval</field>
            <field name="res_model">building.removal.approval</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_building_removal" model="ir.ui.view">
            <field name="name">building.removal.form</field>
            <field name="model">building</field>
            <field name="inherit_id"
                   ref="itsys_real_estate.building_form"/> <!-- Use the correct reference -->
            <field name="arch" type="xml">
                <!-- Add the new tab 'Windeed' inside the notebook tag -->
                <xpath expr="//header" position="inside">
                    <button name="action_remove_asset" string="Dispose Asset"
                            type="object" class="btn-danger" invisible="active == False"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
