<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="asset_import_view_form" model="ir.ui.view">
        <field name="name">asset.import.view.form</field>
        <field name="model">asset.import</field>
        <field name="inherit_id" ref="asset_registry.asset_import_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="replace">
                <footer>
                    <button name="action_update_assets" string="Update Asset"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </xpath>
        </field>
    </record>
</odoo>