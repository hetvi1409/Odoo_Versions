<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_asset_rul" model="ir.actions.report">
        <field name="name">Asset RUL</field>
        <field name="model">asset.rul.reports</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">asset_reports.report_asset_rul</field>
        <field name="report_file">asset_reports.report_asset_rul</field>
        <field name="print_report_name">'Asset RUL  - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_asset_impairment_reports"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_asset_rul">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div calss="page">
                    <img class="img"
                         src="/asset_reports/static/src/img/report_icon.png"/>
                    <br/>
                    <h3>RUL Change</h3>
                    <table class="table">
                        <tbody class="order_body">
                            <tr>
                                <td>From Date:</td>
                                <td><t t-esc="from_date"/></td>
                                <td>Cost Centre:</td>
                                <td>-</td>
                                <td>Facility:</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td>To Date:</td>
                                <td><t t-esc="to_date"/></td>
                                <td>Department:</td>
                                <td>-</td>
                                <td>Function:</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td>Classification:</td>
                                <td></td>
                                <td>Class:</td>
                                <td>-</td>
                                <td>Fund:</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td>Component Type:</td>
                                <td></td>
                                <td>Item:</td>
                                <td>-</td>
                                <td>Region:</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td>Cost Center:</td>
                                <td></td>
                                <td>Project:</td>
                                <td>-</td>
                                <td>Dim 12:</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td>Supplier:</td>
                                <td>-</td>
                                <td>Dim 13:</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td>Cost:</td>
                                <td>-</td>
                                <td>Dim 14:</td>
                                <td>-</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-condensed">
                        <thead>
                            <tr class="text-center">
<!--                                <th class="text-right">Barcode</th>-->
                                <th class="text-right">Asset Description</th>
                                <th class="text-right">New RUL</th>
                                <th class="text-right">Effective From</th>
                                <th class="text-right">Reason</th>
                                <th class="text-right">Captured By</th>
                                <th class="text-right">Cancelled</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data"
                                t-as="rec">
                                <td>
                                    <t t-esc="rec[0]"/>
                                </td>
                                <td>
                                    <span t-esc="rec[1]"/>:
                                    <span t-esc="rec[2]"/>
                                </td>
                                <td>

                                </td>
                                <td>
                                    <span t-esc="rec[3]"/>
                                </td>
                                <td>

                                </td>
                                <td>
                                    <span t-esc="rec[4]"/>
                                </td>
                                <td>
                                    <t t-if="len(rec) > 5">
                                        <t t-if="rec[5] == 'cancelled'">
                                            True
                                        </t>
                                        <t t-if="rec[5] != 'cancelled'">
                                            False
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <span>No data available</span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>