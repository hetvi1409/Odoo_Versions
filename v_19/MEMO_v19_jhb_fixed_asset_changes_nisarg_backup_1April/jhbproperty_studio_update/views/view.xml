<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jhb_view_users_tree_inherit" model="ir.ui.view">
        <field name="name">res.users.list.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="employee" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="employee_ids" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="jhb_rental_contract_tree_view_inherit" model="ir.ui.view">
        <field name="name">rental.contract.tree customization</field>
        <field name="model">rental.contract</field>
        <field name="inherit_id" ref="itsys_real_estate.rental_contract_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='address']" position="replace"/>
            <xpath expr="//field[@name='insurance_fee']" position="replace"/>
            <xpath expr="//field[@name='floor']" position="replace"/>
            <xpath expr="//field[@name='building_unit']" position="replace"/>
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="message_attachment_count" optional="show"/>
            </xpath>
            <xpath expr="//list[1]/field[@name='name']" position="after">
                <field name="jmc_number" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="jhb_view_property_intelligence_form_inherit" model="ir.ui.view">
        <field name="name">property.intelligence.form customization</field>
        <field name="model">property.intelligence</field>
        <field name="inherit_id" ref="property_intelligence.view_property_intelligence_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supporting_document_ids']" position="attributes">
                <attribute name="string">GFIS Documents</attribute>
            </xpath>
        </field>
    </record>

    <record id="jhb_outdoor_advertisement_view_tree_inherit" model="ir.ui.view">
        <field name="name">outdoor.advertisement.view.tree customization</field>
        <field name="model">outdoor.advertisement</field>
        <field name="inherit_id" ref="property_update.outdoor_advertisement_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='jmc_number']" position="after">
                <field name="owned_id" optional="show" string="Owner"/>
            </xpath>
        </field>
    </record>

    <record id="jhb_outdoor_advertisement_view_form_inherit" model="ir.ui.view">
        <field name="name">outdoor.advertisement.view.form customization</field>
        <field name="model">outdoor.advertisement</field>
        <field name="inherit_id" ref="property_update.outdoor_advertisement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='surbub']" position="attributes">
                <attribute name="string">Suburb</attribute>
            </xpath>
            <xpath expr="//field[@name='file']" position="attributes">
                <attribute name="widget">pdf_viewer</attribute>
            </xpath>
        </field>
    </record>

    <record id="jhb_view_memo_list_inherit" model="ir.ui.view">
        <field name="name">memo.memo.list customization</field>
        <field name="model">memo.memo</field>
        <field name="inherit_id" ref="e_system.view_memo_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requester_id']" position="after">
                <field name="approver_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="jhb_view_memo_form_inherit" model="ir.ui.view">
        <field name="name">memo.memo.form customization</field>
        <field name="model">memo.memo</field>
        <field name="inherit_id" ref="e_system.view_memo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]/field[@name='name']" position="attributes">
                <attribute name="invisible">submission_type != 'memo'</attribute>
                <attribute name="force_save">True</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]" position="attributes">
                <attribute name="string">Memo Details</attribute>
            </xpath>
            <xpath expr="//field[@name='subject']" position="attributes">
                <attribute name="string">Subject</attribute>
            </xpath>
        </field>
    </record>

    <record id="jhb_view_employee_tree_inherit" model="ir.ui.view">
        <field name="name">hr.employee.tree customization</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="user_id" optional="show"/>
            </xpath>
        </field>
    </record>

