    <record id="jhb_enquiry_assessment_view_form_inherit" model="ir.ui.view">
        <field name="name">Enquiry Assessment customization</field>
        <field name="model">enquiry.assessment</field>
        <field name="inherit_id" ref="client_enquiry.enquiry_assessment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_committee_meeting_for_transaction']" position="attributes">
                <attribute name="groups">client_enquiry.group_property_manager,base.group_user</attribute>
            </xpath>
            <xpath expr="//field[@name='land_regularisation_id']" position="attributes">
<!--                <attribute name="attrs">{}</attribute>-->
                <attribute name="force_save">True</attribute>
            </xpath>
            <xpath expr="//field[@name='user_domain_ids']" position="attributes">
<!--                <attribute name="attrs">{}</attribute>-->
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="jhb_client_enquiry_view_form_inherit" model="ir.ui.view">
        <field name="name">Client Enquiry customization</field>
        <field name="model">client.enquiry</field>
        <field name="inherit_id" ref="client_enquiry.client_enquiry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='entire_property']" position="attributes">
                <attribute name="string">Does the enquiry relate to the entire property ?</attribute>
            </xpath>
        </field>
    </record>

    <record id="jhb_building_list_inherit" model="ir.ui.view">
        <field name="name">building.tree customization</field>
        <field name="model">building</field>
        <field name="inherit_id" ref="itsys_real_estate.building_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='address']" position="after">
                <field name="ward" optional="show"/>
                <field name="attach_line" optional="show"/>
                <field name="trim_document_ids" optional="show"/>
                <field name="zone_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="string">Status</attribute>
            </xpath>
        </field>
    </record>

    <record id="jhb_approval_category_view_kanban_inherit" model="ir.ui.view">
        <field name="name">approval.category.views.kanban customization</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban[1]" position="attributes">
                <attribute name="create">true</attribute>
            </xpath>
        </field>
    </record>

</odoo>