<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="law_court_form_view" model="ir.ui.view">
            <field name="name">court.form.view</field>
            <field name="model">court.court</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <span class="o_form_label o_td_label" name="address_name">
                                    <b>Address</b>
                                </span>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State"
                                           options="{'no_open': True, 'no_edit': True, 'no_create': True}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <div name="partner_address_country" class="d-flex justify-content-between">
                                        <field name="country_id"
                                               options="{'no_open': True, 'no_edit': True, 'no_create': True}"
                                               placeholder="Country" class="o_address_country"/>
                                    </div>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page string="Judge" name="judge">
                                <field name="judge_ids">
                                    <list editable="top">
                                        <field name="name" required="1"/>
                                        <field name="contact"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="law_court_tree_view" model="ir.ui.view">
            <field name="name">court.list.view</field>
            <field name="model">court.court</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="law_court_act_action" model="ir.actions.act_window">
            <field name="name">Court</field>
            <field name="res_model">court.court</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>