<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="law_court_judge_form_view" model="ir.ui.view">
            <field name="name">court.judge.form.view</field>
            <field name="model">court.judge</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="contact" />
                            </group>
                            <group>
                                <field name="court_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="law_court_judge_tree_view" model="ir.ui.view">
            <field name="name">court.judge.list.view</field>
            <field name="model">court.judge</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="contact" />
                    <field name="court_id"/>
                </list>
            </field>
        </record>

        <record id="law_court_judge_act_action" model="ir.actions.act_window">
            <field name="name">Judge</field>
            <field name="res_model">court.judge</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>