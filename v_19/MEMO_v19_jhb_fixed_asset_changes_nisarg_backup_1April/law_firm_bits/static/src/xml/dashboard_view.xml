                <!-- Reminders -->
                <div class="row mb-4">
                    <t t-if="widget.upcoming_reminders">
                        <div class="col-lg-6 col-md-6">
                            <div class="card h-100">
                                <div class="card-header-bits pb-0">
                                    <h4>Upcoming Reminders</h4>
                                    <p class="text-sm">
                                        <i class="fa fa-arrow-up text-success" aria-hidden="true"/>
                                    </p>
                                </div>
                                <div class="card-body-bits p-3">
                                    <div class="timeline timeline-one-side">
                                        <t t-foreach="widget.upcoming_reminders" t-as="reminder">
                                            <div class="timeline-block mb-3 cursor-pointer"
                                                 id="btn_click_reminder"
                                                 t-att-data-id="reminder.id"
                                                 t-att-data-model="reminder.model">
                                                <span class="timeline-step">
                                                    <i t-att-class="'fa fa-' + reminder.icon"/>
                                                </span>
                                                <div class="timeline-content">
                                                    <div class="row">
                                                        <div class="col-4">
                                                            <a href="#" class="text-dark text-lm font-weight-bold mb-0">
                                                                <t t-esc="reminder.name"/>
                                                            </a>
                                                        </div>
                                                        <div class="col-4 text-center">
                                                            <p class="text-secondary font-weight-bold text-ls mt-1 mb-0">
                                                                <t t-esc="reminder.desc"/>
                                                            </p>
                                                        </div>
                                                        <div class="col-4 text-center">
                                                            <div class="avatar-group mt-2">
                                                                <t t-foreach="reminder.partner_ids" t-as="partner">
                                                                    <a href="javascript:;"
                                                                       class="avatar avatar-xs rounded-circle"
                                                                       data-bs-toggle="tooltip"
                                                                       t-att-title="partner.name">
                                                                        <img t-attf-src="/web/image/res.partner/#{partner.id}/avatar_128"
                                                                             t-att-alt="partner.name"/>
                                                                    </a>
                                                                </t>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="widget.today_reminders">
                        <div class="col-lg-6 col-md-6 mt-4 mt-md-0">
                            <div class="card h-100">
                                <div class="card-header-bits pb-0">
                                    <h4>Today's Reminders</h4>
                                    <p class="text-sm">
                                        <i class="fa fa-arrow-up text-success" aria-hidden="true"/>
                                    </p>
                                </div>
                                <div class="card-body-bits p-3">
                                    <div class="timeline timeline-one-side">
                                        <t t-foreach="widget.today_reminders" t-as="reminder">
                                            <div class="timeline-block cursor-pointer mb-3"
                                                 id="btn_click_reminder"
                                                 t-att-data-id="reminder.id"
                                                 t-att-data-model="reminder.model">
                                                <span class="timeline-step">
                                                    <i t-att-class="'fa fa-' + reminder.icon"/>
                                                </span>
                                                <div class="timeline-content">
                                                    <div class="row">
                                                        <div class="col-4">
                                                            <a href="#" class="text-dark text-lm font-weight-bold mb-0">
                                                                <t t-esc="reminder.name"/>
                                                            </a>
                                                        </div>
                                                        <div class="col-4 text-center">
                                                            <p class="text-secondary font-weight-bold text-ls mt-1 mb-0">
                                                                <t t-esc="reminder.desc"/>
                                                            </p>
                                                        </div>
                                                        <div class="col-4 text-center">
                                                            <div class="avatar-group mt-2">
                                                                <t t-foreach="reminder.partner_ids" t-as="partner">
                                                                    <a href="javascript:;"
