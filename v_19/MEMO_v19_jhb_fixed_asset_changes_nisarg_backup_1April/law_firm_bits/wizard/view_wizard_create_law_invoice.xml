<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="wizard_create_law_invoice_form" model="ir.ui.view">
            <field name="name">create.law.invoice.form</field>
            <field name="model">wizard.create.law.invoice</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="invoice_type" widget="radio" required="1"/>
                                <field name="amount"/>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Timesheet Lines" name="timesheet" invisible="invoice_type == 'fixed'">
                                <field name="invoice_line_ids" readonly="1">
                                    <list limit="20">
                                        <field name="date"/>
                                        <field name="employee_id"/>
                                        <field name="name"/>
                                        <field name="unit_amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <footer>
                            <button string="Create Invoice" name="btn_create_invoice"
                                    type="object" class="btn-primary" data-hotkey="q"/>
                            <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wizard_create_law_invoice_action" model="ir.actions.act_window">
            <field name="name">Create Invoice</field>
            <field name="res_model">wizard.create.law.invoice</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


    </data>
</odoo>