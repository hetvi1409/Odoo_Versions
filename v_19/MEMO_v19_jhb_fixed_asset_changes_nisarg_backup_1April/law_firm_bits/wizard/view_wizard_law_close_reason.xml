<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wizard_law_close_reason_form_view" model="ir.ui.view">
            <field name="name">wizard.law.close.reason.form.view</field>
            <field name="model">wizard.law.close.reason</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="close_reason"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Submit" name="btn_submit_close_reason"
                                type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="wizard_law_close_reason_action" model="ir.actions.act_window">
            <field name="name">Close Reason</field>
            <field name="res_model">wizard.law.close.reason</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


    </data>
</odoo>

