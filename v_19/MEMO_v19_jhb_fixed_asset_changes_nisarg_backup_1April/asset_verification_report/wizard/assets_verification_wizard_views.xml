<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="assets_verification_reports_view_form" model="ir.ui.view">
        <field name="name">assets.verification.reports.view.form</field>
        <field name="model">assets.verification.reports</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <!-- remove unused fields -->
                        <!-- <group>
                            <field name="date_from" widget="daterange"
                            options="{'end_date_field': 'date_to'}"/>
                            <field name="date_to" invisible="1"/>
                            <field name="job_location_id"/>
                        </group> -->
                        <group>
                            <!-- <field name="custodian_department_id"/> -->
                            <!-- <field name="custodian_id"/> -->
                            <field name="history_id" invisible="1"/>

                            <field name="asset_id" invisible="1"/>
                            <field name="verification_job_location_id"/>
                            <field name="period_start_date"/>
                            <field name="period_end_date"/>
                            <field name="asset_ids" widget="many2many_tags" invisible="1"/>

                            <field name="latest_verification_history_ids" widget="many2many_tags" invisible="1"/>
                            <field name="verification_status"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Print PDF"
                            type="object" class="oe_highlight"/>
                    <button name="action_export_excel" string="Print XLS"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn_default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <!-- Wizard Action -->
    <record id="action_assets_verification_reports" model="ir.actions.act_window">
        <field name="name">Assets Verification Report</field>
        <field name="res_model">assets.verification.reports</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="menu_custom_assets_verification_reports"
              name="Asset Verification Report"
              parent="asset_verification_report.menu_asset_reports_custom"
              action="action_assets_verification_reports"/>
</odoo>