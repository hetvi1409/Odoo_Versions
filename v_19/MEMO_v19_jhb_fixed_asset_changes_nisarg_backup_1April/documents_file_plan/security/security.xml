<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rule for normal internal users: hide rejected -->
    <record id="ir_attachment_rule_hide_rejected" model="ir.rule">
        <field name="name">Hide Rejected Attachments</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[('is_rejected', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Rule for Admins: allow all -->
    <record id="ir_attachment_rule_admin_access" model="ir.rule">
        <field name="name">Admin Access to All Attachments</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- always true -->
        <field name="groups" eval="[(4, ref('base.group_system')),(4, ref('documents_file_plan.group_physical_record_registry'))]"/>
    </record>

    <record id="ir_attachment_rule_admin_access" model="ir.rule">
        <field name="name">Admin Access to All Attachments</field>
        <field name="model_id" ref="model_physical_document_submission"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- always true -->
        <field name="groups" eval="[(4, ref('base.group_system')),(4, ref('documents_file_plan.group_physical_record_registry'))]"/>
    </record>

    <!-- Rule for normal users: only see their own submissions (sender or receiver) -->
    <record id="rule_physical_submission_user" model="ir.rule">
        <field name="name">Submission: Sender Own Submissions Only</field>
        <field name="model_id" ref="model_physical_document_submission"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('sender_id', '=', user.id)]</field>
    </record>

</odoo>

