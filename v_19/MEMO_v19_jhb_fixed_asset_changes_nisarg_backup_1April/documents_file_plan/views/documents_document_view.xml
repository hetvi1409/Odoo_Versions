    <record id="documents_documents_view_list_main_inherit" model="ir.ui.view">
        <field name="name">documents.document.list</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list_main"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="folder_name" optional="hide"/>
                <field name="d_number" optional="hide"/>
                <field name="reference_month"/>
                <field name="reference_year"/>
            </xpath>
        </field>
    </record>

    <record id="documents_document_model_list_view" model="ir.ui.view">
        <field name="name">documents.document.list.fileplan</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <list create="false" multi_edit="1" decoration-info="shortcut_document_id" sample="1"
                  default_order="is_folder, create_date DESC, id DESC">
                <field name="is_favorited" widget="boolean_favorite" nolabel="1"/>
                <field name="name" required="True" readonly="False"/>
                <field name="folder_name" optional="hide"/>
                <field name="reference_month"/>
                <field name="reference_year"/>
                <field name="display_name" column_invisible="1"/>
                <field name="owner_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="sender_id" widget="many2one_avatar_user"/>
                <field name="receiver_id" widget="many2one_avatar_user"/>
                <field name="location_id"/>
                <field name="department_id"/>
                <field name="parent_folder_id" optional="show" string="Folder"/>
                <field name="folder_id" optional="show" string="Sub-Folder"/>
                <field name="access_url" column_invisible="1"/>
                <field name="partner_id" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide" options="{'color_field': 'color'}"/>
                <field name="url" optional="hide"/>
                <field name="lock_uid" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="available_embedded_actions_ids" optional="hide" widget="many2many_tags"
                       groups="base.group_user"/>
                <field name="create_date" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="file_extension" optional="hide"/>
                <field name="file_size" optional="hide"/>
                <field name="id" column_invisible="1"/>
                <field name="access_token" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
                <field name="user_permission" column_invisible="1"/>
                <field name="attachment_id" column_invisible="1"/>
                <field name="folder_id" column_invisible="1"/>
                <field name="shortcut_document_id" column_invisible="1"/>
                <field name="mimetype" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="document_view_form_new_file" model="ir.ui.view">
        <field name="name">documents.document.form</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button type="object" name="access_content" string="Access" class="oe_highlight"
                            invisible="not url"/>
                    <button type="object" name="access_content" string="Download" class="oe_highlight"
                            invisible="type != 'binary'"/>
                    <button type="object" name="toggle_lock" string="Lock" invisible="lock_uid"/>
                    <button type="object" name="toggle_lock" string="Unlock" invisible="not lock_uid"/>
                    <button type="object" name="action_unarchive" string="Restore" invisible="active"/>
                    <button type="object" name="action_submit" string="Submit" invisible="show_submit == False"/>
                    <button type="object" name="action_approve_submission" string="Approve"
                            invisible="show_approve_reject == False"/>
                    <button type="object" name="action_reject_submission" string="Reject"
                            invisible="show_approve_reject == False"/>
                    <field name="state" widget="statusbar" invisible="not active"/>
                </header>
                <sheet>
                                        <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_resource" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="not res_id or res_model in [False, 'documents.document']">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Related
                                    <br/>
                                    Record
                                </span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Moved to trash" bg_color="text-bg-danger" invisible="active"/>
                    <field name="thumbnail" nolabel="1" widget="image" class="oe_avatar"
                           options="{&quot;preview_image&quot;:&quot;thumbnail&quot;}" invisible="not thumbnail"/>
                    <div class="oe_title" aria-label="Name">
                        <h1>
                            <field name="name" class="oe_inline" placeholder="Document Name" required="True"/>
                            <i class="fa fa-lock oe_inline" title="Locked" invisible="not lock_uid"/>
                        </h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="show_approve_reject" invisible="1"/>
                    <field name="show_submit" invisible="1"/>
                    <group>
                        <group>
                            <field name="datas" string="File" filename="name" invisible="0"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="url" invisible="type != 'url'"/>
                            <field name="parent_folder_id" readonly="False" widget="documents_folder_many2one"/>
                            <field name="folder_id" readonly="False" widget="documents_folder_many2one"/>
                            <field name="sender_id"/>
                            <field name="receiver_id"/>
                            <field name="location_id"/>
                            <field name="department_id"/>
                            <field name="submission_date"/>
                        </group>
                        <group>
                            <field name="type" readonly="1" invisible="1"/>
                            <field name="create_date"/>
                            <field name="create_uid" widget="many2one_avatar_user"/>
                            <field name="lock_uid" readonly="1" invisible="not lock_uid"/>
                            <field name="reference_month"/>
                            <field name="reference_year"/>
                            <field name="d_number"/>
<!--                            <field name="umz_number"/>-->
                        </group>
                    </group>
                    <group>
                        <field name="description_1" class="oe-bordered-editor" placeholder="Description ..."/>
<!--                        <field name="description_2" class="oe-bordered-editor" placeholder="Description 2..."/>-->
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="filed_document_search_view" model="ir.ui.view">
        <field name="name">documents.document.search.view.inherit</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name" string="Name / Extension"/>
                <field name="tag_ids"/>
                <field name="owner_id"/>
                <field name="partner_id" string="Contact"/>
                <field name="index_content"/>
                <field name="create_uid" string="Created by"/>
                <field name="attachment_id" string="File"/>
                <field name="folder_id" string="Folder"/>
                <field name="reference_month" string="Month"/>
                <field name="reference_year" string="Year"/>
                <filter string="My Documents" name="my_documents_filter"
                        domain="['|', ('owner_id', '=', uid), ('partner_id.user_ids', '=', uid)]"/>
                <filter string="My Activities" name="my_activities_filter" domain="[('activity_user_id','=',uid)]"/>
                <filter string="Starred" name="my_favorites_filter" domain="[('favorited_ids', 'in', uid)]"/>
                <separator/>
                <filter string="Documents" name="pdf_doc" domain="[('type', '!=', 'folder')]"/>
                <filter string="Folders" name="pdf_doc" domain="[('type', '=', 'folder')]"/>
                <filter string="Hide shortcuts" name="no_shortcuts" domain="[('shortcut_document_id', '=', False)]"/>
                <separator/>
                <filter string="Requested Documents" name="requested_filter"
                        domain="[('type', '=', 'binary'), ('attachment_id', '=', False)]"/>
                <separator/>
                <field name="type"/>
                <group>
                    <filter string="Contact" name="filter_partner_id" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Owner" name="filter_owner_id" domain="[]" context="{'group_by': 'owner_id'}"/>
                    <filter string="Type" name="filter_type" domain="[]" context="{'group_by': 'type'}"/>
                    <filter string="Model" name="filter_res_model" domain="[]" context="{'group_by': 'res_model'}"/>
                    <filter string="Creation Date" name="filter_create_date" domain="[]"
                            context="{'group_by':'create_date'}"/>
                    <filter string="File Extension" name="filter_file_extension" domain="[]"
                            context="{'group_by': 'file_extension'}"/>
                    <filter string="Month" name="filter_reference_month" domain="[]"
                            context="{'group_by': 'reference_month'}"/>
                    <filter string="Year" name="filter_reference_year" domain="[]"
                            context="{'group_by': 'reference_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="document_submission_action" model="ir.actions.act_window">
        <field name="name">Filed Documents</field>
        <field name="path">documents_submission</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="domain">[('type', '=', 'binary')]</field>
        <field name="context">{'default_type': 'binary'}</field>
        <field name="search_view_id" ref="documents_file_plan.filed_document_search_view"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('documents_file_plan.documents_document_model_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('documents_file_plan.document_view_form_new_file')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('documents.document_view_kanban')}),
            (0, 0, {'view_mode': 'activity', 'view_id': ref('documents.documents_view_activity')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload <span class="fw-normal">a file or</span> drag
                <span class="fw-normal">it here.</span>
            </p>
        </field>
    </record>

    <record id="documents_request_form_view_inherit" model="ir.ui.view">
        <field name="name">documents.request_wizard.form</field>
        <field name="model">documents.request_wizard</field>
        <field name="inherit_id" ref="documents.documents_request_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button type="object" name="request_document" string="Request" class="oe_highlight"/>
                </header>
            </xpath>
<!--            <field name="tag_ids" position="after">-->
<!--                <field name="department_id"/>-->
<!--                <field name="location_id"/>-->
<!--                <field name="d_number"/>-->
<!--                <field name="umz_number"/>-->
<!--                <field name="requester_id"/>-->
<!--                <field name="request_date"/>-->
<!--            </field>-->
        </field>
    </record>

    <record id="documents_request_list_view" model="ir.ui.view">
        <field name="name">documents.request_wizard.list</field>
        <field name="model">documents.request_wizard</field>
        <field name="arch" type="xml">
            <list string="Work Location">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="requestee_id" string="Request To"/>
                <field name="folder_id"/>
                <field name="department_id"/>
                <field name="location_id"/>
            </list>
        </field>
    </record>

    <record id="view_document_folder_tree_hierarchy" model="ir.ui.view">
        <field name="name">documents.document.folder.tree.hierarchy</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <list class="documents_list" string="Folders" expand="0" default_order="folder_id, parent_folder_id,name">
                <field name="name"/>
                <field name="folder_id"/>
            </list>
        </field>
    </record>
    <record id="documents_view_list" model="ir.ui.view">
        <field name="name">documents list</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="view_document_folder_tree_hierarchy"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">documents_list</attribute>
            </xpath>
        </field>
    </record>


    <record model="ir.actions.act_window" id="action_request_wizard">
        <field name="name">Request a file</field>
        <field name="res_model">documents.request_wizard</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'form_view_ref': 'documents.documents_request_form_view'}</field>
    </record>

</odoo>
