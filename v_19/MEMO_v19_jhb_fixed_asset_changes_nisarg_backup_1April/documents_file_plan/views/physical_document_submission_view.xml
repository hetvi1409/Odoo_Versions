<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="physical_document_submission_list_view" model="ir.ui.view">
        <field name="name">physical.document.submission.list.fileplan</field>
        <field name="model">physical.document.submission</field>
        <field name="arch" type="xml">
            <list create="true" multi_edit="1" sample="1" default_order="create_date DESC, id DESC">
                <field name="name" required="True" readonly="False"/>
                <field name="reference_month"/>
                <field name="reference_year"/>
                <field name="sender_id" widget="many2one_avatar_user" optional="show"/>
                <field name="create_date" optional="hide"/>
                <field name="write_date" optional="show"/>
                <field name="id" column_invisible="1"/>
                <field name="state"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="physical_document_submission_view_form_new_file" model="ir.ui.view">
        <field name="name">physical.document.submission.form</field>
        <field name="model">physical.document.submission</field>
        <field name="arch" type="xml">
            <form create="true">
                <header>
                    <button type="object" name="action_submit" string="Submit" invisible="show_submit == False"/>
                    <button type="object"
                            name="action_request_file"
                            string="Request File"
                            class="btn-primary"
                            invisible="state != 'filed' or sender_id != uid"/>
                    <button name="action_mark_collected"
                            type="object"
                            string="Mark as Collected"
                            class="btn-primary"
                            invisible="state != 'requested_document'"/>
                    <button name="action_mark_not_found"
                            type="object"
                            string="Mark as Not Found"
                            class="btn-danger"
                            invisible="state != 'requested_document'"/>
                    <button type="object" name="action_approve_submission" string="Approve"
                            invisible="show_approve_reject == False"/>
                    <button type="object" name="action_reject_submission" string="Reject"
                            invisible="show_approve_reject == False"/>
                    <button type="object" name="action_filed" string="Filed"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,filed,requested_document,collected"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>

                    <!--                    <div class="oe_button_box" name="button_box">-->
                    <!--                        -->
                    <!--                    </div>-->
                    <widget name="web_ribbon" title="Collected"
                            bg_color="bg-success"
                            invisible="state != 'collected'"/>
                    <widget name="web_ribbon" title="Not Found"
                            bg_color="bg-danger"
                            invisible="state != 'not_found'"/>
                    <widget name="web_ribbon" title="At Warehouse"
                            bg_color="bg-success"/>
                    <widget name="web_ribbon" title="At Warehouse"
                            bg_color="bg-success"
                            invisible="state != 'in_transit'"/>
                    <div class="oe_title" aria-label="Name">
                        <h1>
                            <field name="name" class="oe_inline" placeholder="Document Name" required="True"
                                   readonly="state in ['approved','filed','rejected']"/>
                        </h1>
                    </div>
                    <field name="show_approve_reject" invisible="1"/>
                    <field name="show_submit" invisible="1"/>
                    <group>
                        <group>
                            <field name="sender_id" readonly="state in ['approved','filed','rejected']"/>
                            <field name="receiver_id" readonly="state in ['approved','filed','rejected']"/>
<!--                            <field name="document_type" invisible="uid != receiver_id"/>-->
                            <field name="location_id"
                                   groups="physical_document_records_manage.group_physical_record_custom"
                                   readonly="state in ['approved','filed','rejected']"
                                   invisible="uid != receiver_id"/>
                            <field name="department_id" context="{'hierarchical_naming':False}"
                                   options="{'no_open': True, 'no_create': True}"
                                   readonly="state in ['approved','filed','rejected']"/>
                            <field name="sub_department_id" domain="[('parent_id', '=', department_id)]"
                                   options="{'no_open': True, 'no_create': True}"
                                   context="{'hierarchical_naming':False}"
                                   readonly="state in ['approved','filed','rejected']"/>
                            <field name="submission_date" readonly="state in ['approved','filed','rejected']"/>
                        </group>
                        <group>
                            <field name="create_date" invisible="1"/>
                            <field name="create_uid" widget="many2one_avatar_user" invisible="1"/>
                            <field name="reference_month" readonly="state in ['approved','filed','rejected']"/>
                            <field name="reference_year" readonly="state in ['approved','filed','rejected']"/>
                            <!--                            <field name="d_number"/>-->
                            <!--                            <field name="umz_number"/>-->
                            <field name="breadcrumbs_text" readonly="1"/>
                            <field name="folder_id" readonly="1" widget="documents_folder_many2one"/>
                            <button type="object"
                                    class="oe_stat_button btn-primary"
                                    name="action_open_department_folders"
                                    icon="fa-folder"
                                    string="Upload Files/Folders">
                            </button>
                        </group>
                    </group>
                    <group>
                        <field name="description_1" class="oe-bordered-editor" placeholder="Description 1..."
                               readonly="state in ['approved','filed','rejected']"/>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <field name="main_document_ids" widget="kanban" readonly="1">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click">
                                                <field name="mimetype"/>
                                                <field name="datas" widget="image" class="oe_avatar"/>
                                                <div>
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Attachments" invisible="1">
                            <field name="attachment_ids" widget="kanban" readonly="1">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click">
                                                <field name="mimetype"/>
                                                <field name="datas" widget="image" class="oe_avatar"/>
                                                <div>
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Document Preview" invisible="1">
                            <group>
                                <field name="main_document_id"/>
                            </group>
                            <field name="document" widget="pdf_viewer" filename="document_id.name"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="physical_document_submission_view_search_inherit" model="ir.ui.view">
        <field name="name">physical.document.submission.search.view.inherit</field>
        <field name="model">physical.document.submission</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name" string="Name / Extension"/>
                <field name="sender_id"/>
                <field name="physical_document_ids" string="File"/>
                <field name="reference_month" string="Month"/>
                <field name="reference_year" string="Year"/>
                <field name="create_uid" string="Created by"/>
                <filter string="My Documents" name="my_documents_filter"
                        domain="['|', ('sender_id', '=', uid), ('create_uid', '=', uid)]"/>
                <group>
                    <filter string="Owner" name="filter_sender_id" domain="[]" context="{'group_by': 'sender_id'}"/>
                    <filter string="Creation Date" name="filter_create_date" domain="[]"
                            context="{'group_by':'create_date'}"/>
                    <filter string="Month" name="filter_reference_month" domain="[]"
                            context="{'group_by': 'reference_month'}"/>
                    <filter string="Year" name="filter_reference_year" domain="[]"
                            context="{'group_by': 'reference_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="physical_document_submission_action" model="ir.actions.act_window">
        <field name="name">File Submission</field>
        <field name="path">physical_documents_submission</field>
        <field name="res_model">physical.document.submission</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('documents_file_plan.physical_document_submission_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('documents_file_plan.physical_document_submission_view_form_new_file')})]"/>
    </record>

</odoo>
