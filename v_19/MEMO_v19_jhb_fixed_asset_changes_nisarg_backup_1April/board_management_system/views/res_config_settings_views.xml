<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherent</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="calendar.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='calendar']" position="inside">
                <block title="Agenda Settings" name="agenda">
                    <setting string="Section In Agenda"
                             help="Add More Section To Agenda"
                             id="agenda_calendar_setting">
                        <field name="need_section"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>