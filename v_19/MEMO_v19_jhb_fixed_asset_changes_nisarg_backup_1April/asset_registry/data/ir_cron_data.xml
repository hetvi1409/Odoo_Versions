    <record id="account_asset_jmc_number_change" model="ir.cron">
        <field name="name">Asset: JMC Number</field>
        <field name="model_id" ref="model_account_asset"/>
        <field name="state">code</field>
        <field name="code">model.action_jmc_number_change()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
