<!--                Click to create a new Asset Type.-->
<!--            </p>-->
<!--        </field>-->
<!--    </record>-->
    <menuitem parent="account.account_transactions_menu"
              id="menu_asset_category_action_" name="Asset Category"
              action="asset_category_action" sequence="101"/>


    <record id="account.menu_board_journal_1" model="ir.ui.menu">
            <field name="parent_id" ref="account.account_transactions_menu"/>
    </record>

