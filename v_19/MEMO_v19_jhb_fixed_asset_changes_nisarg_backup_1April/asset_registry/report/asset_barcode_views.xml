<odoo>

    <!-- report action -->
    <record id="action_asset_barcode" model="ir.actions.report">
        <field name="name">Asset Brcode</field>
        <field name="model">account.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">asset_registry.report_barcode</field>
        <field name="report_file">asset_registry.report_barcode</field>
        <field name="print_report_name">Asset Barcode(PDF)</field>
        <field name="binding_model_id" ref="account_asset.model_account_asset"/>
        <field name="binding_type">report</field>
    </record>

    <!-- template for the asset barcode -->
    <template id="report_barcode">
       <t t-call="web.html_container">
           <t t-foreach="docs" t-as="doc">
               <t t-call="web.external_layout">
                   <div class="page">
                       <div class="oe_structure"/>
                       <div>
                           <div class="col-5">
                               <h2>
                                   <span t-field="doc.name"/>
                               </h2>
                               <br/>
                               <span style="margin-left:-60px;">
                                   <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', doc.alternative_ref, 600, 100)"
                                        style="width:350px;height:60px;"/>
                               </span>
                               <br/>
                               <span t-field="doc.alternative_ref"/>
                           </div>
                       </div>
                   </div>
               </t>
           </t>
       </t>
   </template>
</odoo>