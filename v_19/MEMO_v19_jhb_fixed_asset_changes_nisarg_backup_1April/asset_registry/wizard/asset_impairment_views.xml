<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="asset_impairment_view_form" model="ir.ui.view">
        <field name="name">asset.impairment.view.form</field>
        <field name="model">asset.impairment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="asset_id" readonly="1" invisible="1"/>
                        <field name="asset_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="asset_id_no"/>
                    </group>
                </group>
                <group string="External sources of information">
                    <group>
                        <field name="cessation"/>
                    </group>
                    <group>
                        <field name="long_term_change"/>
                    </group>
                </group>
                <group string="Internal sources of information">
                    <group>
                        <field name="evidence"/>
                    </group>
                    <group>
                        <field name="evidence_document_ids"
                               widget="many2many_binary" invisible="evidence != 'yes'"/>
                    </group>
                    <group>
                        <field name="significant_long_term_change"/>
                        <field name="evidence_internal_report"/>
                    </group>
                    <group>
                        <field name="decision"/>
                        <field name="evidence_internal_report_document_ids"
                               widget="many2many_binary" invisible="evidence_internal_report != 'yes'"/>
                        <field name="is_service_amount" invisible="True"/>
                    </group>
                </group>
                <group string="ESTIMATE RECOVERABLE SERVICE AMOUNT" invisible="is_service_amount == False">
                    <field name="recoverable_service_amount" readonly="is_service_amount == True"/>
                    <field name="currency_id" invisible="True"/>
                </group>
                <group string="Reason for impairment">
                    <field name="reason_impairment"/>
                </group>
                <footer>
                    <button name="action_asset_impairment" string="Confirm"
                            type="object"
                            default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="asset_impairment_action" model="ir.actions.act_window">
        <field name="name">Asset Impairment</field>
        <field name="res_model">asset.impairment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_impairment_view_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_asset_impairment"
              name="Asset Impairment"
              action="asset_impairment_action"
              parent="account.account_transactions_menu"/>
</odoo>