<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="job_card_decline_view_form" model="ir.ui.view">
        <field name="name">job.card.decline.form.view</field>
        <field name="model">job.card.decline</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Decline Reason">
                        <field name="decline_id" readonly="1" invisible="1"/>
                        <field name="reason" nolable="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_decline"
                            string="Decline"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>