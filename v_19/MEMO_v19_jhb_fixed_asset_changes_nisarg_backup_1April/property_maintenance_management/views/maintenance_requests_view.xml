<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="maintenance_request_view_form_inherit_property" model="ir.ui.view">
        <field name="name">maintenance.request.view.form.inherit.property</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='request_date']" position="before">
                <field name="property_id" options="{'no_open': False, 'no_create': True}" readonly="0" required="1"
                       force_save="1"/>
                <field name="jmc_number" readonly="1" required="0" force_save="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="maintenance_documents" string="Documents">
                        <field name="maintenance_request_documents_ids" mode="list,form"
                               context="{'default_jmc_property_id': property_id}">
                            <list editable="bottom">
                                <field name="name" readonly="1" required="0"/>
                                <field name="attachment_id" string="Upload Document" domain="[('id', '=', False)]"
                                       options="{'no_open': True, 'no_create': False}" readonly="0" required="1"
                                       force_save="1"/>
                                <field name="folder_id" string="File Plan"
                                       options="{'no_open': True, 'no_create': True}" readonly="0" required="1"
                                       force_save="1"/>
                                <field name="jmc_property_id" options="{'no_open': True, 'no_create': True}"
                                       readonly="1" required="1" force_save="1"/>
                                <button name="action_preview_document" type="object" string="Preview"
                                        class="btn-primary" invisible="attachment_id == False"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>