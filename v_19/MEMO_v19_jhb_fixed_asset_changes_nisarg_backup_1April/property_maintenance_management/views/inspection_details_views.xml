<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inspection_details_view_form" model="ir.ui.view">
        <field name="name">inspection.details.view.form</field>
        <field name="model">inspection.details</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close_inspection"
                            type="object"
                            string="Close"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <field name="name" class="fw-bold" readonly="1"/>
                    <group string="Property Details">
                        <group>
                            <group>
                                <field name="property_name" readonly="1"/>
                                <field name="jmc_number" readonly="1"/>
                            </group>
                            <group>
                                <field name="region_id" readonly="1"/>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="inspected_detail"/>
                            </group>
                        </page>
                        <page string="Documents">
                            <group>
                                <field name="inspected_document_ids"
                                       widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Upload Photos">
                            <group>
                                <group>
                                    <field name="image_1" widget="image"/>
                                    <field name="image_2" widget="image"/>
                                    <field name="image_3" widget="image"/>
                                </group>
                                <group>
                                    <field name="image_4" widget="image"/>
                                    <field name="image_5" widget="image"/>
                                    <field name="image_6" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>
    <record id="inspection_details_view_tree" model="ir.ui.view">
        <field name="name">inspection.details.view.list</field>
        <field name="model">inspection.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

</odoo>