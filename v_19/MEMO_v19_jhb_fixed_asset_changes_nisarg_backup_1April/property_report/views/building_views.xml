<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="building_base_pages_form"
            model="ir.ui.view">
        <field name="name">building.list.view</field>
        <field name="model">building</field>
        <field name="inherit_id"
               ref="itsys_real_estate.building_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="export_property"
                            string="Export Property"
                            type="object"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>