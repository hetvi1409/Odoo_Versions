<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="building_model_view" model="ir.ui.view">
        <field name="name">building.model.view.form</field>
        <field name="model">building</field>
        <field name="inherit_id" ref="itsys_real_estate.building_base_pages_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attach_line']/list/field[@name='file']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='attach_line']/list/field[@name='file']" position="after">
                <button name="open_document_wizard" string="UPLOAD YOUR FILES" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>

</odoo>
