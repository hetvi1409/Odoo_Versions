<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_classification_view_order_form" model="ir.ui.view">
        <field name="name">document.classification.form</field>
        <field name="model">document.classification</field>
        <field name="arch" type="xml">
            <form string="Document">
                <group>
                    <field name="classification_id"/>
                </group>
                <group>
                    <field name="attachment_filename" invisible="1"/>
                    <field name="attachment" widget="binary"
                           filename="attachment_filename" readonly="False"/>
                    <field name="jmc_no"/>
                    <field name="regions_id" readonly="1"/>
                    <field name="doc_s" invisible="1"/>
                </group>
                <footer>
                    <button name="doc_upload" type="object"
                            id="reject_budget_finance" string="UPLOAD"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>