<odoo>
<record id="view_bid_award_form" model="ir.ui.view">
    <field name="name">bid.award.form</field>
    <field name="model">bid.award</field>
    <field name="arch" type="xml">
        <form string="Bid Award">
            <sheet>
                <group>
                    <group>
                        <field name="bid_id" readonly="1"/>
                        <field name="vendor_id" readonly="1"/>
                        <field name="subject"/>
                        <field name="body"/>
                        <field name="attachment_ids" widget="many2many_binary"
                               string="Attach a file" nolabel="1" colspan="2"/>

                    </group>
                    <!--                    <field name="attachment_id"/>-->
                </group>
                <footer>
                    <button string="Send Email" type="object" class="btn-primary" name="action_send_award_letter"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </sheet>
        </form>
    </field>
</record>

<record id="action_bid_award" model="ir.actions.act_window">
    <field name="name">Bid Award</field>
    <field name="res_model">bid.award</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
