<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View for Tender Document -->
    <record id="view_tender_document_form" model="ir.ui.view">
        <field name="name">tender.document.form</field>
        <field name="model">tender.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="file"/>
                        <field name="tender_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
<!--    Form view for bid document-->
    <record id="view_bid_document_form" model="ir.ui.view">
        <field name="name">bid.document.form</field>
        <field name="model">tender.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="file"/>
                        <field name="bid_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Tree Views -->
    <record id="view_tender_document_tree" model="ir.ui.view">
        <field name="name">tender.document.list</field>
        <field name="model">tender.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tender_id"/>
                <field name="bid_id"/>
            </list>
        </field>
    </record>
    <record id="action_tender_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">tender.document</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_tender_documents" name="Documents" sequence="3"
              parent="menu_tender_root" action="action_tender_document"/>

</odoo>
