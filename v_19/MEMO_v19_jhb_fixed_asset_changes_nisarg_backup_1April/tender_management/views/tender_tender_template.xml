                    <div class="container">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link active" href="/tenders">HOME</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/tenders-rfqs">REQUEST FOR QUOTATIONS</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/tenders-rfps">REQUEST FOR PROPOSALS</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/bid-status">BID STATUS</a>
                            </li>
                            <li class="nav-item">
