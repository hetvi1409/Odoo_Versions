<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="seta_dashboard.dashboard_page" name="Dashboard">
        <head>
            <!-- Odoo -->
            <link rel="stylesheet" type="text/css" href="/seta_dashboard/static/lib/jquery.ui/jquery-ui.css"/>
            <link rel="stylesheet" type="text/css" href="/web/static/src/libs/fontawesome/css/font-awesome.css"/>
            <script type="text/javascript" src="/web/static/lib/jquery/jquery.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/jquery.ui/jquery-ui.js"></script>
            
            <!-- CSS -->
            <!-- Library -->
            <link rel="stylesheet" href="/seta_dashboard/static/lib/select2/select2.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/select2-bootstrap-css/select2-bootstrap.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/gridstack/gridstack.min.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/grid/mermaid.min.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/google/icon.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/bootstrap-datepicker/css/bootstrap-datepicker3.standalone.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/bootstrap-datepicker/css/bootstrap-datepicker.standalone.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/bootstrap-datepicker/css/bootstrap-datepicker3.min.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/lib/bootstrap-datepicker/css/bootstrap-datepicker.min.css"/>

            <link rel="stylesheet" href="/seta_dashboard/static/src/css/font.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_bootstrap.min.css"/>

            <!-- General -->
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/font.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_layout.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_dialog.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_button.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_select.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_accordion.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_chart.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/general/seta_replace.css"/>
            <!-- Component -->
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_view.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_view_table.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_view_dashboard.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_config_analysis.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_config_dashboard.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_select_analysis.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_select_metric.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_select_dimension.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_select_sort.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_select_filter_temp.css"/>
            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_select_filter.css"/>

            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/main/seta_description_page.css"/>

            <link rel="stylesheet" href="/seta_dashboard/static/src/css/component/toggle-switchy.css"/>
            <style>
                .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-bottom table {
                    font-size: 13px !important;
                }
                .select2-drop input.select2-input{
                    font-size: 13px !important;
                }
                body {
                    margin: 0;
                    font-family: "Roboto", "Odoo Unicode Support Noto", sans-serif;
                    font-size: 1.08333333rem;
                    font-weight: 400;
                    line-height: 1.5;
                    color: #666666;
                    text-align: left;
                    background-color: #8f8f8f;
                }
                .seta_view_dashboard_grid .seta_dashboard_block_title.dropdown-toggle::after {
                    display: none;
                }
                *, *::before, *::after {
                    box-sizing: border-box;
                }
                .seta_config_dashboard .seta_title_container {
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: flex-start;
                }
                .seta_config_dashboard .seta_title_container .seta_title{
                    font-size: 16px;
                    font-weight: 600;
                }
                .seta_dashboard_filter .seta_select2 .select2-choices {
                    align-items: center;
                }
                .seta_view .dropdown-menu {
                    left: unset;
                    right: 0px;
                }
            </style>
            <!-- JS -->
            <!-- Library -->
            <script type="text/javascript" src="/seta_dashboard/static/lib/jquery.ui/jquery-ui.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/ace-1.3.1/ace.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/ace-1.3.1/mode-javascript.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/ace-1.3.1/worker-javascript.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/ace-1.3.1/theme-chrome.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/core.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/charts.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/maps.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/regression.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/geodata/indonesiaLow.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/geodata/usaLow.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/geodata/worldLow.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/geodata/countries2.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/themes/animated.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/amcharts/themes/frozen.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/gridstack/gridstack-h5.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/sweetalert/sweetalert.min.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/grid/gridjs.umd.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/select2/select2.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/moment/moment.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/bootstrap-datepicker/js/bootstrap-datepicker-conflict.js"></script>

            <!-- Component -->
            <script type="text/javascript" src="/seta_dashboard/static/src/js/component/frontend/chart/amcharts_theme.js"></script>
            <script type="text/javascript" src="/seta_dashboard_themes_extra/static/src/js/component/chart/amcharts_theme_extra.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/src/js/component/frontend/chart/amcharts_component_old.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/src/js/component/frontend/chart/amcharts_component.js"></script>

            <!-- capture / Export Page -->
            <script type="text/javascript" src="/seta_dashboard/static/lib/jspdf/html2canvas.min.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/lib/jspdf/jspdf.umd.min.js"></script>
            <script type="text/javascript" src="/seta_dashboard/static/src/js/component/frontend/seta_dashboard.js"></script>
        </head>
        <input id="access_token" type="hidden" t-att-value="access_token"/>
        <input id="dashboard_id" type="hidden" t-att-value="dashboard_id"/>
        <div class="seta_view">
            <div class="seta_config_dashboard row no-gutters">
                <div class="col-lg-3 seta_title_container seta_p20">
                    <div>
                        <div class="seta_title seta_block_left seta_title_dashboard" style="cursor: unset;">
                             <t t-esc="dashboard_name"/>
                        </div>
                    </div>
                    <div class="seta_subtitle"/>
                </div>
                <div class="col-lg-9 seta_config_dashboard_button_container seta_p20_p30" style="display: flex;align-items: center;justify-content: flex-end; font-size:0.875em" >
                    <div class="flex-row">
                        <div class="seta_dashboard_filter" style="display: none;" title="Filter Date Range" id="seta_dashboard_filter_date_range" data-type="date_range">
                            <div class="seta_dashboard_filter_title dropdown seta_dropdown">
                                <span class="material-icons-outlined" t-esc="'date_range'"/>
                            </div>
                            <div class="seta_dashboard_filter_content">
                                <input type="text" placeholder="Date From" class="seta_datepicker" id="seta_date_from"/>
                                <input type="text" placeholder="Date To" class="seta_datepicker" id="seta_date_to"/>
                            </div>
                            <div style="clear:both;"/>
                        </div>
                        <div class="seta_dashboard_filter" title="Filter Date Format" id="seta_dashboard_filter_date_format" data-type="date_format">
                            <div class="seta_dashboard_filter_title dropdown seta_dropdown">
                                <span class="material-icons-outlined" t-esc="'today'"/>
                            </div>
                            <div class="seta_dashboard_filter_content">
                                <div class="seta_dropdown seta_block_left seta_inline dropdown">
                                    <button class="seta_m0 seta_py0 seta_no_border dropdown-toggle" data-toggle="dropdown" type="button">
                                        Select Date
                                    </button>
                                    <div class="dropdown-menu" style="left: -17px;">
                                        <a class="dropdown-item seta_select_date_format" data-date_format="">All (No Filters)</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="today">Today</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="this_week">This Week</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="this_month">This Month</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="this_year">This Year</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="mtd">Month to Date</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="ytd">Year to Date</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_week">Last Week</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_month">Last Month</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_two_months">Last 2 Months</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_three_months">Last 3 Months</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_year">Last Year</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_10">Last 10 Days</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_30">Last 30 Days</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="last_60">Last 60 Days</a>
                                        <a class="dropdown-item seta_select_date_format" data-date_format="custom">Custom Range</a>
                                    </div>
                                </div>
                            </div>
                            <div style="clear:both;"/>
                        </div>
                        <div id="seta_dashboard_search_container" class="seta_dashboard_filter" style="display:none;">
                            <div class="seta_dashboard_filter_title dropdown seta_dropdown">
                                <span class="material-icons-outlined" t-esc="'memory'"/>
                            </div>
                            <div class="seta_dashboard_filter_content">
                                
                            </div>
                        </div>
                        <div id="seta_dynamic_filter_container">
                        </div>

                        <div class="seta_dropdown dropdown seta_inline">
                            <div class="seta_btn seta_btn_wlg dropdown-toggle px-2" data-toggle="dropdown" title="Select Themes">
                                <span class="material-icons-outlined seta_btn_icon_left" t-esc="'palette'"/>
                            </div>
                            <div class="dropdown-menu seta_select_theme_container" aria-labelledby="dropdownMenuButton"></div>
                        </div>

                        <div id="seta_export_capture" class="seta_btn seta_btn_wlg px-2" title="Capture Dashboard">
                            <span class="material-icons seta_btn_icon" t-esc="'photo_camera'"/>
                        </div>
                        <div id="seta_export_capture_loading" style="display:none; cursor:progress" class="seta_btn seta_btn_wlg active px-2" title="Capturing..">
                            <span class="material-icons seta_btn_icon seta_rotate" t-esc="'rotate_right'"/>
                        </div>
                    </div>
                </div>
                <div style="clear:both;"/>
            </div>
            <div class="seta_view_dashboard">
                <div class="seta_view_dashboard_grid grid-stack"></div>
            </div>
        </div>
    </template>
</odoo>
