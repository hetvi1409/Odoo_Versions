<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_menu_legal"
              name="Portal layout : Legal"
              inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'legal' or legal"
                t-attf-class="breadcrumb-item #{'active' if not legal else ''}">
                <a t-if="legal"
                   t-attf-href="/my/legal">
                    Legal
                </a>
            </li>
        </xpath>
    </template>

    <template id="portal_my_legal" name="Legal"
              customize_show="True" inherit_id="portal.portal_my_home"
              priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div id="portal_vendor_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Legal</t>
                    <t t-set="url" t-value="'/my/legal'"/>
                    <t t-set="placeholder_count"
                       t-value="'legal_count'"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="my_legal" name="Legal">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Legal</t>
            </t>
            <t t-if="not legal">
                <p>There are currently no legals for your account.
                </p>
            </t>
            <t t-if="legal" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Matter #</th>
                        <th>Client</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Lawyer</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-foreach="legal" t-as="res">
                        <tr>
                            <td>
                                <a t-attf-href="/legal_details_portal/#{res.id}">
                                    <t t-out="res.name"/>
                                </a>
                            </td>
                            <td >
                                <span t-field="res.partner_id.name"/>
                            </td>
                            <td >
                                <span t-field="res.date_start"/>
                            </td>
                            <td >
                                <span t-field="res.date"/>
                            </td>
                            <td >
                                <span t-field="res.user_id.name"/>
                            </td>
                            <td class="text-end">
                                <span t-field="res.state"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

