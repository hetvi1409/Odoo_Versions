<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_menu_enquiry_assessment"
              name="Portal layout : Assessment"
              inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'enquiry_assessment' or enquiry_assessment"
                t-attf-class="breadcrumb-item #{'active' if not enquiry_assessment else ''}">
                <a t-if="enquiry_assessment"
                   t-attf-href="/my/enquiry_assessment">
                    Assessment
                </a>
            </li>
        </xpath>
    </template>

    <template id="portal_my_enquiry_assessment" name="Assessment"
              customize_show="True" inherit_id="portal.portal_my_home"
              priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div id="portal_vendor_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Assessment</t>
                    <t t-set="url" t-value="'/my/enquiry_assessment'"/>
                    <t t-set="placeholder_count"
                       t-value="'enquiry_assessment_count'"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="my_enquiry_assessment" name="Assessment">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Assessment</t>
            </t>
            <t t-if="not enquiry_assessment">
                <p>There are currently no assessment for your account.
                </p>
            </t>
            <t t-if="enquiry_assessment" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Assessment #</th>
                        <th>Enquiry</th>
                        <th>Property</th>
                        <th>JMC Number</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-foreach="enquiry_assessment" t-as="res">
                        <tr>
                            <td>
                                <a t-attf-href="/enquiry_assessment_details_portal/#{res.id}">
                                    <t t-out="res.name"/>
                                </a>
                            </td>
                            <td >
                                <span t-field="res.enquiry_id.name"/>
                            </td>
                            <td >
                                <span t-field="res.property_id.name"/>
                            </td>
                            <td >
                                <span t-field="res.jmc_number"/>
                            </td>
                            <td class="text-end">
                                <span t-field="res.state"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

