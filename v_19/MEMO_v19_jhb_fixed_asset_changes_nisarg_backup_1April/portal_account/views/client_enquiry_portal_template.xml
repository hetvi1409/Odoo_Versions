<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_menu_client_enquiry"
              name="Portal layout : Enquiry"
              inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'client_enquiry' or client_enquiry"
                t-attf-class="breadcrumb-item #{'active' if not client_enquiry else ''}">
                <a t-if="client_enquiry"
                   t-attf-href="/my/client_enquiry">
                    Enquiry
                </a>
            </li>
        </xpath>
    </template>

    <template id="portal_my_client_enquiry" name="Enquiry"
              customize_show="True" inherit_id="portal.portal_my_home"
              priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div id="portal_vendor_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Enquiry</t>
                    <t t-set="url" t-value="'/my/client_enquiry'"/>
                    <t t-set="placeholder_count"
                       t-value="'client_enquiry_count'"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="my_client_enquiry" name="Enquiry">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Enquiry</t>
            </t>
            <t t-if="not client_enquiry">
                <p>There are currently no enquiries for your account.
                </p>
            </t>
            <t t-if="client_enquiry" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Enquiry #</th>
                        <th>type</th>
                        <th>Channel</th>
                        <th>Assessment</th>
                        <th>Assessment Status</th>
<!--                        <th class="text-end">Status</th>-->
                    </tr>
                </thead>

                <tbody>
                    <t t-foreach="client_enquiry" t-as="res">
                        <tr>
                            <td>
                                <a t-attf-href="/client_enquiry_details_portal/#{res.id}">
                                    <t t-out="res.name"/>
                                </a>
                            </td>
                            <td >
                                <span t-field="res.type"/>
                            </td>
                            <td >
                                <span t-field="res.team_id.name"/>
                            </td>
                            <td >
                                <span t-field="res.assessment_id.name"/>
                            </td>
                            <td >
                                <span t-field="res.assessment_state"/>
                            </td>
<!--                            <td class="text-end">-->
<!--                                <span t-field="res.state"/>-->
<!--                            </td>-->
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

