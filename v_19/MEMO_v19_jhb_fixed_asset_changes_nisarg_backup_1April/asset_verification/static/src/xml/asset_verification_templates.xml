<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="asset_verification.AssetVerification">
        <div class="o_asset_verification_container o_home_menu_background o_stock_barcode_main_menu_container">
            <div class="o_asset_verification position-relative o_stock_barcode_main_menu">
                <h1 class="mb-4">Asset Verification</h1>

                <!-- Verification Job Selection Field -->
                <div class="mb-3">
                    <label for="verificationJobSelection">Select Verification Job:</label>
                    <select id="verificationJobSelection" class="form-control" t-on-change="_onJobSelectionChange">
                        <option value="">Select a job...</option>
                        <t t-foreach="state.jobs" t-as="job" t-key="job_index">
                            <option t-att-value="job.id" t-esc="job.name"/>
                        </t>
                    </select>
                </div>

                <div class="o_barcode_container position-relative d-inline-block mt-4 mb-5">
                    <input
                        type="text"
                        id="oe_barcode_id"
                        class="form-control oe_barcode_value"
                        t-model="state.barcode"
                        t-on-keypress="_onKeypress"
                        t-on-change="_onChange"
                        placeholder="Scan or enter barcode"
                        t-att-autofocus="'autofocus'"
                    />
                    <img
                        src="/barcodes/static/img/barcode.png"
                        alt="Barcode"
                        class="img-fluid mb-1 mt-1"
                    />
                    <span class="o_barcode_laser"/>
                </div>

                <ul class="text-left mb-4 pl-4">
                    <li>Use <b>Tap to Scan</b> to scan the asset using the camera scanner.</li>
                    <li>Use a <b>barcode scanner</b> to directly scan the asset.</li>
                </ul>

                <button class="btn btn-primary o_mobile_barcode button_asset o_stock_mobile_barcode button_asset" t-on-click="openMobileScanner">
                    <i class="fa fa-camera"/> Tap to Scan
                </button>

                <button class="btn btn-primary button_job" id="openJobButton" style="display: none;" t-on-click="openSelectedJob">
                    <i class="fa fa-folder-open"/> Open Job
                </button>
            </div>
        </div>
    </t>
</templates>

