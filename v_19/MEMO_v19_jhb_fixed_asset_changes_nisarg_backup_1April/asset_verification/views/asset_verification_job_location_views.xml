<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<record id="action_asset_verification_job_location" model="ir.actions.act_window">
        <field name="name">Asset Verification Job Location</field>
        <field name="res_model">asset.verification.job.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add a new Asset Verification Job Location.
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_asset_verification_job_location_list" model="ir.ui.view">
        <field name="name">asset.verification.job.location.list</field>
        <field name="model">asset.verification.job.location</field>
        <field name="arch" type="xml">
            <list string="Asset Verification Job Location">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_asset_verification_job_location_form" model="ir.ui.view">
        <field name="name">asset.verification.job.location.form</field>
        <field name="model">asset.verification.job.location</field>
        <field name="arch" type="xml">
            <form string="Asset Verification Job Location">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="code"/>
                        <field name="building_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>