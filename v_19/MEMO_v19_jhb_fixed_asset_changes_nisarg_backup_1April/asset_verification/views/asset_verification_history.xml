<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_account_asset_verification_history" model="ir.ui.view">
            <field name="name">asset.verification.history.view.form</field>
            <field name="model">asset.verification.history</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Asset Verification" name="verification">
                            <group>
                                <field name="is_verified"/>
                                <field name="parent_barcode"/>
                                 <field name="past_year"/>
                                <field name="this_year"/>
                                <!-- <field name="comments"/> -->
                                <field name="condition" widget="many2many_tags"/>
                                <field name="date_verification"/>
                                <field name="asset_verification_user_id"/>
                                <field name="location_id"/>
                            </group>
                            <group>
                                <field name="major_group_description"/>
                                <field name="current_condition_this_year"/>
                                <field name="name_installation"/>
                                <field name="asset_make_type"/>
                                <field name="barcode_past_year"/>
                                <field name="current_condition_past_year"/>
                                <field name="asset_component"/>
                                <field name="asset_size"/>
                                <field name="estimated_useful_life_month"/>
                                <field name="inspector"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="Images">
                                <group>
                                    <field name="image_ids" nolabel="1">
                                        <list>
                                            <field name="image" widget="image" options="{'size': [250, 250]}" />
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list view -->
        <record id="view_account_asset_verification_history_list" model="ir.ui.view">
            <field name="name">asset.verification.history.view.list</field>
            <field name="model">asset.verification.history</field>
            <field name="arch" type="xml">
                <list string="Asset Verification History">
                    <field name="is_verified"/>
                    <field name="parent_barcode"/>
                    <field name="past_year"/>
                    <field name="this_year"/>
                    <field name="condition" widget="many2many_tags"/>
                    <field name="date_verification"/>
                    <field name="asset_verification_user_id"/>
                    <field name="location_id"/>
                    <field name="create_date" string="TimeStamps"/>
                </list>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_account_asset_verification_history_kanban" model="ir.ui.view">
            <field name="name">asset.verification.history.kanban</field>
            <field name="model">asset.verification.history</field>
            <field name="arch" type="xml">
                <kanban>
                    <!-- Declare all fields needed -->
                    <field name="id"/>
                    <field name="history_id"/>
                    <field name="parent_barcode"/>
                    <field name="image_ids"/>
<!--                    <field name="image_count"/>-->
                    <field name="date_verification"/>
                    <field name="is_verified"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card" style="padding:15px;">

                                <!-- Images Section -->
                                <div class="o_kanban_image_section">
<!--                                    <div class="mb-2">-->
<!--                                        <strong>-->
<!--                                            <i class="fa fa-images"/> Images (<t t-esc="record.image_count.raw_value || 0"/>)-->
<!--                                        </strong>-->
<!--                                    </div>-->

                                    <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                        <t t-if="record.image_count.raw_value > 0">
                                            <!-- Loop through image IDs and create img tags -->
                                            <t t-foreach="record.image_ids.raw_value" t-as="image_id">
                                                <div class="o_squared_image" style="position:relative; width:100px; height:100px;">
                                                    <img class="card-img-top"
                                                        t-att-src="'/web/image/asset.verification.image/' + image_id + '/image'"
                                                        style="width:100%; height:100%; object-fit:cover; border-radius:6px; border:2px solid #dee2e6;"
                                                        alt="Verification Image"
                                                    />
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div style="width:100%; height:100px; display:flex; align-items:center; justify-content:center; background-color:#f8f9fa; border-radius:6px; border:2px dashed #dee2e6;">
                                                <div class="text-center">
                                                    <i class="fa fa-camera fa-2x text-muted mb-2"/>
                                                    <div class="text-muted small">No images</div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record id="action_asset_verification_history" model="ir.actions.act_window">
            <field name="name">Asset Verification History</field>
            <field name="res_model">asset.verification.history</field>
            <field name="view_mode">list,form,kanban</field>
        </record>

        <record id="view_asset_verification_history_search_view" model="ir.ui.view">
            <field name="name">asset.verification.history.search.view</field>
            <field name="model">asset.verification.history</field>
            <field name="arch" type="xml">
                <search string="Asset Verification History">
                    <group>
                            <filter name="group_by_condition" string="Condition" context="{'group_by':'condition'}"/>
                    </group>
                </search>

            </field>
        </record>

    </data>
</odoo>

