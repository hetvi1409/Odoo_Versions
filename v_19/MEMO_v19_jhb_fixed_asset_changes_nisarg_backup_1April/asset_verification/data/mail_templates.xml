<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="email_template_asset_approval" model="mail.template">
            <field name="name">Asset Approval Notification</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="subject">Approval Alert: Asset {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The asset
                        <t t-esc="object.name"/>
                        has been submitted for approval.
                    </p>
                    <p>Please review the asset details.</p>
                </div>
            </field>
        </record>

        <record id="email_template_asset_approved" model="mail.template">
            <field name="name">Asset Approved Notification</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="subject">Approval Alert: Asset {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The asset
                        <t t-esc="object.name"/>
                        has been approved.
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_asset_reject" model="mail.template">
            <field name="name">Asset Reject Notification</field>
            <field name="model_id" ref="account_asset.model_account_asset"/>
            <field name="subject">Approval Alert: Asset {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The asset
                        <t t-esc="object.name"/>
                        has been rejected.
                    </p>
                    <p>Please context approval manager for more details.</p>
                </div>
            </field>
        </record>

        <record id="email_template_asset_removal_reject" model="mail.template">
            <field name="name">Asset Reject Notification</field>
            <field name="model_id" ref="asset_verification.model_asset_removal_approval"/>
            <field name="subject">Removal Approval Alert: Asset {{ object.asset_id.name }}</field>
            <field name="email_from">{{ object.company_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The asset
                        <t t-esc="object.asset_id.name"/>
                        removal approval has been rejected.
                    </p>
                    <p>Please contact approval manager for more details.</p>
                </div>
            </field>
        </record>


        <record id="email_template_asset_removal_approved" model="mail.template">
            <field name="name">Asset Removal Approved Notification</field>
            <field name="model_id" ref="asset_verification.model_asset_removal_approval"/>
            <field name="subject">Removal Approval Alert: Asset {{ object.asset_id.name }}</field>
            <field name="email_from">{{ object.company_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The asset
                        <t t-esc="object.asset_id.name"/>
                        has been removed.
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_removal_to_confirm" model="mail.template">
            <field name="name">Removal Request Submitted</field>
            <field name="model_id" ref="asset_verification.model_asset_removal_approval"/>
            <field name="subject">Removal Approval Alert: Asset {{ object.asset_id.name }}</field>
            <field name="body_html" type="html">
                            <field name="auto_delete" eval="False"/>
                <p><strong><t t-esc="object.asset_id.name"/></strong> has been requested for removal.</p>
                <p>Please process this request accordingly!</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                        style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Removal Request
                    </a>
                </div>
            </field>
        </record>

    </data>
</odoo>