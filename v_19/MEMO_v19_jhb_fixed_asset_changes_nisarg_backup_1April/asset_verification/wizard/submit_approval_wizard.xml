<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_asset_submit_approval_wizard_form_id" model="ir.ui.view">
        <field name="name">asset.submit.approval.wizard.form</field>
        <field name="model">asset.submit.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <group>
                    <label for="text" string="Are you sure you want to submit this asset for approval?" readonly="1"/>
                    <field name="text" invisible="1"/>
                    <field name="asset_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>