<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="chief_directorate_view_department_tree" model="ir.ui.view">
            <field name="name">hr.department.list</field>
            <field name="model">hr.department</field>
            <field name="arch" type="xml">
                <list string="Companies" multi_edit="1">
                    <field name="company_id" column_invisible="True"/>
                    <field name="name" string="Directorate"/>
                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    <field name="manager_id" widget="many2one_avatar_employee"/>
                    <field name="total_employee" string="Employees"/>
                    <field name="color" widget="color_picker" string="Color"/>
                </list>
            </field>
        </record>
        <record id="directorate_view_department_tree" model="ir.ui.view">
            <field name="name">hr.department.list</field>
            <field name="model">hr.department</field>
            <field name="arch" type="xml">
                <list string="Companies" multi_edit="1">
                    <field name="company_id" column_invisible="True"/>
                    <field name="name" string="Directorate"/>
                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    <field name="manager_id" widget="many2one_avatar_employee"/>
                    <field name="total_employee" string="Employees"/>
                    <field name="parent_id" string="Chief Directorate"/>
                    <field name="color" widget="color_picker" string="Color"/>
                </list>
            </field>
        </record>
        <record id="chief_directorate_view_department_form" model="ir.ui.view">
            <field name="name">hr.department.form</field>
            <field name="model">hr.department</field>
            <field name="arch" type="xml">
                <form string="Chief Directorate">
                    <field name="company_id" invisible="1"/>
                    <sheet>
                        <div class="oe_button_box" name="button_box" invisible="not id">
                            <button class="oe_stat_button" name="action_employee_from_department" type="object"
                                    icon="fa-users">
                                <field string="Employees" name="total_employee" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_plan_from_department"
                                    icon="fa-list-ul">
                                <field string="Plans" name="plans_count" widget="statinfo"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" invisible="1"/> <!-- Remove in master -->
                                <field name="manager_id" widget="many2one_avatar_employee"/>
                                <field name="company_id" options="{'no_create': True}"
                                       groups="base.group_multi_company"/>
                                <field name="color" widget="color_picker" string="Color"/>
                            </group>
                            <div invisible="not id or id and not child_ids and not parent_id">
                                <widget name="hr_department_chart"/>
                            </div>
                        </group>
                        <div class="oe_title">
                            <label for="child_ids" string="Child Directorate"/>
                            <field name="child_ids"
                                   context="{'default_patent_id':id, 'list_view_ref': 'e_system.directorate_view_department_tree'}"/>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="chief_directorate_view_department_filter" model="ir.ui.view">
            <field name="name">hr.department.search</field>
            <field name="model">hr.department</field>
            <field name="arch" type="xml">
                <search string="Chief Directorate">
                    <field name="name" string="Chief Directorate"/>
                    <field name="manager_id"/>
                    <filter string="Unread Messages" name="message_needaction"
                            domain="[('message_needaction','=',True)]"
                            groups="mail.group_mail_notification_type_inbox"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>
        <record id="chief_directorate_tree_action" model="ir.actions.act_window">
            <field name="name">Chief Directorate</field>
            <field name="res_model">hr.department</field>
            <field name="search_view_id" ref="e_system.chief_directorate_view_department_filter"/>
            <field name="domain">[("has_read_access", "=", True),("parent_id","=",False)]</field>
            <field name="context">{'default_parent_id': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new department
                </p>
                <p>
                    Structure Employees per department and have an overview of e.g.
                    expenses, timesheets, time off, recruitment, etc.
                </p>
            </field>
        </record>

        <record id="chief_directorate_tree_view_tree_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="e_system.chief_directorate_view_department_tree"/>
            <field name="act_window_id" ref="e_system.chief_directorate_tree_action"/>
        </record>

        <record id="chief_directorate_form_view_tree_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="e_system.chief_directorate_view_department_form"/>
            <field name="act_window_id" ref="e_system.chief_directorate_tree_action"/>
        </record>

        <menuitem id="menu_hr_department_kanban"
                name="ALL DIRECTORATES" sequence="2"
                parent="e_system.e_system_menu_configuration"
                action="hr.hr_department_kanban_action" groups="base.group_system"/>

        <menuitem id="menu_chief_directorate"
                  name="CHIEF DIRECTORATES" sequence="3"
                  parent="e_system.e_system_menu_configuration"
                  action="e_system.chief_directorate_tree_action" groups="base.group_system"/>


        <record id="directorate_view_department_form" model="ir.ui.view">
            <field name="name">hr.department.form</field>
            <field name="model">hr.department</field>
            <field name="arch" type="xml">
                <form string="Directorate">
                    <field name="company_id" invisible="1"/>
                    <sheet>
                        <div class="oe_button_box" name="button_box" invisible="not id">
                            <button class="oe_stat_button" name="action_employee_from_department" type="object"
                                    icon="fa-users">
                                <field string="Employees" name="total_employee" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_plan_from_department"
                                    icon="fa-list-ul">
                                <field string="Plans" name="plans_count" widget="statinfo"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" invisible="1"/> <!-- Remove in master -->
                                <field name="manager_id" widget="many2one_avatar_employee"/>
                                <field name="parent_id" string="Chief Directorate"/>
                                <field name="company_id" options="{'no_create': True}"
                                       groups="base.group_multi_company"/>
                                <field name="color" widget="color_picker" string="Color"/>
                            </group>
                            <div invisible="not id or id and not child_ids and not parent_id">
                                <widget name="hr_department_chart"/>
                            </div>
                        </group>
                        <div class="oe_title">
                            <label for="child_ids" string="Child Directorate"/>
                            <field name="child_ids"
                                   context="{'default_patent_id':id, 'list_view_ref': 'e_system.directorate_view_department_tree'}"/>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="directorate_view_department_filter" model="ir.ui.view">
            <field name="name">hr.department.search</field>
            <field name="model">hr.department</field>
            <field name="arch" type="xml">
                <search string="Directorate">
                    <field name="name" string="Directorate"/>
                    <field name="manager_id"/>
                    <filter string="Unread Messages" name="message_needaction"
                            domain="[('message_needaction','=',True)]"
                            groups="mail.group_mail_notification_type_inbox"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>
        <record id="directorate_tree_action" model="ir.actions.act_window">
            <field name="name">Directorate</field>
            <field name="res_model">hr.department</field>
            <field name="search_view_id" ref="e_system.directorate_view_department_filter"/>
            <field name="domain">[("has_read_access", "=", True),("parent_id","!=",False)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new department
                </p>
                <p>
                    Structure Employees per department and have an overview of e.g.
                    expenses, timesheets, time off, recruitment, etc.
                </p>
            </field>
        </record>

        <record id="directorate_tree_view_tree_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="e_system.directorate_view_department_tree"/>
            <field name="act_window_id" ref="e_system.directorate_tree_action"/>
        </record>

        <record id="directorate_form_view_tree_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="e_system.directorate_view_department_form"/>
            <field name="act_window_id" ref="e_system.directorate_tree_action"/>
        </record>

        <menuitem id="menu_directorate"
                  name="DIRECTORATES" sequence="4"
                  parent="e_system.e_system_menu_configuration" groups="base.group_system"
                  action="e_system.directorate_tree_action"/>

        <menuitem id="menutarget_audience"
                  name="TARGET AUDIENCES" sequence="5"
                  parent="e_system.e_system_menu_configuration" groups="base.group_system"
                  action="hr.action_hr_job"/>
    </data>
</odoo>