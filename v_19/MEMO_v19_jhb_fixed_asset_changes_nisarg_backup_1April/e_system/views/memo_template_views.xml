<odoo>
    <record id="view_memo_template_form" model="ir.ui.view">
        <field name="name">memo.template.form</field>
        <field name="model">memo.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="submission_type"/>
                        <field name="type"/>
                        <field name="privacy" widget="radio"/>
                        <!-- <field name="purpose_body" invisible="submission_type in ['general','circular']" required="submission_type not in ['general','circular']"/> -->
                        <field name="background_body" string="Body" required="1"/>
                        <!-- <field name="background_body" string="Body" invisible="submission_type not in ['general','circular']" required="1"/> -->
                        <!-- <field name="motivation_body" invisible="submission_type in ['general','circular']" required="submission_type not in ['general','circular']"/> -->
                        <!-- <field name="project_status" invisible="submission_type in ['general','circular']"/> -->
                    </group>
                    <notebook>
                        <page name="tagged_user" string="Tagged Users" invisible="privacy == 'private'">
                            <group>
                                <field name="tagged_user_ids"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_memo_template_list" model="ir.ui.view">
        <field name="name">memo.template.list</field>
        <field name="model">memo.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="submission_type"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="action_memo_template" model="ir.actions.act_window">
        <field name="name">EDMS Templates</field>
        <field name="res_model">memo.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_memo_template"
              name="EDMS Templates" sequence="1"
              parent="e_system.e_system_menu_configuration"
              action="action_memo_template"
              groups="base.group_user,e_system.group_memo_quality_assurance,e_system.group_memo_requester"/>
</odoo>
