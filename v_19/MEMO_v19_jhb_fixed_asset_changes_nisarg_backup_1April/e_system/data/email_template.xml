<odoo>
    <data>
        <record id="email_template_submit_quality_assurance" model="mail.template">
            <field name="name">Memo Submit For Quality Assurance</field>
            <field name="model_id" ref="model_memo_memo"/>
            <field name="subject">{{ object.name }} Submit For Quality Assurance</field>
            <field name="email_cc">{{ object.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="ctx.get('approve_user', 'Quality Assurance User')">Quality Assurance</t>,
                        <br/>
                        <br/>
                        <p>The e-submission memo application
                            <strong>
                                <t t-out="object.name or ''">Memo-1</t>
                            </strong>
                            has just submit for quality assurance.
                        </p>
                        <p>You can view it by clicking the link below:</p>
                        <p>
                            <a t-att-href="ctx.get('url')"
                               style="background-color: #E8B90E; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                Open
                            </a>
                        </p>
                        <br/>
                        Best regards,
                        <br/>
                        <t t-out="object.requester_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="email_template_complete_quality_assurance" model="mail.template">
            <field name="name">Memo Complete Quality Assurance</field>
            <field name="model_id" ref="model_memo_memo"/>
