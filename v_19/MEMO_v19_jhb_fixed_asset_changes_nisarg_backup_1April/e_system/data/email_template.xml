            <field name="partner_to">{{ object.requester_id.partner_id.id }}</field>
            <field name="email_cc">{{ object.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="ctx.get('approve_user', 'Requester User')">Responsible Officer</t>,
                        <br/>
                        <br/>
                        <p>The e-submission memo application
                            <strong>
                                <t t-out="object.name or ''">Memo-1</t>
                            </strong>
                            has completed quality assurance.
                        </p>
                        <p>You can view it by clicking the link below:</p>
                        <p>
                            <a t-att-href="ctx.get('url')"
                               style="background-color: #E8B90E; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                Open
                            </a>
                        </p>
                        <br/>
                        Best regards,
                        <br/>
                        <t t-out="user.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="mail_template_general_submit" model="mail.template">
            <field name="name">General Submit Notification</field>
            <field name="model_id" ref="e_system.model_memo_memo"/>
            <field name="subject">{{ object.name }}</field>
            <field name="email_from">{{ object.requester_id.email or 'noreply@example.com' }}</field>
            <field name="partner_to">{{ ctx.get('partner_ids') }}</field>
            <field name="email_cc">{{ object.create_uid.email_formatted }}</field>
            <!--            <field name="description">Sent manually to selected partners when memo is assigned/shared</field>-->
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="ctx.get('approve_user', 'Approve User')">Approver</t>,
                        <br/>
                        <br/>
                        <p>You have received a General Memo titled
                            <strong>
                                <t t-out="object.name or ''">General-Title</t>
                            </strong>
                            approve sign request
                            <br/>
                            You can find the general memo document link below.
                            <br/>
                            <br/>
                            <a t-att-href="ctx.get('url')"
                               style="background-color: #E8B90E; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                Open General Document
                            </a>
                        </p>
                        <div>
                            <t t-out="object.purpose_body or ''"/>
                        </div>
                        <br/>
                        <div>
                            <t t-out="object.background_body or ''"/>
                        </div>
                        <br/>
                        <div>
                            <t t-out="object.motivation_body or ''"/>
                        </div>
                        <br/>
                        Best regards,
                        <br/>
                        <t t-out="object.requester_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

