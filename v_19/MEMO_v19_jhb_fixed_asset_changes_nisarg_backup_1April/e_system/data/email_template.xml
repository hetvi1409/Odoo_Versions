        <record id="mail_template_memo_escalation" model="mail.template">
            <field name="name">Memo Escalation Notification</field>
            <field name="model_id" ref="e_system.model_memo_memo"/>
            <field name="subject">Escalation: Pending Memo {{ object.name }}</field>
            <field name="email_from">{{ object.requester_id.email or 'noreply@example.com' }}</field>
            <field name="email_cc">{{ object.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p>Hello,</p>

                    <p>
                        This is a <strong>Day 7 Escalation</strong> regarding the Memo:
                        <strong>
                            <t t-out="object.name or ''"/>
                        </strong>
                        .
                    </p>

                    <p>
                        The following recommender(s) have not yet signed:
                        <br/>
                        <strong>
                            <t t-out="ctx.get('pending_names', '')"/>
                        </strong>
                    </p>

                    <p>
                        To avoid further delay, please take the necessary action.
                    </p>

                    <p>
                        <a t-att-href="ctx.get('url')"
                           style="background-color: #E74C3C; padding: 8px 16px; text-decoration: none;
                          color: #fff; border-radius: 5px; font-size:13px;">
                            View Memo Document
                        </a>
                    </p>

                    <br/>
                    <div>
                        <t t-out="object.purpose_body or ''"/>
                    </div>
                    <br/>
                    <div>
                        <t t-out="object.background_body or ''"/>
                    </div>
                    <br/>
                    <div>
                        <t t-out="object.motivation_body or ''"/>
                    </div>

                    <br/>
                    Best regards,
                    <br/>
                    <t t-out="object.requester_id.name or ''"/>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

