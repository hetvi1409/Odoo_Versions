<templates id="template" xml:space="preserve">
    <t t-name="widget_preview_image.binary_field" t-inherit="web.BinaryField"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//button[hasclass('o_clear_file_button')]" position="before">
            <t t-if="props.record.resId and !props.record.isDirty">
                <button
                        class="btn btn-secondary fa fa-folder-open o_clear_file_button"
                        data-tooltip="Open"
                        aria-label="Open"
                        t-on-click="() => this.open_images({})"
                />
            </t>
        </xpath>
        <xpath expr="//a[hasclass('o_form_uri')]" position="after">
            <button
                    class="btn btn-secondary fa fa-folder-open o_clear_file_button"
                    data-tooltip="Open"
                    aria-label="Open"
                    t-on-click="() => this.open_images({})"
            />
        </xpath>
    </t>
</templates>
