<odoo>
    <template id="template_header_default_jhb" inherit_id="website.template_header_default"
              name="Template Header Default Custom">
        <xpath expr="//t[@t-call='website.navbar']" position="before">
            <div id="top-header" class=""
                 style="top: 0;left: 0;right: 0;background-color: rgb(49, 99, 99);line-height: 1em;font-size: 12px;z-index: 100000;color: #fff;margin: 0;padding: 0;border: 0;outline: 0;-webkit-text-size-adjust: 100%;vertical-align: baseline;">
