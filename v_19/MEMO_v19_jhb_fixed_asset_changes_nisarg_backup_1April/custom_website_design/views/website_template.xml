                     style="max-width:1080px; margin:auto; padding:8px 0;">

                    <!-- LEFT SIDE -->
                    <div class="d-flex align-items-center text-white">
                        <span class="me-2 fw-semibold" style="font-size: 14px;">
                            Contact Us - Tel: 010 219 900 | Email:
                        </span>
                        <a href="mailto:clientservicingunit@jhbproperty.co.za"
                           class="text-white text-decoration-none fw-semibold">
                            clientservicingunit@jhbproperty.co.za
                        </a>
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="d-flex align-items-center gap-3 text-white">

                        <!-- IT HELPDESK -->
                        <a href="https://jhbproperty.co.za/helpdesk/i-t-support-39"
                           class="text-white text-decoration-none d-flex align-items-center gap-1">
                            <i class="fa fa-user"></i>
                            <span>IT Helpdesk</span>
                        </a>

                        <!-- SOCIAL ICONS -->
                        <div class="d-flex align-items-center gap-2">
                            <a href="/website/social/facebook" class="text-white" target="_blank">
                                <i class="fa fa-facebook"></i>
                            </a>
                            <a href="/website/social/twitter" class="text-white" target="_blank">
                                <i class="fa fa-twitter"></i>
                            </a>
                            <a href="/website/social/instagram" class="text-white" target="_blank">
                                <i class="fa fa-instagram"></i>
                            </a>
                        </div>

                    </div>
                </div>
                <!--                    <div id="et-secondary-menu"></div> &lt;!&ndash; #et-secondary-menu &ndash;&gt;-->
            </div> <!-- .container -->
        </xpath>
