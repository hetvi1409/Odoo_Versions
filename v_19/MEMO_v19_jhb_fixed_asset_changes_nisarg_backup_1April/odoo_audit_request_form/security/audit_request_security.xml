<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_audit" model="ir.module.category">
            <field name="name">Audit</field>
            <field name="sequence">61</field>
            <field name="visible" eval="True"/>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_audit">
            <field name="name">Audit</field>
            <field name="category_id" ref="odoo_audit_request_form.module_audit"/>
        </record>

        <record model="res.groups" id="custom_group_audit_requester_probc">
            <field name="name">Audit Requester</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_audit"/>
        </record>
        
        <record model="res.groups" id="custom_group_audit_approve_probc">
            <field name="name">Audit Approver</field>
            <field name="privilege_id" ref="res_groups_privilege_audit"/>
            <field name="implied_ids" eval="[(4, ref('custom_group_audit_requester_probc'))]"/>
        </record>
        
        <record id="custom_audit_approve_rule_probc_project" model="ir.rule">
            <field name="name">Audit Request Approver</field>
            <field name="model_id" ref="odoo_audit_request_form.model_custom_audit_request"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('custom_group_audit_approve_probc'))]"/>
        </record>
        
        <record id="custom_audit_request_rule_probc_project" model="ir.rule">
            <field name="name">Audit Request Requester</field>
            <field name="model_id" ref="odoo_audit_request_form.model_custom_audit_request"/>
            <field name="domain_force">[('responsible_user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('custom_group_audit_requester_probc'))]"/>
        </record>
        
        <record id="custom_audit_request_portal_user_rule_probc" model="ir.rule">
            <field name="name">Audit Request Portal User</field>
            <field name="model_id" ref="odoo_audit_request_form.model_custom_audit_request"/>
            <field name="domain_force">[('partner_id.id','child_of', [user.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>