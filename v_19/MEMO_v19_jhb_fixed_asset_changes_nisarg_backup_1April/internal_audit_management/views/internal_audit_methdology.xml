<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_internal_audit_method" model="ir.actions.act_window">
        <field name="name">Internal Audit Methodology</field>
        <field name="res_model">internal.audit.method</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Internal Audit Method
            </p>
            <p>
                Create and manage the Internal Audit Method
            </p>
        </field>
    </record>
    <record id="internal_audit_method_view_form" model="ir.ui.view">
        <field name="name">internal.audit.method.view.form</field>
        <field name="model">internal.audit.method</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                            invisible="state != 'preparer'"
                            string="Review" class="oe_highlight"/>
                    <button name="action_2nd_review" type="object" invisible="state != 'first_reviewer'" string="2nd Review" class="oe_highlight"/>
                    <button name="action_approve" type="object"
                            invisible="state != 'second_reviewer'"
                            string="Approve" class="oe_highlight"/>
                    <button name="action_mark_discrepancy" type="object"
                            invisible="state in ['reverted', 'rejected', 'approved']"
                            string="Refuse"/>
                    <button name="action_send_back_review" type="object"
                            invisible="state in ['preparer', 'reverted', 'rejected', 'approved']"
                            string="Revert" class="oe_highlight"/>
                    <button name="action_send_back_new" type="object"
                            invisible="state != 'rejected'"
                            string="Move To New" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                string="Revert Records"
                                class="oe_stat_button" icon="fa-book">
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence_no" readonly="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="team_id"
                                   readonly="state in ['approved', 'rejected']"/>
                            <field name="user_preparer_ids"/>
                            <field name="user_reviewer_1_ids"/>
                            <field name="user_reviewer_2_ids"/>
                            <field name="user_approver_ids"/>
                            <field name="user_ids" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   readonly="state in ['approved', 'rejected']"/>
                        </group>
                        <group>
                            <button name="action_view_documents"
                                    invisible="not attachment_ids"
                                    type="object" icon="fa-file-text-o"
                                    string="Open Documents"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <group>
                                    <field name="document_ids"
                                           widget="many2many_binary">
                                    </field>
                                </group>
                                <group>
                                    <button name="action_view_documents"
                                            invisible="not document_ids"
                                            type="object" icon="fa-file-text-o"
                                            string="Open Documents"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tracking"
                              name="methodology_tracking">
                            <field name="methodology_tracking_ids"
                                   options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}">
                                <list editable="bottom" create="0" edit="0">
                                    <field name="user_id"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="comment"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit Reverts/ Review Notes">
                            <group>
                                <field name="feedback"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="internal_audit_method_view_tree" model="ir.ui.view">
        <field name="name">internal.audit.method.view.list</field>
        <field name="model">internal.audit.method</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('preparer')"
                       decoration-warning="state in ('rejected')"
                       decoration-success="state in ('approved')"/>
            </list>
        </field>
    </record>
    <menuitem id="internal_audit_method_menu"
              name="Internal Audit Method"
              parent="internal_audit_management.high_level_documents_menu"
              action="action_internal_audit_method"
              sequence="18"/>
</odoo>
