                            <field name="user_approver_ids"
                                   widget="many2many_avatar_user"
                                   readonly="stages == 'approved'"
                                   invisible="1"/>
                        </group>
                        <group>
                            <!--                            <field name="user_id"-->
                            <!--                                   widget="many2one_avatar_user"/>-->
                            <field name="user_ids" invisible="1"/>
                            <field name="start_date"
                                   string="Planned Date"
                                   widget="daterange"
                                   options="{'end_date_field': 'date_end', 'always_range': 1}"
                                   on_change="1"/>
                            required="start_date or date_end"
                            <!-- Invisible End Date to store the value -->
                            <field name="date_end"
                                   invisible="1"
                                   required="start_date"
                                   on_change="1"/>
                            <field name="team_id" invisible="1"/>
                            <!--                            <field name="team_members_ids"-->
                            <!--                                   widget="many2many_tags" invisible=""/>-->
                            <field name="risk_priority_rating"/>
                            <!--                            <field name="q1_allocated_time"-->
                            <!--                                   widget="timesheet_uom"/>-->
                            <!--                            <field name="q2_allocated_time"-->
                            <!--                                   widget="timesheet_uom"/>-->
                            <!--                            <field name="q3_allocated_time"-->
                            <!--                                   widget="timesheet_uom"/>-->
                            <!--                            <field name="q4_allocated_time"-->
                            <!--                                   widget="timesheet_uom"/>-->
                            <!--                            <field name="allocated_hours"-->
                            <!--                                   widget="timesheet_uom_no_toggle"/>-->
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Audit Operational Plan"
                              name="operational_plan">
                            <field name="operational_plan_ids">
                                <list editable="bottom">
                                    <field name="sequence_number"/>
                                    <field name="name" string="AOP Name"/>
                                    <field name="rolling_plan_id"
                                           string="ARP Name"/>
                                    <field name="plan_id" column_invisible="0"/>
                                    <field name="description"/>
                                    <field name="scope_of_work"/>
                                    <field name="assurance_consulting"/>
                                    <field name="department_ids"
                                           widget="many2many_tags"/>
                                    <field name="user_ids"
                                           widget="many2many_tags"/>
                                    <field name="start_date"
                                           string="Start Date"/>
                                    <field name="date_end"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholer="Description..."/>
                        </page>
                        <page string="Tracking">
                            <field name="rolling_plan_tracking">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="previous"/>
                                    <field name="new_state"/>
                                    <field name="comment"/>
                                    <field name="date_updated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="internal_audit_rolling_plan_view_tree" model="ir.ui.view">
        <field name="name">rolling.plan.view.list</field>
        <field name="model">rolling.plan</field>
        <field name="arch" type="xml">
            <list duplicate="0" expand="1">
                <field name="sequence_no"/>
                <field name="category_id"/>
                <field name="rec_name"/>
                <field name="name" />
                <field name="department_ids"/>
                <field name="risk_priority_rating"/>
                <field name="start_date" string="Start Date"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>
    <menuitem id="high_task_arp_menu"
              name="Internal Audit Rolling Plan 1 year"
              parent="internal_audit_management.high_level_documents_menu"
              action="action_internal_audit_rolling_plan"
              sequence="10"/>
    <menuitem id="internal_audit_rolling_plan"
              name="Internal Audit Rolling Plan"
              parent="project.menu_project_config"
              action="action_internal_audit_rolling_plan"
              sequence="7"/>
</odoo>
