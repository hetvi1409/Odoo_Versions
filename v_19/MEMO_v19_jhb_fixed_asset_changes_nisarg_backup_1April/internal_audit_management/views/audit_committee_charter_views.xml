    </record>
    <record id="committee_charter_note_view_tree" model="ir.ui.view">
        <field name="name">committee.charter.note.view.list</field>
        <field name="model">committee.charter.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="audit_committee_charter_id"/>
                <field name="create_uid"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('new')"
                       decoration-warning="state in ('review', 'refuse')"
                       decoration-success="state in ('approve')"/>
            </list>
        </field>
    </record>
    <menuitem id="high_audit_committee_charter_menu"
              name="Audit Committee Charter"
              parent="internal_audit_management.high_charter_menu"
