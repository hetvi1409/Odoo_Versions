    <record id="view_project_task_inherit_tree" model="ir.ui.view">
        <field name="name">view.project.task.inherit.list</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="parent_id" invisible="1"/>
                <button class="oe_link" type="object"
                        name="action_view_sub_task" string="View" invisible="parent_id == False"/>
            </xpath>
        </field>
    </record>
</odoo>
