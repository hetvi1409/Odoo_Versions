<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_department_form" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.job</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="lead_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[1]" position="replace">
                <button class="oe_stat_button" type="object"
                        name="action_view_members" icon="fa-users">
                    <label for="total_employee">Members</label>
                    <field string="Employees" name="total_employee" invisible="1"
                           widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Members" name="members">
                        <field name="employee_ids">
                            <kanban class="o_hr_employee_kanban">
                                <!--                                    <field name="user_id"/>-->
                                <field name="work_email"/>
                                <field name="work_phone"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                                <div>
                                                    <div class="oe_kanban_details">
                                                        <div class="o_kanban_record_top">
                                                            <div class="o_kanban_record_headings">
                                                                <strong class="o_kanban_record_title">
                                                                    <field name="name"
                                                                           placeholder="Employee's Name"/>
                                                                </strong>
                                                                <span t-if="record.name.raw_value"
                                                                      class="o_kanban_record_subtitle">
                                                                    <field name="name"/>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <ul>
                                                        <li t-if="record.work_email.raw_value"
                                                            class="o_text_overflow">
                                                            <i class="fa fa-fw me-2 fa-envelope text-primary"
                                                               title="Email"/>
                                                            <field name="work_email"/>
                                                        </li>
                                                        <li t-if="record.work_phone.raw_value"
                                                            class="o_force_ltr">
                                                            <i class="fa fa-fw me-2 fa-phone text-primary"
                                                               title="Phone"/>
                                                            <field name="work_phone"/>
                                                        </li>
                                                        <li t-if="record.role_ids.raw_value"
                                                            class="o_force_ltr">
                                                            <i class="fa fa-fw me-2 fa-phone text-primary"
                                                               title="Role"/>
                                                            <field name="role_ids"
                                                                   widget="many2many_tags"/>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="hr_department_kanban_action" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new department
            </p>
            <p>
                Odoo's department structure is used to manage all documents
                related to employees by departments: expenses, timesheets,
                time off, recruitments, etc.
            </p>
        </field>
    </record>

    <menuitem
            id="menu_hr_department_kanban"
            action="hr_department_kanban_action"
            parent="project.menu_project_config"/>

</odoo>