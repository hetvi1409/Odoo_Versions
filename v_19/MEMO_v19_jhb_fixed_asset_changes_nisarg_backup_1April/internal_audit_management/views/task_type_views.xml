<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View for Task Type -->
    <record id="view_task_type_tree" model="ir.ui.view">
        <field name="name">task.type.list.view</field>
        <field name="model">task.type</field>
        <field name="arch" type="xml">
            <list string="Task Types" editable="bottom">
                <field name="name"/>
                <field name="task_name"/>
                <field name="task_type"/>
                <field name="type_id"/>
            </list>
        </field>
    </record>

    <!-- Action to Open Tree View -->
    <record id="action_task_type_tree" model="ir.actions.act_window">
        <field name="name">Task Types</field>
        <field name="res_model">task.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_task_type_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Task Type!
            </p>
        </field>
    </record>

    <!-- Menu Item to Access the Tree View -->
    <menuitem
        id="menu_task_type"
        name="Task Types"
        parent="project.menu_project_config"
        action="action_task_type_tree"
    />
</odoo>