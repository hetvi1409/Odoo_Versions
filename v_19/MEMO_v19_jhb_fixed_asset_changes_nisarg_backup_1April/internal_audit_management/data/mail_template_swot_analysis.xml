<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_swot_analysis_to_review" model="mail.template">
        <field name="name">SWOT Analysis</field>
        <field name="model_id"
               ref="internal_audit_management.model_swot_analysis"/>
        <field name="subject">SWOT Analysis : Review</field>
        <field name="description">send to the users.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi
                    <br/>
                    SWOT Analysis was created
                    <b>
                        <t t-out="object.start_date"/>
                        <t t-out="object.end_date"/>
                    </b>Please review this.
                </p>
            </div>
        </field>
    </record>
