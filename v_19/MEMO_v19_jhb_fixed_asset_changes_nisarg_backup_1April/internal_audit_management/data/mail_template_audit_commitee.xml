<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_internal_audit_committee_charter_to_review" model="mail.template">
        <field name="name">Audit Committee Charter</field>
        <field name="model_id" ref="internal_audit_management.model_audit_committee_charter"/>
        <field name="subject">Audit Committee Charter : Review</field>
        <field name="description">send to the users.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi
                    <br/>
                  Audit Committee Charter was created
                    <b>
                        <t t-out="object.name"/>
                    </b>Please review this.
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_list_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        <t>
                            Open
                            <t t-out="object.name"/>
                        </t>
                    </a>
                </div>
            </div>
        </field>
    </record>
