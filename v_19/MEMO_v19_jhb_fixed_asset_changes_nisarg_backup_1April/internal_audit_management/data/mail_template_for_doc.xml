<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_audit_standards_review" model="mail.template">
        <field name="name">Document Review</field>
        <field name="model_id" ref="internal_audit_management.model_audit_standards"/>
        <field name="subject">Internal Audit Standards:
            Reviewed
        </field>
        <field name="description">send to the users.</field>
        <field name="email_to">{{object.user_reviewer_1_ids.partner_id.email}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi
                    <t t-out="object.user_reviewer_1_ids.name"/>
                    <br/>
                    Please check the documents.
                    <b>
                        <t t-out="object.name"/>
                    </b>
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_form_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        <t>
                            Open
                            <t t-out="object.name"/>
                        </t>
                    </a>
                </div>
            </div>
        </field>
    </record>
