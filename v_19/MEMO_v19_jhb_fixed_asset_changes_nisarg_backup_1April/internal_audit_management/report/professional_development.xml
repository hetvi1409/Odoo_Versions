<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="professional_development_report_action" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">professional.development</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.professional_development_report</field>
        <field name="report_file">internal_audit_management.professional_development_report</field>
        <field name="binding_model_id" ref="model_professional_development"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s' % object.name</field>
    </record>

    <template id="professional_development_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="col-xs-4" style="padding:0;">
                            <center>
                                <h2>Professional Development</h2>
                            </center>
                        </div>
                        <table style="width:100%; border-collapse: collapse;">
                            <tr>
                                <td>
                                    <strong>W/P Reference:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.wp_reference"/>
                                </td>
                                <td>
                                    <strong>Preparer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_preparer_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Project:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.project_id.name"/>
                                </td>
                                <td>
                                    <strong>First Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_1_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Subject :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.subject"/>
                                </td>
                                <td>
                                    <strong>Second Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_2_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Period :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.start_date"/>
                                    <t t-esc="doc.end_date"/>
                                </td>
                                <td>
                                    <strong>Approver:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_approver_ids.name"/>
                                </td>
                            </tr>
                        </table>
                        <t t-if="doc.member_details">
                            <center>
                                <h4>Team Members</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Employee Number</th>
                                        <th>Rank</th>
                                        <th>Qualifications</th>
                                        <th>Experience</th>
                                        <th>Certifications</th>
                                        <th>Training Attended</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="politic" t-value="doc.member_details"/>
                                    <tr t-foreach="politic" t-as="pol">
                                        <td>
                                            <t t-esc="pol.name.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.employee_number"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.rank.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.qualifications"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.experience"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.certifications"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.training_attend"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.feedback">
                            <center>
                                <h4>Revert Details</h4>
                            </center>
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Feedback:</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.feedback"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <t t-set="reverts"
                           t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                        <t t-if="reverts">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Revert Name</th>
                                        <th>Created Date</th>
                                        <th>Review Comments</th>
                                        <th>Audit Proposal</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="reverts"
                                        t-as="revert">
                                        <td>
                                            <t t-esc="revert.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.date"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.comments"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.audit_findings"/>
                                        </td>
                                        <td>
                                            <span t-field="revert.state"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
