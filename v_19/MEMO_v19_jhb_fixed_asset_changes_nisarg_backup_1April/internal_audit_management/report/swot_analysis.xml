<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="swot_analysis_report_action" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">swot.analysis</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.swot_analysis_report</field>
        <field name="report_file">internal_audit_management.swot_analysis_report</field>
        <field name="binding_model_id" ref="model_swot_analysis"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s' % object.name</field>
    </record>

    <template id="swot_analysis_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="col-xs-4" style="padding:0;">
                            <center>
                                <h2 t-esc="doc.name"/>
                            </center>
                        </div>
                        <table style="width:100%; border-collapse: collapse;">
                            <tr>
                                <td>
                                    <strong>Sequence Number:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.sequence_no"/>
                                </td>
                                <td>
                                    <strong>Preparer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_preparer_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Start Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.start_date"/>
                                </td>
                                <td>
                                    <strong>First Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_1_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>End Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.end_date"/>
                                </td>
                                <td>
                                    <strong>Second Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_2_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Approver:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_approver_ids.name"/>
                                </td>

                            </tr>
                        </table>
                        <t t-if="doc.strengths_ids">
                            <center>
                                <h4>Strength</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                        <th>Strategic Objectives</th>
                                        <th>Target Date</th>
                                        <th>Responsible Auditor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="strength" t-value="doc.strengths_ids"/>
                                    <tr t-foreach="strength" t-as="stren">
                                        <td>
                                            <t t-esc="stren.sequence"/>
                                        </td>
                                        <td>
                                            <t t-esc="stren.critical_issue"/>
                                        </td>
                                        <td>
                                            <t t-esc="stren.internal_audit"/>
                                        </td>
                                        <td>
                                            <t t-esc="stren.strategic_objectives"/>
                                        </td>
                                        <td>
                                            <t t-esc="stren.target_date"/>
                                        </td>
                                        <td>
                                            <t t-esc="stren.responsible_auditor.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.weaknesses_ids">
                            <center>
                                <h4>Weakness</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                        <th>Strategic Objectives</th>
                                        <th>Target Date</th>
                                        <th>Responsible Auditor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="weakness" t-value="doc.weaknesses_ids"/>
                                    <tr t-foreach="weakness" t-as="weak">
                                        <td>
                                            <t t-esc="weak.sequence"/>
                                        </td>
                                        <td>
                                            <t t-esc="weak.critical_issue"/>
                                        </td>
                                        <td>
                                            <t t-esc="weak.internal_audit"/>
                                        </td>
                                        <td>
                                            <t t-esc="weak.strategic_objectives"/>
                                        </td>
                                        <td>
                                            <t t-esc="weak.target_date"/>
                                        </td>
                                        <td>
                                            <t t-esc="weak.responsible_auditor.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.opportunities_ids">
                            <center>
                                <h4>Opportunities</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                        <th>Strategic Objectives</th>
                                        <th>Target Date</th>
                                        <th>Responsible Auditor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="opportunities" t-value="doc.opportunities_ids"/>
                                    <tr t-foreach="opportunities" t-as="op">
                                        <td>
                                            <t t-esc="op.sequence"/>
                                        </td>
                                        <td>
                                            <t t-esc="op.critical_issue"/>
                                        </td>
                                        <td>
                                            <t t-esc="op.internal_audit"/>
                                        </td>
                                        <td>
                                            <t t-esc="op.strategic_objectives"/>
                                        </td>
                                        <td>
                                            <t t-esc="op.target_date"/>
                                        </td>
                                        <td>
                                            <t t-esc="op.responsible_auditor.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.threats_ids">
                            <center>
                                <h4>Threats</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                        <th>Strategic Objectives</th>
                                        <th>Target Date</th>
                                        <th>Responsible Auditor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="threats" t-value="doc.threats_ids"/>
                                    <tr t-foreach="threats" t-as="thr">
                                        <td>
                                            <t t-esc="thr.sequence"/>
                                        </td>
                                        <td>
                                            <t t-esc="thr.critical_issue"/>
                                        </td>
                                        <td>
                                            <t t-esc="thr.internal_audit"/>
                                        </td>
                                        <td>
                                            <t t-esc="thr.strategic_objectives"/>
                                        </td>
                                        <td>
                                            <t t-esc="thr.target_date"/>
                                        </td>
                                        <td>
                                            <t t-esc="thr.responsible_auditor.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <center>
                            <h4>Revert Details</h4>
                        </center>
                        <t t-if="doc.feedback">
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Feedback:</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.feedback"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <t t-set="reverts"
                           t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                        <t t-if="reverts">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Revert Name</th>
                                        <th>Created Date</th>
                                        <th>Review Comments</th>
                                        <th>Audit Proposal</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="reverts"
                                        t-as="revert">
                                        <td>
                                            <t t-esc="revert.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.date"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.comments"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.audit_findings"/>
                                        </td>
                                        <td>
                                            <span t-field="revert.state"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
