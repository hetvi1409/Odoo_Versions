<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_project_create_wizard" model="ir.actions.act_window">
        <field name="name">Project Create</field>
        <field name="res_model">project.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="project_create_wizard_view_form" model="ir.ui.view">
        <field name="name">project.create.wizard.form.view</field>
        <field name="model">project.create.wizard</field>
        <field name="arch" type="xml">
            <form create="0" duplicate="0">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="audit_type"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Create Project"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem name="Create New Project" id="project_create_wizard_menu"
              parent="project.menu_main_pm"
              sequence="1" action="action_project_create_wizard"/>
</odoo>