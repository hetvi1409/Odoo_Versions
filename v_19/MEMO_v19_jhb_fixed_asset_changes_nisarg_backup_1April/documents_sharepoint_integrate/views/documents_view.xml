<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="document_view_form_rename_inherite" model="ir.ui.view">
        <field name="name">documents.document.view.form.jhb</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_form_rename"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                <field name="sharepoint_base_url"/>
                <field name="sharepoint_site_name"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="document_view_form_details_inherite" model="ir.ui.view">
        <field name="name">documents.document.view.form.jhb</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_upload_url_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                <field name="sharepoint_base_url"/>
                <field name="sharepoint_site_name"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>