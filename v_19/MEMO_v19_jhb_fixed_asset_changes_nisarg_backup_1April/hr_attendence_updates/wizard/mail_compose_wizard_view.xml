<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_mail_compose_wizard" model="ir.ui.view">
        <field name="name">attendance.mail.compose.wizard.form</field>
        <field name="model">attendance.mail.compose.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Manager">
                <group>
                    <field name="template_id" required="1"/>
                    <field name="recipient_ids" widget="many2many_tags"/>
                    <field name="attendance_ids" invisible="0"/>
                </group>
                <footer>
                    <button string="Send" name="action_send_mail" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>