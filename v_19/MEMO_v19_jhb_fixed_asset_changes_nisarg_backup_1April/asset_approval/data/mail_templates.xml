<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="email_template_to_confirm_asset" model="mail.template">
            <field name="name">Approval Request Submitted</field>
            <field name="model_id" ref="model_account_asset"/>
            <field name="subject">Approval Request: {{object.name}}</field>
            <field name="body_html" type="html">
                <p>Dear,</p>
                <p>
                    Asset
                    <strong>
                        <t t-esc="object.name"/>
                    </strong>
                   has requested for approval.
                </p>
                <p>Please process this request accordingly!</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Request
                    </a>
                </div>
            </field>
        </record>
        <record id="email_template_approval_confirmed_asset"
                model="mail.template">
            <field name="name">Approval Confirmed</field>
            <field name="model_id" ref="model_account_asset"/>
            <field name="subject">Approved: {{object.name}}</field>
            <field name="body_html" type="html">
                <p>We are pleased to inform you that the asset
                    <strong>
                        <t t-esc="object.name"/>
                    </strong>
                    has been approved.
                </p>
                <p>Thank you for your submission!</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Asset
                    </a>
                </div>
            </field>
        </record>
        <record id="email_template_rejected_asset" model="mail.template">
            <field name="name">Approval Rejected</field>
            <field name="model_id" ref="model_account_asset"/>
            <field name="subject">Rejected: {{object.name}}</field>
            <field name="body_html" type="html">
                <p>We regret to inform you that the asset
                    <strong>
                        <t t-esc="object.name"/>
                    </strong>
                    has been rejected.
                </p>
                <p>For more details, please contact us.</p>
                <p>Best regards,</p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.redirect_url"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        View Request
                    </a>
                </div>
            </field>
        </record>
    </data>
</odoo>