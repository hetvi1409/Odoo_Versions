<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_servitude_register_approve" model="mail.template">
        <field name="name">Servitude Register</field>
        <field name="model_id" ref="servitude_register.model_servitude_register"/>
        <field name="subject">Servitude Register: {{ object.name or 'n/a' }}</field>
        <field name="description">Send mail to the holder</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi,
                    <br/>
                    The Servitude Register <b><t t-out="object.name"/></b> was approved. Please check it.
                </p>
            </div>
        </field>
    </record>
    <record id="email_template_servitude_register_refuse" model="mail.template">
        <field name="name">Servitude Register</field>
        <field name="model_id" ref="servitude_register.model_servitude_register"/>
        <field name="subject">Servitude Register: {{ object.name or 'n/a' }}</field>
        <field name="description">Send mail to the holder</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi,
                    <br/>
                    The Servitude Register <b><t t-out="object.name"/></b> was rejected. Please check it.
                </p>
            </div>
        </field>
    </record>
    <record id="email_template_servitude_register_invoice" model="mail.template">
        <field name="name">Servitude Register</field>
        <field name="model_id" ref="servitude_register.model_servitude_register"/>
        <field name="subject">Servitude Register: {{ object.name or 'n/a' }}</field>
        <field name="description">Send mail to the holder</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi,
                    <br/>
                    A Invoice was created for the servitude register <b><t t-out="object.name"/></b>. Please check it.
                </p>
            </div>
        </field>
    </record>

</odoo>