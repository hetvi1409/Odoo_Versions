<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="onboarding_activity_plan" model="mail.activity.plan">
        <field name="name">Employee Onboarding Plan</field>
        <field name="res_model">hr.employee</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="activity_pre_arrival" model="mail.activity.plan.template">
        <field name="summary">Prepare onboarding documents</field>
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
    </record>

    <record id="activity_it_setup" model="mail.activity.plan.template">
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
        <field name="summary">Setup IT and desk</field>
        <field name="note">
            Liaise with IT department:
            - Mobile phone
            - Laptop
            - Email address
            - Desk allocation
            - Access card
        </field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
    </record>

    <record id="activity_induction_schedule" model="mail.activity.plan.template">
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
        <field name="summary">Corporate induction planning</field>
        <field name="note">
            - Schedule corporate induction
            - Confirm departmental presentations
            - Identify induction buddy
        </field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
    </record>

    <record id="activity_first_day" model="mail.activity.plan.template">
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
        <field name="summary">Employee onboarding execution</field>
        <field name="note">
            - Complete HR payroll documents
            - Coordinate onboarding programme
            - Employee completes induction checklist
            - Introduce team and buddy
            - Assign desk based on role
        </field>
        <field name="delay_count">1</field>
        <field name="delay_unit">days</field>
    </record>

    <record id="activity_document_handover" model="mail.activity.plan.template">
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
        <field name="summary">Send documents to payroll</field>
        <field name="note">
            Hand over employee documents to Payroll for SAP upload
        </field>
        <field name="delay_count">2</field>
        <field name="delay_unit">days</field>
    </record>

    <record id="activity_first_week" model="mail.activity.plan.template">
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
        <field name="summary">Manager meeting</field>
        <field name="note">
            Meeting with line manager:
            - Discuss job role
            - Set goals and objectives
        </field>
        <field name="delay_count">7</field>
        <field name="delay_unit">days</field>
    </record>


    <record id="activity_feedback" model="mail.activity.plan.template">
        <field name="plan_id" ref="recruitment_enhancement.onboarding_activity_plan"/>
        <field name="summary">Collect employee feedback</field>
        <field name="note">
            Collect employee feedback on induction experience
        </field>
        <field name="delay_count">30</field>
        <field name="delay_unit">days</field>
    </record>

</odoo>