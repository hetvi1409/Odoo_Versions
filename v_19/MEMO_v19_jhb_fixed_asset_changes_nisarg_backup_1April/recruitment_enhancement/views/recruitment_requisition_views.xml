<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_requisition_list" model="ir.ui.view">
        <field name="name">recruitment.requisition.list</field>
        <field name="model">recruitment.requisition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="position_type"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-info="state in ('in_process','approval_in_process')"
                       decoration-danger="state =='rejected'" decoration-warning="state == 'cancelled'"/>
                <field name="document_complete"/>
                <field name="approval_cycle_days"/>
            </list>
        </field>
    </record>

    <record id="view_recruitment_requisition_form" model="ir.ui.view">
        <field name="name">recruitment.requisition.form</field>
        <field name="model">recruitment.requisition</field>
        <field name="arch" type="xml">
            <form string="Recruitment Requisition">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state in ['draft','cancelled','approved','done','approval_in_process']"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ['approved','cancelled','rejected']"/>
                    <!--                    <button name="action_open_shortlisting" string="Shortlisting" type="object" class="btn-secondary"-->
                    <!--                            invisible="state != 'approved'"/>-->
                    <button name="action_start_approval_process" string="Start Approval"
                            type="object" class="btn-primary" invisible="state != 'in_process'"/>
                    <button name="action_approve_requisition" string="Approve"
                            type="object" class="btn-success"
                            invisible="state != 'approval_in_process' or not is_current_approver"/>
                    <button name="action_reject_requisition" string="Reject"
                            type="object" class="btn-danger"
                            invisible="state != 'approval_in_process' or not is_current_approver"/>
                    <button name="action_recruitment_in_process" string="Recruitment In Process"
                            type="object" class="btn-primary" invisible="state != 'approved'" groups="hr_recruitment.group_hr_recruitment_manager,recruitment_enhancement.group_recruitment_process_user"/>
                    <button name="action_done" string="Recruitment Done"
                            type="object" class="btn-primary" invisible="1"/>
                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_input{
                         border-color: black !important;
                            border:1px solid black;
                            padding:10px;
                            border-radius:6px;
                        }
                    </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_advert_pdf" string="View Job Advert" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o"/>

                        <button name="action_view_requisition_report" string="Requisition Report" type="object"
                            class="oe_stat_button" icon="fa-file-pdf-o"/>

                    </div>
                    <div style="display:flex; justify-content:flex-end; margin-bottom:8px;"
                         invisible="not current_approver_id">
                        <span class="me-2 text-muted">Approval pending for :</span>
                        <field name="current_approver_id" widget="badge" decoration-primary="1"/>
                    </div>
                    <group string="POSITION OVERVIEW">
                        <group>
                            <field name="name" string="Job Title" readonly="state != 'draft'"/>
                            <field name="job_id" readonly="state != 'draft'"/>
                            <field name="department_id" string="Department" readonly="state != 'draft'"/>
                            <field name="company_id" string="Company" readonly="state != 'draft'"/>
                            <field name="job_location" string="Location" readonly="state != 'draft'"/>
                            <field name="no_of_positions" string="Target" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="position_type" readonly="state != 'draft'"/>
                            <field name="job_grade" readonly="state != 'draft'"/>
                            <field name="reports_to_title" readonly="state != 'draft'"/>
                            <field name="hr_coordinator_id" string="Report To" readonly="state != 'draft'"/>
                            <field name="years_of_experience" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="BUSINESS JUSTIFICATION">
                        <group>
                            <field name="previous_incumbent" string="Previous Incumbent" readonly="1"
                                invisible="position_type != 'existing'" required="position_type == 'existing'"/>
                            <field name="impact_if_not_filled" readonly="state != 'draft'"/>
                            <field name="skill_ids" widget="many2many_tags"/>
                            <field name="qualification"/>
                            <field name="minimum_qualifications"/>
                            <field name="required_experience"/>
                        </group>
                        <group>
                            <field name="purpose_job_main" string="Reason For Hire" readonly="state != 'draft'"/>
                            <field name="job_desc"/>
                            <field name="survey_id"/>
                            <field name="document_complete" readonly="1" invisible="1"/>
                            <field name="approval_cycle_days" readonly="1" invisible="1"/>
                            <field name="approval_status" invisible="1"/>
                            <field name="budget_availability"/>
                            <field name="certifications"/>
                            <field name="applicant_ids" invisible="1"/>
                        </group>
                    </group>
                    <group string="Hired" invisible="state != 'done'">
                        <group>
                            <field name="hired_employee" readonly="1"/>
                            <field name="hired_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Business Need">
                            <!-- <group>
                                <field name="business_justification" readonly="state != 'draft'"/>
                            </group> -->
                            <group>
                                <group>
                                    <field name="website_published" widget="boolean_toggle"/>
                                    <field name="publish_date"/>
                                    <field name="unpublish_date"/>
                                    <field name="interviewer_ids" widget="many2many_tags_avatar"/>
                                    <field name="sourcing_method"/>
                                </group>
                                <group>

                                    <field name="business_strategy_alignment" readonly="state != 'draft'"/>
                                    <field name="external_advert_required" readonly="state != 'draft'"/>
                                    <field name="internal_advert_required" readonly="state != 'draft'"/>
                                    <field name="channel_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                                    <field name="advert_days" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <page string="EE Targets">
                            <group>
                                <field name="ee_target_youth" readonly="state != 'draft'"/>
                                <field name="ee_target_women" readonly="state != 'draft'"/>
                                <field name="ee_target_pwd" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Job Summary">
                            <field name="job_summary"/>
                            <!--                            <field name="summary"/>-->
                        </page>
                        <page string="Pre-Screening">
                            <group>
                                <group>
                                    <field name="need_prescreening"/>
                                </group>
                                <group invisible="not need_prescreening">
                                    <button name="action_start_prescreening_survey"
                                            type="object"
                                            string="Start Pre-Screening"
                                            class="btn-primary"
                                            icon="fa-edit"/>

                                </group>
                                <group invisible="not need_prescreening">
                                    <field name="survey_id" readonly="1"/>
                                    <field name="attachment_id" invisible="1"/>
                                </group>
                                <field name="question_and_page_ids" invisible="not need_prescreening">
                                    <list create="0">
                                        <field name="title" required="1"/>
                                        <field name="survey_id" required="1"/>
                                        <field name="question_type" required="1"/>
                                        <field name="elimination_question" required="1"/>
                                        <field name="constr_mandatory" required="1"/>
                                    </list>
                                </field>
                            </group>
                        </page>


                        <page string="Documents">
                            <group>
                                <!--                                <field name="requisition_form_file" filename="requisition_form_filename"-->
                                <!--                                       readonly="state != 'draft'"/>-->
                                <field name="requisition_form_filename" invisible="1"/>
                                <field name="job_description_file" filename="job_description_filename"
                                        readonly="state != 'draft'"/>
                                <field name="job_description_filename" invisible="1"/>
                                <field name="organogram_file" filename="organogram_filename"
                                       readonly="state != 'draft'"/>
                                <field name="organogram_filename" invisible="1"/>
                                <field name="budget_file" filename="budget_file_name"
                                       readonly="state != 'draft'"/>
                                <field name="budget_file_name" invisible="1"/>
                            </group>
                        </page>

                        <page string="Approval Signatories">
                            <field name="approval_line_ids" required="1"
                                   readonly="state not in ['draft', 'in_process']">
                                <list editable="bottom" create="1" required="1">
                                    <field name="approver_role_id" required="1"/>
                                    <field name="user_id" options="{'no_create': True,'no_open': True,}"/>
                                    <field name="approval_date" readonly="1"/>
                                    <field name="signature" widget="signature" readonly="1"/>
                                    <field name="status" widget="badge" decoration-success="status == 'approved'"
                                           decoration-info="status =='pending'"
                                           decoration-danger="status =='rejected'" readonly="1"/>
                                    <field name="reject_reason" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approval Log">
                            <group>
                                <field name="rejection_reason" placeholder="Feedback for return/rejection"/>
                            </group>
                            <field name="approval_log_ids" readonly="1">
                                <list>
                                    <field name="level"/>
                                    <field name="approver_id"/>
                                    <field name="decision"/>
                                    <field name="decision_date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_recruitment_requisition" model="ir.actions.act_window">
        <field name="name">Requisitions</field>
        <field name="res_model">recruitment.requisition</field>
        <field name="view_mode">list,form</field>
        <!--        <field name="search_view_id" ref="view_recruitment_requisition_search"/>-->
    </record>

</odoo>

