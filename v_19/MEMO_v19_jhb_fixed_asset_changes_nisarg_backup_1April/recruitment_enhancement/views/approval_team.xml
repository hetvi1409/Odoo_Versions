<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="approval_list_view_form" model="ir.ui.view">
        <field name="name">approval.list.view.form</field>
        <field name="model">approval.team</field>
        <field name="arch" type="xml">
            <form string="Approval Team">
                <sheet>
                    <style>
                        .o_input{
                        border-color: black !important;
                        border:1px solid black;
                        padding:10px;
                        border-radius:6px;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group>
                        <field name="name"/>
                        <field name="model_id" required="1"/>
                        <field name="department_id"/>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="has_role"/>
                                <field name="user_id"
                                       invisible="has_role"
                                       options="{'no_create': True}"/>
                                <field name="group_ids"
                                       widget="many2many_tags"
                                       invisible="not has_role"
                                       options="{'no_create': True}"/>
                                <field name="department_id" readonly="1"/>
                                <field name="job_id"/>
                                <field name="approval_signed"/>
                                <field name="rejected_signed"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="approval_list_view_list" model="ir.ui.view">
        <field name="name">approval.list.view.list</field>
        <field name="model">approval.team</field>
        <field name="arch" type="xml">
            <list string="Approval Team">
                <field name="name"/>
                <!-- <field name="user_ids" widget="many2many_tags"/> -->
            </list>
        </field>
    </record>

    <record id="action_approval_team" model="ir.actions.act_window">
        <field name="name">Approval Team</field>
        <field name="res_model">approval.team</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>

