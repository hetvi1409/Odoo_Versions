<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recruitment_background_check_list" model="ir.ui.view">
        <field name="name">recruitment.background.check.list</field>
        <field name="model">recruitment.background.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="applicant_id"/>
                <field name="check_type"/>
                <field name="status"/>
                <field name="requested_date"/>
                <field name="completed_date"/>
                <field name="reviewed_by"/>
            </list>
        </field>
    </record>

    <record id="view_recruitment_background_check_form" model="ir.ui.view">
        <field name="name">recruitment.background.check.form</field>
        <field name="model">recruitment.background.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_pending" string="Reset to Pending" type="object" class="btn-primary" invisible="status in ('pending','approval_in_process')" groups="recruitment_enhancement.group_recruitment_background"/>
                    <button name="action_mark_concern" string="Mark Concern" type="object" class="btn-secondary" invisible="status in ('concern','approval_in_process')" groups="recruitment_enhancement.group_recruitment_background"/>
                    <!-- <button name="action_mark_failed" string="Mark Failed" type="object" class="btn-secondary" invisible="status == 'failed'"/> -->
                    <button name="action_start_approval_process" string="Start Approval"
                            type="object" class="btn-primary" invisible="status != 'pending'" groups="recruitment_enhancement.group_recruitment_background"/>
                    <button name="action_approve_applicant" string="Approve" invisible="status != 'approval_in_process' or not is_current_approver"
                            type="object" class="btn-success" groups="recruitment_enhancement.group_recruitment_background"/>
                    <button name="action_reject_applicant" string="Reject" invisible="status != 'approval_in_process' or not is_current_approver"
                            type="object" class="btn-danger" groups="recruitment_enhancement.group_recruitment_background"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,clear,concern,failed"/>
                </header>
                <sheet>
                    <style>
                        .o_input{
                         border-color: black !important;
                        border:1px solid black;
                        padding:10px;
                        border-radius:6px;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="requisition_id"/>
                            <!-- <field name="interview_session_id"/> -->
                            <field name="applicant_id"/>
                            <field name="check_type"/>
                        </group>
                        <group>
                            <field name="requested_date"/>
                            <field name="completed_date"/>
                            <field name="vendor_name" invisible="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="approval_status" invisible="1"/>
                            <field name="state" invisible="1"/>
                            <field name="is_approval_line" invisible="1"/>
                            <field name="is_current_approver" invisible="1"/>
                        </group>
                    </group>
                    <field name="result_notes"/>
                    <notebook>
                        <page string="Approvals">
                            <field name="approval_line_ids" required="1">
                                <list editable="bottom" create="1" required="1">
                                    <field name="approver_role_id" required="1"/>
                                    <field name="user_id" options="{'no_create': True,'no_open': True,}"/>
                                    <field name="approval_date" readonly="1"/>
                                    <field name="signature" widget="signature" readonly="1"/>
                                    <field name="status" widget="badge" decoration-success="status == 'approved'"
                                            decoration-info="status =='pending'"
                                            decoration-danger="status =='rejected'" readonly="1"/>
                                    <field name="reject_reason" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recruitment_background_check" model="ir.actions.act_window">
        <field name="name">Background Checks</field>
        <field name="res_model">recruitment.background.check</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
