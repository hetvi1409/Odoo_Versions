<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_recruitment_enhancement" model="ir.ui.view">
        <field name="name">hr.job.form.recruitment.enhancement</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <style>
                        .o_input{
                         border-color: black !important;
                        border:1px solid black;
                        padding:10px;
                        border-radius:6px;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_requisitions" type="object" class="oe_stat_button" icon="fa-files-o">
                    <field name="requisition_count" widget="statinfo" string="Requisitions"/>
                </button>
                <button name="action_view_advert_pdf"
                        string="View Job Advert"
                        type="object"
                        class="oe_stat_button" invisible="attachment_id == False"
                        icon="fa-file-pdf-o"/>
            </xpath>
            <!-- <xpath expr="//group[@name='job_posting']" position="inside">
                <field name="ee_target_youth"/>
                <field name="ee_target_women"/>
                <field name="ee_target_pwd"/>
                <field name="attachment_id" invisible="1"/>
            </xpath> -->

        </field>
    </record>

    <record id="view_hr_job_form_inherit" model="ir.ui.view">
        <field name="model">hr.job</field>
        <field name="name">hr.job.view.form.inherit</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <style>
                        .o_input{
                        border-color: black !important;
                        border:1px solid black;
                        padding:10px;
                        border-radius:6px;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
            </xpath>

            <xpath expr="/form//page[@name='trackers_page']" position="after">
                <page string="Expected skills">
                    <div class="o_hr_skills_editable o_hr_skills_group o_group_skills">
                        <field name="id" invisible="1"/>
                        <group>
                            <group>
                                <field mode="list" nolabel="1" name="current_job_skill_ids" widget="skills_one2many" context="{'default_applicant_id': id, 'no_timeline': True}">
                                    <list class="o_applicant_skills" decoration-muted="valid_to and valid_to &lt; context_today().strftime('%Y-%m-%d')" decoration-danger="valid_to and valid_to &lt;= (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d') and valid_to &gt; context_today().strftime('%Y-%m-%d')" decoration-warning="valid_to and valid_to &lt;= (context_today() + relativedelta(months=1)).strftime('%Y-%m-%d') and valid_to &gt; (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d')">
                                        <field name="skill_type_id" optional="hidden"/>
                                        <field name="skill_id"/>
                                        <field name="skill_level_id"/>
                                        <field name="level_progress" widget="progressbar"/>
                                        <field name="valid_to" column_invisible="1"/>
                                    </list>
                                </field>
                            </group>

                        </group>
                    </div>
                </page>
            </xpath>

            <xpath expr="/form/sheet/notebook/page[@name='recruitment_page']/group/group[@name='job_posting']/field[@name='current_job_skill_ids']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>


    <record id="view_hr_job_kanban" model="ir.ui.view">
        <field name="model">hr.job</field>
        <field name="name">hr.job.view.kanban</field>
        <field name="inherit_id" ref="hr_recruitment.view_hr_job_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@role='menuitem'][@name='menu_view_applications']" position="after">
                <div role="menuitem">
                    <a name="action_search_matching_candidates" type="object">
                        Matching Candidates
                    </a>
                </div>
            </xpath>
            <!-- Replace the hidden Job Page div with our two visible buttons -->
            <xpath expr="//div[@name='large_screen_job_page_div']" position="replace">
                <div class="d-flex flex-column gap-2 me-2">
                    <button class="btn btn-primary"
                            name="search_new_applications"
                            type="object">
<!--                            context="{'search_default_job_id': id}">-->
                        <field name="new_application_count"/>
                        New Applications
                    </button>
                    <button class="btn btn-secondary"
                            name="%(recruitment_enhancement.action_hr_applications_failed)d"
                            type="action"
                            context="{'search_default_job_id': id}">
                        <field name="staging_application_count"/>
                        Staging Applications
                    </button>
                </div>
            </xpath>
            <xpath expr="//div[@class='col align-content-center'][.//field[@name='new_application_count']]" position="after">
                <div class="col align-content-center">
                    <div class="d-flex justify-content-center">
                        <field name="qualification_application_count" class="number"/>
                        <div class="number_description text-body-secondary fs-4 lh-1">
                            Qualification Applications
                        </div>
                    </div>
                </div>
            </xpath>
