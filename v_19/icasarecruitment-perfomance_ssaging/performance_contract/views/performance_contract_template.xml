<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_performance_contract_template_form" model="ir.ui.view">
        <field name="model">performance.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_performance_contract_template_list" model="ir.ui.view">
        <field name="model">performance.contract.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_performance_contract_template" model="ir.actions.act_window">
        <field name="name">Performance Contract Templates</field>
        <field name="res_model">performance.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
