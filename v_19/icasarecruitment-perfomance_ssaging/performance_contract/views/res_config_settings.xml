<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="res_config_settings_view_employee_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.appraisal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_appraisal']/block" position="after">

                <block title="Goal Deadline Reminder Settings">
                    <div class="row">
                        <setting name="goal_deadline_reminder_settings" class="o_full_width">
                            <div class="content-group mt8">
                                <div>
                                    <label for="send_mail_before" class="o_form_label o_required_modifier mb-2">Goal Deadline Reminder (days before)</label>
                                    <field name="send_mail_before"  class="o_full_width m-2"/>
                                </div>
                            </div>
                        </setting>
                    </div>
                </block>

            </xpath>
        </field>
    </record>
</odoo>