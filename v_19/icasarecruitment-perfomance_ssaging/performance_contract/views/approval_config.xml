<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_performance_contract_approval_form" model="ir.ui.view">
        <field name="model">performance.contract.approval</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_id"/>
                        <field name="user_id"/>
                        <field name="approved"/>
                        <field name="approval_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_performance_contract_approval_list" model="ir.ui.view">
        <field name="model">performance.contract.approval</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="user_id"/>
                <field name="approved"/>
                <field name="approval_date"/>
            </list>
        </field>
    </record>

    <record id="action_performance_contract_approval" model="ir.actions.act_window">
        <field name="name">Performance Contract Approvals</field>
        <field name="res_model">performance.contract.approval</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>