<odoo>
    <data noupdate="0">
        <record id="cron_expired_performance_contracts" model="ir.cron">
            <field name="name">Performance Contract: Daily Expiry Check</field>
            <!-- Double check this matches your model's _name -->
            <field name="model_id" ref="model_performance_contract"/>
            <field name="state">code</field>
            <field name="code">model.performance_contract_expire_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_send_goal_deadline_reminders" model="ir.cron">
            <field name="name">Send Goal Deadline Reminders</field>
            <field name="model_id" ref="model_performance_contract"/>
            <field name="state">code</field>
            <field name="code">model.send_goal_deadline_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
