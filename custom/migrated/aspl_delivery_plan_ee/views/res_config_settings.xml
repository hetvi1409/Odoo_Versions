<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_inventory_settings_inherit_map_type" model="ir.ui.view">
    <field name="name">res.config.settings.inventory.map.type</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <xpath expr="//block[@name='request_vendor_setting_container']" position="after">
        <block title="Map" name="select_map">
            <setting title="Map title" >
                <field name="map_type"/>
              <br/>
              <div class="m-2">
                <label for="api_key" string="API KEY" invisible="not map_type=='Google Map' "/>
                <field class="ms-2" name="api_key" invisible="not map_type=='Google Map' " required="1"/>
              </div>
            </setting>
        </block>
      </xpath>

    </field>
  </record>
</odoo>
