<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- create form view and list view -->
    <record id="view_freelancer_profile_form" model="ir.ui.view">
        <field name="name">freelancer.profile.form</field>
        <field name="model">freelancer.profile</field>
        <field name="arch" type="xml">
            <form string="Freelancer Profile">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="is_freelancer"/>
                        <field name="skill_ids"/>
                        <field name="experience_years"/>
                        <field name="portfolio_url"/>
                        <field name="state"/>
                        <field name="proposal_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freelancer_profile_tree" model="ir.ui.view">
        <field name="name">freelancer.profile.tree</field>
        <field name="model">freelancer.profile</field>
        <field name="arch" type="xml">
            <list string="Freelancer Profiles">
                <field name="partner_id"/>
                <field name="is_freelancer"/>
                <field name="skill_ids"/>
                <field name="experience_years"/>
                <field name="portfolio_url"/>
                <field name="state"/>
                <field name="proposal_count"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_freelancer_profile" name="Freelancer Profiles" parent="base.menu_custom" action="action_freelancer_profile"/>

</odoo>