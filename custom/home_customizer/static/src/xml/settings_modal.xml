<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="home_customizer.SettingsModal">
        <Dialog title="props.title" size="'md'">
            <div class="o_home_customizer_modal">
                <div class="mb-2" t-foreach="settings" t-as="setting" t-key="setting.id">
                    <label t-att-for="setting.id" class="form-label d-flex justify-content-between align-items-center" t-if="setting.type !== 'boolean'">
                        <span>
                            <t t-esc="setting.label"/>: 
                            <strong t-esc="formatValue(setting)"/>
                        </span>
                        <span>
                             <button type="button" class="btn btn-sm btn-light px-2 py-0 me-1" 
                                t-if="isChanged(setting.key)" 
                                t-on-click="() => this.undoSetting(setting.key)" 
                                title="Undo change">
                                <i class="fa fa-undo" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-light px-2 py-0" 
                                t-if="isDifferentFromDefault(setting.key)" 
                                t-on-click="() => this.resetSetting(setting.key)" 
                                title="Reset to Odoo's default">
                                Reset
                            </button>
                        </span>
                    </label>
                    <div t-if="setting.type === 'range'">
                        <input type="range" class="form-range" 
                            t-att-id="setting.id" 
                            t-att-min="setting.min" 
                            t-att-max="setting.max" 
                            t-att-step="setting.step" 
                            t-model.number="state[setting.key]"
                            t-on-input="() => this.onInput(setting.key)"/>
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span><t t-esc="setting.min"/><t t-esc="setting.unit"/></span>
                            <span><t t-esc="setting.max"/><t t-esc="setting.unit"/></span>
                        </div>
                    </div>
                     <div t-if="setting.type === 'boolean'" class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" 
                            t-att-id="setting.id" 
                            t-model="state[setting.key]"
                            t-on-change="() => this.onInput(setting.key)"/>
                        <label class="form-check-label" t-att-for="setting.id"><t t-esc="setting.label"/></label>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="save">OK</button>
                <button class="btn btn-secondary" t-on-click="close">Cancel</button>
                <div class="ms-auto">
                     <button class="btn btn-warning me-2" t-if="hasChanges()" t-on-click="undoAll" title="Undo all changes">
                        <i class="fa fa-undo" aria-hidden="true"></i>
                    </button>
                    <button class="btn btn-info" t-if="hasDiffFromDefaults()" t-on-click="resetAll" title="Reset all to Odoo's default">
                        Reset all
                    </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
