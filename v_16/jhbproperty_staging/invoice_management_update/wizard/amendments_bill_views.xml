<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="amendments_bill_view_form" model="ir.ui.view">
        <field name="name">amendments.bill.view.form</field>
        <field name="model">amendments.bill</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="move_id" readonly="1"/>
                        <field name="any_amendments"/>
                    </group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="attachment_ids" widget="many2many_binary"
                        attrs="{'invisible': [('any_amendments', '!=', True)]}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_submit" string="Submit" type="object"
                            default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>