<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <record id="invoice_interest_view_form" model="ir.ui.view">
       <field name="name">invoice.interest.view.form</field>
       <field name="model">invoice.interest</field>
       <field name="arch" type="xml">
           <form>
               <group>
                   <group>
                       <field name="invoice_id"/>
                       <field name="payment_state"/>
                   </group>
                   <group>
                       <field name="partner_id"/>
                   </group>

               </group>
               <footer>
                   <button name="action_submit" string="Submit" type="object"
                             default_focus="1" class="oe_highlight"/>
                   <button string="Cancel" class="btn btn-default" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
   <record id="invoice_interest_action" model="ir.actions.act_window">
       <field name="name">Invoice Interest</field>
       <field name="res_model">invoice.interest</field>
       <field name="type">ir.actions.act_window</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
   </record>
   <menuitem id="invoice_interest_menu" name="Invoice interest"
              parent="account.menu_finance_receivables" action="invoice_interest_action" />
</odoo>
