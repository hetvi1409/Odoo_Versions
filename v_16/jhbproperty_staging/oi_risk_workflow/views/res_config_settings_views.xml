<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Adding more fields to res config settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="oi_risk_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='oi_risk_management']" position="inside">
                <h2>Approvers</h2>
                <div class="row mt16 o_settings_container" name="risk_workflow_approvers_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="risk_workflow_preparer">
                        <div class="o_setting_left_pane">
                            <field name="preparer_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="preparer_id" string="Preparer"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="risk_workflow_reviewer">
                        <div class="o_setting_left_pane">
                            <field name="reviewer_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="reviewer_id" string="Reviewer"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="risk_workflow_approver">
                        <div class="o_setting_left_pane">
                            <field name="approver_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="approver_id" string="Approver"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
