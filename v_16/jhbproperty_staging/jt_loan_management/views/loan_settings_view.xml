<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="special_account_view" model="ir.ui.view">
            <field name="name">loan.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">

                <div class="app_settings_block" data-string="Loan" string="Loan" data-key="jt_loan_management" >
                    <h2>Bad Debt Accounts for Loans</h2>
                    <div class="row mt16 o_settings_container" >
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="write_off_account_id"/>
                                <field name="loan_counter" invisible="1"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Account used to write-off the unpaid
                                        amount from the invoices, which need to
                                        be cancelled when loan was Cancelled / Closed.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="write_off_account_id"
                                       domain="[('company_id','=',company_id)]"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Loans Accounts and Products</h2>
                    <div class="row mt16 o_settings_container" >
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="interest_prod_id"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Product used to invoice as the interest of the loans.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="interest_prod_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('type', '!=', 'property'),'|',('company_id','=',company_id),('company_id','=',False)]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="processing_fee_prod_id" string="Processing Fee Product"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Product used to invoice as processing fee from the loans.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="processing_fee_prod_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('type', '!=', 'property'),'|',('company_id','=',company_id),('company_id','=',False)]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="acc_rec_id" string="Current Assets"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Current Assets for Counter entry of Account Receivable towards Principal on loan invoices.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="acc_rec_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id)]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="income_acc_id" string="Loan Income Account"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Income Account used in loan invoice items.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="income_acc_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id)]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="loan_jou_id" string="Loan Journal"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Journal used in loan invoice.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="loan_jou_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id),('type','=','sale')]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="disbursement_acc_id" string="Disbursement Account"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Disbursement Account used in loan amount entry.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="disbursement_acc_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id)]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="disbursement_journal_id" string="Disbursement Journal"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Disbursement Journal used in loan amount entry.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="disbursement_journal_id"
                                       required='1'
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('type','=','general'),('company_id','=',company_id)]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="penalty_product_id" string="Penalty Product"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Select the product that will be used as penalty product on due invoices.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="penalty_product_id" readonly="0"
                                       required='1'
                                       domain="[('type','=','service')]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="principal_product_id" string="Principle Product"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Select the product that will be used as penalty product on due invoices.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                <field name="principal_product_id" readonly="0"
                                       required='1'
                                       domain="[('type','=','service')]"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="inv_create_date" string="Auto Invoice Create Date"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Installment Invoice Create Date before how much days from installment due date.
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
<field name="inv_create_date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Penalty on Due Invoices</h2>
                    <div class="row mt16 o_settings_container" >
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="penalty_option"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Charge Penalty Or Interest
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="penalty_option"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('penalty_option', '!=', 'penalty')], 'required': [('penalty_option', '!=', False)]}">
                            <div class="o_setting_right_pane">
                                <label for="charge_option"/>
                                <div class="row">
                                    <div class="text-muted col-md-8">
                                        Charge penalty with
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="charge_option"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('penalty_option', '!=', 'interest')]}">
                            <div class="o_setting_right_pane">
                                <label for="charge" string="Daily Interest Rate (%)"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="charge"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('penalty_option', '!=', 'fixed')]}">
                            <div class="o_setting_right_pane">
                                <label for="charge" string="Fixed amount"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="charge"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('penalty_option', '!=', 'penalty'), ('charge_option', '!=', 'percentage')]}">
                            <div class="o_setting_right_pane">
                                <label for="charge" string="In Percentage (%)"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="charge"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" attrs="{'invisible': [('penalty_option', '!=', 'penalty'), ('penalty_option', '!=', 'interest')]}">
                            <div class="o_setting_right_pane">
                                <label for="charge" string="Allow # of days after due"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="of_days"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                    <app data-string="Loans" string="Loans"
                         name="jt_loan_management">
                        <block title="Bad Debt Accounts for Loans"
                               id="bad_debt_account_loan">
                            <setting id="write_off_account"
                                     string="Write-Off Account" help="Account used to write-off the unpaid amount from the invoices, which need to
                                            be cancelled when loan was Cancelled / Closed.">
                                <field name="loan_counter" invisible="1"/>
                                <field name="write_off_account_id"
                                       domain="[('company_id','=',company_id)]"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"/>
                            </setting>
                        </block>
                        <block title="Loans Accounts and Products" id="loan_account_and_product">
                            <setting id="interest_product"
                                     string="Interest Product"
                                     help="Product used to invoice as the interest of the loans.">
                                <field name="interest_prod_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('type', '!=', 'property'),'|',('company_id','=',company_id),('company_id','=',False)]"/>
                            </setting>
                            <setting id="processing_fee_product"
                                     string="Processing Fee Product"
                                     help="Product used to invoice as processing fee from the loans.">
                                <field name="processing_fee_prod_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('type', '!=', 'property'),'|',('company_id','=',company_id),('company_id','=',False)]"/>
                            </setting>
                            <setting id="current_assets" string="Current Assets"
                                     help="Current Assets for Counter entry of Account Receivable towards Principal on loan invoices.">
                                <field name="acc_rec_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id)]"/>
                            </setting>
                            <setting id="loan_income_account"
                                     string="Loan Income Account"
                                     help="Income Account used in loan invoice items.">
                                <field name="income_acc_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id)]"/>
                            </setting>
                            <setting id="loan_journals" string="Loan Journal"
                                     help="Journal used in loan invoice.">
                                <field name="loan_jou_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id),('type','=','sale')]"/>
                            </setting>
                            <setting id="disbursement_account"
                                     string="Disbursement Account"
                                     help="Disbursement Account used in loan amount entry.">
                                <field name="disbursement_acc_id"
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('company_id','=',company_id)]"/>
                            </setting>
                            <setting id="disbursement_journal"
                                     string="Disbursement Journal"
                                     help="Disbursement Journal used in loan amount entry.">
                                <field name="disbursement_journal_id"
                                       required='1'
                                       attrs="{'readonly': [('loan_counter', '>', 0)]}"
                                       domain="[('type','=','general'),('company_id','=',company_id)]"/>
                            </setting>
                            <setting id="penalty_product"
                                     string="Penalty Product"
                                     help="Select the product that will be used as penalty product on due invoices.">
                                <field name="penalty_product_id" readonly="0"
                                       required='1'
                                       domain="[('type','=','service')]"/>
                            </setting>
                            <setting id="principal_product"
                                     string="Principal Product"
                                     help="Select the product that will be used as penalty product on due invoices.">
                                <field name="principal_product_id" readonly="0"
                                       required='1'
                                       domain="[('type','=','service')]"/>
                            </setting>
                            <setting id="j_inv_create_date"
                                     string="Auto Invoice Create Date"
                                     help="Installment Invoice Create Date before how much days from installment due date.">
                                <field name="inv_create_date"/>
                            </setting>
                        </block>
                        <block title="Penalty on Due Invoices"
                               id="penalty_due_inv">
                            <setting id="charge_penalty_int"
                                     string="Charge Penalty Or Interest :">
                                <field name="penalty_option"/>
                            </setting>
                            <div class="row"
                                 attrs="{'invisible': [('penalty_option', '!=', 'penalty')]}">
                                <setting id="charge_penalty_with"
                                         string="Charge penalty with :"
                                         attrs="{'invisible': [('penalty_option', '!=', 'penalty')], 'required': [('penalty_option', '!=', False)]}">
                                    <field name="charge_option"/>
                                </setting>
                            </div>
                            <div class="row">
                                <setting id="daily_"
                                         string="Daily Interest Rate (%)"
                                         attrs="{'invisible': [('penalty_option', '!=', 'interest')]}">
                                    <field name="charge"/>
                                </setting>
                                <setting id="fixed_amt" string="Fixed amount"
                                         attrs="{'invisible': [('charge_option', '!=', 'fixed')]}">
                                    <field name="charge"/>
                                </setting>
                                <setting id="in_percentage"
                                         string="In Percentage (%)"
                                         attrs="{'invisible': [('penalty_option', '!=', 'penalty'), ('charge_option', '!=', 'percentage')]}">
                                    <field name="charge"/>
                                </setting>
                            </div>
                            <div class="row">
                                <setting string="Allow # of days after due"
                                         attrs="{'invisible': [('penalty_option', '!=', 'penalty'), ('penalty_option', '!=', 'interest')]}">
                                    <field name="of_days"/>
                                </setting>
                            </div>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_loan_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'jt_loan_management', 'bin_size':
                False}
            </field>
        </record>

        <menuitem id="account_config"
                  name="Configurations"
                  parent="jt_loan_management.menu_loans"
                  sequence="6"
        />

        <menuitem id="account_setting"
                  name="Settings"
                  parent="account_config"
                  sequence="6"
                  action="action_loan_configuration"
        />

    </data>
</odoo>
