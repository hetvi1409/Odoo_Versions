<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_strategy_view_form_1" model="ir.ui.view">
        <field name="name">audit_strategy_view_form</field>
        <field name="model">audit.strategy</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.audit_strategy_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form>
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}"
                               statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                        <button name="action_review" type="object"
                                string="Prepare" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('preparer_id', '!=', uid)]}"/>
                        <button name="action_2nd_review" type="object"
                                string="Review"
                                class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                        <button name="action_revert" type="object"
                                string="Revert" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                        <button name="action_approve" type="object"
                                string="Approve"
                                class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                        <button name="action_reject" type="object"
                                string="Reject"
                                class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                        <button name="action_update" type="object"
                               
                                string="Updated" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'reverted'), ('preparer_id', '!=', uid)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_records" type="object"
                                    string="Revert Records"
                                    class="oe_stat_button" icon="fa-book">
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"
                                       attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="requirements"
                                       attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="user_id"
                                       attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="record_work_done"
                                       attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="conclusion"
                                       attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            </group>
                            <group>
                                <field name="user_ids" invisible="1"/>
                                <field name="team_id"
                                       attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="can_edit" invisible="1"/>
                                <field name="preparer_id" widget="many2one_avatar_user"/>
                                <field name="reviewer_id" widget="many2one_avatar_user"/>
                                <field name="approver_id" widget="many2one_avatar_user"/>
                            </group>
                        </group>
                        <group>
                            <field name="attachment_ids" widget="many2many_binary"
                                   attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            <field name="feedback"
                                   attrs="{'readonly': [('can_edit', '!=', False)], 'invisible': [('state', 'not in', ['reverted'])]}"/>
                        </group>
                        <notebook>
                            <page string="Tracking"
                                  name="audit_strategy_tracking_ids">
                                <field name="audit_strategy_tracking_ids"
                                       options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}" attrs="{'readonly': [('can_edit', '!=', False)]}">
                                    <tree editable="bottom" create="0" edit="0">
                                        <field name="user_id"/>
                                        <field name="previous_stage_id"/>
                                        <field name="new_stage_id"/>
                                        <field name="comment"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
                </form>
            </xpath>
        </field>
    </record>
</odoo>