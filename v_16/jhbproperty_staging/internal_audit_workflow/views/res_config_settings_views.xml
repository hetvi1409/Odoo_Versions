<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Adding more fields to res config settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]/div[@data-key='project']" position="inside">
                <div class="row mt16 o_settings_container" name="internal_audit_workflow">
                    <div class="col-12 col-lg-6 o_setting_box" id="audit_preparer_setting">
                        <div class="o_setting_left_pane">
                            <field name="audit_preparer_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="audit_preparer_id" string="Preparer"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="audit_reviewer_setting">
                        <div class="o_setting_left_pane">
                            <field name="audit_reviewer_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="audit_reviewer_id" string="Reviewer"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="audit_approver_setting">
                        <div class="o_setting_left_pane">
                            <field name="audit_approver_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="audit_approver_id" string="Approver"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
