<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_action_plan_view_form" model="ir.ui.view">
        <field name="name">audit_action_plan_view_form</field>
        <field name="model">audit.action.plan</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.audit_action_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form>
                    <header>
                        <field name="stages" widget="statusbar" options="{'clickable': '1'}"
                               statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                        <button name="action_review" type="object"
                                string="Prepare" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'draft'), ('preparer_id', '!=', uid)]}"/>
                        <button name="action_2nd_review" type="object"
                                string="Review"
                                class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                        <button name="action_revert" type="object"
                               
                                string="Revert"
                                class="oe_highlight" attrs="{'invisible': [('stages', 'not in', ['preparer', 'second_reviewer', 'first_reviewer'])]}"/>
                        <button name="action_approve" type="object"
                                string="Approve"
                                class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                        <button name="action_reject" type="object"
                                string="Reject"
                                class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_records" type="object"
                                    string="Revert Records"
                                    class="oe_stat_button" icon="fa-book">
                            </button>
                        </div>
                        <widget name="web_ribbon" text="Closed" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <group>
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="type" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="requirements" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="user_id" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="team_id" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="record_work_done" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="conclusion" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="feedback" attrs="{'invisible': [('stages', 'not in', ['refuse'])]}"/>
                            </group>
                            <group>
                                <field name="rating" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="deficiency" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="department_id" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="start_date" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="manager_id" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="can_edit" invisible="1"/>
                                <field name="preparer_id" widget="many2one_avatar_user"/>
                                <field name="reviewer_id" widget="many2one_avatar_user"/>
                                <field name="approver_id" widget="many2one_avatar_user"/>
                                <field name="project_id" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="project_task" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="audit_type" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="finding" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="impact" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="recommendation" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="section" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="reviewer" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="completion_date" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="resolved" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            </group>
                        </group>
                        <group>
                            <field name="attachment_ids" widget="many2many_binary" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            <field name="blockages" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            <field name="proposed_completion_date" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            <field name="auditor_conclusion" attrs="{'readonly': ['!', ('can_edit', '!=', False)]}"/>
                        </group>
                        <notebook>
                            <page string="Audit Action" name="audit">
                                <field name="audit_details" attrs="{'readonly': ['!', ('can_edit', '!=', False)]}"/>
                            </page>
                        </notebook>
                        <notebook>
                            <page string="Record of Work Done" name="record_of_work_ids">
                                <field name="record_of_work_ids" attrs="{'readonly': ['!', ('can_edit', '!=', False)]}">
                                    <tree editable="bottom">
                                        <field name="audit_area"/>
                                        <field name="title_of_finding"/>
                                        <field name="recommendation"/>
                                        <field name="mgmt_action_plan"/>
                                        <field name="action_date"/>
                                        <field name="implemented_not"/>
                                        <field name="follow_up"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents" name="documents">
                                <field name="attachment_doc_ids" widget="many2many_binary" attrs="{'readonly': ['!', ('can_edit', '!=', False)]}"/>
                            </page>
                            <page string="Audit Reverts/ Review Notes">
                                <group>
                                    <field name="feedback" attrs="{'readonly': ['!', ('can_edit', '!=', False)]}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
                </form>
            </xpath>
            <!--            <xpath expr="//header" position="replace">-->
            <!--                <header>-->
            <!--                    <field name="stages" widget="statusbar" options="{'clickable': '1'}"-->
            <!--                           statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>-->
            <!--                    <button name="action_review" type="object" attrs="{'invisible': ['|', ('stages', '!=', 'draft'), ('preparer_id', '!=', uid)]}">-->
            <!--                            string="Prepare" class="oe_highlight"/>-->
            <!--                    <button name="action_2nd_review" type="object"-->
            <!--                            invisible="stages != 'preparer' or uid != reviewer_id" string="Review"-->
            <!--                            class="oe_highlight"/>-->
            <!--                    <button name="action_revert" type="object"-->
            <!--                            invisible="stages not in ['second_reviewer', 'first_reviewer']" string="Revert"-->
            <!--                            class="oe_highlight"/>-->
            <!--                    <button name="action_approve" type="object"-->
            <!--                            invisible="stages != 'second_reviewer' or uid != approver_id" string="Approve"-->
            <!--                            class="oe_highlight"/>-->
            <!--                    <button name="action_reject" type="object"-->
            <!--                            invisible="stages != 'second_reviewer' or uid != approver_id" string="Reject"-->
            <!--                            class="oe_highlight"/>-->
            <!--                </header>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//field[@name='user_preparer_ids']" position="replace">-->
            <!--                <field name="preparer_id" widget="many2one_avatar_user"/>-->
            <!--                <field name="reviewer_id" widget="many2one_avatar_user"/>-->
            <!--                <field name="approver_id" widget="many2one_avatar_user"/>-->
            <!--            </xpath>-->
        </field>
    </record>
</odoo>