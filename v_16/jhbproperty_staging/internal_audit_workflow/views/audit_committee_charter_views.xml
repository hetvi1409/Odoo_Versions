<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_committee_charter_view_form" model="ir.ui.view">
        <field name="name">audit_committee_charter_view_form</field>
        <field name="model">audit.committee.charter</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.audit_committee_charter_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form>
                    <header>
                        <field name="stages" widget="statusbar" options="{'clickable': '1'}"
                               statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                        <button name="action_review" type="object"
                               
                                string="Preparer" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'draft'), ('preparer_id', '!=', uid)]}"/>
                        <button name="action_2nd_review" type="object"
                               
                                string="Review" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                        <button name="action_revert_comment" type="object"
                               
                                string="Revert" class="oe_highlight" attrs="{'invisible': ['|', ('stages', 'not in', ['preparer', 'first_reviewer']), ('reviewer_id', '!=', uid)]}"/>
                        <button name="action_approve" type="object"
                               
                                string="Approve" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                        <button name="action_revert_comment" type="object"
                               
                                string="Revert" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                        <button name="action_reject" type="object"
                               
                                string="Reject" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                        <button name="action_revert" type="object"
                               
                                string="Move to Prepare" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'rejected'), ('approver_id', '!=', uid)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_records" type="object"
                                    string="Revert Records"
                                    class="oe_stat_button" icon="fa-book">
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="sequence_no" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="project_id" invisible="1"/>
                                <field name="requirements" style="height: 105px;" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="user_id" invisible="1" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="record_work_done" style="height: 105px;" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                <field name="conclusion" style="height: 105px;" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                            </group>
                            <group>
                                <field name="can_edit" invisible="1"/>
                                <field name="preparer_id" widget="many2one_avatar_user"/>
                                <field name="reviewer_id" widget="many2one_avatar_user"/>
                                <field name="approver_id" widget="many2one_avatar_user"/>
                                <field name="user_ids" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Upload Audit Committee Charter">
                                <group>
                                    <field name="attachment_ids" widget="many2many_binary" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                </group>
                                <group>
                                    <button name="action_view_documents"
                                           
                                            type="object" icon="fa-file-text-o"
                                            string="Open Documents" attrs="{'invisible': [('attachment_ids', '!=', False)]}"/>
                                </group>
                            </page>
                            <page string="Documents">
                                <group>
                                    <group>
                                        <field name="document_ids"
                                               widget="many2many_binary" attrs="{'readonly': [('can_edit', '!=', False)]}">
                                        </field>
                                    </group>
                                    <group>
                                        <button name="action_view_documents"
                                               
                                                type="object" icon="fa-file-text-o"
                                                string="Open Documents" attrs="{'invisible': [('document_ids', '!=', False)]}"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Tracking"
                                  name="audit_committee_charter_tracking">
                                <field name="audit_committee_charter_tracking_ids"
                                       options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}" attrs="{'readonly': [('can_edit', '!=', False)]}">
                                    <tree editable="bottom" create="0" edit="0">
                                        <field name="user_id"/>
                                        <field name="previous_stage_id"/>
                                        <field name="new_stage_id"/>
                                        <field name="comment"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Audit Reverts/ Review Notes">
                                <group>
                                    <field name="feedback" attrs="{'readonly': [('can_edit', '!=', False)]}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
                </form>
            </xpath>
