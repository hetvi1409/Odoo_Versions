<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_universe_view_form_inherited" model="ir.ui.view">
        <field name="name">audit_universe_view_form</field>
        <field name="model">audit.universe</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.audit_universe_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <field name="stages" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                    <button name="action_review" type="object"
                           
                            string="Preparer" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'draft'), ('preparer_id', '!=', uid)]}"/>
                    <button name="action_2nd_review" type="object"
                           
                            string="Review" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                    <button name="action_reject" type="object"
                           
                            string="Reject" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Move to Prepare" class="oe_highlight" attrs="{'invisible': ['|', ('stages', '!=', 'rejected'), ('approver_id', '!=', uid)]}"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="preparer_id" widget="many2one_avatar_user"/>
                <field name="reviewer_id" widget="many2one_avatar_user"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
                <field name="can_edit" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='sequence_no']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='period']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='end_date']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='audit_line_ids']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='feedback']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
