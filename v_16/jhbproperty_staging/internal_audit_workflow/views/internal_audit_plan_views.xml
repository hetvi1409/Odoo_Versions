<!--                            invisible="state in ['reverted', 'rejected', 'approved']"-->
<!--                            string="Refuse"/>-->
<!--                    <button name="action_send_sign" type="object" string="Send For Sign" class="oe_highlight"/>-->
<!--                    <button name="action_revert" type="object"-->
<!--                            invisible="state not in ['first_reviewer', 'second_reviewer']" string="Revert"-->
<!--                            class="oe_highlight"/>-->
<!--                </header>-->
<!--            </xpath>-->
