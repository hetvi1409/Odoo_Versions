<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="prof_dev_form" model="ir.ui.view">
        <field name="name">prof_dev_form</field>
        <field name="model">professional.development</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.prof_dev_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                    <button name="action_2nd_review" type="object" string="Prepare"
                            class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'preparer'), ('preparer_id', '!=', uid)]}"/>
                    <button name="action_approve" type="object" string="Reviewed"
                            class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'second_reviewer'), ('reviewer_id', '!=', uid)]}"/>
                    <button name="action_send_back_review" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_update" type="object"
                           
                            string="Updated" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'reverted')]}"/>
                    <button name="action_send_back_review" type="object"
                           
                            string="Move to Prepare" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='user_preparer_ids']" position="replace">
                <field name="can_edit" invisible="1"/>
                <field name="preparer_id" widget="many2one_avatar_user"/>
                <field name="reviewer_id" widget="many2one_avatar_user"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
            </xpath>
            <xpath expr="//field[@name='wp_reference']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='subject']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='end_date']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_prof']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='member_details']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='document_ids']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='feedback']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
