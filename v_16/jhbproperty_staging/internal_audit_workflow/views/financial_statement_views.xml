<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="financial_statement_view_form" model="ir.ui.view">
        <field name="name">financial_statement_view_form</field>
        <field name="model">financial.statement</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="internal_audit_management.financial_statement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="preparer,second_reviewer,approved,reverted,rejected"/>
                    <button name="action_review" type="object"
                           
                            string="Prepare" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('preparer_id', '!=', uid)]}"/>
                    <button name="action_2nd_review" type="object" string="Reviewer" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'preparer'), ('reviewer_id', '!=', uid)]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'second_reviewer'), ('approver_id', '!=', uid)]}"/>
                    <button name="action_mark_discrepancy" type="object"
                           
                            string="Refuse" attrs="{'invisible': [('state', 'in', ['reverted', 'rejected'])]}"/>
                    <button name="action_send_back_review" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('state', 'in', ['draft', 'rejected', 'reverted', 'approved'])]}"/>
                    <button name="action_send_back_new" type="object"
                           
                            string="Move To New" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='user_preparer_ids']" position="replace">
                <field name="can_edit" invisible="1"/>
                <field name="preparer_id" widget="many2one_avatar_user"/>
                <field name="reviewer_id" widget="many2one_avatar_user"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='requirements']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='record_work_done']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='conclusion']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='document_ids']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='financial_statement_tracking_ids']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='feedback']" position="attributes">
                <attribute name="attrs">{'readonly': [('can_edit', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
