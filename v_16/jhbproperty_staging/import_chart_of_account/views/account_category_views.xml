<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="account_category_view_tree" model="ir.ui.view">
       <field name="name">account.category.view.tree</field>
       <field name="model">account.category</field>
       <field name="arch" type="xml">
           <tree editable="bottom">
               <field name="name"/>
           </tree>
       </field>
   </record>
   <record id="account_category_action" model="ir.actions.act_window">
       <field name="name">Account Category</field>
       <field name="res_model">account.category</field>
       <field name="type">ir.actions.act_window</field>
       <field name="view_mode">tree</field>
   </record>
   <menuitem id="account_category_import_menu" name="Account Category"
              parent="account.account_account_menu" action="account_category_action" />
</odoo>