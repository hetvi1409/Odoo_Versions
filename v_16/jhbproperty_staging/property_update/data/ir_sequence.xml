<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_jmc_number" model="ir.sequence">
            <field name="name">JMC Number Sequence</field>
            <field name="code">building.jmc_number</field>
            <field name="prefix">JMC</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
    <record id="ir_cron_action_to_do" model="ir.cron">
        <field name="name">Action Rental count To Do</field>
        <field name="model_id" ref="itsys_real_estate.model_building"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_rental_count()
        </field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>