    <record id="creditor_region_view_tree" model="ir.ui.view">
        <field name="name">creditor.region.view.tree</field>
        <field name="model">creditor.region</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="creditor_region_action" model="ir.actions.act_window">
        <field name="name">Creditor Region</field>
        <field name="res_model">creditor.region</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new Creditor Region.
            </p>
        </field>
    </record>
    <menuitem parent="itsys_real_estate.menu_settings"
              id="menu_creditor_region" name="Creditor Region"
              action="creditor_region_action" sequence="20"/>
