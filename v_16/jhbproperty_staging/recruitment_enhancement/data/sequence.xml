<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_recruitment_requisition" model="ir.sequence">
        <field name="name">Recruitment Requisition</field>
        <field name="code">recruitment.requisition</field>
        <field name="prefix">SCM/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_recruitment_shortlisting" model="ir.sequence">
        <field name="name">Recruitment Shortlisting</field>
        <field name="code">recruitment.shortlisting</field>
        <field name="prefix">SHORT/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_recruitment_interview_session" model="ir.sequence">
        <field name="name">Recruitment Interview Session</field>
        <field name="code">recruitment.interview.session</field>
        <field name="prefix">INT/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_recruitment_offer" model="ir.sequence">
        <field name="name">Recruitment Offer</field>
        <field name="code">recruitment.offer</field>
        <field name="prefix">OFF/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_recruitment_background_check" model="ir.sequence">
        <field name="name">Recruitment Background Check</field>
        <field name="code">recruitment.background.check</field>
        <field name="prefix">BGC/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_job_application" model="ir.sequence">
        <field name="name">Job Application</field>
        <field name="code">hr.applicant</field>
        <field name="prefix">JOB/</field>
        <field name="padding">5</field>
    </record>
</odoo>
