<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_recruitment_process_user" model="res.groups">
        <field name="name">Recruitment Process User</field>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
    </record>

    <record id="group_recruitment_process_manager" model="res.groups">
        <field name="name">Recruitment Process Manager</field>
        <field name="implied_ids" eval="[(4, ref('recruitment_enhancement.group_recruitment_process_user'))]"/>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>


    <record id="group_recruitment_head_of_department_custom" model="res.groups">
        <field name="name">Head of Department</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_recruitment_line_manager_custom" model="res.groups">
        <field name="name">Line Manager</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_recruitment_background" model="res.groups">
        <field name="name">Background Verification</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>


    <record id="recruitment_requisition_rule_turn_based_access" model="ir.rule">
        <field name="name">Recruitment Requisition: Turn-based Access</field>
        <field name="model_id" ref="recruitment_enhancement.model_recruitment_requisition"/>
        <field name="groups"
               eval="[(4, ref('recruitment_enhancement.group_recruitment_process_user')),
                      (4, ref('recruitment_enhancement.group_recruitment_process_manager')),
                      (4, ref('base.group_user'))]"/>
        <field name="domain_force">
            user.id in [1, 2] and [(1,'=',1)] or ['|','|','|',
            ('create_uid', '=', user.id),
            ('hr_coordinator_id', '=', user.id),
            ('allowed_user_ids', 'in', [user.id]),
            ('message_partner_ids', 'in', [user.partner_id.id])]
        </field>
    </record>
</odoo>