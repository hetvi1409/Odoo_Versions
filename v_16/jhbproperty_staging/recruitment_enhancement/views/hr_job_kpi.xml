<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_hr_job_kpi_tree" model="ir.ui.view">
		<field name="name">hr.job.kpi.tree</field>
		<field name="model">hr.job.kpi</field>
		<field name="arch" type="xml">
			<tree string="Job KPI's">
				<field name="name"/>
			</tree>
		</field>
	</record>

	<record id="view_hr_job_kpi_form" model="ir.ui.view">
		<field name="name">hr.job.kpi.form</field>
		<field name="model">hr.job.kpi</field>
		<field name="arch" type="xml">
			<form string="Job KPI Tag">
				<sheet>
					<group>
						<field name="name"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_hr_job_kpi" model="ir.actions.act_window">
		<field name="name">Job KPI's</field>
		<field name="res_model">hr.job.kpi</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Create your first Job KPI's
			</p>
		</field>
	</record>

	<menuitem id="menu_hr_job_kpi"
			  name="Job KPI's"
			  parent="hr_recruitment.menu_hr_recruitment_configuration"
			  action="action_hr_job_kpi"
			  sequence="50"/>

</odoo>
