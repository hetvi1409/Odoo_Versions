<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approver_role_view_list" model="ir.ui.view">
        <field name="name">approver.role.list</field>
        <field name="model">approver.role</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
