<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="outdoor_advertisement_view_tree" model="ir.ui.view">
        <field name="name">outdoor.advertisement.list.view</field>
        <field name="model">outdoor.advertisement</field>
        <field name="inherit_id"
               ref="property_update.outdoor_advertisement_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="export_outdoor"
                            string="Export Outdoor"
                            type="object"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>