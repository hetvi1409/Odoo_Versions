<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <!--Scheduled action for fetching mails-->
    <record id="servitude_register_date_action" model="ir.cron">
       <field name="name">Expired Date</field>
       <field name="model_id" ref="model_servitude_register"/>
       <field name="state">code</field>
       <field name="code">model.action_expired_date()</field>
       <field name="user_id" ref="base.user_root"/>
       <field name="interval_number">1</field>
       <field name="interval_type">days</field>
       <field name="numbercall">-1</field>
   </record>
</odoo>