<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.module.category" id="module_servitude_register_category">
        <field name="name">Servitude Register</field>
        <field name="sequence">0</field>
    </record>

    <record id="group_servitude_register_finance_officer" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="category_id" ref="module_servitude_register_category"/>
    </record>
    <record id="group_servitude_register_surveyor" model="res.groups">
        <field name="name">Surveyor</field>
        <field name="implied_ids"
               eval="[(4, ref('group_servitude_register_finance_officer'))]"/>
        <field name="category_id" ref="module_servitude_register_category"/>
    </record>
    <record id="group_servitude_register_legal_officer" model="res.groups">
        <field name="name">Legal Officer</field>
        <field name="implied_ids"
               eval="[(4, ref('group_servitude_register_surveyor'))]"/>
        <field name="category_id" ref="module_servitude_register_category"/>
    </record>
    <record id="group_servitude_register_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="implied_ids"
               eval="[(4, ref('group_servitude_register_legal_officer'))]"/>
        <field name="category_id" ref="module_servitude_register_category"/>
    </record>


</odoo>