<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="event_description_full_inherit"
              inherit_id='website_event.event_description_full'
              name="Event Description Link">
        <xpath expr="//div[hasclass('o_wevent_theme_bg_light')]//div" position="after">
            <div t-if="event.webinar_link" class="o_wevent_sidebar_block">
                <h6 class="o_wevent_sidebar_title">Link</h6>
                <p class="mb-2">Please find the link, and join the <b>Webinar</b>.</p>
                <a t-att-href="event.webinar_link">Join Now</a>
            </div>
            <div t-if="event.podcast_link" class="o_wevent_sidebar_block">
                <h6 class="o_wevent_sidebar_title">Link</h6>
                <p class="mb-2">Please find the link, and listen the <b>Podcast</b>.</p>
                <a t-att-href="event.podcast_link">Listen Now</a>
            </div>
        </xpath>
    </template>
</odoo>