<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

	<record id="approval_committee_meeting" model="approval.config" forcecreate="False">
		<field name="model_id" ref="model_committee_meeting" />
		<field name="state">to approve</field>
		<field name="name">To Approve</field>
		<field name="sequence">10</field>
		<field name="group_ids" eval="[(4, ref('group_committee_member'))]" />
		<field name="condition">True</field>
		<field name="filter_condition">user in record.mapped('attendance_ids.employee_id.user_id')</field>
		<field name="schedule_activity" eval="True" />
		<field name="committee" eval="True" />
	</record>
	
</odoo>