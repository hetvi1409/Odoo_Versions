<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

	<record id="cron_update_committee_group_users" model="ir.cron" forcecreate="False">
		<field name="name">Update Committee Group Users</field>
		<field name="user_id" ref="base.user_root" />
		<field name="active" eval="True" />
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="model_id" ref="model_committee_type" />
		<field name="state">code</field>
		<field name="code">model._update_members()</field>
		<field name="nextcall" eval="datetime.today() + relativedelta(days=1,hour=0, second=0, minute=0)" />
		<field name="binding_model_id" ref="model_committee_type" />
		<field name="binding_type">action</field>
	</record>
	
	<record id="cron_update_committee_state" model="ir.cron" forcecreate="False">
		<field name="name">Update Committee Status</field>
		<field name="user_id" ref="base.user_root" />
		<field name="active" eval="True" />
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="model_id" ref="model_committee" />
		<field name="state">code</field>
		<field name="code">model._check_completed()</field>
		<field name="nextcall" eval="datetime.today() + relativedelta(days=1,hour=0, second=0, minute=0)" />
	</record>
	

</odoo>