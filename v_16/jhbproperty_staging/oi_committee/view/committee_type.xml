<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_committee_type_form" model="ir.ui.view">
		<field name="name">committee.type.form</field>
		<field name="model">committee.type</field>
		<field name="inherit_id" ref="base.view_groups_form" />
		<field name="mode">primary</field>
		<field name="arch" type="xml">
			<data>
				<field name="users" position="attributes">
					<attribute name="readonly">1</attribute>
				</field>
				<field name="share" position="after">
					<field name="model_id" />
					<field name="code" />
				</field>
			</data>
		</field>
	</record>
	
	<record id="view_committee_type_tree" model="ir.ui.view">
		<field name="name">committee.type.tree</field>
		<field name="model">committee.type</field>
		<field name="arch" type="xml">
			<tree>
				<field name="full_name" />
			</tree>
		</field>
	</record>	
	
	<record id="view_committee_type_search" model="ir.ui.view">
		<field name="name">committee.type.search</field>
		<field name="model">committee.type</field>
		<field name="arch" type="xml">
			<search>
				<field name="full_name" />
			</search>
		</field>
	</record>	
		
</odoo>
