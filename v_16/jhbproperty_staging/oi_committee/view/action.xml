<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="act_committee_type" model="ir.actions.act_window">
		<field name="name">Committee Type</field>
		<field name="res_model">committee.type</field>
		<field name="view_mode">tree,form</field>
	</record>

	<record id="act_committee" model="ir.actions.act_window">
		<field name="name">Committee</field>
		<field name="res_model">committee</field>
		<field name="view_mode">tree,form</field>
	</record>
	
	<record id="act_committee_meeting" model="ir.actions.act_window">
		<field name="name">Committee Meeting</field>
		<field name="res_model">committee.meeting</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{'search_default_active' : 1}</field>
	</record>
	

</odoo>
