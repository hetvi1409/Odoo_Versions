<odoo>
    <data noupdate="0">

        <!-- Daily -->
        <record id="ir_cron_daily_helpdesk_report" model="ir.cron">
            <field name="name">Daily Helpdesk Report (Open Tickets)</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model.send_daily_open_tickets_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Weekly -->
        <record id="ir_cron_weekly_helpdesk_report" model="ir.cron">
            <field name="name">Weekly Helpdesk Report (All Tickets)</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model.send_weekly_all_tickets_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Monthly -->
        <record id="ir_cron_monthly_helpdesk_report" model="ir.cron">
            <field name="name">Monthly Helpdesk Report (By Department Tickets)</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model.send_monthly_by_department_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
