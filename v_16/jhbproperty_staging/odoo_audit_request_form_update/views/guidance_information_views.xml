<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_guidance_information" model="ir.actions.act_window">
        <field name="name">Guidance Information</field>
        <field name="res_model">guidance.information</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Guidance
            </p>
            <p>
                Create and manage the Guidance and other information;
            </p>
        </field>
    </record>
    <menuitem name="Guidance Information"
              id="menu_audit_request_guidance_information"
              parent="odoo_audit_request_form.custom_audit_request_configuration_menu"
              action="odoo_audit_request_form_update.action_guidance_information"
              sequence="6"/>
    <record id="guidance_information_view_tree" model="ir.ui.view">
        <field name="name">guidance.information.view.tree</field>
        <field name="model">guidance.information</field>
        <field name="arch" type="xml">
            <tree string="Team" class="o_enquiry" duplicate="0">
                <field name="name"/>
                <field name="audit_category_id"/>
            </tree>
        </field>
    </record>
    <record id="guidance_information_view_form" model="ir.ui.view">
        <field name="name">guidance.information.view.form</field>
        <field name="model">guidance.information</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="audit_category_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="guidance" string="Guidance">
                            <field name="guidance"/>
                        </page>
                        <page name="information" string="Information">
                            <field name="information"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>