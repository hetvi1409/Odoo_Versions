<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit survey_page_statistics_header template to add a Print button -->
    <template id="survey_page_statistics_header_inherit" inherit_id="survey.survey_page_statistics_header">
        <xpath expr="//div[contains(@class, 'o_survey_statistics_header')]" position="inside">
            <!-- Add a Print button to the survey statistics header -->
            <button
                class="btn btn-primary d-print-none o_survey_results_print"
                aria-label="Print"
                title="Print">
                <i class="fa fa-print"></i> Print
            </button>
        </xpath>
    </template>
</odoo>
