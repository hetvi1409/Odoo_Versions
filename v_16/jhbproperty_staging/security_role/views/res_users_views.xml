<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_role_form" model="ir.ui.view">
        <field name="name">res.users.form.role.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <group>
                    <field name="access_role_id"/>
                    <field name="available_role_ids" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="res_users_view_search_inherite">
        <field name="name">res.users.view.search.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_share']" position="replace"/>
        </field>
    </record>

    <record id="base.action_res_users" model="ir.actions.act_window">
            <field name="context">{}</field>
        </record>
</odoo>
