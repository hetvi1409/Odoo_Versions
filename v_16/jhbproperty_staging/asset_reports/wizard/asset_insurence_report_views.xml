<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Asset insurance report -->
    <record id="asset_insurance_reports_view_form" model="ir.ui.view">
        <field name="name">asset.insurance.reports.view.form</field>
        <field name="model">asset.insurance.reports</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="to_date"/>
                    </group>
                    <group>
                        <field name="from_date"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xlsx" string="Print Excel report"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="asset_insurance_reports_action" model="ir.actions.act_window">
        <field name="name">Asset Insurance</field>
        <field name="res_model">asset.insurance.reports</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="asset_insurance_reports_menu"
              name="Asset insurance Report"
              action="asset_insurance_reports_action"
              parent="account.menu_finance_entries_management"/>
</odoo>
