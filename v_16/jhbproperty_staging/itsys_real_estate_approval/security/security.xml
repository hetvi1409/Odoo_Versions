<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_property_approval" model="ir.module.category">
        <field name="name">Property Asset Approval</field>
        <field name="description">Manage approval process for property assets</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_property_approval_manager" model="res.groups">
        <field name="name">Property Approval Manager</field>
        <field name="category_id" ref="module_category_property_approval"/>
    </record>

     <record id="asset_property_rule_manager" model="ir.rule">
        <field name="name">Property - Manager Access</field>
        <field name="model_id" ref="model_building_approval"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Allows access to all records -->
        <field name="groups" eval="[(4, ref('itsys_real_estate_approval.group_property_approval_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

     <record id="asset_property_rule_user" model="ir.rule">
        <field name="name">Property - User Access</field>
        <field name="model_id" ref="model_building_approval"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field> <!-- Users see only their own records -->
         <field name="groups" eval="[(4, ref('base.group_user'))]"/> <!-- Apply to regular users -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="asset_property_rule_manager_removal" model="ir.rule">
        <field name="name">Property - Manager Access Removal</field>
        <field name="model_id" ref="model_building_removal_approval"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Allows access to all records -->
        <field name="groups" eval="[(4, ref('itsys_real_estate_approval.group_property_approval_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

     <record id="asset_property_rule_user_removal" model="ir.rule">
        <field name="name">Property - User Access Removal</field>
        <field name="model_id" ref="model_building_removal_approval"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field> <!-- Users see only their own records -->
         <field name="groups" eval="[(4, ref('base.group_user'))]"/> <!-- Apply to regular users -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="asset_property_rule_manager_bulk_import" model="ir.rule">
        <field name="name">Property - Manager Access Bulk Import</field>
        <field name="model_id" ref="model_building_approval_bulk_import"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('itsys_real_estate_approval.group_property_approval_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="asset_property_rule_user_bulk_import" model="ir.rule">
        <field name="name">Property - User Access Bulk Import</field>
        <field name="model_id" ref="model_building_approval_bulk_import"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>