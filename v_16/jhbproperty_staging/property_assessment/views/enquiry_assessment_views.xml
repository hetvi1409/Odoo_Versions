<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="enquiry_assessment_view_form" model="ir.ui.view">
        <field name="name">enquiry.assessment.form.inherit</field>
        <field name="model">enquiry.assessment</field>
        <field name="inherit_id"
               ref="client_enquiry.enquiry_assessment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="title_deed_number"/>
                <field name="location"/>
                <field name="region_id"/>
                <field name="ward"/>
                <field name="market_value"/>
                <field name="zoning_id"/>
                <field name="sg_id"/>
                <field name="reg_date"/>
            </xpath>
        </field>
    </record>

</odoo>