<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.attendance.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')]/div[@name=('overtime_settings')]" position="after">
                <h2>Auto Check-in/Checkout Configuration</h2>
                <div class="row mt16 o_settings_container" name="start_time_setting_container">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="auto_checkin_enabled"/>
                        </div>
                        <div class="o_setting_right_pane" name="auto_checkin_enabled_right_pane">
                            <label for="auto_checkin_enabled"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <!--                                <span class="o_form_label">Set default working from</span>-->
                            <!--                                <div class="mt8">-->
                            <!--                                    <field name="hr_attendance_start_time" placeholder="08:00:00"/>-->
                            <!--                                </div>-->
                            <span class="o_form_label">Set default time check out</span>
                            <div class="mt8">
                                <field name="hr_attendance_end_time" placeholder="18:00:00"/>
                            </div>
                        </div>
                    </div>
                </div>
                <h2>Overtime Settings</h2>

                <div class="row mt16 o_settings_container">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="weekday_ot_rate"/>
                            <span class="fa fa-lg"
                                  title="Set the Weekday Overtime Rate here.."/>
                            <div class="row">
                                <div class="text-muted col-md-8">
                                    Set the Weekday Overtime Rate here..
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div class="address_format" readonly="1">
                                        <field name="weekday_ot_rate" style="width: 15%"/>
                                        /hour
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="col-6">
                            <label for="weekend_ot_rate"/>
                            <span class="fa fa-lg"
                                  title="Set the Weekend Overtime Rate here.."/>
                            <div class="row">
                                <div class="text-muted col-md-8">
                                    Set the Weekend Overtime Rate here..
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div class="address_format" readonly="1">
                                        <field name="weekend_ot_rate" style="width: 30%"/>
                                        /hour
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="holiday_ot_rate"/>
                            <span class="fa fa-lg"
                                  title="Set the Holiday Overtime Rate here.."/>
                            <div class="row">
                                <div class="text-muted col-md-8">
                                    Set the Holiday Overtime Rate here..
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div class="address_format" readonly="1">
                                        <field name="holiday_ot_rate" style="width: 15%"/>
                                        /hour
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="col-6">
                            <label for="ot_time_limit"/>
                            <span class="fa fa-lg"
                                  title="Set OT Time Difference here.."/>
                            <div class="row">
                                <div class="text-muted col-md-8">
                                    Set Overtime Time Limit here.
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <div class="address_format" readonly="1">
                                        <field name="ot_time_limit" style="width: 30%"/>
                                        /Minutes
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
