        <record id="crime_type_organized_crime" model="crime.type">
            <field name="name">Organized crime</field>
            <field name="description">
                The term “organized crime” refers to the unlawful activities of members of
                criminal organizations that supply illegal goods and services.
            </field>
        </record>
        <record id="crime_type_organized_crime_1" model="crime.type">
            <field name="name">Supply Illegal Goods and Services</field>
            <field name="parent_id" ref="crime_type_organized_crime"/>
        </record>

        <record id="crime_type_political_crime" model="crime.type">
            <field name="name">Political crime</field>
            <field name="description">
                The political‐crime category contains both crimes by the government and crimes against the government.
                Political goals motivate political criminals.
            </field>
        </record>
        <record id="crime_type_political_crime_1" model="crime.type">
            <field name="name">Crimes Against The Government</field>
            <field name="parent_id" ref="crime_type_political_crime"/>
        </record>
        <record id="crime_type_political_crime_2" model="crime.type">
