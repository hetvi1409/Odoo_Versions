<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_law_task_form" model="ir.ui.view">
            <field name="name">law.project.task.form.view</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[last()]" position="after">
                    <button name="update_default_task" string="Update Task List" type="object"
                            attrs="{'invisible': [('law_default_id', '=', False)]}"/>
                    <field name="law_default_id" invisible="1"/>
                    <button name="create_law_invoice" string="Create Invoice" type="object"/>
                    <field name="law_default_id" invisible="1"/>
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="open_invoice_from_task_view" icon="fa-files-o">
                        <field string="Invoice" name="count_invoice" widget="statinfo"/>
                    </button>
                </xpath>

                <xpath expr="//page[@name='extra_info']" position="before">
                    <page name="documents" string="Documents">
                        <field name="law_document_ids" widget="many2many_binary"/>
                    </page>
                </xpath>

                <xpath expr="//page[@name='extra_info']/group/group/field[@name='sequence']" position="before">
                    <field name="law_task_type" required="0"/>
                </xpath>

                <xpath expr="//field[@name='task_properties']" position="replace"/>

            </field>
        </record>

        <record id="quick_create_law_task_form" model="ir.ui.view">
            <field name="name">project.task.form.quick_create</field>
            <field name="model">project.task</field>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" required="1"/>
                        <field name="law_task_type" required="0"/>

                        <!-- Consultation -->
                        <field name="partner_id" string="Client" domain="[('is_law_client', '=', True)]"
                               attrs="{'invisible': [('law_task_type', '!=', 'consultation')]}"/>
                        <field name="user_ids" string="Lawyers"
                               domain="[('share', '=', False), ('active', '=', True)]"
                               options="{'no_open': True,'no_create': True}"
                               attrs="{'invisible': [('law_task_type', '!=', 'consultation')]}"
                               widget="many2many_avatar_user"/>
                        <field name="planned_hours" widget="float_time"
                               attrs="{'invisible': [('law_task_type', '!=', 'consultation')]}"/>
                        <field name="law_charges" attrs="{'invisible': [('law_task_type', '!=', 'consultation')]}"/>

                        <!-- Submission -->
                        <field name="law_sub_selection" attrs="{'invisible': [('law_task_type', '!=', 'submission')]}"/>
                        <field name="law_document_names" widget="many2many_tags"
                               attrs="{'invisible': ['|', ('law_task_type', '!=', 'submission'), ('law_sub_selection', '!=', 'doc')]}"/>
                        <field name="law_fund"
                               attrs="{'invisible': ['|', ('law_task_type', '!=', 'submission'), ('law_sub_selection', '!=', 'fund')]}"/>

                        <!-- Trial -->
                        <field name="court_id" options="{'no_open':True, 'no_create': True, 'no_create_edit': True}"
                               attrs="{'invisible': [('law_task_type', '!=', 'trial')]}"/>
                        <field name="judge_id" options="{'no_open':True, 'no_create': True, 'no_create_edit': True}"
                               attrs="{'invisible': [('law_task_type', '!=', 'trial')]}"/>
                        <field name="law_document_ids" widget="many2many_binary"
                               attrs="{'invisible': [('law_task_type', '!=', 'trial')]}"/>

                        <!-- Meeting -->
                        <field name="planned_date_begin" widget="daterange"
                               attrs="{'invisible': [('law_task_type', '!=', 'meeting')]}"
                               options='{"related_end_date": "planned_date_end"}'/>
                        <i class="fa fa-long-arrow-right mx-2 oe_edit_only"
                           attrs="{'invisible': [('law_task_type', '!=', 'meeting')]}"
                           aria-label="Arrow icon" title="Arrow"/>
                        <field name="planned_date_end" widget="daterange"
                               attrs="{'invisible': [('law_task_type', '!=', 'meeting')]}"
                               options='{"related_start_date": "planned_date_begin"}'/>

                        <!-- Other -->
                        <field name="description" nolabel="1" placeholder="Description"
                               attrs="{'invisible': [('law_task_type', '!=', 'other')]}"/>

                        <field name="company_id" invisible="1"/>
                        <field name="parent_id" invisible="1" groups="base.group_no_one"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_law_task_kanban" model="ir.ui.view">
            <field name="name">project.task.kanban</field>
            <field name="model">project.task</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column o_kanban_project_tasks"
                        on_create="quick_create" quick_create_view="law_firm_bits.quick_create_law_task_form">
                    <field name="name"/>
                    <field name="color"/>
                    <field name="priority"/>
                    <field name="stage_id" options='{"group_by_tooltip": {"description": "Description"}}'/>
                    <field name="user_ids"/>
                    <field name="partner_id"/>
                    <field name="sequence"/>
                    <field name="is_closed"/>
                    <field name="partner_is_company"/>
                    <field name="displayed_image_id"/>
                    <field name="active"/>
                    <field name="legend_blocked"/>
                    <field name="legend_normal"/>
                    <field name="legend_done"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    <field name="rating_last_value"/>
                    <field name="rating_ids"/>
                    <field name="allow_subtasks"/>
                    <field name="child_text"/>
                    <field name="is_private"/>
                    <progressbar field="kanban_state"
                                 colors='{"done": "success", "blocked": "danger", "normal": "muted"}'/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name" required="1"/>
                                            </strong>
                                            <br/>
                                            <strong class="o_kanban_record_title">
                                                <field name="law_task_type" required="1"/>
                                            </strong>
                                            <br/>
                                            <!-- Consultation -->
                                            <div attrs="{'invisible': [('law_task_type', '!=', 'consultation')]}">
                                                <span>Client :-</span>
                                                <field name="partner_id" string="Client"/>
                                                <br/>
                                                <span>Meeting Duration :-</span>
                                                <field name="planned_hours" widget="float_time"/>
                                                <br/>
                                                <span>Charges :-</span>
                                                <field name="law_charges"/>
                                            </div>

                                            <!-- Submission -->
                                            <div attrs="{'invisible': [('law_task_type', '!=', 'submission')]}">
                                                <field name="law_sub_selection"/>
                                                <br/>
                                                <field name="law_document_names" widget="many2many_tags"
                                                       attrs="{'invisible': [('law_sub_selection', '!=', 'doc')]}"/>
                                                <field name="law_fund"
                                                       attrs="{'invisible': [('law_sub_selection', '!=', 'fund')]}"/>
                                            </div>

                                            <!-- Trial -->
                                            <div attrs="{'invisible': [('law_task_type', '!=', 'trial')]}">
                                                <field name="court_id"/>
                                                <br/>
                                                <field name="judge_id"/>
                                            </div>

                                            <!-- Meeting -->
                                            <div attrs="{'invisible': [('law_task_type', '!=', 'meeting')]}">
                                                <field name="planned_date_begin"/>
                                                <br/>
                                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only"
                                                   attrs="{'invisible': [('law_task_type', '!=', 'meeting')]}"
                                                   aria-label="Arrow icon" title="Arrow"/>
                                                <br/>
                                                <field name="planned_date_end"/>
                                            </div>

                                            <!-- Other -->
                                            <div attrs="{'invisible': [('law_task_type', '!=', 'other')]}">
                                                <field name="description" widget="html"/>
                                            </div>

                                            <div attrs="{'invisible': [('law_task_type', '!=', False)]}">
                                                <strong class="o_kanban_record_title">
                                                    <s t-if="!record.active.raw_value">
                                                        <field name="name" widget="name_with_subtask_count"/>
                                                    </s>
                                                    <t t-else="">
                                                        <field name="name" widget="name_with_subtask_count"/>
                                                    </t>
                                                </strong>
                                                <br/>
                                                <span invisible="context.get('default_project_id', False)">
                                                    <br/>
                                                    <field name="project_id" widget="project_private_task"
                                                           options="{'no_open': True}"/>
                                                </span>
                                                <br/>
                                                <t t-if="record.partner_id.value">
                                                    <span t-if="!record.partner_is_company.raw_value">
                                                        <field name="commercial_partner_id"/>
                                                    </span>
                                                    <span t-else="">
                                                        <field name="partner_id"/>
                                                    </span>
                                                </t>
                                            </div>

                                        </div>
                                        <div class="o_dropdown_kanban dropdown" t-if="!selection_mode"
                                             groups="base.group_user">
                                            <a role="button" class="dropdown-toggle o-no-caret btn"
                                               data-toggle="dropdown" data-display="static" href="#"
                                               aria-label="Dropdown menu" title="Dropdown menu">
                                                <span class="fa fa-ellipsis-v"/>
                                            </a>
                                            <div class="dropdown-menu" role="menu">
                                                <a t-if="widget.editable" role="menuitem" type="set_cover"
                                                   class="dropdown-item" data-field="displayed_image_id">Set Cover Image
                                                </a>
                                                <a name="%(portal.portal_share_action)d" role="menuitem" type="action"
                                                   class="dropdown-item">Share
                                                </a>
                                                <a t-if="widget.editable" role="menuitem" type="edit"
                                                   class="dropdown-item">Edit
                                                </a>
                                                <div role="separator" class="dropdown-divider"/>
                                                <ul class="oe_kanban_colorpicker" data-field="color"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="tag_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                        <div t-if="record.date_deadline.raw_value" name="date_deadline"
                                             attrs="{'invisible': [('is_closed', '=', True)]}">
                                            <field name="date_deadline" widget="remaining_days"/>
                                        </div>
                                        <div t-if="record.displayed_image_id.value">
                                            <field name="displayed_image_id" widget="attachment_image"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom" t-if="!selection_mode">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority"/>
                                            <field name="activity_ids" widget="kanban_activity"/>
                                            <b t-if="record.rating_ids.raw_value.length">
                                                <span style="font-weight:bold;"
                                                      class="fa fa-fw mt4 fa-smile-o text-success"
                                                      t-if="record.rating_last_value.value == 5"
                                                      title="Latest Rating: Satisfied" role="img"
                                                      aria-label="Happy face"/>
                                                <span style="font-weight:bold;"
                                                      class="fa fa-fw mt4 fa-meh-o text-warning"
                                                      t-if="record.rating_last_value.value == 3"
                                                      title="Latest Rating: Okay" role="img" aria-label="Neutral face"/>
                                                <span style="font-weight:bold;"
                                                      class="fa fa-fw mt4 fa-frown-o text-danger"
                                                      t-if="record.rating_last_value.value == 1"
                                                      title="Latest Rating: Dissatisfied" role="img"
                                                      aria-label="Sad face"/>
                                            </b>
                                        </div>
                                        <div class="oe_kanban_bottom_right" t-if="!selection_mode">
                                            <field name="kanban_state" widget="state_selection" groups="base.group_user"
                                                   invisible="context.get('fsm_mode', False)"/>
                                            <t t-if="record.user_ids.raw_value">
                                                <field name="user_ids" widget="many2many_avatar_user"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                <div class="oe_clear"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="act_project_law_task_all" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree,kanban,form,calendar</field>
            <field name="domain">[('display_project_id', '=', active_id)]</field>
            <field name="context">{'default_project_id': active_id, 'search_default_my_tasks': 1,
                'search_default_open_tasks': 1, 'all_task': 0, 'default_user_ids': [(4, uid)]}
            </field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('law_firm_bits.view_law_task_kanban')}),
                          ]"/>
            <field name="search_view_id" ref="project.view_task_search_form"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks found. Let's create one!
                </p>
                <p>
                    To get things done, use activities and status on tasks.
                    <br/>
                    Chat in real-time or by email to collaborate efficiently.
                </p>
            </field>
        </record>

    </data>
</odoo>