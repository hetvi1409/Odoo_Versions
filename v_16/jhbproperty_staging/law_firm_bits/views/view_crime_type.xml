<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="law_crime_type_form_view" model="ir.ui.view">
            <field name="name">crime.type.form.view</field>
            <field name="model">crime.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" placeholder="e.g. Crime..." name="name" default_focus="1"
                                       required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="law_crime_type_tree_view" model="ir.ui.view">
            <field name="name">crime.type.tree.view</field>
            <field name="model">crime.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="complete_name"/>
                </tree>
            </field>
        </record>

        <record id="law_crime_type_act_action" model="ir.actions.act_window">
            <field name="name">Crime Type</field>
            <field name="res_model">crime.type</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>