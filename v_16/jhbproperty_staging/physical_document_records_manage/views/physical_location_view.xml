<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="custom_physical_record_form_view">
            <field name="name">custom.physical.location.form.view</field>
            <field name="model">custom.physical.location</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                            </group>
                            <group>
                                <field name="parent_location_id" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="custom_physical_record_tree_view">
            <field name="name">custom.physical.location.form.view</field>
            <field name="model">custom.physical.location</field>
            <field name="arch" type ="xml">
                <tree>
                    <field name="name" />
                    <field name="parent_location_id" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="custom_physical_record_search_view">
            <field name="name">custom.physical.location.form.view</field>
            <field name="model">custom.physical.location</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="parent_location_id" />
                </search>
            </field>
        </record>
  
        <record id="action_custom_record_physical_locations" model="ir.actions.act_window">
            <field name="name">Physical Locations</field>
            <field name="res_model">custom.physical.location</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Physcial Locations" id="sub_menu_custom_locations" 
                  parent="menu_physical_configurations_custom" 
                  sequence="29" action="action_custom_record_physical_locations"/>

    </data>
</odoo>