<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_building_form_inherit" model="ir.ui.view">
            <field name="name">building.form.inherit.valuation.roll</field>
            <field name="model">building</field>
            <field name="inherit_id" ref="itsys_real_estate.building_base_pages_form"/> <!-- Replace with the correct module name -->
            <field name="arch" type="xml">

            <xpath expr="//field[@name='pricing']" position="after">
                <field name="market_value"/>
            </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Valuation Roll">
                        <!-- Add your fields related to the Valuation Roll here -->
                        <group>
                            <field name="town_name_key"/>
                            <field name="town_name_description"/>
                            <field name="erf_number"/>
                            <field name="portion_number"/>
                            <field name="property_remainder_indicator"/>
                            <field name="unit_type"/>
                            <field name="sp_scheme_key"/>
                            <field name="at_scheme_key"/>
                            <field name="scheme_year"/>
                            <field name="scheme_name"/>
                            <field name="reflect_on_scheme_property"/>
                            <field name="unit_key"/>
                            <field name="unit_number"/>
                            <field name="premise_id"/>
                            <field name="unit_legal_area"/>
                            <field name="participation_quota"/>
                            <field name="lowest_stand_sg_id"/>
                            <field name="land_type_code"/>
                            <field name="land_type_name"/>
                            <field name="remainder_of_subdivision"/>
                            <field name="remainder_of_township"/>
                            <field name="tps_code"/>
                            <field name="tps_name"/>
                            <field name="tps_year"/>
                            <field name="zoning_property_key"/>
                            <field name="zone_code"/>
                            <field name="zoning_effective_date"/>
                            <field name="multiple_zoning_count"/>
                            <field name="address_key"/>
                            <field name="street_key"/>
                            <field name="street_number"/>
                            <field name="street_type"/>
                            <field name="street_type_name"/>
                            <field name="scheme_primary_address_sg_id"/>
                            <field name="multiple_active_addresses_count"/>
                            <field name="building_plan_date"/>
                            <field name="building_plan_ref"/>
                            <field name="occupancy_cert_date"/>
                            <field name="occupancy_cert_id"/>
                            <field name="total_engineering_payable_amount"/>
                            <field name="engineering_paid_indicator"/>
                            <field name="engineering_paid_amount"/>
                            <field name="valuation_roll_key"/>
                            <field name="roll_type"/>
                            <field name="valuation_implementation_date"/>
                            <field name="valuation_roll_end_date"/>
                            <field name="valuation_key"/>
                            <field name="valuation_type"/>
                            <field name="valuation_type_description"/>
                            <field name="valuation_date_captured"/>
                            <field name="valuation_effective_date"/>
                            <field name="valuation_status"/>
                            <field name="cat_code"/>
                            <field name="cat_description"/>
                            <field name="lis_application_key"/>
                            <field name="voucher_key"/>
                            <field name="va3_key"/>
                            <field name="lis_task_key"/>
                            <field name="valuation_value_key"/>
                            <field name="rateable_area"/>
                            <field name="market_value"/>
                            <field name="remarks_list_key"/>
                            <field name="remark_description"/>
                            <field name="td_main_key"/>
                            <field name="owner_id_number"/>
                            <field name="title_deed_number"/>
                            <field name="registration_date"/>
                            <field name="purchased_price"/>
                            <field name="article_section"/>
                            <field name="unit_rights_key"/>
                            <field name="right_description"/>
                            <field name="valuation_split_number"/>
                            <field name="valuation_split_indicator"/>
                            <field name="valuation_reason"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
