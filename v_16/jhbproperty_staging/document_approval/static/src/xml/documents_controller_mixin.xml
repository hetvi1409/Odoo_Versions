<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="document_approval.DocumentsViews.Buttons" t-inherit="documents.DocumentsViews.Buttons" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-attf-class, 'o_documents_kanban_share_domain')]" position="after">
            <button type="button" t-attf-class="btn btn-secondary o_documents_kanban_spreadsheet {{additionalClasses}}" t-att-disabled="disabled"
                t-on-click.stop.prevent="onClickCreateRequest">
                Create Approval Request
            </button>
            <button type="button" t-attf-class="btn btn-secondary o_documents_kanban_spreadsheet {{additionalClasses}}" t-att-disabled="disabled"
                t-on-click.stop.prevent="onClickViewRequest">
                View Approval Request
            </button>
        </xpath>
    </t>
</templates>
