<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="minutes_of_meeting_report_action" model="ir.actions.report">
        <field name="name">Minutes Of Meeting</field>
        <field name="model">calendar.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">board_management_system.minutes_of_meeting_report</field>
        <field name="report_file">board_management_system.minutes_of_meeting_report</field>
        <field name="binding_model_id" ref="model_calendar_event"/>
        <field name="print_report_name">'MOM'</field>
        <field name="binding_type">report</field>
    </record>
    <template id="minutes_of_meeting_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <style>
                            thead { display: table-header-group; }
                            .align_center { text-align: center; }
                        </style>
                        <h3>
                            <center>
                                <strong>Minutes Of Meeting</strong>
                            </center>
                        </h3>
                        <br/>
                        Meeting: <strong><t t-out="o.name"/></strong>
                        <br/>
                        Attendees: <t t-foreach="o.partner_ids" t-as="partner">
                        <t t-out="partner.name"/>,
                    </t>
                        <br/>
                        <t t-out="o.mom"/>
                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>