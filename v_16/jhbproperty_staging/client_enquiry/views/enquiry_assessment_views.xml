                                           readonly="1"/>
                                    <field name="technical_growth_folder_id"
                                           invisible="1"/>
                                    <field name="technical_growth_document_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
                                </group>
                                <group attrs="{'invisible': [('technical_growth_folder_id', '=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_open_technical_growth_document"
                                            string="Open Document"
                                            type="object"/>
                                </group>
                                <group attrs="{'invisible': [('technical_growth_folder_id', '!=', False)]}">
                                    <label for="transaction_document_id">Upload
                                        Document
