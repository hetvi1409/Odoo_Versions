                                    <field name="executive_management_folder_id"
                                           invisible="1"/>
                                    <field name="executive_management_document_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
                                </group>
                                <group attrs="{'invisible': [('executive_management_folder_id', '=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_open_executive_management_document"
                                            string="Open Document"
                                            type="object"/>
                                </group>
                                <group attrs="{'invisible': [('executive_management_folder_id', '!=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_upload_executive_management_document"
                                            string="Upload Document"
                                            type="object"/>
                                </group>
                            </group>
                            <group string="Council section 79 Report"
                                   states="executive,council_79_approved,sub_mayoral,mayoral_approved,council_approved,approved">
                                <group>
                                    <field name="council_79_attachment_ids"
                                           widget="many2many_binary"
                                           readonly="1"/>
                                    <field name="council_79_folder_id"
                                           invisible="1"/>
                                    <field name="council_79_document_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
                                </group>
                                <group attrs="{'invisible': [('council_79_folder_id', '=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_open_council_79_document"
                                            string="Open Document"
                                            type="object"/>
                                </group>
                                <group attrs="{'invisible': [('council_79_folder_id', '!=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_upload_council_79_document"
                                            string="Upload Document"
                                            type="object"/>
                                </group>
                            </group>
                            <group string="Sub Mayoral Report"
                                   states="council_79_approved,sub_mayoral,mayoral_approved,council_approved,approved">
                                <group>
                                    <field name="sub_mayoral_attachment_ids"
                                           widget="many2many_binary"
                                           readonly="1"/>
                                    <field name="sub_mayoral_folder_id"
                                           invisible="1"/>
                                    <field name="sub_mayoral_document_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
                                </group>
                                <group attrs="{'invisible': [('sub_mayoral_folder_id', '=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_open_sub_mayoral_document"
                                            string="Open Document"
                                            type="object"/>
                                </group>
                                <group attrs="{'invisible': [('sub_mayoral_folder_id', '!=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_upload_sub_mayoral_document"
                                            string="Upload Document"
                                            type="object"/>
                                </group>

                            </group>
                            <group string="Mayoral"
                                   states="mayoral_approved,sub_mayoral,mayoral_approved,council_approved,approved">
                                <group>
                                    <field name="mayoral_attachment_ids"
                                           widget="many2many_binary"
                                           readonly="1"/>
                                    <field name="mayoral_meeting_folder_id"
                                           invisible="1"/>
                                    <field name="mayoral_document_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
                                </group>
                                <group attrs="{'invisible': [('mayoral_meeting_folder_id', '=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_open_mayoral_document"
                                            string="Open Document"
                                            type="object"/>
                                </group>
                                <group attrs="{'invisible': [('mayoral_meeting_folder_id', '!=', False)]}">
                                    <label for="transaction_document_id"/>
                                    <button name="action_upload_mayoral_document"
                                            string="Upload Document"
                                            type="object"/>
                                </group>
                            </group>
                            <group string="Council Report"
                                   states="mayoral_approved,council_approved,approved">
                                <group>
