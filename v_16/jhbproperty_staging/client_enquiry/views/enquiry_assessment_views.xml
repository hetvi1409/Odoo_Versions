    <record id="enquiry_assessment_view_search" model="ir.ui.view">
        <field name="name">enquiry.assessment.view.search</field>
        <field name="model">enquiry.assessment</field>
        <field name="arch" type="xml">
            <search string="Client Enquiry">
                <field name="name" string="Enquiry"/>
                <filter string="Compile assessment review" name="compile"
                        domain="[('state','=', 'compile')]"/>
                <filter string="Objection" name="objection"
                        domain="[('state','=', 'objection')]"/>
                <separator/>
                <filter string="My Assessment" domain="[('user_id','=',uid)]"
                        name="my_ticket"/>
                <filter string="Unassigned Assessment"
                        domain="[('user_id','=',False)]" name="unassigned"/>
                <group expand="0" string="Group By...">
                    <filter string="Customer" name="partner_id" domain="[]"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Enquiry" name="enquiry_id" domain="[]"
                            context="{'group_by':'enquiry_id'}"/>
                    <filter string="Property" name="property_id" domain="[]"
                            context="{'group_by':'property_id'}"/>
                    <filter string="State" name="state" domain="[]"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="enquiry_assessment_view_tree" model="ir.ui.view">
        <field name="name">Enquiry Assessment</field>
        <field name="model">enquiry.assessment</field>
        <field name="arch" type="xml">
            <tree default_order="create_date desc">
                <!--                <field name="name"/>-->
                <field name="create_date"/>
                <field name="enquiry_id"/>
                <field name="property_id" optional="show"/>
                <field name="jmc_number"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-primary="state in ('draft', 'ownership')"
                       decoration-warning="state in ('compile', 'objection')"
                       decoration-info="state in ('transition', 'valuation', 'internal_meeting')"
                       decoration-success="state in ('approve', 'valuation_completed', 'internal_meeting_approved', 'mayoral_approved', 'council_approved', 'council_79_approved')"
                       decoration-danger="state in ('PTOB', 'negotiation', 'terminate', 'refused')"/>
            </tree>
        </field>

    </record>
    <record id="action_enquiry_assessment_my" model="ir.actions.act_window">
        <field name="name">Property Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">enquiry.assessment</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{
            'default_user_id': uid,
            'search_default_my_ticket': true
            }
        </field>

    </record>

    <record id="action_enquiry_assessment" model="ir.actions.act_window">
        <field name="name">Property Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">enquiry.assessment</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>


    <record id="action_enquiry_assessment_property"
            model="ir.actions.act_window">
        <field name="name">Property Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">enquiry.assessment</field>
        <field name="domain">[('property_id','!=', False)]</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>


    <menuitem id="enquiry_assessment_property_menu"
              name="Assessment"
              action="action_enquiry_assessment_property"
              parent="itsys_real_estate.menu_building_list"
              sequence="52"/>

