<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="enquiry_assessment" model="ir.ui.view">
        <field name="name">enquiry.assessment.view.kanban</field>
        <field name="model">enquiry.assessment</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" action="action_view_assessment"
                    type="object"
                    class="o_kanban_small_column o_kanban_helpdesk_ticket"
                    sample="1" quick_create="false">
                <field name="state" readonly="1"/>
                <field name="user_id" options="{'no_open': True, 'no_quick_create': True}"/>
                <field name="priority"/>
                <field name="property_id"/>
                <field name="enquiry_id"/>
                <!--                <field name="team_id"/>-->
                <progressbar field="kanban_state"
                             colors='{"done": "success", "blocked": "danger", "normal": "200"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <span class="oe_kanban_color_help" role="img"/>
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn"
                                   role="button" data-bs-toggle="dropdown"
                                   href="#" aria-label="Dropdown menu"
                                   title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable">
                                        <a type="edit" class="dropdown-item"
                                           role="menuitem">Edit
                                        </a>
                                    </t>
                                    <t t-if="widget.deletable">
                                        <a type="delete" class="dropdown-item"
                                           role="menuitem">Delete
                                        </a>
                                    </t>
                                </div>
                            </div>
                            <div class="oe_kanban_content text-break">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div>
                                    <field name="property_id"/>
                                </div>
                                <!--                                <div>-->
                                <field name="enquiry_id"/>
                                <!--                                </div>-->
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority"
                                               widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="kanban_state"
                                               widget="state_selection"
                                               groups="base.group_user"/>
                                        <field t-if="record.user_id.raw_value"
                                               name="user_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="enquiry_assessment_view_form" model="ir.ui.view">
        <field name="name">Enquiry Assessment</field>
        <field name="model">enquiry.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="check_ownership" states="draft"
                            groups="client_enquiry.group_asset_evaluator"
                            string="Capture Assessment Results" type="object"/>
                    <button name="create_land_regularization"
                            groups="client_enquiry.group_property_manager"
                            attrs="{'invisible': ['|', '|', ('state', '!=', 'ownership'), ('land_regularisation_id', '!=' , False),('type', '!=', 'land')]}"
                            string="Land Regularization"
                            type="object" class="oe_highlight"/>
                    <button name="send_compile_report"
                            groups="client_enquiry.group_property_manager"
                            attrs="{'invisible': ['|', ('state', '!=', 'ownership'), ('circulation_id', '!=' , False)]}"
                            string="Next"
                            type="object"/>
                    <!--                    <button name="action_review_assessment" states="ownership"-->
                    <!--                            groups="client_enquiry.group_manager"-->
                    <!--                            string="Review Compile assessment" type="object"/>-->
<!--                    <button name="action_objection" states="compile"-->
<!--                            groups="client_enquiry.group_property_manager"-->
<!--                            string="Objection" type="object"/>-->
                    <button name="action_create_valuation_form"
                            states="objection"
                            groups="client_enquiry.group_property_manager"
                            string="Request Valuation" type="object"/>
                    <button name="action_scm_assessment" states="valuation"
                            groups="client_enquiry.group_asset_evaluator"
                            string="Upload Valuation Report" type="object"/>
                    <button name="action_receive_transition_report"
                            states="valuation_completed"
                            groups="client_enquiry.group_property_manager"
                            string="Upload Transaction Report" type="object"/>
                    <button name="action_assigne_to_me"
                            string="Assign to me" type="object"
                            attrs="{'invisible': [('user_id', '!=', False)]}"/>

                    <button name="action_create_committee_meeting_for_transaction"
                            string="Request Meeting"
                            type="object"
                            groups="client_enquiry.group_property_manager"
                            attrs="{'invisible': [('state', '!=', 'transition')]}"
                            class="btn btn-primary"/>
                    <button name="action_upload_the_report"
                            string="Upload Internal Report" type="object"
                            groups="client_enquiry.group_property_manager"
                            attrs="{'invisible': [('state', '!=', 'internal_meeting')]}"
                            class="btn btn-primary"/>
                    <button name="action_open_mayoral"
                            string="Upload Mayoral Report" type="object"
                            groups="client_enquiry.group_property_manager"
                            attrs="{'invisible': [('state', '!=', 'sub_mayoral')]}"
                            class="btn btn-primary"/>
                    <button name="action_upload_council"
                            groups="client_enquiry.group_property_manager"
                            string="Upload Council Report" type="object"
                            attrs="{'invisible': [('state', '!=', 'mayoral_approved')]}"
                            class="btn btn-primary"/>
                    <button name="action_technical_growth_cluster"
                            string="Upload Technical Growth Cluster"
                            groups="client_enquiry.group_property_manager"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'internal_meeting_approved')]}"
                            class="btn btn-primary"/>
                    <button name="action_executive_management_team"
                            string="Upload Executive Management Team"
                            groups="client_enquiry.group_property_manager"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'technical_growth')]}"
                            class="btn btn-primary"/>
                    <button name="action_council_section_79"
                            groups="client_enquiry.group_property_manager"
                            string="Upload Council section 79 Report"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'executive')]}"
                            class="btn btn-primary"/>
                    <button name="action_sub_mayoral"
                            groups="client_enquiry.group_property_manager"
                            string="Upload Sub-Mayoral Report"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'council_79_approved')]}"
                            class="btn btn-primary"/>

                    <button name="action_section_179_report"
                            groups="client_enquiry.group_property_manager"
                            string="Section 179 Report"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'council_approved')]}"
                            class="btn btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ownership"/>
                </header>
                <sheet>
                <style>
                    .o_form_view:not(.o_field_highlight)
                    .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                    .o_input:not(:hover):not(:focus) {
                              --o-input-border-color: black !important;
                              }
                  </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transaction" type="object"
                                class="oe_stat_button"
                                title="Open Transaction"
                                attrs="{'invisible': [('transaction_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Transaction</span>
                            </div>
                        </button>
                        <button name="action_view_land_regularization" type="object"
                                class="oe_stat_button"
                                title="Open Land Regularisation"
                                attrs="{'invisible': [('land_regularisation_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Land Regularisation</span>
                            </div>
                        </button>
                        <button name="action_view_circulation" type="object"
                                class="oe_stat_button"
                                title="Open Circulation"
                                attrs="{'invisible': [('circulation_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Circulation</span>
                            </div>
                        </button>
                        <button name="action_open_valuation" type="object"
                                class="oe_stat_button"
                                title="Open Valuations">
                            <i class="fa fa-edit o_button_icon text-success"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="valuation_count" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Valuations</span>
                            </div>
                        </button>
                        <button name="action_open_enquiry" type="object"
                            class="oe_stat_button"
                            title="Open Enquiry"
                                attrs="{'invisible': [('enquiry_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon text-success"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Enquiry</span>
                            </div>
                        </button>
                        <button name="action_open_booking" type="object"
                                class="oe_stat_button"
                                title="Open Booking"
                                attrs="{'invisible': [('booking_id', '=', False)]}">
                            <i class="fa fa-fw fa-file o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Booking</span>
                            </div>
                        </button>
                        <button name="action_open_meetings" type="object"
                                class="oe_stat_button"
                                title="Open Meeting"
                                attrs="{'invisible': [('committee_transaction', '=', False), ('committee_board_meeting', '=', False)]}">
                            <i class="fa fa-fw fa-file o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Meeting</span>
                            </div>
                        </button>
                        <button name="action_open_meeting_request" type="object"
                                class="oe_stat_button"
                                title="Open Meeting Request"
                                attrs="{'invisible': [('committee_transaction', '=', False), ('committee_board_meeting', '=', False)]}">
                            <i class="fa fa-fw fa-file o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Meeting Request</span>
                            </div>
                        </button>
                    </div>
                    <field name="kanban_state" widget="state_selection"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="sla_policy_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': True}" readonly="1" invisible="1"/>
                        <span attrs="{'invisible': [('sla_deadline', '=', False)]}"  class="mx-2 text-muted">
                            <i class="fa fa-lg fa-clock-o me-2" aria-label="Sla Deadline" title="Sla Deadline" invisible="1"/>
                            <field name="sla_deadline" widget="remaining_days" invisible="1"/>
                        </span>

                    </div>
                    <group>
                        <group>
                            <field name="partner_id" invisible="1"/>
                            <field name="property_id"/>
                            <field name="jmc_number"/>
                            <field name="land_regularisation_id" readonly="1" invisible="1"/>
                            <field name="is_supported" invisible="1"/>
                            <field name="sla_reached_late" invisible="1"/>
                            <field name="sla_reached" invisible="1"/>
                            <field name="sla_fail" invisible="1"/>
                            <field name="sla_success" invisible="1"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   invisible="1"/>
                            <field name="committee_transaction" invisible="1"/>
                            <field name="committee_board_meeting"
                                   invisible="1"/>
                            <field name="meeting_request_ids"
                                   widget="many2many_tags" invisible="1"/>
                            <field name="committee_meeting_ids"
                                   widget="many2many_tags" invisible="1"/>
                            <field name="user_domain_ids"
                                   widget="many2many_tags" invisible="0"/>
                            <field name="user_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"
                                   domain="[('id', 'in', user_domain_ids)]"/>
                            <field name="transaction_id" invisible="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="stand_number"/>
                            <field name="valuation_ids" widget="many2many_tags"
                                   readonly="1"
                                   attrs="{'invisible': [('state', 'not in', ['objection', 'valuation'])]}"/>
                            <field name="booking_id" invisible="1"/>
                            <field name="priority" widget="priority"/>
<!--                            <field name="zoning"/>-->
                            <field name="type"/>
                            <field name="circulation_id" invisible="1" readonly="1"/>
                            <field name="enquiry_id"/>
                        </group>

                    </group>
<!--                    <group string="Enquirer Details">-->
<!--                        <group>-->
<!--                            <field name="enquiry_name_id"/>-->
<!--                            <field name="first_name"/>-->
<!--                        </group>-->
<!--                        <group>-->
<!--                            <field name="title"/>-->
<!--                            <field name="cell_phone"/>-->
<!--                            <field name="email"/>-->
<!--                        </group>-->
<!--                    </group>-->

                    <notebook>
                        <page string="Assessment Reports"
                              attrs="{'invisible': [('state', '=', 'draft')]}">
                            <group>
                                <group>
                                    <field name="attachment_ids"
                                           widget="many2many_binary"/>

                                     <button name="action_button_doc_view"
                            string="Open Document" type="object"/>


                                    <field name="assessment_documents_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
                                    <field name="assessment_folder_id"
                                           invisible="1"/>
                                </group>
                                <group>
<!--                                    <button name="action_open_assessment_documents"-->
<!--                                            string="Open Document"-->
<!--                                            type="object"/>-->
                                </group>
                            </group>
                        </page>
<!--                        <page string="GIS"-->
<!--                              attrs="{'invisible': [('state', '=', 'draft')]}">-->
<!--                            <group>-->
<!--                                <field name="latitude"-->
<!--                                       groups="client_enquiry.group_asset_evaluator"/>-->
<!--                                <field name="longitude"-->
<!--                                       groups="client_enquiry.group_asset_evaluator"/>-->
<!--                            </group>-->
<!--                        </page>-->
                        <page string="Comments"
                              attrs="{'invisible': [('state', 'in', ['draft', 'ownership'])]}">
                            <group>
                                <group>
                                    <field name="circulation_documents_ids"
                                           widget="many2many_tags"
                                           invisible="0"/>
                                    <field name="circulation_folder_id"
                                           invisible="1"/>
                                </group>
                                <group>
                                    <button name="action_open_circulation_documents"
                                            string="Open Document"
                                            type="object"/>
                                </group>
                            </group>
                            <field name="circulation_ids">
                                <tree editable="1">
                                    <field name="date"/>
                                    <field name="attachment_ids"
                                           widget="many2many_tags"/>
                                    <field name="user_id"/>
                                    <field name="group_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Objections"
                              states="valuation,PTOB,valuation_completed,terminate,transition,send_transition,approve,refused,internal_meeting,internal_meeting_approved,mayoral_approved,council_approved,council_79_approved,technical_growth,executive,sub_mayoral,approved"
                              attrs="{'invisible': [('state', '!=', 'objection')]}">
                            <group>
                                <field name="outcome" readonly="1"/>
                                <field name="is_object_valid"
                                       attrs="{'invisible': [('outcome', '!=', 'yes')]}"
                                       readonly="1"/>
                            </group>
                        </page>

                        <page string="Valuation"
                              states="valuation_completed,terminate,transition,send_transition,approve,refused,internal_meeting,internal_meeting_approved,mayoral_approved,council_approved,council_79_approved,technical_growth,executive,sub_mayoral,approved">
                            <group>
                                <group>
                                    <field name="valuation_document_id"
                                           readonly="1"/>
                                    <field name="valuation_folder_id"
                                           readonly="1"/>
                                </group>
                                <group>
                                    <button name="action_open_valuation_documents"
                                            string="Open Document"
                                            type="object"/>
                                </group>

                            </group>
                        </page>
                        <page string="Transition"
                              states="transition,send_transition,approve,refused,internal_meeting,internal_meeting_approved,mayoral_approved,council_approved,council_79_approved,technical_growth,executive,sub_mayoral,approved">
                            <group>
                                <field name="transaction_report_ids"
                                       widget="many2many_binary"/>
                                <field name="transaction_document_id"
                                       readonly="1"/>
                                <field name="transaction_folder_id"
                                       invisible="1"/>
                                <!--                                <field name="transaction_sign_document_id"/>-->
                                <!--                                <field name="share_link" widget="CopyClipboardChar" readonly="1" class="mb-3"/>-->
                                <label for="transaction_document_id"/>
                                <button name="action_sign_document"
                                        string="Sign Document" type="object"/>
                                <button name="action_signed_document"
                                        string="Signed Document" type="object"/>

                            </group>
                        </page>
                        <page string="Meetings"
                              states="refused,internal_meeting,internal_meeting_approved,mayoral_approved,council_approved,council_79_approved,technical_growth,executive,council_79_approved,sub_mayoral,approved">
                            <group string="Internal meetings"
                                   states="internal_meeting,internal_meeting_approved,mayoral_approved,council_approved,council_79_approved,technical_growth,executive,council_79_approved,sub_mayoral,approved">
                                <group>
                                    <field name="internal_meeting_ids"
                                           widget="many2many_tags"
                                           readonly="1"/>
                                </group>
                                <group>
                                    <field name="internal_meeting_document_ids"
                                           widget="many2many_binary"
                                           readonly="1"/>
                                    <field name="board_meeting_folder_id"
                                           invisible="1"/>
                                    <field name="board_document_ids"
                                           widget="many2many_tags"
                                           invisible="1"/>
