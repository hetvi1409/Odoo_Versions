<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_client_enquiry_sla_policy" model="ir.actions.act_window">
        <field name="name">SLA Policy</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.enquiry.sla.policy</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="client_enquiry_sla_policy_view_form" model="ir.ui.view">
        <field name="name">client.enquiry.sla.policy.view.form</field>
        <field name="model">client.enquiry.sla.policy</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" write="0">
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="deadline_type"/>
                        </group>
                        <group>
                            <field name="dead_line"/>
                            <field name="sla_number"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="client_enquiry_sla_policy_menu" name="SLA Policy" action="action_client_enquiry_sla_policy"
        sequence="0" parent="client_enquiry.client_enquiry_helpdesk_configuration_menu" />

    <record id="action_client_enquiry_sla_policy_status" model="ir.actions.act_window">
        <field name="name">SLA Policy Status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.enquiry.sla.policy.status</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="client_enquiry_sla_policy_status_menu" name="SLA Policy Status" action="action_client_enquiry_sla_policy_status"
        sequence="0" parent="client_enquiry.client_enquiry_helpdesk_configuration_menu" />

    <record id="client_enquiry_sla_policy_status_view_graph_analysis" model="ir.ui.view">
        <field name="name">client.enquiry.sla.policy.status.view.graph</field>
        <field name="model">client.enquiry.sla.policy.status</field>
        <field name="arch" type="xml">
            <graph string="Tickets Analysis" sample="1" disable_linking="1">
                <field name="team_id"/>
                <field name="policy_id"/>
            </graph>
        </field>
    </record>

    <record id="action_client_enquiry_sla_policy_status_graph" model="ir.actions.act_window">
        <field name="name">SLA Policy Status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.enquiry.sla.policy.status</field>
        <field name="view_mode">graph,pivot</field>
    </record>

    <menuitem id="client_enquiry_sla_policy_status_graph_menu" name="SLA Policy Status" action="action_client_enquiry_sla_policy_status_graph"
        sequence="0" parent="client_enquiry.client_enquiry_reporting_main_menu" />

</odoo>