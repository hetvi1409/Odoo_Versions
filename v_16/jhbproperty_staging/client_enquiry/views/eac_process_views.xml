<?xml version="1.0" encoding="UTF-8" ?>
<odoo>    
    <record id="action_eac_process" model="ir.actions.act_window">
        <field name="name">EAC Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">eac.process</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="eac_process_view_form" model="ir.ui.view">
        <field name="name">eac.process.view.form</field>
        <field name="model">eac.process</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_create_eac_meeting" states="draft"
                            string="Create EAC Meeting" type="object"
                            class="btn btn-primary"/>
                    <button name="action_approve_eac_meeting" states="eac_meeting"
                            string="Approve EAC" type="object"
                            class="btn btn-primary"/>
                    <button name="action_refuse_eac_meeting" states="eac_meeting"
                            string="Refuse EAC" type="object"
                            class="btn btn-secondary"/>
                    <button name="action_approve" states="eac_approve"
                            string="Approve" type="object"
                            class="btn btn-primary"/>
                    <button name="action_refuse" states="eac_approve"
                            string="Refuse" type="object"
                            class="btn btn-secondary"/>
                </header>
                <sheet>
                    <style>
                    .o_form_view:not(.o_field_highlight)
                    .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                    .o_input:not(:hover):not(:focus) {
                              --o-input-border-color: black !important;
                              }
                  </style>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transaction" type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('valuation_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Transaction</span>
                            </div>
                        </button>
                        <button name="action_view_valuation" type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('valuation_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Valuation</span>
                            </div>
                        </button>
                        <button name="action_view_circulation" type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('circulation_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Circulation</span>
                            </div>
                        </button>
                        <button name="action_view_assessment" type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('assessment_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Assessment</span>
                            </div>
                        </button>
                        <button name="action_view_enquiry" type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('enquiry_id', '=', False)]}">
                            <i class="fa fa-edit o_button_icon"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Enquiry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                            <field name="circulation_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                            <field name="enquiry_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="valuation_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                            <field name="assessment_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                            <field name="user_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="property_id"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                            <field name="jmc_number"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="stand_number"/>
                        </group>
                    </group>
                    <group>
                        <field name="eac_comments" readonly="1"/>
                        <field name="review_comments" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="transaction_attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Meetings">
                            <group>
                                <group>
                                    <label for="eac_committee_id"/>
                                    <div col="2" class="o_row">
                                        <field name="eac_committee_id" class="oe_inline"
                                        options="{'no_open': True, 'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                                        <button name="action_create_eac_meeting" type="object" class="btn btn-link" attrs="{'invisible': [('eac_committee_id', '!=', False)]}" >
                                            <span class="fa fa-tag"/><span> Create meeting</span>
                                        </button>
                                        <button name="action_view_eac_meeting" type="object" class="btn btn-link" attrs="{'invisible': [('eac_committee_id', '==', False)]}" >
                                            <span class="fa fa-tag"/><span> View meeting</span>
                                        </button>
                                    </div>
                                </group>
                                <group>
                                    <field name="eac_attachment_ids" widget="many2many_binary"/>
                                </group>
                            </group>
                        </page>
                        <page string="GEOLIS">
                            <iframe id="custom_src" name="custom_src"
                                    src="https://ags.joburg.org.za/cgis/index.aspx"
                                    width="100%" height="500"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>
    <record id="eac_process_view_tree" model="ir.ui.view">
        <field name="name">eac.process.view.tree</field>
        <field name="model">eac.process</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="property_id"/>
                <field name="enquiry_id"/>
                <field name="jmc_number"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <menuitem id="eac_process_menu"
              name="EAC Process 2"
              action="action_eac_process"
              parent="client_enquiry.client_enquiry_helpdesk_enquiries_menu"
              sequence="24"/>
</odoo>
