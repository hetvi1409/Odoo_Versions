<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_committee_meeting_form">
        <field name="name">committee.meeting.view.form</field>
        <field name="model">committee.meeting</field>
        <field name="inherit_id"
               ref="committee_meeting_management.view_committee_meeting_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='final']" position="after">
                <page string="Transaction" attrs="{'invisible': [('is_transaction', '=', False)]}">
                        <group>
                            <field name="is_transaction" invisible="1"/>
                            <field name="assessment_id"/>
                            <field name="transaction_document_id" invisible="1"/>
                            <label for="transaction_document_id" readonly="1"/>
                            <button name="action_sign_document" attrs="{'invisible': [('transaction_document_id', '=', False)]}"
                                    string="Open Document" type="object"/>
                        </group>
                    </page>
            </xpath>
        </field>
    </record>
              <record model="ir.ui.view" id="view_client_enquiry_form">
        <field name="name">client.enquiry.form</field>
        <field name="model">client.enquiry</field>
        <field name="inherit_id" ref="client_enquiry.client_enquiry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='enquiry_folder_id']" position="after">
                      <button name="action_button_doc_view"
                            string="Open Document" type="object"/>
            </xpath>
        </field>
    </record>
     <record model="ir.ui.view" id="view_assessment_enquiry_form">
        <field name="name">assessment.enquiry.form</field>
        <field name="model">enquiry.assessment</field>
        <field name="inherit_id" ref="client_enquiry.enquiry_assessment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='upload_report_document_ids']" position="after">
                      <button name="action_button_doc_view"
                            string="Open Document" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>