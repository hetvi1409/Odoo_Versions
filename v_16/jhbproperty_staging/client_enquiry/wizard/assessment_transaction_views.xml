<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="assessment_transaction_view_form" model="ir.ui.view">
        <field name="name">assessment.transaction.form.view</field>
        <field name="model">assessment.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="assessment_id"/>
                        <field name="jmc_number"/>
                        <field name="transition_report" widget="download_link"
                               filename="transition_report_name" options="{'filename': 'transition_report_name'}"/>
                        <field name="transition_report_name" readonly="1"  invisible="1" force_save="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>