<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_staging_approval" model="ir.module.category">
        <field name="name">Staging Asset Approval</field>
        <field name="description">Manage approval process for staging assets</field>
        <field name="sequence">10</field>
    </record>
    <record id="group_staging_approval_manager" model="res.groups">
        <field name="name">Staging Approval Manager</field>
        <field name="category_id" ref="module_category_staging_approval"/>
    </record>

     <record id="asset_verification_staging_rule_manager" model="ir.rule">
        <field name="name">Asset Verification Staging - Manager Access</field>
        <field name="model_id" ref="model_asset_verification_staging"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Allows access to all records -->
        <field name="groups" eval="[(4, ref('asset_verification.group_staging_approval_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

     <record id="asset_verification_staging_rule_user" model="ir.rule">
        <field name="name">Asset Verification Staging - User Access</field>
        <field name="model_id" ref="model_asset_verification_staging"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field> <!-- Users see only their own records -->
         <field name="groups" eval="[(4, ref('base.group_user'))]"/> <!-- Apply to regular users -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>