<odoo>
    <record id="view_res_config_settings_sharepoint" model="ir.ui.view">
        <field name="name">res.config.settings.sharepoint</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]//div[@name='integration']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="sync_outlook_calendar_setting">
                    <div class="o_setting_right_pane">
                        <strong>Documents Sharepoint Sync</strong>
                        <div class="text-muted">
                            Synchronize your Documents with Sharepoint
                        </div>
                        <div class="content-group">
                            <div class="d-flex">
                                <label for="sharepoint_client_id" class="o_light_label"/>
                                <field name="sharepoint_client_id" class="ml16"/>
                            </div>
                            <div class="d-flex">
                                <label for="sharepoint_client_secret" class="o_light_label"/>
                                <field name="sharepoint_client_secret" password="True" class="ml16"/>
                            </div>
                            <div class="d-flex">
                                <label for="sharepoint_tenant_id" class="o_light_label"/>
                                <field name="sharepoint_tenant_id" class="ml16"/>
                            </div>
                            <div class="d-flex">
                                <label for="sharepoint_site_url" class="o_light_label"/>
                                <field name="sharepoint_site_url" class="ml16"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
