<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="folder_view_form_inherite" model="ir.ui.view">
        <field name="name">documents.folder.view.form.jhbproperty</field>
        <field name="model">documents.folder</field>
        <field name="inherit_id" ref="documents.folder_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_folder_id']" position="after">
                <field name="sharepoint_base_url"/>
                <field name="sharepoint_site_name"/>
            </xpath>
        </field>
    </record>

</odoo>