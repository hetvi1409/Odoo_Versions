<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    
    <record model="ir.ui.view" id="oi_risk_management.risk_treatment_view_list">
        <field name="name">oi_risk_management.risk.view.list</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="activity_id" string="Risk Factor" />
                <field name="name" string="Risk Name" />
                <field name="risk_treatment_state"/>
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="oi_risk_management.risk_treatment_view_form">
        <field name="name">oi_risk_management.risk.view.form</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="risk_treatment_state" widget="statusbar" options="{'clickable': '1'}"/>
                    
                        <button name="action_risk_treatment_prepare" type="object" string="Prepare"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_treatment_state', '!=', 'draft')]}"/>
                        <button name="action_risk_treatment_reviewed" type="object" string="Reviewed"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_treatment_state', '!=', 'prepared')]}"/>
                        <button name="action_risk_treatment_approved" type="object" string="Approved"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_treatment_state', '!=', 'reviewed')]}"/>
                        <button name="action_risk_treatment_rejected" type="object" string="Rejected"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_treatment_state', '!=', 'reviewed')]}"/>
                </header>
                <sheet>
                                            <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>

                    <group>
                        <h1 class="font-weight-bold text-center my-2" style="color: #666" colspan="2">Risk Treatment</h1>
                    </group>
                    <group>
                        <group>
                            <field name="activity_id" string="Risk Factor" attrs="{'readonly': [('risk_treatment_state', 'not in', ['draft'])]}"/>
                            <field name="factor_sequence"/>
                        </group>
                        <group>
                            <field name="state" invisible="1"/>
                            <field name="name" string="Risk Name"
                                   attrs="{'readonly': [('risk_treatment_state', 'not in', ['draft'])]}"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Treatments">
                            <group string="Treatments" colspan="2">
                                <field name="risk_treatment_ids" nolabel="1">
                                    <tree editable="bottom" >
                                        <field name="risk_state" attrs="{'column_invisible': True}"/>
                                        <field name="name"/>
                                        <field name="target_date"/>
                                        <field name="status"/>
                                        <field name="owner_id"
                                               options="{'no_create': True, 'no_edit': True}"/>
                                        <button name="action_change_status" type="object"
                                                string="Change Status / Attach"
                                                class="float-right btn-primary"/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
<!--                                        <button name="action_view_documents" type="object"-->
<!--                                                string="Open Document"-->
<!--                                                class="float-right btn-primary"-->
<!--                                                invisible="not attachment_ids"/>-->
                                    </tree>
                                    <form>
                                        <field name="risk_state" invisible="1"/>
                                        <sheet>
                                            <div>
                                                <label for="name"
                                                       style="width: 15%; vertical-align: middle;"/>
                                                <field name="name" style="width: 80%"
                                                       attrs="{'readonly': [('risk_state', '!=', 'draft')]}"/>
                                            </div>
                                            <div class="mt-2">
                                                <label for="target_date"
                                                       style="width: 15%; vertical-align: middle;"/>
                                                <field name="target_date" style="width: 80%"
                                                       attrs="{'readonly': [('risk_state', '!=', 'draft')]}"/>
                                            </div>
                                            <div class="mt-2">
                                                <label for="status"
                                                       style="width: 15%; vertical-align: middle;"/>
                                                <field name="status" style="width: 80%"/>
                                            </div>
                                            <div class="mt-2">
                                                <label for="owner_id"
                                                       style="width: 15%; vertical-align: middle;"/>
                                                <field name="owner_id" style="width: 80%"/>
                                            </div>

                                            <field name="attachment_ids" nolabel="1" class="mt-2"
                                                   widget="many2many_binary"/>
<!--                                            <button name="action_view_documents"-->
<!--                                                    invisible="not attachment_ids"-->
<!--                                                    type="object" icon="fa-file-text-o"-->
<!--                                                    string="Open Documents"/>-->
                                        </sheet>
                                    </form>
                                </field>
                            </group>
                        </page>
<!--                        <page name="documents" string="Documents">-->
<!--                            <group>-->
<!--                                <group>-->
<!--                                    <field name="treatment_attachment_ids" widget="many2many_binary"/>-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <button name="action_view_treatment_documents"-->
<!--                                            invisible="not treatment_attachment_ids"-->
<!--                                            type="object" icon="fa-file-text-o"-->
<!--                                            string="Open Documents"/>-->
<!--                                </group>-->
<!--                            </group>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
                <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="oi_risk_management.action_risk_treatment_view">
        <field name="name">Risk Treatment</field>
        <field name="res_model">oi_risk_management.risk</field>
        <field name="view_mode">tree,form,graph,pivot,activity</field>
        <field name="context">{'create': False,
                        'delete': False, }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('oi_risk_management.risk_treatment_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('oi_risk_management.risk_treatment_view_form')})]"/>
    </record>
    <menuitem name="Risk Treatment" id="oi_risk_management.risk_treatment_menu"
              parent="oi_risk_management.menu_root"
              action="oi_risk_management.action_risk_treatment_view" sequence="4"/>
</odoo>