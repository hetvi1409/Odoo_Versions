<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="oi_risk_management.risk_assessment_view_list">
        <field name="name">oi_risk_management.risk.view.list</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" />
                <field name="name" string="Risk Name" />
                <field name="inherent_risk_total_score"
                       string="Inherent Risk Score"/>
                <field name="current_risk_total_score"
                       string="Current Risk Score"/>
                <field name="residual_risk_total_score"
                       string="Residual Risk Score"/>
                <field name="risk_assessment_state"/>
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="oi_risk_management.risk_assessment_view_form">
        <field name="name">oi_risk_management.risk.view.form</field>
        <field name="model">oi_risk_management.risk</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="risk_assessment_state" widget="statusbar" options="{'clickable': '1'}"/>

                        <button name="action_risk_assessment_prepare" type="object" string="Prepare"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_assessment_state', '!=', 'draft')]}"/>
                        <button name="action_risk_assessment_reviewed" type="object" string="Reviewed"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_assessment_state', '!=', 'prepared')]}"/>
                        <button name="action_risk_assessment_approved" type="object" string="Approved"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_assessment_state', '!=', 'reviewed')]}"/>
                        <button name="action_risk_assessment_rejected" type="object" string="Rejected"
                                class="oe_highlight"
                                attrs="{'invisible': [('risk_assessment_state', '!=', 'reviewed')]}"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>

                    <group>
                        <h1 class="font-weight-bold text-center my-2" style="color: #666" colspan="2">Risk Assessment</h1>
                    </group>
                    <group>
                        <group>
                            <field name="activity_id" string="Risk Factor" readonly="1"/>
                            <field name="factor_sequence"/>
                        </group>
                        <group>
                            <field name="name" string="Risk Name"
                                   readonly="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="evaluation" string="Evaluation">
                            <field name="risk_evaluation_line_ids" nolabel="1"
                                   attrs="{'readonly': [('risk_assessment_state', '!=', 'draft')]}">
                                <tree create="0" delete="0">
                                    <field name="type"/>
                                    <field name="inherent_risk" domain="[('type', '=', type)]"
                                           options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="current_risk" domain="[('type', '=', type)]"
                                           options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="residual_risk" domain="[('type', '=', type)]"
                                           options="{'no_create': True, 'no_edit': True}"/>
                                </tree>
                                <form>

                                    <style>
                                        .o_form_view:not(.o_field_highlight)
                                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                                        .o_input:not(:hover):not(:focus) {
                                        --o-input-border-color: black !important;
                                    </style>

                                    <group>
                                        <field name="type" readonly="1" force_save="1"/>
                                        <field name="risk_criteria_ids" readonly="1" nolabel="1" colspan="2">
                                            <tree>
                                                <field name="score"/>
                                                <field name="color" widget="color_picker" nolabel="1" readonly="1"/>
                                                <field name="name"/>
                                                <field name="ehs"
                                                       attrs="{'column_invisible': [('parent.type', '!=', 'severity')]}"/>
                                                <field name="value"
                                                       attrs="{'column_invisible': [('parent.type', '!=', 'severity')]}"/>
                                                <field name="reputation"
                                                       attrs="{'column_invisible': [('parent.type', '!=', 'severity')]}"/>
                                                    <field name="percentage"
                                                           attrs="{'column_invisible': [('parent.type', '!=', 'likelihood')]}"/>
                                                    <field name="frequency"
                                                           attrs="{'column_invisible': [('parent.type', '!=', 'likelihood')]}"/>
                                                    <field name="description"
                                                           attrs="{'column_invisible': [('parent.type', '!=', 'control_effectiveness')]}"/>
                                                </tree>
                                            </field>
                                        </group>
                                        <group>
                                            <field name="inherent_risk" domain="[('type', '=', type)]"
                                                   options="{'no_create': True, 'no_edit': True}"/>
                                            <field name="inherent_risk_justification" string="Justification"/>
                                        </group>
                                        <group>
                                            <field name="current_risk" domain="[('type', '=', type)]"
                                                   options="{'no_create': True, 'no_edit': True}"/>
                                            <field name="current_risk_justification" string="Justification"/>
                                        </group>
                                        <group>
                                            <field name="residual_risk" domain="[('type', '=', type)]"
                                                   options="{'no_create': True, 'no_edit': True}"/>
                                            <field name="residual_risk_justification" string="Justification"/>
                                        </group>
                                    </form>
                                </field>
                            <group>
                                <group string="Risk Score">
                                    <field name="inherent_risk_total_score"
                                           string="Inherent Risk Score"/>
                                    <field name="current_risk_total_score"
                                           string="Current Risk Score"/>
                                    <field name="residual_risk_total_score"
                                           string="Residual Risk Score"/>
                                </group>
                            </group>
                            <group>
                                <field name="contributing_factor"/>
                            </group>
                            <group string="Current Control" colspan="2">
                                <field name="current_control_ids" nolabel="1">
                                    <tree editable="bottom" default_order="sequence">
                                        <field name="sequence_id"/>
                                        <field name="name"/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </tree>
                                </field>
                            </group>
                            <group>
                                <group string="Control Effectiveness">
                                    <field name="main_risk_total_score"/>
                                    <field name="control_effectiveness_id"
                                           string="Score"
                                           options="{'no_create': True, 'no_edit': True}"
                                           attrs="{'readonly': [('risk_assessment_state', '!=', 'draft')]}"/>
                                </group>
                                <group>
                                    <field name="control_effectiveness_risk_criteria_ids"
                                           readonly="1" nolabel="1" >
                                        <tree>
                                            <field name="score"></field>
                                            <field name="color"
                                                   widget="color_picker"
                                                   nolabel="1" readonly="1"/>
                                            <field name="name"></field>
                                            <field name="description"></field>
                                        </tree>
                                    </field>
                                </group>

                            </group>
                        </page>
                        <page name="documents" string="Documents">
                            <field name="document_attachment_ids">
                                <tree editable="bottom">
                                    <field name="description"/>
                                    <field name="assessment_attachment_id" widget="many2many_binary"/>
                                </tree>
                            </field>
<!--                            <group>-->
<!--                                <group>-->
<!--                                    <field name="assessment_attachment_ids" widget="many2many_binary"/>-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <button name="action_view_documents"-->
<!--                                            invisible="not assessment_attachment_ids"-->
<!--                                            type="object" icon="fa-file-text-o"-->
<!--                                            string="Open Documents"/>-->
<!--                                </group>-->
<!--                            </group>-->

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="oi_risk_management.action_risk_assessment_view">
        <field name="name">Risk Assessment</field>
        <field name="res_model">oi_risk_management.risk</field>
        <field name="view_mode">tree,form,graph,pivot,activity</field>
        <field name="context">{'create': False,
                        'delete': False, }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('oi_risk_management.risk_assessment_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('oi_risk_management.risk_assessment_view_form')})]"/>

    </record>
    <menuitem name="Risk Assessment" id="oi_risk_management.risk_assessment_menu"
              parent="oi_risk_management.menu_root"
              action="oi_risk_management.action_risk_assessment_view" sequence="3"/>


</odoo>