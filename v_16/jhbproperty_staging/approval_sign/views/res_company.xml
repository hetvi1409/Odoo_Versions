<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_info']"
                   position="after">
                <page name="officers" string="Report Values">
                    <group>
                        <group string="Header &amp; Footer">
                            <field name="header_image" widget="image" class="oe_avatar"/>
                            <field name="footer_image" widget="image" class="oe_avatar"/>
                        </group>
                        <group string="Executive Director">
                            <field name="executive_director_1"/>
                            <field name="executive_director_2"/>
                        </group>
                        <group string="Company Secretary">
                            <field name="company_secretory"/>
                            <field name="company_registration_number"/>
                        </group>
                        <group string="Non-Executive Directors">
                            <field name="non_executive_director_1"/>
                            <field name="non_executive_director_2"/>
                            <field name="non_executive_director_3"/>
                            <field name="non_executive_director_4"/>
                            <field name="non_executive_director_5"/>
                            <field name="non_executive_director_6"/>
                            <field name="non_executive_director_7"/>
                            <field name="non_executive_director_8"/>
                            <field name="non_executive_director_9"/>
                            <field name="non_executive_director_10"/>
                            <field name="non_executive_director_11"/>
                        </group>
                    </group>

                </page>
            </xpath>
        </field>
    </record>

</odoo>