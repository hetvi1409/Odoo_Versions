<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.view.form</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="Sage">
                    <group string="Account">
                        <group>
                            <field name="account_link"/>
                            <field name="extension_id_account"/>
                            <field name="account_extension_link"/>
                        </group>
                        <group>
                            <field name="account_master"/>
                            <field name="account_extension"/>
                        </group>
                    </group>
                    <group string="Project">
                        <group>
                            <field name="project_code"/>
                            <field name="project_long_code"/>
                            <field name="project_soca_account"/>
                        </group>
                        <group>
                            <field name="project_description"/>
                            <field name="project_guid_code"/>
                        </group>
                    </group>
                    <group string="Item">
                        <group>
                            <field name="item_code"/>
                            <field name="item_long_code"/>
                            <field name="item_soca_account"/>
                        </group>
                        <group>
                            <field name="item_description"/>
                            <field name="item_guid_code"/>
                        </group>
                    </group>
                    <group string="Fund">
                        <group>
                            <field name="fund_code"/>
                            <field name="fund_long_code"/>
                            <field name="fund_soca_account"/>
                        </group>
                        <group>
                            <field name="fund_description"/>
                            <field name="fund_guid_code"/>
                        </group>
                    </group>
                    <group string="Function">
                        <group>
                            <field name="function_code"/>
                            <field name="function_long_code"/>
                            <field name="function_soca_account"/>
                        </group>
                        <group>
                            <field name="function_description"/>
                            <field name="function_guid_code"/>
                        </group>
                    </group>
                    <group string="Region">
                        <group>
                            <field name="region_code"/>
                            <field name="region_long_code"/>
                            <field name="region_soca_account"/>
                        </group>
                        <group>
                            <field name="region_description"/>
                            <field name="region_guid_code"/>
                        </group>
                    </group>
                    <group string="Costing">
                        <group>
                            <field name="costing_code"/>
                            <field name="costing_long_code"/>
                            <field name="costing_soca_account"/>
                        </group>
                        <group>
                            <field name="costing_description"/>
                            <field name="costing_guid_code"/>
                        </group>
                    </group>
                    <group string="msc">
                        <field name="msc_code"/>
                        <field name="msc_description"/>
                        <field name="scoa_version_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>