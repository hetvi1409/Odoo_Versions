<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherent.tender_management</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="tender Management" string="Tender Management"
                     data-key="tender_management" >
                    <h2>Documents</h2>
                    <div class="row mt16 o_settings_container" name="tender_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="default_company_schedule_setting">
                            <div class="o_setting_right_pane">
                                <label for="folder_id"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Tender Folder
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="folder_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="procurement_ticker_setting">
                            <div class="o_setting_left_pane">
                                <field name="ticker_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ticker_enabled"/>
                                <div class="text-muted">
                                    Show scrolling procurement announcement on website.
                                </div>
                                <div class="content-group mt16" attrs="{'invisible': [('ticker_enabled', '=', False)]}">
                                    <div class="mt8">
                                        <label for="ticker_title"/>
                                        <field name="ticker_title" placeholder="STAY UP TO DATE:"/>
                                    </div>
                                    <div class="mt8">
                                        <label for="ticker_message"/>
                                        <field name="ticker_message"
                                               widget="text"
                                               placeholder="Enter ticker text shown on website procurement page..."/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="res_conig_settings_view_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'tender_management', 'bin_size': False}</field>
    </record>
    <menuitem id="menu_res_conig_settings_view" name="Settings"
              sequence="5" parent="menu_tender_configuration"
              action="res_conig_settings_view_action"/>

</odoo>