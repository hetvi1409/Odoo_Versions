<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="procurement_contact_nav" name="Procurement Contact And Navigation">
        <div class="tm-contact-strip">
            Contact Us: 010 219 9000 | Fax: 010 219 9400 |
            <a href="mailto:clientservicingunit@jhbproperty.co.za">clientservicingunit@jhbproperty.co.za</a>
        </div>
        <header class="o_header_standard tm-procurement-header">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-top border-bottom tm-procurement-nav">
                <div class="container">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#tmProcurementNav"
                            aria-controls="tmProcurementNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"/>
                    </button>
                    <div class="collapse navbar-collapse" id="tmProcurementNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a t-attf-class="nav-link #{'active' if active_menu == 'home' else ''}" href="/tenders">HOME</a>
                            </li>
                            <li class="nav-item">
                                <a t-attf-class="nav-link #{'active' if active_menu == 'rfq' else ''}" href="/tenders-rfqs">REQUEST FOR QUOTATIONS</a>
                            </li>
                            <li class="nav-item">
                                <a t-attf-class="nav-link #{'active' if active_menu == 'rfp' else ''}" href="/tenders-rfps">REQUEST FOR PROPOSALS</a>
                            </li>
                            <li class="nav-item">
                                <a t-attf-class="nav-link #{'active' if active_menu == 'bid_status' else ''}" href="/bid-status">BID STATUS</a>
                            </li>
                            <li class="nav-item tm-archive-dropdown">
                                <a t-attf-class="nav-link #{'active' if active_menu == 'archive' else ''}" href="/tenders-archive" aria-haspopup="true">
                                    ARCHIVE <span class="tm-archive-caret">&#9662;</span>
                                </a>
                                <ul class="tm-archive-submenu" role="menu" aria-label="Archive years">
                                    <t t-foreach="archive_years" t-as="archive_year">
                                        <li>
                                            <a t-att-href="'/tenders-archive/%d' % archive_year">
                                                <t t-esc="archive_year"/> RFQs
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    </template>

    <template id="procurement_hero" name="Procurement Hero">
        <section class="s_title parallax s_parallax_is_fixed bg-black-50 tm-procurement-hero"
                 data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
            <span class="s_parallax_bg oe_img_bg"
                  style="background-image: url('/tender_management/static/src/img/image.jpg'); background-position: 85% 0;"/>
            <div class="o_we_bg_filter bg-black-50"/>
            <div class="container text-center">
                <h3>
                    <t t-esc="hero_title or 'PROCUREMENT'"/>
                </h3>
                <t t-if="hero_subtitle">
                    <h4>
                        <t t-esc="hero_subtitle"/>
                    </h4>
                </t>
                <div class="tm-breadcrumb-lite" t-if="breadcrumb_label">
                    <a href="/tenders">Home</a>
                    <t t-if="breadcrumb_parent_label">
                        <span>&gt;</span>
                        <a t-att-href="breadcrumb_parent_url or '/tenders'">
                            <t t-esc="breadcrumb_parent_label"/>
                        </a>
                    </t>
                    <span>&gt;</span>
                    <span>
                        <t t-esc="breadcrumb_label"/>
                    </span>
                </div>
            </div>
        </section>
    </template>

    <template id="tender_information" name="Website Tenders">
        <!-- Template extending website.layout -->
        <t t-call="website.layout">
            <div id="wrap" class="o_portal_wrap">
                <div class="container mv64">
                    <div class="col-xs-12">
                        <div class="box box-primary">
                            <div class="box-header search-header">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="box text-center"
                                             style="border: 1px solid #ddd; padding: 10px; border-radius: 6px; background-color: #729bcf; box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1); height: 60px;">
                                            <h3 class="box-title"
                                                style="line-height: 40px;">
                                                Tenders List
                                            </h3>
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-right">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <br/>
                                </div>
                                <div class="col-xs-12">

                                    <div class="nav-tabs-custom">
                                        <ul class="nav nav-tabs custom-tab">
                                        </ul>
                                        <div class="tab-content">
                                            <div class="tab-pane active"
                                                 id="tab_1">

                                                <form class="form-inline"
                                                      name="frmsearch"
                                                      action="/published_tenders"
                                                      method="POST"
                                                      autocomplete="off">
                                                    <input type="hidden"
                                                           name="csrf_token"
                                                           t-att-value="request.csrf_token()"
                                                           autocomplete="off">
                                                    </input>
                                                    <div class="row">
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <input type="text"
                                                                     placeholder="Search"
                                                                       id="searchRefNo"
                                                                       name="searchRefNo"
                                                                       class="form-control"
                                                                       maxlength="50">
                                                                </input>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <input type="text"
                                                                       placeholder="Title"
                                                                       id="searchNoticeTitle"
                                                                       name="searchNoticeTitle"
                                                                       class="form-control"
                                                                       autocomplete="off">
                                                                </input>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <!--
                                                                <t t-set="categories"
                                                                   t-value="request.env['tender.category'].sudo().search([])"/>
                                                                <select name="categories"
                                                                        id="searchCategoryName"
                                                                        class="form-control searchCategory">
                                                                    <option value="">
                                                                        Category...
                                                                    </option>
                                                                    <t t-foreach="categories or []"
                                                                       t-as="category">
                                                                        <option t-att-value="category.id">
                                                                            <t t-esc="category.name"/>
                                                                        </option>
                                                                    </t>
                                                                </select>
                                                                -->

                                                                <!--                                                                <input type="text"-->
                                                                <!--                                                                       placeholder="Category"-->
                                                                <!--                                                                       id="searchCategoryName"-->
                                                                <!--                                                                       name="searchCategoryName"-->
                                                                <!--                                                                       class="form-control">-->
                                                                <!--                                                                </input>-->
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <select class="form-control"
                                                                        id="searchStatus"
                                                                        name="searchStatus">
                                                                    <option value="">
                                                                        --Status--
                                                                    </option>
                                                                    <option value="CONCLUDED">
                                                                        Closed
                                                                    </option>
                                                                    <option value="CANCEL_APPROVED">
                                                                        Opened
                                                                    </option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <br/>
                                                    <div class="row">
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <label for="searchPublishDateFrom">
                                                                    --Publish
                                                                    Date From--
                                                                </label>
                                                                <input type="date"
                                                                       id="searchPublishDateFrom"
                                                                       name="searchPublishDateFrom"
                                                                       class="form-control">
                                                                </input>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <label for="searchPublishDateTo">
                                                                    --Publish
                                                                    Date To--
                                                                </label>
                                                                <input type="date"
                                                                       id="searchPublishDateTo"
                                                                       name="searchPublishDateTo"
                                                                       class="form-control">
                                                                </input>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <label for="searchClosingDateFrom">
                                                                    --Closing
                                                                    Date From--
                                                                </label>
                                                                <input type="date"
                                                                       id="searchClosingDateFrom"
                                                                       name="searchClosingDateFrom"
                                                                       class="form-control">
                                                                </input>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <label for="searchClosingDateTo">
                                                                    --Closing
                                                                    Date To--
                                                                </label>
                                                                <input type="date"
                                                                       id="searchClosingDateTo"
                                                                       name="searchClosingDateTo"
                                                                       class="form-control">
                                                                </input>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <select class="form-control"
                                                                        id="searchBidTypes"
                                                                        name="searchBidTypes">
                                                                    <option value="">
                                                                        --Bid
                                                                        Types--
                                                                    </option>
                                                                    <option value="rfi">
                                                                        RFI
                                                                    </option>
                                                                    <option value="rfe">
                                                                        RFE
                                                                    </option>
                                                                    <option value="rfq">
                                                                        RFQ
                                                                    </option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                <button type="submit"
                                                                        class="btn bg-purple"
                                                                        title="Search">
                                                                    <i class="fa fa-fw fa-search"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </form>
                                                <!-- Bootstrap table to show tenders information -->
                                                <div class="col-xs-12 responsive-card-table">
                                                    <!-- Table headers -->
                                                    <table id="tender_information"
                                                           class="table table-bordered table-hover">
                                                        <thead style="background-color: #729bcf;">
                                                            <tr class="active">
                                                                <!-- <th class="text-center tm-col-open">Opening Date</th> -->
                                                                <th class="text-center tm-col-open">
                                                                    Publish Date
                                                                </th>
                                                                <th class="text-center tm-col-name">
                                                                    Tender Name
                                                                </th>
                                                                <th class="text-center tm-col-desc">
                                                                    Tender Description
                                                                </th>
<!--                                                                <th class="text-center">-->
<!--                                                                    Category-->
<!--                                                                </th>-->
<!--                                                                <th class="text-center">-->
<!--                                                                    Bid Type-->
<!--                                                                </th>-->
                                                                <th class="text-center tm-col-close">
                                                                    Closing Date
                                                                </th>
                                                                <th class="text-center tm-col-status">
                                                                    Status
                                                                </th>
                                                                <th class="text-center tm-col-action">
                                                                    Action
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <!-- Looping over the tenders_information to show the tender details -->
                                                            <t t-foreach="tenders_information"
                                                               t-as="tender">
                                                                <tr>
                                                                    <!-- <td class="text-center tm-col-open" t-esc="tender.start_time"/> -->
                                                                    <td class="text-center tm-col-open"
                                                                        t-esc="tender.publish_date"/>
                                                                    <td class="text-center tm-col-name"
                                                                        t-esc="tender.name"/>
                                                                    <td class="text-center tm-col-desc"
                                                                        t-esc="tender.description"/>
<!--                                                                    <td class="text-center">-->
<!--                                                                        <t t-if="tender.category_id">-->
<!--                                                                            <t t-esc="tender.category_id.name"/>-->
<!--                                                                        </t>-->
<!--                                                                    </td>-->
                                                                    <td class="text-center tm-col-close"
                                                                        t-esc="tender.closing_date"/>
                                                                    <td class="text-center tm-col-status">
                                                                        <t t-set="state_label" t-value="dict(env['tender.tender']._fields['state'].selection).get(tender.state, tender.state)"/>
                                                                        <t t-esc="state_label"/>
                                                                    </td>
                                                                    <td class="text-center tm-col-action">
                                                                        <a t-att-href="'/tender/%d' % tender.id"
                                                                           class="btn btn-primary">
                                                                            Open
                                                                        </a>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="tender_detail_template" name="Tender Detail">
        <t t-call="website.layout">
            <t t-set="main_object" t-value="tender"/>
            <div id="wrap" class="oe_structure tender_timer_id tm-procurement-wrap">
                <t t-set="active_menu" t-value="'rfq' if tender.type == 'rfq' else ('rfp' if tender.type == 'rfp' else 'home')"/>
                <t t-call="tender_management.procurement_contact_nav"/>

                <t t-set="hero_title" t-value="'PROCUREMENT'"/>
                <t t-set="hero_subtitle" t-value="tender.name"/>
                <t t-set="breadcrumb_parent_label" t-value="'RFQs' if tender.type == 'rfq' else ('RFPs' if tender.type == 'rfp' else 'Tenders')"/>
                <t t-set="breadcrumb_parent_url" t-value="'/tenders-rfqs' if tender.type == 'rfq' else ('/tenders-rfps' if tender.type == 'rfp' else '/tenders')"/>
                <t t-set="breadcrumb_label" t-value="'Tender Detail'"/>
                <t t-set="blocked_states" t-value="['closed', 'adjudication_in_progress', 'awarded']"/>
                <t t-call="tender_management.procurement_hero"/>
                <div class="container tm-content-block">
                    <div class="unique-navbar">
                        <div class="unique-navbar-left">
                            <strong>TENDER INFORMATION</strong>
                        </div>
                        <div class="unique-navbar-right">
                            <div class="tender_timer text-center">
                                <p class="countdown-text">Auction will end in
                                </p>
                                <h3 id="tender_timer_count">---</h3>
                                <p class="countdown-date">Till
                                    <t t-esc="tender.closing_date"/>
                                </p>
                            </div>
                        </div>
                    </div>

                    <t t-if="tender.state in blocked_states">
                        <div class="tm-state-alert-banner text-center">
                            <t t-if="tender.state == 'closed'">Tender Closed</t>
                            <t t-if="tender.state == 'adjudication_in_progress'">Tender Closed - Adjudication In Progress</t>
                            <t t-if="tender.state == 'awarded'">Tender Closed - Awarded</t>
                        </div>
                    </t>

                    <input name="tender_id" t-att-value="tender.id"
                           type="hidden"/>
                          <input name="tender_timer_token" t-att-value="timer_token"
                              type="hidden"/>

                    <div class="tm-tender-description-card">
                        <div class="section-heading tm-section-heading">Tender Description</div>
                        <p class="tm-tender-description-text">
                            <t t-if="tender.description">
                                <t t-esc="tender.description"/>
                            </t>
                            <t t-else="">No description provided for this tender.</t>
                        </p>
                    </div>

                    <div class="row tm-detail-panel">
                        <div class="col-12">
                            <div class="row g-4 tm-detail-grid">
                                <div class="col-lg-6">
                                    <div class="tm-info-card">
                                        <div class="section-heading tm-section-heading">Details</div>
                                        <div class="tm-kv-list">
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Tender Name</span>
                                                <span class="tm-kv-value"><t t-esc="tender.name"/></span>
                                            </div>
                                            <!--
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Category</span>
                                                <span class="tm-kv-value"><t t-esc="tender.category_id.name"/></span>
                                            </div>
                                            -->
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Type</span>
                                                <span class="tm-kv-value tm-kv-type">
                                                    <t t-set="type_mapping" t-value="{'rfi': 'RFI', 'rfp': 'RFP', 'rfq': 'RFQ'}"/>
                                                    <t t-esc="type_mapping.get(tender.type, 'Unknown')"/>
                                                </span>
                                            </div>
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Current Status</span>
                                                <span class="tm-kv-value">
                                                    <t t-set="state_label" t-value="dict(env['tender.tender']._fields['state'].selection).get(tender.state, tender.state)"/>
                                                    <t t-esc="state_label"/>
                                                </span>
                                            </div>
                                            <div class="tm-kv-item">
                                                <!-- <span class="tm-kv-label">Opening Date</span> -->
                                                <!-- <span class="tm-kv-value"><t t-esc="tender.start_time"/></span> -->
                                                <span class="tm-kv-label">Publish Date</span>
                                                <span class="tm-kv-value"><t t-esc="tender.publish_date"/></span>
                                            </div>
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Closing Date</span>
                                                <span class="tm-kv-value"><t t-esc="tender.closing_date"/></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tm-info-card mt-4">
                                        <div class="section-heading tm-section-heading">Briefing Session</div>
                                        <div class="tm-kv-list">
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Is there a briefing session?</span>
                                                <span class="tm-kv-value">
                                                    <t t-if="tender.briefing_session">Yes</t>
                                                    <t t-else="">No</t>
                                                </span>
                                            </div>
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Is it compulsory?</span>
                                                <span class="tm-kv-value">
                                                    <t t-if="tender.briefing_compulsory">Yes</t>
                                                    <t t-else="">No</t>
                                                </span>
                                            </div>
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Briefing Date and Time</span>
                                                <span class="tm-kv-value">
                                                    <t t-if="tender.briefing_date_time">
                                                        <t t-esc="tender.briefing_date_time"/>
                                                    </t>
                                                    <t t-else="">N/A</t>
                                                </span>
                                            </div>
                                            <div class="tm-kv-item">
                                                <span class="tm-kv-label">Briefing Venue</span>
                                                <span class="tm-kv-value">
                                                    <t t-if="tender.briefing_venue">
                                                        <t t-esc="tender.briefing_venue"/>
                                                    </t>
                                                    <t t-else="">N/A</t>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="tm-info-card">
                                        <div class="section-heading tm-section-heading">RFQ Documents</div>
                                        <p class="tm-doc-hint">Click a file name below to download it directly.</p>
                                        <ul class="tm-doc-list">
                                            <t t-if="not tender.rfq_document_ids">
                                                <li class="text-muted">No RFQ documents available.</li>
                                            </t>
                                            <t t-foreach="tender.rfq_document_ids" t-as="document">
                                                <li>
                                                    <a class="tm-doc-link" t-att-href="'/download/document/%d' % document.id">
                                                        <span class="tm-doc-name" t-att-title="document.name">
                                                            <t t-esc="document.name"/>
                                                        </span>
                                                        <i class="fa fa-download"/>
                                                    </a>
                                                </li>
                                            </t>
                                        </ul>
                                        <div class="tm-doc-actions">
                                            <a class="btn btn-primary custom-button-bid"
                                               t-att-href="'/download/all_rfq_documents/%d' % tender.id">
                                                Download RFQ Documents
                                            </a>
                                        </div>
                                    </div>

                                    <div class="tm-info-card mt-4">
                                        <div class="section-heading tm-section-heading">Other Documents</div>
                                        <ul class="tm-doc-list">
                                            <t t-if="not tender.document_ids">
                                                <li class="text-muted">No additional documents available.</li>
                                            </t>
                                            <t t-foreach="tender.document_ids" t-as="document">
                                                <li>
                                                    <a class="tm-doc-link" t-att-href="'/download/document/%d' % document.id">
                                                        <span class="tm-doc-name" t-att-title="document.name">
                                                            <t t-esc="document.name"/>
                                                        </span>
                                                        <i class="fa fa-download"/>
                                                    </a>
                                                </li>
                                            </t>
                                        </ul>

                                        <div class="tm-doc-actions">
                                            <a class="btn btn-primary custom-button-bid"
                                               t-att-href="'/download/all_documents/%d' % tender.id">
                                                Download All Documents
                                            </a>
                                            <!--
                                            <a class="btn btn-primary custom-button-bid"
                                               title="Download Documents" target="_blank"
                                               t-attf-href="/print_bid1/{{ tender.id }}">
                                                Preview
                                                <i class="ms-1 fa fa-download"/>
                                            </a>
                                            -->
                                        </div>

                                        <div class="tm-detail-actions">
                                            <div class="tm-submission-row" t-if="tender.allow_bidding">
                                                <p class="tm-submission-label">Bid Submission</p>
                                            </div>
                                            <t t-if="warning_message and tender.allow_bidding">
                                                <p id="loginMessage" class="tm-warning-message mt-2">
                                                    <t t-esc="warning_message"/>
                                                </p>
                                            </t>
                                            <div class="tm-back-links">
                                                <t t-if="tender.allow_bidding and not warning_message and tender.state not in blocked_states">
                                                    <a t-att-href="'/bid_submit/%d' % tender.id" class="btn btn-primary tm-next-btn">Next >>></a>
                                                </t>
                                                <t t-if="tender.type == 'rfq'">
                                                    <a href="/tenders-rfqs" class="btn btn-primary tm-back-btn">Back To RFQs</a>
                                                </t>
                                                <t t-if="tender.type == 'rfp'">
                                                    <a href="/tenders-rfps" class="btn btn-primary tm-back-btn">Back To RFPs</a>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="bid_submission_template" name="Bid Submission">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure tm-procurement-wrap">
                <t t-set="active_menu" t-value="'rfq' if tender.type == 'rfq' else ('rfp' if tender.type == 'rfp' else 'home')"/>
                <t t-call="tender_management.procurement_contact_nav"/>

                <t t-set="hero_title" t-value="'PROCUREMENT'"/>
                <t t-set="hero_subtitle" t-value="'Bid Submission'"/>
                <t t-set="breadcrumb_parent_label" t-value="'Tender Detail'"/>
                <t t-set="breadcrumb_parent_url" t-value="'/tender/%d' % tender.id"/>
                <t t-set="breadcrumb_label" t-value="'Submit Bid'"/>
                <t t-call="tender_management.procurement_hero"/>

                <div class="container tm-content-block">
                    <div class="tm-form-panel">
                        <form action="/submit_bid" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="tender_id" t-att-value="tender.id"/>
                            <div class="row" id="whole_sub" t-ref="location">
                                <div class="col-md-12">
                                    <div class="form-group p-3 tm-inner-form-panel">
                                        <h4>Selected Tender: <t t-esc="tender.name"/></h4>
                                        <t t-set="customer" t-value="request.env.user.partner_id"/>
                                        <p>Vendor Name: <t t-esc="customer.name"/></p>
                                        <div>
                                            <label for="bid_documents">Upload Documents:</label>
                                            <input type="file" id="bid_documents" name="bid_documents_ids" multiple="true" required="required"
                                                   accept=".pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                                        </div>
                                        <div class="row s_col_no_resize s_col_no_bgcolor mb-3"/>
                                        <div class="form-group d-flex justify-content-between mt-4">
                                            <button type="submit" id="next" class="btn btn-primary">Submit</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="error_template" name="Error Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure tm-procurement-wrap">
                <t t-set="active_menu" t-value="'home'"/>
                <t t-call="tender_management.procurement_contact_nav"/>

                <t t-set="hero_title" t-value="'PROCUREMENT'"/>
                <t t-set="hero_subtitle" t-value="'Something went wrong'"/>
                <t t-set="breadcrumb_label" t-value="False"/>
                <t t-call="tender_management.procurement_hero"/>

                <div class="container tm-content-block">
                    <div class="tm-thankyou-panel text-center">
                        <h1>Error</h1>
                        <p t-esc="error_message"/>
                        <a href="/tenders" class="btn btn-primary mt-3">Back to Tenders</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="thank_you_page" name="Bid Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure tm-procurement-wrap">
                <t t-set="active_menu" t-value="'home'"/>
                <t t-call="tender_management.procurement_contact_nav"/>

                <t t-set="hero_title" t-value="'PROCUREMENT'"/>
                <t t-set="hero_subtitle" t-value="'Bid Submission Completed'"/>
                <t t-set="breadcrumb_label" t-value="False"/>
                <t t-call="tender_management.procurement_hero"/>

                <div class="container tm-content-block">
                    <div class="tm-thankyou-panel text-center">
                        <h1>Thank You!</h1>
                        <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                            <hr class="mx-auto border-top w-50 border-dark text-center"/>
                        </div>
                        <h5>
                            <span class="fa fa-check-circle"/>
                            <span>Your bid has been submitted successfully.</span>
                        </h5>
                        <h5 class="mt-3">
                            <span class="tm-reference-label">You can track with this Reference Number:</span>
                            <br/>
                            <span class="tm-reference-value">
                                <t t-esc="reference_number"/>
                            </span>
                        </h5>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
