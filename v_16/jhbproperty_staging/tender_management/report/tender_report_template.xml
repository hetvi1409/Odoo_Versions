<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--    PDF report action-->
    <record id="tender_tender_report_action" model="ir.actions.report">
        <field name="name">Tender</field>
        <field name="model">tender.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.tender_report_template</field>
        <field name="report_file">tender_management.tender_report_template</field>
        <field name="binding_model_id" ref="model_tender_tender"/>
        <field name="binding_type">report</field>
    </record>

    <template id="tender_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <h3 align="center">Tender Report</h3>
                        <br/>
                        <br/>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td>
                                    <strong>Tender Name</strong>
                                </td>
                                <td>
                                    <span t-esc="o.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Category</strong>
                                </td>
                                <td>
                                    <span t-esc="o.category_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Procurement Entity</strong>
                                </td>
                                <td>
                                    <span t-esc="o.procurement_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Current Status</strong>
                                </td>
                                <td>
                                    <span t-esc="o.state.capitalize()"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Description</strong>
                                </td>
                                <td>
                                    <span t-esc="o.description"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Tender Opening Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.start_time"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Closing Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.closing_date"/>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <h5>Documents and Details</h5>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Document Name</th>
                                    <th>Document Type</th>
                                    <th>Upload Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.document_ids" t-as="document">
                                    <tr>
                                        <td>
                                            <span t-esc="document.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="document.tender_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="document.create_date"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>