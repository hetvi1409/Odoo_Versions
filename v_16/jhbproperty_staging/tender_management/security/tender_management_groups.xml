<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--        New user groups for the module Tender Management-->
        <record model="ir.module.category" id="tender_management_groups">
            <field name="name">Tender Management</field>
            <field name="description">User access level for Tender Management</field>
            <field name="sequence">8</field>
        </record>

        <record id="tender_management_group_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="tender_management_groups"/>
        </record>

        <record id="tender_management_group_supplier" model="res.groups">
            <field name="name">Supplier</field>
            <field name="implied_ids" eval="[(4, ref('tender_management.tender_management_group_auditor'))]"/>
            <field name="category_id" ref="tender_management_groups"/>
        </record>

        <record id="tender_management_group_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="implied_ids" eval="[(4, ref('tender_management.tender_management_group_supplier')),(4, ref('tender_management.tender_management_group_auditor'))]"/>
            <field name="category_id" ref="tender_management_groups"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>