<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_transport_request_reject_wizard" model="ir.ui.view">
        <field name="name">transport.request.reject.wizard</field>
        <field name="model">transport.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Transport Request">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Reject" type="object" name="action_reject"
                            class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>