<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_template_fuel_card" model="mail.template">
        <field name="name">Fuel Card Overdue</field>
        <field name="model_id" ref="fuel_card_register.model_fuel_card_transaction"/>
        <field name="subject"> Fuel Card Overdue: {{ object.name or 'n/a' }}</field>
        <field name="description">Send to the Fleet manager.</field>
        <field name="email_to">{{user.email}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi,<br/>
                    <p>The following fuel card is overdue for return:</p>
                    <ul>
                        <li><strong>Card:</strong> <t t-out="object.card_id.name"/></li>
                        <li><strong>Driver:</strong> <t t-out="object.driver_id.name"/></li>
                        <li><strong>Date Issued:</strong> <t t-out="object.date_issued"/></li>
                    </ul>
                    <p>Please follow up accordingly.</p>
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_form_fuel_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        <t>
                            Open <t t-out="object.name"/>
                        </t>
                    </a>
                </div>
            </div>
        </field>
    </record>
</odoo>