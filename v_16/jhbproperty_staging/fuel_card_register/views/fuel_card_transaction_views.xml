<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="fuel_card_transaction_form">
        <field name="name">fuel.card.transaction.view.form</field>
        <field name="model">fuel.card.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                    </style>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Transaction Reference"/>
                        </h1>
                    </div>
                    <group>
                        <field name="card_id"/>
                        <field name="driver_id"/>
                        <field name="vehicle_id"/>
                        <field name="date_issued"/>
                        <field name="issued_by_id"/>
                        <field name="date_returned"/>
                        <field name="returned_to_id"/>
                        <field name="status"/>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                           widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="fuel_card_transaction_tree">
        <field name="name">fuel.card.transaction.view.tree</field>
        <field name="model">fuel.card.transaction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="card_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="date_issued"/>
                <field name="issued_by_id"/>
            </tree>
        </field>
    </record>
    <!--    Kanban View-->
    <record id="view_fuel_card_transaction_kanban" model="ir.ui.view">
        <field name="name">fuel.card.transaction.kanban</field>
        <field name="model">fuel.card.transaction</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row mb4">
                                <div class="col-6">
                                    <strong>
                                        <span>
                                            <field name="name"/>
                                        </span>
                                    </strong>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>
                                        <field name="status" widget="badge"/>
                                    </strong>
                                    <br/>
                                    <field name="issued_by_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Search View -->
    <record id="view_fuel_card_transaction_search" model="ir.ui.view">
        <field name="name">fuel.card.transaction.search</field>
        <field name="model">fuel.card.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Fuel Card Transaction">
                <field name="card_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="status"/>
                <field name="date_issued" string="Date and Time issue"/>
                <field name="date_returned"
                       string="Date and Time issue of return"/>

                <filter name="filter_draft" string="Draft"
                        domain="[('status','=','issued')]"/>
                <filter name="filter_published" string="Published"
                        domain="[('status','=','returned')]"/>

                <group expand="1" string="Group By">
                    <filter name="group_by_status" string="Status"
                            context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="fuel_card_transaction_action" model="ir.actions.act_window">
        <field name="name">Fuel Card Transaction</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fuel.card.transaction</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
    <menuitem id="menu_fuel_card_transaction"
              action="fuel_card_transaction_action"
              name="Fuel Card Transaction"
              parent="fleet.fleet_configuration"
              sequence="10"
    />
</odoo>