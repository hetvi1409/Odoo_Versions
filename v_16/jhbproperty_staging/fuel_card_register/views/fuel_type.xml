<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="fuel_type_list">
        <field name="name">fuel.type.view.list</field>
        <field name="model">fuel.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="fuel_type_action" model="ir.actions.act_window">
        <field name="name">Fuel Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fuel.type</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="menu_fuel_type_card"
              action="fuel_type_action"
              name="Fuel Type"
              parent="fleet.fleet_configuration"
              sequence="10"
    />
</odoo>