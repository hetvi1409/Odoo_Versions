<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="server_action_currently_issued_report" model="ir.actions.server">
        <field name="name">Download Issued Fuel Cards</field>
        <field name="model_id" ref="fuel_card_register.model_fuel_card_transaction"/>
        <field name="binding_model_id" ref="fuel_card_register.model_fuel_card_transaction"/>
        <field name="state">code</field>
        <field name="code">action = env['fuel.card.transaction'].create({}).action_download_report()</field>
    </record>
    <menuitem id="menu_issued_card_report_wizard"
              name="Issued Cards"
              parent="fleet.menu_fleet_reporting"
              action="server_action_currently_issued_report" sequence="10"/>
</odoo>
