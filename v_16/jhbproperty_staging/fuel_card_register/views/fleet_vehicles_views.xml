<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='fleet_vehicle_view_form' model='ir.ui.view'>
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_assignation_logs']" position='before'>
                <button name="action_view_tank_details"
                    type="object"
                    class="oe_stat_button"
                    help="show the tank details for this vehicle">Request Fuel<i class='fas fa-gas-pump'/>
                </button>
                <button name="action_view_card_details"
                    type="object"
                    class="oe_stat_button"
                    help="show the tank details for this vehicle">Fuel Card<i class='fas fa-gas-pump'/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>