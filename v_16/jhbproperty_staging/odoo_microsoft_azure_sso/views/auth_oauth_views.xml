<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_oauth_provider_form" model="ir.ui.view">
        <field name="name">auth.oauth.provider.form.kanak</field>
        <field name="model">auth.oauth.provider</field>
        <field name="inherit_id" ref="auth_oauth.view_oauth_provider_form" />
        <field name="arch" type="xml">
            <field name='client_id' position='after'>
                <field name='microsoft_provider' invisible="1" />
                <field name='microsoft_secret_key' password="True" attrs="{'required':[('microsoft_provider','=',True)],'invisible':[('microsoft_provider','=',False)]}" />
                <field name='microsoft_tenant_id' attrs="{'required':[('microsoft_provider','=',True)],'invisible':[('microsoft_provider','=',False)]}" />
            </field>
        </field>
    </record>
</odoo>