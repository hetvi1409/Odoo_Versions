<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_task" name="My Task"
              inherit_id="project.portal_my_task">
        <xpath expr="//t[@t-set='entries']" position="inside">
            <a role="button"
               class="btn btn-primary mb8" data-bs-toggle="modal"
               data-bs-target="#modaltasksign" href="#">
                <i class="fa fa-check"/>
                Sign
            </a>
            <div class="modal fade" id="modaltasksign" tabindex="-1"
                 role="dialog" aria-labelledby="exampleModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Sign
                                Task
                            </h5>
                            <button type="button" class="close"
                                    data-dismiss="modal" aria-label="Close">
<!--                                <span aria-hidden="true">&times;</span>-->
                            </button>
                        </div>
                        <div class="modal-body">
                            <!-- Add your modal content here -->
                            <!-- You can include your form or any other content -->
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-dismiss="modal">Close
                            </button>
                            <!-- Add other buttons if needed -->
                        </div>
                    </div>
                </div>
            </div>
