<template>
    <div t-name="setaCurrentSortItem" class="seta_current_sort_item seta_item seta_btn seta_btn_wlda seta_w100 seta_rd8 active" t-att-data-id="id" t-att-data-name="name">
        <span class="material-icons-outlined seta_btn_icon_left">
            <t t-esc="field_icon"/>
        </span>
        <span class="seta_text seta_block_left" t-att-title="name">
            <t t-esc="name"/>
        </span>
        <span t-att-data-sort_id="sort_id" class="seta_remove_sort_item material-icons seta_btn_icon_right seta_hover_highlight">highlight_off</span>
        <!-- Sort -->
        <div t-att-class="'seta_block_right dropdown seta_dropdown seta_sort_'+sort">
            <div class="dropdown-toggle add_seta_current_sort_item" id="dropdownSort" data-toggle="dropdown">
                <span class="material-icons seta_btn_icon_right" t-att-title="sort == 'asc' ? 'Ascending' : 'Descending'">sort</span>
            </div>
            <div class="dropdown-menu" aria-labelledby="dropdownSort">
                <a class="dropdown-item seta_select_sort_direction" data-sort="asc" t-att-data-sort_id="sort_id">Asc</a>
                <a class="dropdown-item seta_select_sort_direction" data-sort="desc" t-att-data-sort_id="sort_id">Desc</a>
            </div>
        </div>
        <div style="clear:both"/>
    </div>
    <div t-name="setaSelectSortItem" class="seta_select_sort_item seta_item seta_btn seta_btn_wlda seta_w100 seta_rd" t-att-data-id="id" t-att-data-name="name">
        <span class="material-icons-outlined seta_btn_icon_left">
            <t t-esc="field_icon"/>
        </span>
        <span class="seta_text seta_block_left" t-att-title="name">
            <t t-esc="name"/>
        </span>
        <div style="clear:both"/>
    </div>
</template>