<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <function model="seta.data.source" name="create_source_db_odoo"/>

        <!-- Start Block Group: 1. DB Odoo Partner Template -->
        <record model="seta.table" id="seta_table_template_partner">
            <field name="name">Partners</field>
            <field name="source_id" search="[('type', '=', 'db_odoo')]"/>
            <field name="db_query">
                SELECT 
	                rp.id,
                    rp.name,
                    rp.street,
                    rp.city,
                    rcs.name AS state,
                    rc.name AS country,
                    rcp.name AS company,
                    rp.create_date AS create_date
                FROM res_partner rp
                LEFT JOIN res_company rcp ON (rcp.id = rp.company_id)
                LEFT JOIN res_country_state rcs ON (rcs.id = rp.state_id)
                LEFT JOIN res_country rc ON (rc.id = rp.country_id);
            </field>
        </record>

        <function model="seta.table" name="get_table_fields" eval="[ref('seta_table_template_partner')]">
        </function>

        <!-- Start Analysis Partner Template: 1. Count Partner By Address -->
        <record model="seta.analysis" id="seta_analysis_template_partner_by_address">
            <field name="name">Top Partner By City</field>
            <field name="method">table_view</field>
            <field name="source_id" search="[('type', '=', 'db_odoo')]"/>
            <field name='table_id' ref='seta_table_template_partner'/>
            <field name='table_view_id' ref='seta_table_template_partner'/>
            <field name="visual_type_id" ref='seta_dashboard.seta_visual_type_pie'/>
        </record>

        <record model="seta.analysis.metric" id="seta_analysis_metric_template_partner_by_address">
            <field name="analysis_id" ref='seta_analysis_template_partner_by_address'/>
            <field name="field_id" search="[('table_id', '=', ref('seta_table_template_partner')), ('field_name', '=', 'id')]"/>
            <field name="calculation">count</field>
            <field name="sort">desc</field>
        </record>

        <record model="seta.analysis.dimension" id="seta_analysis_dimension_template_partner_by_address">
            <field name="analysis_id" ref='seta_analysis_template_partner_by_address'/>
            <field name="field_id" search="[('table_id', '=', ref('seta_table_template_partner')), ('field_name','=', 'city')]"/>
        </record>
        <!-- End Analysis Partner Template: 1. Count Partner By Address -->

        <!-- Start Analysis Partner Template: 2. Count Partner By Join Date -->
        <record model="seta.analysis" id="seta_analysis_template_partner_by_date">
            <field name="name">Count Partner By Join Date</field>
            <field name="method">table_view</field>
            <field name="source_id" search="[('type', '=', 'db_odoo')]"/>
            <field name='table_id' ref='seta_table_template_partner'/>
            <field name='table_view_id' ref='seta_table_template_partner'/>
            <field name="visual_type_id" ref='seta_dashboard.seta_visual_type_row'/>
        </record>

        <record model="seta.analysis.metric" id="seta_analysis_metric_template_partner_by_date">
            <field name="analysis_id" ref='seta_analysis_template_partner_by_date'/>
            <field name="field_id" search="[('table_id', '=', ref('seta_table_template_partner')), ('field_name', '=', 'id')]"/>
            <field name="calculation">count</field>
        </record>

        <record model="seta.analysis.dimension" id="seta_analysis_dimension_template_partner_by_date">
            <field name="analysis_id" ref='seta_analysis_template_partner_by_date'/>
            <field name="field_id" search="[('table_id', '=', ref('seta_table_template_partner')), ('field_name','=', 'create_date')]"/>
            <field name="field_format">day</field>
            <field name="sort">asc</field>
        </record>
        <!-- Start Analysis Partner Template: 2. Count Partner By Join Date -->

        <!-- End Block Group: 1. DB Odoo Partner Template -->
        
        <!-- Create Dashboard -->
        <record model="seta.dashboard" id="seta_dashboard_template_partner">
            <field name="name">Example of Partner Dashboard</field>
            <field name="theme_id" ref='seta_dashboard_theme_colorful'/>
        </record>
        <record model="seta.dashboard.block" id="seta_dashboard_block_template_partner_by_date">
            <field name="dashboard_id" ref='seta_dashboard_template_partner'/>
            <field name="analysis_id" ref='seta_analysis_template_partner_by_date'/>
        </record>
        <record model="seta.dashboard.block" id="seta_dashboard_block_template_partner_by_address">
            <field name="dashboard_id" ref='seta_dashboard_template_partner'/>
            <field name="analysis_id" ref='seta_analysis_template_partner_by_address'/>
        </record>
        <!-- End Create Dashboard -->
    </data>
</odoo>
