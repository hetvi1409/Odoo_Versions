<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seta_analysis" model="ir.ui.view">
            <field name="name">seta.analysis</field>
            <field name="model">seta.analysis</field>
            <field name="type">setaanalysis</field>
            <field name="arch" type="xml">
                <setaanalysis string="Analysis">
                </setaanalysis>
            </field>
        </record>

        <record model="ir.ui.view" id="seta_dashboard.seta_analysis_form">
            <field name="name">seta.analysis.form</field>
            <field name="model">seta.analysis</field>
            <field name="inherit_id" ref="seta_data.seta_analysis_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='get_analysis_data']" position="after">
                    <button name="get_analysis_data_amchart" context="{'test_analysis_amchart': True}" string="Test Amchart" class="mb16 btn btn-secondary" icon="fa-bug"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>