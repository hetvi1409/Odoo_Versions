<odoo>
    <record id="inherit_view_account_asset_form" model="ir.ui.view">
        <field name="name">account.asset.form.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='closing_book_value_2023']" position="after">
                <field name="total_depreciation_2024"/>
                <field name="closing_accum_w_and_t_2024"/>
                <field name="current_w_and_t_2024"/>
                <field name="closing_tax_value_2024"/>
                <field name="accumulated_depreciation_2024"/>
                <field name="total_depreciation_2025"/>
                <field name="current_w_and_t_2025"/>
                <field name="closing_accum_w_and_t_2025"/>
                <field name="closing_tax_value_2025"/>
                <field name="accumulated_depreciation_2025"/>
                <field name="closing_book_value_2024"/>
                <field name="closing_book_value_2025"/>
            </xpath>
        </field>
    </record>
</odoo>