<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="supply_chain_document_view_order_form" model="ir.ui.view">
        <field name="name">supply.chain.document.form</field>
        <field name="model">supply.chain.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <group>
                    <field name="folder_id"/>
                    <field name="sub_folder_id"/>
                    <field name="attachment_filename" invisible="1"/>
                    <field name="attachment" widget="binary"
                           filename="attachment_filename" readonly="0"/>
                </group>
                <footer>
                    <button name="document_upload" type="object"
                            id="reject_budget_finance" string="UPLOAD"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>