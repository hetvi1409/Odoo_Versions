                ['|',('company_id','=',False),('company_id', 'in', company_ids)]
            </field>
        </record>
        <record id="bsc_memo_multi_company" model="ir.rule">
            <field name="name">Memo Multi Company</field>
            <field name="model_id" ref="model_bsc_memo"/>
