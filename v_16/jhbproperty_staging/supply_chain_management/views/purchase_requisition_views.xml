<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_requisition_action" model="ir.actions.act_window">
        <field name="name">Purchase Requisition</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.requisition</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <record id="purchase_requisition_view_form" model="ir.ui.view">
        <field name="name">purchase.requisition.view.form</field>
        <field name="model">purchase.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget='statusbar'
                           statusbar_visible='draft,first_approve,second_approve'/>
                    <button name="action_first_approve"
                            class="oe_highlight" states="draft"
                            string="First Approval" type="object"
                            groups="supply_chain_management.purchase_requisition_user_manager"/>
                    <button name="action_first_review"
                            class="btn btn-secondary" states="draft"
                            string="Refuse" type="object"
                            groups="supply_chain_management.purchase_requisition_user_manager"/>
                    <button name="action_budget_approve"
                            class="oe_highlight" states="first_approve"
                            string="Approve Budget" type="object"
                            groups="supply_chain_management.purchase_requisition_finance"/>
                    <button name="action_budget_refuse"
                            class="btn btn-secondary" states="first_approve"
                            string="Refuse" type="object"
                            groups="supply_chain_management.purchase_requisition_finance"/>
                    <button name="action_create_meeting"
                            class="btn btn-secondary"
                            string="Create Meeting" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'second_approve'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm"/>
                    <button name="action_approve"
                            class="oe_highlight" string="Approve" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'second_approve'), ('type', '!=', 'not_competitive')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'second_approve'), ('type', '!=', 'not_competitive')]}"
                            class="btn btn-secondary"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_approve_spec"
                            class="oe_highlight" string="Approve" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'second_approve'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm"/>
                    <button name="action_refuse_spec" string="Refuse" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'second_approve'), ('type', '!=', 'competitive_bid')]}"
                            class="btn btn-secondary"
                            groups="supply_chain_management.purchase_requisition_scm"/>
                    <button name="action_create_po"
                            class="oe_highlight" string="Create Purchase Order" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'approve'), ('type', '!=', 'not_competitive')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_create_po"
                            class="oe_highlight" string="Create Purchase Order" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'agreement'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_tender_advertisement"
                            class="oe_highlight" string="Tender Advertisement" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'approve'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_send_audit_report"
                            class="oe_highlight" string="Send the report" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'advertisement'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_bid_evaluation"
                            class="oe_highlight" string="Bid Evaluation" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'advertisement'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_edc_meeting"
                            class="oe_highlight" string="Create Meeting" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'bid_evaluated'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm_manager"/>
                    <button name="action_edc"
                            class="oe_highlight" string="Evaluation Review" type="object"
                            attrs="{'invisible': ['|', ('state', '!=', 'bid_evaluated'), ('type', '!=', 'competitive_bid')]}"
                            groups="supply_chain_management.purchase_requisition_scm_eac"/>
                    <button name="reset_drafts" class="btn btn-secondary"
                            groups="supply_chain_management.purchase_requisition_user"
                            states="first_approve,second_approve,cancelled"
                            string="Set to Draft" type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="get_budget_details"
                                attrs="{'invisible': ['|', ('state', '=', 'draft'),
                                ('budget_count', '=', '0')]}"
                                icon="fa-credit-card">
                            <field string="Budget details"
                                   name="budget_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="get_memo_details"
                                attrs="{'invisible': [('memo_id', '=', False)]}"
                                icon="fa-book">
                            Memo
                        </button>
                        <button class="oe_stat_button" type="object"
                            name="get_committee_meeting_details"
                            icon="fa-calendar">
                            <field string="Meetings" name="meeting_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="New"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="selected_partner_id"
                                   domain="[('id', 'in', partner_ids)]"
                                   options="{'no_create': True}"
                                   attrs="{'invisible': [('state', 'in', ['draft', 'first_approve'])]}"/>
                            <field name="requisition_date"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="budget_count" invisible="0"/>
                            <field name="memo_id"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="independent_advisor_id"
                                   attrs="{'invisible': [('state', 'in', ['draft', 'first_approve', 'second_approve', 'approve', 'created_po'])]}"/>
                            <field name="report_send" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requisition Orders ">
                            <field name="line_ids"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="amount"/>
                                    <field name="sub_total"/>
                                </tree>
                            </field>

                            <group class="oe_subtotal_footer oe_right"
                                   colspan="2">
                                <div class="oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Quote">
                            <field name="quote_line_ids">
                                <tree editable="bottom">
                                    <field name="partner_id"
                                           domain="[('id', 'in', parent.partner_ids)]"
                                           options="{'no_create': True}"/>
                                    <field name="description" />
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Document">
                            <group>
                            <button name="supply_document_upload" type="object"
                                    string="UPLOAD"
                                    class="btn-primary"/>
                            </group>
                        </page>

                        <page string="Recommendation Report"
                              attrs="{'invisible': ['|', ('state', 'not in', ['advertisement', 'bid_evaluated']), ('type', '!=', 'competitive_bid')]}">
                            <group>
                                <field name="recommendation_report" widget="html"/>
                            </group>
                        </page>
                        <page string="Documents" attrs="{'invisible': ['|', ('state', 'not in', ['advertisement', 'bid_evaluated']), ('type', '!=', 'competitive_bid')]}">
                            <group>
                                <field name="attachment_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="purchase_requisition_view_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.view.tree</field>
        <field name="model">purchase.requisition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="type"/>
                <field name="amount_total"/>
                <field name="state" decoration-info="state == 'draft'"
                       decoration-success="state in ('approve', 'created_po')"
                       decoration-muted="state in ('second_approve', 'first_approve')"
                       decoration-danger="state == 'cancelled'" widget="badge"/>
            </tree>
        </field>
    </record>

    <menuitem id="purchase_requisition_menu"
              name="Purchase Requisition"
              parent="purchase.menu_procurement_management"
              action="purchase_requisition_action"
              groups="supply_chain_management.purchase_requisition_user"/>

</odoo>