<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_internal_audit_operational_plan"
            model="ir.actions.act_window">
        <field name="name">Internal Audit Operational Plan</field>
        <field name="res_model">operational.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Operational Plan
            </p>
            <p>
                Create and manage the Operational Plan;
            </p>
        </field>
    </record>
    <record id="internal_audit_operational_plan_view_tree" model="ir.ui.view">
        <field name="name">operational.plan.view.tree</field>
        <field name="model">operational.plan</field>
        <field name="arch" type="xml">
            <tree duplicate="0">
                <field name="sequence_number"/>
                <field name="name" string="AOP Name"/>
                <field name="rolling_plan_id" string="ARP Name"/>
                <field name="scope_of_work"/>
                <field name="assurance_consulting"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="user_ids"
                       widget="many2many_tags"/>
                <field name="tag_ids"/>
            </tree>
        </field>
    </record>
    <record id="internal_audit_operational_plan_view_form" model="ir.ui.view">
        <field name="name">operational.plan.view.form</field>
        <field name="model">operational.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                           
                            string="1st Review" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'preparer')]}"/>
                    <button name="action_2nd_review" type="object"
                           
                            string="2nd Review" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'first_reviewer')]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'first_reviewer')]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'second_reviewer')]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'second_reviewer')]}"/>
                    <button name="action_reject" type="object"
                           
                            string="Reject" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'second_reviewer')]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Move to Prepare" class="oe_highlight" attrs="{'invisible': [('stages', '!=', 'rejected')]}"/>
                    <button name="action_send_sign" type="object" string="Send For Sign" class="oe_highlight"/>
                    <field name="stages" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                string="Revert Records"
                                class="oe_stat_button" icon="fa-book">
                        </button>
                        <button name="view_signed_document" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                string="ARP 1 Year" attrs="{'invisible': [('sign_request_id', '!=', False)]}">
                            Signed Document
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="name" options="{'line_breaks': False}"
                                   widget="text" class="o_text_overflow"/>
                        </h1>
                    </div>
                    <group>
                        <group>
<!--                            <field name="plan_id"/>-->
<!--                            <field name="rolling_plan_id"/>-->
<!--                            <field name="sequence_number"/>-->
<!--                            <field name="description"/>-->
                            <field name="user_id"/>
<!--                            <field name="period"/>-->
<!--                            <field name="assurance_consulting"/>-->
                            <field name="user_ids" invisible="1"/>
                            <field name="user_preparer_ids"
                                   widget="many2one_avatar_user"/>
                            <field name="sign_request_id" invisible="0"/>
<!--                            <field name="user_reviewer_1_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   attrs="{'readonly': [('stages', '=', 'approved')]}"/>-->
<!--                            <field name="user_reviewer_2_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   attrs="{'readonly': [('stages', '=', 'approved')]}"/>-->
<!--                            <field name="user_approver_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   attrs="{'readonly': [('stages', '=', 'approved')]}"/>-->
                        </group>
                        <group>
<!--                            <field name="start_date"-->
<!--                                   string="Planned Date"-->
<!--                                   widget="daterange"-->
<!--                                   options="{'end_date_field': 'date_end', 'always_range': 1}"-->
<!--                                   required="start_date or date_end"-->
<!--                                   on_change="1"/>-->
                            <!-- Invisible End Date to store the value -->
<!--                            <field name="date_end"-->
<!--                                   invisible="1"-->
<!--                                   required="start_date"-->
<!--                                   on_change="1"/>-->
<!--                            <field name="scope_of_work"/>-->
<!--                            <field name="department_ids" widget="many2many_tags"/>-->
<!--                            <field name="entity_type_id"/>-->
                            <field name="team_member_ids"
                                   widget="many2many_tags"/>
<!--                            <field name="q1_allocated_time" widget="timesheet_uom"/>-->
<!--                            <field name="q2_allocated_time" widget="timesheet_uom"/>-->
<!--                            <field name="q3_allocated_time" widget="timesheet_uom"/>-->
<!--                            <field name="q4_allocated_time" widget="timesheet_uom"/>-->
                            <field name="check_allocated_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Projects">
                            <field name="project_ids">
                                <tree create="0">
                                    <field name="name"/>
                                    <field name="plan_id"/>
                                    <field name="internal_audit_3_years"/>
                                    <field name="internal_audit_1_year_id"/>
                                    <field name="sequence_number"/>
                                    <field name="audit_type"/>
                                    <field name="scope_of_work"/>
                                    <field name="q1_allocated_time" widget="timesheet_uom"/>
                                    <field name="q2_allocated_time" widget="timesheet_uom"/>
                                    <field name="q3_allocated_time" widget="timesheet_uom"/>
                                    <field name="q4_allocated_time" widget="timesheet_uom"/>
                                    <field name="department_id"/>
                                    <field name="user_id"/>
                                    <field name="date_start"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tracking">
                            <field name="operational_plan_tracking_ids">
                                <tree string="Tracking">
                                    <field name="user_id"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="comment"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Upload Documents">
                            <group>
                                <group>
                                    <field name="attachment_ids"
                                           widget="many2many_binary"
                                           attrs="{'readonly': [('stages', 'in', ['approved', 'rejected'])]}"/>
                                </group>
                                <group>
                                    <button name="action_view_documents"
                                           
                                            type="object" icon="fa-file-text-o"
                                            string="Open Documents" attrs="{'invisible': [('attachment_ids', '!=', False)]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Audit Reverts/ Review Notes">
                            <group>
                                <field name="feedback"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
</odoo>
