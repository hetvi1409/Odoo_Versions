<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_internal_audit_method" model="ir.actions.act_window">
        <field name="name">Internal Audit Methodology</field>
        <field name="res_model">internal.audit.method</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Internal Audit Method
            </p>
            <p>
                Create and manage the Internal Audit Method
            </p>
        </field>
    </record>
    <record id="internal_audit_method_view_form" model="ir.ui.view">
        <field name="name">internal.audit.method.view.form</field>
        <field name="model">internal.audit.method</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                           
                            string="Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'preparer')]}"/>
                    <button name="action_2nd_review" type="object" string="2nd Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'first_reviewer')]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_mark_discrepancy" type="object"
                           
                            string="Refuse" attrs="{'invisible': [('state', 'in', ['reverted', 'rejected', 'approved'])]}"/>
                    <button name="action_send_back_review" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('state', 'in', ['preparer', 'reverted', 'rejected', 'approved'])]}"/>
                    <button name="action_send_back_new" type="object"
                           
                            string="Move To New" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                string="Revert Records"
                                class="oe_stat_button" icon="fa-book">
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence_no" readonly="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="team_id"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
<!--                            <field name="user_preparer_ids"/>-->
<!--                            <field name="user_reviewer_1_ids"/>-->
<!--                            <field name="user_reviewer_2_ids"/>-->
<!--                            <field name="user_approver_ids"/>-->
                            <field name="user_ids" invisible="1"/>
                            <field name="memo_template" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                        </group>
                        <group>
                            <button name="action_view_documents"
                                   
                                    type="object" icon="fa-file-text-o"
                                    string="Open Documents" attrs="{'invisible': [('attachment_ids', '!=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <group>
                                <field name="background_body" />
                            </group>
                        </page>
                        <page string="Documents">
                            <group>
                                <group>
                                    <field name="document_ids"
                                           widget="many2many_binary">
                                    </field>
                                </group>
                                <group>
                                    <button name="action_view_documents"
                                           
                                            type="object" icon="fa-file-text-o"
                                            string="Open Documents" attrs="{'invisible': [('document_ids', '!=', False)]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tracking"
                              name="methodology_tracking">
                            <field name="methodology_tracking_ids"
                                   options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}">
                                <tree editable="bottom" create="0" edit="0">
                                    <field name="user_id"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="comment"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Reverts/ Review Notes">
                            <group>
                                <field name="feedback"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
    <record id="internal_audit_method_view_tree" model="ir.ui.view">
        <field name="name">internal.audit.method.view.tree</field>
        <field name="model">internal.audit.method</field>
        <field name="arch" type="xml">
            <tree duplicate="0">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('preparer')"
                       decoration-warning="state in ('rejected')"
                       decoration-success="state in ('approved')"/>
            </tree>
        </field>
    </record>
</odoo>