<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_audit_follow_up" model="ir.actions.act_window">
        <field name="name">Audit Followup</field>
        <field name="res_model">audit.followup</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Audit Followup
            </p>
            <p>
                Create and manage the Audit Followup.
            </p>
        </field>
    </record>
    <record id="audit_follow_up_view_tree" model="ir.ui.view">
        <field name="name">Audit FollowUp</field>
        <field name="model">audit.followup</field>
        <field name="arch" type="xml">
            <tree duplicate="0">
                <field name="followup_name"/>
                <field name="audit_number"/>
            </tree>
        </field>
    </record>
    <record id="audit_follow_up_view_form" model="ir.ui.view">
        <field name="name">Audit FollowUp</field>
        <field name="model">audit.followup</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                           
                            string="1st Review" class="oe_highlight" attrs="{'invisible': [('stage', '!=', 'preparer')]}"/>
                    <button name="action_2nd_review" type="object"
                           
                            string="2nd Review" class="oe_highlight" attrs="{'invisible': [('stage', '!=', 'first_reviewer')]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('stage', 'not in', ['first_reviewer', 'second_reviewer'])]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': [('stage', '!=', 'second_reviewer')]}"/>
                    <button name="action_sent_manager" type="object"
                           
                            string="Send To Auditee" class="oe_highlight" attrs="{'invisible': [('stage', '!=', 'follow_up')]}"/>
                    <button name="action_audit_conclusion" type="object"
                           
                            string="Audit Conclusion" class="oe_highlight" attrs="{'invisible': [('stage', '!=', 'audit_response')]}"/>
                    <field name="stage" widget="statusbar" statusbar_visible="follow_up,audit_response,audit_conclusion"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                string="Revert Records"
                                class="oe_stat_button" icon="fa-book">
                        </button>
                    </div>
                    <div class="pe-0 w-100">
                        <h1 class="d-flex justify-content-between align-items-center">
                            <div class="d-flex w-100">
                                <field name="followup_name"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="audit_number"/>
                            <field name="project_id"/>
                            <label for="start_date" string="Period"/>
                            <div>
                                <field name="start_date" class="oe_inline"/>
                                -
                                <field name="end_date" class="oe_inline"/>
                            </div>
                            <field name="subject"/>
                            <field name="date_audit"/>
                        </group>
                        <group>
                            <field name="user_preparer_ids"/>
<!--                            <field name="user_reviewer_1_ids"/>-->
<!--                            <field name="user_reviewer_2_ids"/>-->
<!--                            <field name="user_approver_ids"/>-->
                            <field name="edms_template"/>
                        </group>
                    </group>
                    <table style="width:100%" attrs="{'invisible': [('stage', 'not in', [['follow_up', 'audit_response', 'audit_conclusion']])]}">
                        <tr>
                            <th>
                                <strong>AUDIT FOLLOW UP SETTING</strong>
                            </th>
                        </tr>
                    </table>
                    <notebook>
                         <page string="Content">
                            <group>
                                <field name="background_body" />
                            </group>
                        </page>
                        <page string="INTERNAL AUDIT CAPTURING">
                            <field name="follow_up_setting">
                                <tree editable="bottom">
                                     <field name="main_stage" attrs="{'column_invisible': True}"/>
                                     <field name="follow_up_number"/>
                                     <field name="audit_area" attrs="{'readonly': [('main_stage', 'in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="title_of_finding" attrs="{'readonly': [('main_stage', 'in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="recommendation" attrs="{'readonly': [('main_stage', 'in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="responsible_mngr" attrs="{'readonly': [('main_stage', 'in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="mgmt_action_plan" attrs="{'readonly': [('parent.stage', 'not in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="poe" attrs="{'readonly': [('parent.stage', 'not in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="action_date" attrs="{'readonly': [('parent.stage', 'not in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="attach_poe" widget="many2many_binary" attrs="{'readonly': [('parent.stage', 'not in', ['audit_response', 'audit_conclusion'])]}"/>
                                     <field name="implement_not_implement" attrs="{'readonly': [('parent.stage', 'not in', ['audit_conclusion'])]}"/>
                                     <field name="follow_up" attrs="{'readonly': [('parent.stage', 'not in', ['audit_conclusion'])]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Audit Reverts/ Review Notes">
                            <group>
                                <field name="feedback"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
    <menuitem id="audit_follow_up_plan_menu"
              name="Audit Follow Up"
              parent="internal_audit_management.follow_up_update"
              action="action_audit_follow_up"
              sequence="2"/>
</odoo>