<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.project.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//div[hasclass('settings')]/div[@data-key='project']" position="inside">
                <div class="row mt16 o_settings_container" name="project_template_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="project_template_setting">
                        <div class="o_setting_left_pane">
                            <field name="template_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="template_id"/>
                            <div class="text-muted">
                                Create new project using this template
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="arp_sign_template_setting">
                        <div class="o_setting_left_pane">
                            <field name="arp_sign_template_id"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="arp_sign_template_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
