<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="requested_doc" model="ir.ui.view">
        <field name="name">requested.doc.view.form</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button type="object" name="access_content" string="Access" class="oe_highlight"/>
                    <button type="object" name="access_content" string="Download" class="oe_highlight"/>
                    <button type="object" name="toggle_lock" string="Lock" attrs="{'invisible': [('lock_uid', '!=', False)]}"/>
                    <button type="object" name="toggle_lock" string="Unlock" attrs="{'invisible': [('lock_uid', '!=', False)]}"/>
                    <button type="object" name="action_unarchive" string="Restore" attrs="{'invisible': [('active', '!=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_resource" type="object" class="oe_stat_button" icon="fa-external-link" attrs="{'invisible': ['|',('res_id', '!=', False), ('res_model', 'in', [False, 'documents.document'])]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Related <br/> Record</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Moved to trash" bg_color="text-bg-danger" attrs="{'invisible': [('active', '!=', False)]}"/>
                    <field name="thumbnail" nolabel="1" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;:&quot;thumbnail&quot;}" attrs="{'invisible': [('thumbnail', '!=', False)]}"/>
                    <div class="oe_title" aria-label="Name">
                        <h1>
                            <field name="name" class="oe_inline" placeholder="Document Name" required="True" attrs="{'readonly': [('is_locked', '!=', False)]}"/> <i class="fa fa-lock oe_inline" title="Locked" attrs="{'invisible': [('lock_uid', '!=', False)]}"/>
                        </h1>
                    </div>
                    <field name="is_locked" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="res_model"/>
                    <group>
                        <group>
                            <field name="datas" string="File" filename="name" attrs="{'readonly': [('is_locked', '!=', False)]}"/>
                            <field name="folder_id" options="{'no_create_edit': True, 'no_create': True}"/>
                            <field name="owner_id" string="Submitted by" widget="many2one_avatar_user" attrs="{'readonly': [('is_locked', '!=', False)]}"/>
                        </group>
                        <group>
                            <field name="create_date" string="Date Submitted"/>
                            <field name="create_uid" widget="many2one_avatar_user"/>
                            <field name="lock_uid" readonly="1" attrs="{'invisible': [('lock_uid', '!=', False)]}"/>
                        </group>
                    </group>
                    <group groups="base.group_no_one">
                        <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        <field name="file_size" invisible="1"/>
                        <field name="mimetype" invisible="1"/>
                    </group>
<!--                    <group>-->
<!--                        <field name="create_activity_option" invisible="1"/>-->
<!--                    </group>-->
<!--                    <group string="Activity" name="activity" autofocus="autofocus" invisible="1">-->
<!--                        <group>-->
<!--                            <field name="create_activity_type_id" options="{'no_create': True, 'no_open': True}" attrs="{'required': [('create_activity_option', '!=', False)]}"/>-->
<!--                            <field name="create_activity_summary" placeholder="e.g. Discuss proposal"/>-->
<!--                        </group>-->
<!--                        <group>-->
<!--                            <label for="create_activity_date_deadline_range"/>-->
<!--                            <div class="o_row">-->
<!--                                <field name="create_activity_date_deadline_range"/>-->
<!--                                <field name="create_activity_date_deadline_range_type"/>-->
<!--                            </div>-->
<!--                            <field name="create_activity_user_id"/>-->
<!--                        </group>-->
<!--                        <group>-->
<!--                            <field name="create_activity_note" placeholder="Log a note..."/>-->
<!--                        </group>-->
<!--                    </group>-->
                </sheet>
                <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
     <record id="action_requested_docss" model="ir.actions.act_window">
        <field name="name">Requested Doc</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">tree,form</field>
         <field name="view_ids"
       eval="[(5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('documents.documents_view_list')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('internal_audit_management.requested_doc')})]"/>

        <field name="domain">[("res_model", "=", 'project.task')]</field>
    </record>

    <menuitem name="Requested Documents" id="requested_doc_menu"
              parent="internal_audit_management.audit_process_menu"
              sequence="5" action="action_requested_docss"/>
</odoo>