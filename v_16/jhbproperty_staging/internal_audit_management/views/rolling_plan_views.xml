    <record id="internal_audit_rolling_plan_view_tree" model="ir.ui.view">
        <field name="name">rolling.plan.view.tree</field>
        <field name="model">rolling.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence_no"/>
                <field name="category_id"/>
                <field name="rec_name"/>
                <field name="name" attrs="{'column_invisible': True}"/>
                <field name="department_ids"/>
                <field name="risk_priority_rating"/>
                <field name="start_date" string="Start Date"/>
                <field name="date_end"/>
            </tree>
        </field>
    </record>
