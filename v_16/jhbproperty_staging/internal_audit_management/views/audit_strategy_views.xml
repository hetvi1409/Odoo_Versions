<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_audit_strategy" model="ir.actions.act_window">
        <field name="name">Audit Strategy</field>
        <field name="res_model">audit.strategy</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Strategy
            </p>
            <p>
                Create and manage the Audit Strategy;
            </p>
        </field>
    </record>
    <record id="audit_strategy_view_form" model="ir.ui.view">
        <field name="name">audit.strategy.view.form</field>
        <field name="model">audit.strategy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object" string="1st Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'preparer')]}"/>
                    <button name="action_2nd_review" type="object" string="2nd Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'first_reviewer')]}"/>
                    <button name="action_revert" type="object" string="Revert" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'first_reviewer')]}"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_reject" type="object" string="Reject" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_update" type="object"
                           
                            string="Updated" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'reverted')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="requirements"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="user_id"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="record_work_done"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="conclusion"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                        </group>
                        <group>
                            <field name="user_ids" invisible="1"/>
                            <field name="team_id"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="user_preparer_ids"
                                   widget="many2one_avatar_user"/>
<!--                            <field name="user_reviewer_1_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   attrs="{'readonly': [('state', '=', 'approved')]}"/>-->
<!--                            <field name="user_reviewer_2_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   attrs="{'readonly': [('state', '=', 'approved')]}"/>-->
<!--                            <field name="user_approver_ids"-->
<!--                                   widget="many2one_avatar_user"-->
<!--                                   attrs="{'readonly': [('state', '=', 'approved')]}"/>-->
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"
                               attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                        <field name="feedback"
                               attrs="{'invisible': [('state', 'not in', ['reverted'])]}"/>
                    </group>
                    <notebook>
                        <page string="Tracking"
                              name="audit_strategy_tracking_ids">
                            <field name="audit_strategy_tracking_ids"
                                   options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}">
                                <tree editable="bottom" create="0" edit="0">
                                    <field name="user_id"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="comment"/>
                                    <field name="date"/>
                                </tree>
                               </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
    <record id="audit_strategy_view_tree" model="ir.ui.view">
        <field name="name">audit.strategy.view.form</field>
        <field name="model">audit.strategy</field>
        <field name="arch" type="xml">
            <tree duplicate="0">
                <field name="requirements"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('preparer')"
                       decoration-warning="state in ('reverted')"
                       decoration-success="state in ('approved')"/>
            </tree>
        </field>
    </record>
    <menuitem id="audit_strategy_menu"
              name="Audit Strategy"
              parent="internal_audit_management.committee_charter_root_menu"
              action="action_audit_strategy"
              sequence="20"/>
</odoo>