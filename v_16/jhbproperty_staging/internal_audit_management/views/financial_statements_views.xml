<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_financial_statement" model="ir.actions.act_window">
        <field name="name">Council Resolution</field>
        <field name="res_model">financial.statement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Methodology
            </p>
            <p>
                Create and manage the Internal Audit Methodology and other
                information;
            </p>
        </field>
    </record>
    <record id="financial_statement_view_form" model="ir.ui.view">
        <field name="name">financial.statement.view.form</field>
        <field name="model">financial.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                           
                            string="Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'preparer')]}"/>
                    <button name="action_2nd_review" type="object" string="2nd Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'first_reviewer')]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_mark_discrepancy" type="object"
                           
                            string="Refuse" attrs="{'invisible': [('state', 'in', ['reverted', 'rejected'])]}"/>
                    <button name="action_send_back_review" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('state', 'in', ['rejected', 'preparer', 'reverted', 'approved'])]}"/>
                    <button name="action_send_back_new" type="object"
                           
                            string="Move To New" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                string="Revert Records"
                                class="oe_stat_button" icon="fa-book">
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"
                                   attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="sequence_no"/>
                            <field name="requirements"
                                   style="height: 105px;" attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
<!--                            <field name="user_id"-->
<!--                                   readonly="state in ['approved', 'rejected']"/>-->
                            <field name="record_work_done"
                                   style="height: 105px;" attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                            <field name="conclusion"
                                   style="height: 105px;" attrs="{'readonly': [('state', 'in', ['approved', 'rejected'])]}"/>
                        </group>
                        <group>
<!--                            <field name="team_id"-->
<!--                                   readonly="state in ['approved', 'rejected']"/>-->
                            <field name="user_preparer_ids" widget="many2one_avatar_user"/>
<!--                            <field name="user_reviewer_1_ids" widget="many2one_avatar_user"/>-->
<!--                            <field name="user_reviewer_2_ids" widget="many2one_avatar_user"/>-->
<!--                            <field name="user_approver_ids" widget="many2one_avatar_user"/>-->
                            <field name="user_ids" invisible="1"/>
                        </group>
                    </group>
<!--                    <group>-->
<!--                        <field name="attachment_ids" widget="many2many_binary"-->
<!--                               readonly="state in ['approved', 'rejected']"/>-->
<!--                        <field name="interim_attachment_ids"-->
<!--                               widget="many2many_binary"-->
<!--                               readonly="state in ['approved', 'rejected']"/>-->
<!--                        <field name="performance_attachment_ids"-->
<!--                               widget="many2many_binary"-->
<!--                               readonly="state in ['approved', 'rejected']"/>-->
<!--                        <field name="feedback"-->
<!--                               readonly="state not in ['rejected']"/>-->
<!--                    </group>-->
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="document_ids"
                                       widget="many2many_binary">
                                </field>
                            </group>
                        </page>
<!--                        <page string="Comments">-->
<!--&lt;!&ndash;                            <field name="comment_ids"&ndash;&gt;-->
<!--&lt;!&ndash;                                   readonly="state not in ['new']">&ndash;&gt;-->
<!--&lt;!&ndash;                                <tree editable="bottom">&ndash;&gt;-->
<!--&lt;!&ndash;                                    <field name="name"/>&ndash;&gt;-->
<!--&lt;!&ndash;                                </tree>&ndash;&gt;-->
<!--&lt;!&ndash;                            </field>&ndash;&gt;-->
<!--                        </page>-->
                        <page string="Tracking"
                              name="financial_statement_tracking">
                            <field name="financial_statement_tracking_ids"
                                   options="{'no_create_edit': True, 'no_quick_create': True, 'no_open': True}">
                                <tree editable="bottom" create="0" edit="0">
                                    <field name="user_id"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="comment"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Reverts/ Review Notes">
                            <group>
                                <field name="feedback"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
    <record id="financial_statement_view_tree" model="ir.ui.view">
        <field name="name">financial.statement.view.form</field>
        <field name="model">financial.statement</field>
        <field name="arch" type="xml">
            <tree duplicate="0">
                <field name="sequence_no"/>
                <field name="requirements"/>
                <field name="team_id"/>
                <!--                <field name="role_id"/>-->
                <field name="state" widget="badge"
                       decoration-info="state in ('preparer')"
                       decoration-warning="state in ('rejected')"
                       decoration-success="state in ('approved')"/>
            </tree>
        </field>
    </record>
</odoo>