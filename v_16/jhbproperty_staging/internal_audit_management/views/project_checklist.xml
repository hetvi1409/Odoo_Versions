<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_project_checklist" model="ir.actions.act_window">
        <field name="name">Project Checklist</field>
        <field name="res_model">project.checklist</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Project Checklist
            </p>
            <p>
                Create and manage the Project Checklist
            </p>
        </field>
    </record>
    <record id="project_checklist__tree" model="ir.ui.view">
        <field name="name">project.checklist.view.form</field>
        <field name="model">project.checklist</field>
        <field name="arch" type="xml">
            <tree duplicate="0">
                <field name="project_title"/>
                <field name="project"/>
            </tree>
        </field>
    </record>
    <record id="action_print_project_checklist" model="ir.actions.report">
        <field name="name">Project Checklist</field>
        <field name="model">ir.actions.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.report_project_checklist</field>
        <field name="print_report_name">'Project Checklist'</field>
    </record>
    <record id="project_checklist_form" model="ir.ui.view">
        <field name="name">view.project.checklist.form</field>
        <field name="model">project.checklist</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object"
                           
                            string="1st Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'preparer')]}"/>
                    <button name="action_2nd_review" type="object"
                           
                            string="2nd Review" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'first_reviewer')]}"/>
                    <button name="action_revert" type="object"
                           
                            string="Revert" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['first_reviewer', 'second_reviewer'])]}"/>
                    <button name="action_send_approver" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_approve" type="object"
                           
                            string="Approve" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'approver')]}"/>
                    <button name="action_reject" type="object"
                           
                            string="Reject" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'second_reviewer')]}"/>
                    <button name="action_print_project_checklist" type="object" string="Print" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="preparer,first_reviewer,second_reviewer,approved,reverted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                string="Revert Records"
                                class="oe_stat_button" icon="fa-book">
                        </button>
                    </div>
                    <h5 style="text-align:left;">PROJECT CHECKLIST AND AUDIT CONSIDERATIONS</h5>
                    <table style="width:100%">
                        <tr>
                            <td>
                                <strong>Title:  <field name="project_title"/></strong>
                            </td>
                            <td>
                                <group>
                                    <field name="user_preparer_ids"/>
                                </group>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Project:  <field name="project_id"/></strong>
                            </td>
                            <td>
                                <group>
                                    <field name="user_reviewer_1_ids"/>
                                </group>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Project #: </strong><field name="project"/>
                            </td>
                            <td>
                                <group>
                                    <field name="user_reviewer_2_ids"/>
                                </group>
                            </td>
                        </tr>
                        <tr>
                            <td>

                            </td>
                            <td>
                                <group>
                                    <field name="user_approver_ids"/>
                                </group>
                            </td>
                        </tr>
                    </table>
                    <div style="width:100%">
                        <h4><b>Planning: </b></h4>
                        <field name="planing_checklist_ids" style="border-collapse: collapse; width: 100%; border: 2px solid black;">
                            <tree options='{"no_open": True}'>
                                <field name="description" string=" " style="border: 1px solid black; padding: 8px;"/>
                                <field name="plan_date" style="border: 1px solid black; padding: 8px;"/>
                                <field name="initials" style="border: 1px solid black; padding: 8px;"/>
                            </tree>
                        </field>
                    </div>
                    <div style="width:100%">
                        <h4><b>Preliminary Survey: </b></h4>
                        <field name="preliminary_survey_ids" style="border-collapse: collapse; width: 100%; border: 2px solid black;">
                            <tree options='{"no_open": True}'>
                                <field name="description" string=" " style="border: 1px solid black; padding: 8px;"/>
                                <field name="plan_date" style="border: 1px solid black; padding: 8px;"/>
                                <field name="initials" style="border: 1px solid black; padding: 8px;"/>
                            </tree>
                        </field>
                    </div>
                    <div style="width:100%">
                        <h4><b>FIELD WORK PHASE: </b></h4>
                        <field name="field_work_ids" style="border-collapse: collapse; width: 100%; border: 2px solid black;">
                            <tree options='{"no_open": True}'>
                                <field name="description" string=" " style="border: 1px solid black; padding: 8px;"/>
                                <field name="plan_date" style="border: 1px solid black; padding: 8px;"/>
                                <field name="initials" style="border: 1px solid black; padding: 8px;"/>
                            </tree>
                        </field>
                    </div>
                    <div style="width:100%">
                        <h4><b>FINAL PHASE: </b></h4>
                        <field name="final_phase_ids" style="border-collapse: collapse; width: 100%; border: 2px solid black;">
                            <tree options='{"no_open": True}'>
                                <field name="description" string=" " style="border: 1px solid black; padding: 8px;"/>
                                <field name="plan_date" style="border: 1px solid black; padding: 8px;"/>
                                <field name="initials" style="border: 1px solid black; padding: 8px;"/>
                            </tree>
                        </field>
                    </div>
                    <table style="width:100%">
                        <tr>
                            <td><strong>Auditor-in-Charge:  <field name="auditor_in_charge"/></strong></td>
                            <td><strong>Audit Manager :  <field name="auditor_manager"/></strong></td>
                        </tr>
                    </table>
                    <notebook>
                        <page string="Audit Reverts/ Review Notes">
                            <group>
                                <field name="feedback"/>
                            </group>
                        </page>
                        <page string="Documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
        </div>
            </form>
        </field>
    </record>
</odoo>
