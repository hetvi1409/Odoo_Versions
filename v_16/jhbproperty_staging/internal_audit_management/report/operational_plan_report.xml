<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="internal_operational_plan_report_action"
            model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">operational.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.operational_plan_report</field>
        <field name="report_file">internal_audit_management.operational_plan_report</field>
        <field name="binding_model_id" ref="model_operational_plan"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s' % object.name</field>
    </record>

    <template id="operational_plan_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="col-xs-4" style="padding:0;">
                            <center>
                                <h2 t-esc="doc.name"/>
                            </center>
                        </div>
                        <table class="table table-striped align_center">
                            <tr>
<!--                                <td>-->
<!--                                    <strong>Internal Audit Rolling Plan: 3-->
<!--                                        Year:-->
<!--                                    </strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.plan_id.name"/>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <strong>Internal Audit Rolling Plan: 1 Year:-->
<!--                                    </strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <span t-field="doc.rolling_plan_id.name"/>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <strong>ARP Number:</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <span t-field="doc.sequence_number"/>-->
<!--                                </td>-->
                            </tr>
                            <tr>
<!--                                <td>-->
<!--                                    <strong>Motivation/Link to Description :-->
<!--                                    </strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.description"/>-->
<!--                                </td>-->
                                <td>
                                    <strong>Manager Responsible :</strong>
                                </td>
                                <td>
                                    <span t-field="doc.user_id.name"/>
                                </td>
                                <td>
                                    <strong>State :</strong>
                                </td>
                                <td>
                                    <span t-field="doc.stages"/>
                                </td>
                            </tr>
                            <tr>
<!--                                <td>-->
<!--                                    <strong>Type Of Audit :</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.assurance_consulting"/>-->
<!--                                </td>-->
                                <td>
                                    <strong>Start Date :</strong>
                                </td>
                                <td>
                                    <span t-field="doc.start_date"/>
                                </td>
                                <td>
                                    <strong>End Date :</strong>
                                </td>
                                <td>
                                    <span t-field="doc.date_end"/>
                                </td>
                            </tr>
                        </table>
                        <table class="table table-striped align_center">
                            <tr>
<!--                                <td>-->
<!--                                    <strong>Scope Of Work :</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.scope_of_work"/>-->
<!--                                </td>-->
                                <td>
                                    <strong>Departments :</strong>
                                </td>
                                <td>
                                    <t t-foreach="doc.department_ids"
                                       t-as="department">
                                        <span t-field="department.name"/>,
                                    </t>
                                </td>
                                <td>
                                    <strong>Team Members :</strong>
                                </td>
                                <td>
                                    <t t-foreach="doc.team_member_ids"
                                       t-as="member">
                                        <span t-field="member.name"/>,
                                    </t>
                                </td>
                            </tr>
                            <tr>
<!--                                <td>-->
<!--                                    <strong>Q1 Allocated Time :</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.q1_allocated_time"/>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <strong>Q2 Allocated Time :</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.q2_allocated_time"/>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <strong>Q3 Allocated Time :</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.q3_allocated_time"/>-->
<!--                                </td>-->
                            </tr>
                            <tr>
<!--                                <td>-->
<!--                                    <strong>Q4 Allocated Time :</strong>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-esc="doc.q4_allocated_time"/>-->
<!--                                </td>-->
                                <td>
                                    <strong>Check Allocated Time :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.check_allocated_time"/>
                                </td>
                                <td>
                                    <strong>Preparer :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_preparer_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>First Reviewer :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_1_ids.name"/>
                                </td>
                                <td>
                                    <strong>Second Reviewer :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_2_ids.name"/>
                                </td>
                                <td>
                                    <strong>Approver :</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_approver_ids.name"/>
                                </td>
                            </tr>
                        </table>
                        <t t-if="doc.project_ids">
                            <center>
                                <h4>Projects</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Project Name</th>

                                        <th>Internal Audit Rolling Plan: 3 Year</th>
                                        <th>Internal Audit Rolling Plan: 1 Year</th>
                                        <th>ARP Number</th>
                                        <th>Type Of Audit</th>
                                        <th>Scope Of Work</th>
                                        <th>Q1 Allocated Time</th>
                                        <th>Q2 Allocated Time</th>
                                        <th>Q3 Allocated Time</th>
                                        <th>Q4 Allocated Time</th>

                                        <th>Team</th>
                                        <th>Project Manager</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.project_ids"
                                        t-as="project">
                                        <td>
                                            <t t-esc="project.name"/>
                                        </td>

                                        <td>
                                            <t t-esc="project.internal_audit_3_years"/>
                                        </td><td>
                                            <t t-esc="project.internal_audit_1_year_id"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.sequence_number"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.audit_type"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.scope_of_work"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.q1_allocated_time"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.q2_allocated_time"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.q3_allocated_time"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.q4_allocated_time"/>
                                        </td>


                                        <td>
                                            <t t-esc="project.department_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.user_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.date_start"/>
                                        </td>
                                        <td>
                                            <t t-esc="project.date"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <center>
                                <h4>Revert Details</h4>
                            </center>
                            <t t-if="doc.feedback">
                                <table class="table table-striped align_center">
                                    <tr>
                                        <td>
                                            <strong>Feedback:</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.feedback"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                            <t t-set="reverts"
                               t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                            <t t-if="reverts">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Revert Name</th>
                                            <th>Created Date</th>
                                            <th>Review Comments</th>
                                            <th>Audit Proposal</th>
                                            <th>State</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="reverts"
                                            t-as="revert">
                                            <td>
                                                <t t-esc="revert.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="revert.date"/>
                                            </td>
                                            <td>
                                                <t t-esc="revert.comments"/>
                                            </td>
                                            <td>
                                                <t t-esc="revert.audit_findings"/>
                                            </td>
                                            <td>
                                                <span t-field="revert.state"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
