<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="audit_followup_report_action" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">audit.followup</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.audit_followup_report</field>
        <field name="report_file">internal_audit_management.audit_followup_report</field>
        <field name="binding_model_id" ref="model_audit_followup"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">' Audit Followup %s' % object.name</field>
    </record>

    <template id="audit_followup_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="col-xs-4" style="padding:0;">
                            <center>
                                <h2 t-esc="doc.followup_name"/>
                            </center>
                        </div>
                        <table style="width:100%; border-collapse: collapse;">
                            <tr>
                                <td>
                                    <strong>Audit Number:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.audit_number"/>
                                </td>
                                <td>
                                    <strong>Preparer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_preparer_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Project:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.project_id.name"/>
                                </td>
                                <td>
                                    <strong>First Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_1_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Period:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.start_date"/> - <t t-esc="doc.end_date"/>
                                </td>
                                <td>
                                    <strong>Second Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_2_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Subject:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.subject"/>
                                </td>
                                <td>
                                    <strong>Approver:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_approver_ids.name"/>
                                </td>

                            </tr>
                            <tr>
                                <td>
                                    <strong>Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.date_audit"/>
                                </td>
                            </tr>
                        </table>
                        <t t-if="doc.follow_up_setting">
                            <center>
                                <h4>Audit Capturing</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>Audit Area</th>
                                        <th>Title of Finding</th>
                                        <th>Recommendation</th>
                                        <th>Responsible Manager</th>
                                        <th>Management's Action Plan</th>
                                        <th>POE</th>
                                        <th>Action Date</th>
                                        <th>Implemented</th>
                                        <th>Follow Up</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="audit_cap" t-value="doc.follow_up_setting"/>
                                    <tr t-foreach="audit_cap" t-as="aud">
                                        <td>
                                            <t t-esc="aud.follow_up_number"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.audit_area"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.title_of_finding"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.recommendation"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.responsible_mngr.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.mgmt_action_plan"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.poe"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.action_date"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.implement_not_implement"/>
                                        </td>
                                        <td>
                                            <t t-esc="aud.follow_up"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.feedback">
                            <center>
                                <h4>Revert Details</h4>
                            </center>
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Feedback:</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.feedback"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <t t-set="reverts"
                           t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                        <t t-if="reverts">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Revert Name</th>
                                        <th>Created Date</th>
                                        <th>Review Comments</th>
                                        <th>Audit Proposal</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="reverts"
                                        t-as="revert">
                                        <td>
                                            <t t-esc="revert.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.date"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.comments"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.audit_findings"/>
                                        </td>
                                        <td>
                                            <span t-field="revert.state"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
