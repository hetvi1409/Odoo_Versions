<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pestel_analysis_report_action" model="ir.actions.report">
        <field name="name">PDF Report</field>
        <field name="model">pestel.analysis</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_audit_management.pestel_analysis_report</field>
        <field name="report_file">internal_audit_management.pestel_analysis_report</field>
        <field name="binding_model_id" ref="model_pestel_analysis"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s' % object.name</field>
    </record>

    <template id="pestel_analysis_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="col-xs-4" style="padding:0;">
                            <center>
                                <h2 t-esc="doc.name"/>
                            </center>
                        </div>
                        <table style="width:100%; border-collapse: collapse;">
                            <tr>
                                <td>
                                    <strong>Sequence Number:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.sequence_no"/>
                                </td>
                                <td>
                                    <strong>Preparer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_preparer_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Start Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.start_date"/>
                                </td>
                                <td>
                                    <strong>First Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_1_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>End Date:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.end_date"/>
                                </td>
                                <td>
                                    <strong>Second Reviewer:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_reviewer_2_ids.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Approver:</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.user_approver_ids.name"/>
                                </td>

                            </tr>
                        </table>
                        <t t-if="doc.political_factor">
                            <center>
                                <h4>Political Factor</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="politic" t-value="doc.political_factor"/>
                                    <tr t-foreach="politic" t-as="pol">
                                        <td>
                                            <t t-esc="pol.critical_issues"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.internal_audit_implication"/>
                                        </td>
                                        <td>
                                            <t t-esc="pol.sequence"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.economic_factor">
                            <center>
                                <h4>Economic Factor</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="economic" t-value="doc.economic_factor"/>
                                    <tr t-foreach="economic" t-as="eco">
                                        <td>
                                            <t t-esc="eco.critical_issues"/>
                                        </td>
                                        <td>
                                            <t t-esc="eco.internal_audit_implication"/>
                                        </td>
                                        <td>
                                            <t t-esc="eco.sequence"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.social_factor">
                            <center>
                                <h4>Social Factor</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="social" t-value="doc.social_factor"/>
                                    <tr t-foreach="social" t-as="soc">
                                        <td>
                                            <t t-esc="soc.critical_issues"/>
                                        </td>
                                        <td>
                                            <t t-esc="soc.internal_audit_implication"/>
                                        </td>
                                        <td>
                                            <t t-esc="soc.sequence"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.technological_factor">
                            <center>
                                <h4>Technological Factor</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="technological" t-value="doc.technological_factor"/>
                                    <tr t-foreach="technological" t-as="tech">
                                        <td>
                                            <t t-esc="tech.critical_issues"/>
                                        </td>
                                        <td>
                                            <t t-esc="tech.internal_audit_implication"/>
                                        </td>
                                        <td>
                                            <t t-esc="tech.sequence"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.environmental_factor">
                            <center>
                                <h4>Environmental Factor</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="environment" t-value="doc.environmental_factor"/>
                                    <tr t-foreach="environment" t-as="envi">
                                        <td>
                                            <t t-esc="envi.critical_issues"/>
                                        </td>
                                        <td>
                                            <t t-esc="envi.internal_audit_implication"/>
                                        </td>
                                        <td>
                                            <t t-esc="envi.sequence"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.legislative_factor">
                            <center>
                                <h4>Legislative Factor</h4>
                            </center>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Critical Issues</th>
                                        <th>Internal Audit Implications</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="legislative" t-value="doc.legislative_factor"/>
                                    <tr t-foreach="legislative" t-as="leg">
                                        <td>
                                            <t t-esc="leg.critical_issues"/>
                                        </td>
                                        <td>
                                            <t t-esc="leg.internal_audit_implication"/>
                                        </td>
                                        <td>
                                            <t t-esc="leg.sequence"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <center>
                            <h4>Revert Details</h4>
                        </center>
                        <t t-if="doc.feedback">
                            <table class="table table-striped align_center">
                                <tr>
                                    <td>
                                        <strong>Feedback:</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.feedback"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <t t-set="reverts"
                           t-value="doc.env['audit.revert'].search([('res_id', '=', doc.id), ('res_model', '=', doc._name)])"/>
                        <t t-if="reverts">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Revert Name</th>
                                        <th>Created Date</th>
                                        <th>Review Comments</th>
                                        <th>Audit Proposal</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="reverts"
                                        t-as="revert">
                                        <td>
                                            <t t-esc="revert.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.date"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.comments"/>
                                        </td>
                                        <td>
                                            <t t-esc="revert.audit_findings"/>
                                        </td>
                                        <td>
                                            <span t-field="revert.state"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
