<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="internal_audit_revert_view_form" model="ir.ui.view">
        <field name="name">internal.audit.revert.view.form</field>
        <field name="model">internal.audit.revert.wizard</field>
        <field name="arch" type="xml">
            <form create="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="comments"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            data-hotkey="t"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>