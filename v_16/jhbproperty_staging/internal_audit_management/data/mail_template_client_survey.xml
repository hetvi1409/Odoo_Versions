<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_client_survey" model="mail.template">
        <field name="name">JHB Local Municipality</field>
        <field name="model_id"
               ref="internal_audit_management.model_client_survey"/>
        <field name="subject">CUSTOMER SATISFACTION SURVEY</field>
        <field name="description">send to the users.</field>
        <field name="email_to">{{object.reviewer.partner_id.email}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Good day
                    <t t-out="object.reviewer.name"/>
                    <br/>
                    Please see below link to the customer satisfaction survey relation to the <t t-out="object.survey_number"/> project for your completion.
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_form_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        <t>
                            Open
                            <t t-out="object.survey_number"/>
                        </t>
                    </a>
                </div>
            </div>
        </field>
    </record>
