<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_project_checklist" model="mail.template">
        <field name="name">Umzimkhulu Local Municipality</field>
        <field name="model_id"
               ref="internal_audit_management.model_project_checklist"/>
        <field name="subject">Project Checklist</field>
        <field name="description">send to the users.</field>
        <field name="email_to">{{object.user_reviewer_1_ids.partner_id.email}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Good day
                    <t t-out="object.user_reviewer_1_ids.name"/>
                    <br/>
                    Please see below link to the project checklist relation to the <t t-out="object.project_title"/> project for your completion.
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_form_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        <t>
                            Open
                            <t t-out="object.project_title"/>
                        </t>
                    </a>
                </div>
            </div>
        </field>
    </record>
