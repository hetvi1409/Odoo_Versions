<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_audit_findings_to_review" model="mail.template">
        <field name="name">Audit Findings</field>
        <field name="model_id"
               ref="internal_audit_management.model_audit_finding"/>
        <field name="subject">Audit Findings : Review</field>
        <field name="description">send to the users.</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hi
                    <br/>
                    Audit Finding was created
                    <b>
                        <t t-out="object.audit_finding"/>
                    </b>Please review this.
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="(object.get_list_url())"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                            Open
                    </a>
                </div>
            </div>
        </field>
    </record>
