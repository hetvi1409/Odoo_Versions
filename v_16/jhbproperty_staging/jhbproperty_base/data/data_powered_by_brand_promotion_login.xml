<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <template id="frontend_layout_brand_promotion_inline_inherit" inherit_id="web.frontend_layout" name="Frontend Layout Brand Promotion Inline" priority="95">
            <xpath expr="//div[hasclass('o_footer_copyright')]//div[hasclass('row')]" position="replace">
                <div class="row">
                    <div class="col-12 text-center text-muted">
                        <span class="o_footer_copyright_name me-2">&#169; 2000 - <t t-out="datetime.datetime.now().year"/>. City of Joburg Property Company</span>
                        <span class="o_jhb_brand_promotion_inline">
                            <span> - </span>
                            <a class="fw-semibold" target="_blank" href="https://www.natedsystems.co.za/">Powered by Nated Systems</a>
                            <span> - </span>
                            <a target="_blank" href="https://www.odoo.com/">Technology by Odoo</a>
                        </span>
                    </div>
                </div>
            </xpath>
        </template>

        <template id="login_layout_inherit" inherit_id="web.login_layout" name="Login Layout">
            <xpath expr="//a[contains(@href, 'utm_source=db')]" position="replace">
                <a href="https://www.odoo.com/" target="_blank">Technology by <span>Odoo</span></a>
            </xpath>
        </template>

    </data>
</odoo>