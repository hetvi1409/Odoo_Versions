<odoo>
    <record id="view_memo_action_wizard_form" model="ir.ui.view">
        <field name="name">memo.action.wizard.form</field>
        <field name="model">memo.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Memo Action">
                <group>
                    <field name="action_type" invisible="1"/>
                    <field name="reject_reason"
                           attrs="{'invisible': [('action_type', '!=', 'reject')]}"/>
                    <field name="change_reason"
                           attrs="{'invisible': [('action_type', '!=', 'change')]}"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="confirm_action" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>