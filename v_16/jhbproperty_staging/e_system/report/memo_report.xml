<odoo>
    <record id="paperformat_e_submission" model="report.paperformat">
            <field name="name">E-Submission</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">60</field>
            <field name="margin_bottom">35</field>
            <field name="margin_left">12</field>
            <field name="margin_right">12</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">40</field>
            <field name="dpi">90</field>
        </record>
    <record id="action_report_memo_management" model="ir.actions.report">
            <field name="name">E-Submission PDF</field>
            <field name="model">memo.memo</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">e_system.report_memo_document</field>
            <field name="report_file">e_system.report_memo_document</field>
<!--            <field name="binding_model_id" ref="e_system.model_memo_memo"/>-->
<!--            <field name="binding_type">report</field>-->
            <field name="print_report_name">'Memo - %s' % (object.memo_number or object.name)</field>
            <field name="paperformat_id" ref="paperformat_e_submission"/>
        </record>
</odoo>
