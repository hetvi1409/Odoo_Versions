<odoo>
    <!-- Kanban View -->
    <record id="view_memo_kanban" model="ir.ui.view">
        <field name="name">memo.memo.kanban</field>
        <field name="model">memo.memo</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div class="o_kanban_details">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="state" widget="badge"/>
                                    <br/>
                                    <field name="date"/>
                                </div>
                                <div class="o_kanban_footer mt8">
                                    <button type="object" name="action_approve_memo" class="btn btn-sm btn-primary"
                                            attrs="{'invisible': [('state', '!=', 'draft')]}">
                                        Approve
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_memo_graph" model="ir.ui.view">
        <field name="name">memo.memo.graph</field>
        <field name="model">memo.memo</field>
        <field name="arch" type="xml">
            <graph string="Memo Statistics" type="bar">
                <field name="state"/>
                <field name="id" type="count"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_memo_search" model="ir.ui.view">
        <field name="name">memo.memo.search</field>
        <field name="model">memo.memo</field>
        <field name="arch" type="xml">
            <search string="Search Memos">
                <field name="name"/>
                <field name="memo_number" string="Memo Number"/>
                <field name="requester_id"/>
                <field name="state"/>
                <field name="date" string="Memo Date"/>
                <field name="create_uid"/>

                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_signed" string="Signed" domain="[('state','=','signed')]"/>

                <group expand="1" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_by_creator" string="Created By" context="{'group_by':'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
