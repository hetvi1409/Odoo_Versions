<odoo>
    <record id="view_memo_form" model="ir.ui.view">
        <field name="name">memo.memo.form</field>
        <field name="model">memo.memo</field>
        <field name="arch" type="xml">
            <form string="Memo" class="o_form_full">
                <header>
                    <button name="action_save_as_template"
                            type="object"
                            string="Save as Template"
                            class="btn-primary"/>
                    <button name="action_load_template"
                            type="object"
                            string="Load from Template"
                            class="btn-primary"
                            attrs="{'invisible': ['|',('template_id','=',False),('state', 'not in', ['draft'])]}"/>
                    <button name="action_download_memo" type="object"
                            string="Download Memo" class="btn-primary"
                            attrs="{'invisible': [('submission_type', '!=', 'memo')]}"
                            context="{'lang': 'en_US'}"/>
                    <button name="action_download_memo" type="object"
                            string="Download Circular" class="btn-primary"
                            attrs="{'invisible': [('submission_type', '!=', 'circular')]}"
                            context="{'lang': 'en_US'}"/>
                    <button name="action_download_memo" type="object"
                            string="Download Procurement" class="btn-primary"
                            attrs="{'invisible': [('submission_type', '!=', 'procurement')]}"
                            context="{'lang': 'en_US'}"/>
                    <button name="action_preview_report" type="object" string="Preview" class="btn-primary"/>
                    <button name="action_save_version"
                            type="object"
                            string="Save Version"
                            class="btn-primary"
                            attrs="{'invisible': [('state','in',['approved', 'rejected'])]}"/>
                    <button name="%(action_memo_email_wizard)d" type="action"
                            string="Send by Email" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'awaiting_approval')]}"/>
                    <button name="action_quality_assurance" type="object" class="btn-primary"
                            string="Submit for Quality Assurance"
                            attrs="{'invisible': [('show_submit_qa', '=', False)]}"/>
                    <button name="action_done_quality_assurance" type="object" class="btn-primary"
                            string="Complete Quality Assurance"
                            attrs="{'invisible': [('show_complete_qa', '=', False)]}"/>
                    <button name="action_submit" type="object" class="btn-primary" string="Submit for Recommendation"
                            attrs="{'invisible': ['|',('show_submit_recommendation', '=', False),('recommender_required','=',True)]}"/>
                    <button name="action_submit_for_approval" type="object" class="btn-primary" string="Submit for Approval"
                            attrs="{'invisible': ['|','|',('state', '!=', 'draft'),('quality_assurance_required', '=', True),('recommender_required','=',True)]}"/>
                    <button name="action_open_change_request_wizard" type="object" string="Request Change"
                            attrs="{'invisible': [('show_change_request', '=', False)]}"/>
                    <button name="action_approve_memo" type="object" class="btn-primary" string="Approve"
                            attrs="{'invisible': &quot;['|', ('state', '!=', 'pending_approval'), ('approver_id', '!=', uid)]&quot;}"/>
<!--                            attrs="{'invisible': [('state', 'in', ['approved','rejected'])]}"/>-->
                    <button name="action_open_reject_wizard" type="object" class="btn-primary" string="Reject"
                            attrs="{'invisible': &quot;['|', ('state', '!=', 'pending_approval'), ('approver_id', '!=', uid)]&quot;}"/>
<!--                            attrs="{'invisible': [('show_change_request', '=', False)]}"/>-->
                    <!--                    <button name="action_reject" type="object" string="Reject"-->
                    <!--                            attrs="{'invisible': [('state', '!=', 'recommend')]}"/>-->
                    <!--                    <button name="action_request_change" type="object" string="Request Change"-->
                    <!--                            attrs="{'invisible': [('state', 'not in', ['quality_assurance', 'recommend'])]}"/>-->
                    <!--                    <button name="%(action_report_memo_management)d" type="action"-->
                    <!--                            string="Download Memo" class="btn-primary"-->
                    <!--                            attrs="{'invisible': [('submission_type', '!=', 'memo')]}"-->
                    <!--                            context="{'lang': 'en_US'}"/>-->
                    <!--                    <button name="%(action_report_memo_management)d" type="action"-->
                    <!--                            string="Download Circular" class="btn-primary"-->
                    <!--                            attrs="{'invisible': [('submission_type', '!=', 'circular')]}"-->
                    <!--                            context="{'lang': 'en_US'}"/>-->
                    <!--                    <button name="%(action_report_memo_management)d" type="action"-->
                    <!--                            string="Download Procurement" class="btn-primary"-->
                    <!--                            attrs="{'invisible': [('submission_type', '!=', 'procurement')]}"-->
                    <!--                            context="{'lang': 'en_US'}"/>-->
                    <!--                    <button name="action_publish" type="object" string="Publish"-->
                    <!--                            attrs="{'invisible': [('state', '!=', 'approved')]}"/>-->
                    <!--                    <button name="action_acknowledge" type="object" string="Acknowledge"-->
                    <!--                            attrs="{'invisible': [('ack_required', '==', False), ('state', '!=', 'published')]}"/>-->
                    <field name="state" widget="statusbar" attrs="{'invisible': [('is_creator', '=', True)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="0"
                           attrs="{'invisible': [('is_creator', '=', False)]}"/>
                </header>
                <sheet>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) {
                        --o-input-border-color: black !important;
                        }
                        .o_form_view:not(o_field_highlight)
                        .o_field_html .note-editable:not(:hover), .o_form_view:not(o_field_highlight) .o_field_html
                        .note-editable:not(:focus) {
                        border-color: black !important;
                        }
                        .form-check:not(:hover),
                        .form-check:not(:hover) .form-check-input:not(:disabled),
                        .form-select:not(:hover), .form-select:not(:hover) .form-check-input:not(:disabled) {
                        border-color: black !important;
                        }
                    </style>
                    <div class="oe_title pe-0">
                        <h1 class="d-flex flex-row justify-content-between">
                            <field name="name" placeholder="Memo Title..."
                                   attrs="{'invisible': [('submission_type', '!=', 'memo')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="name" placeholder="Circular Title..."
                                   attrs="{'invisible': [('submission_type', '!=', 'circular')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="name" placeholder="Procurement Title..."
                                   attrs="{'invisible': [('submission_type', '!=', 'procurement')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="submission_recommended" invisible="1"/>
                            <field name="show_submit_qa" invisible="1"/>
                            <field name="show_complete_qa" invisible="1"/>
                            <field name="show_change_request" invisible="1"/>
                            <field name="show_submit_recommendation" invisible="1"/>
                            <field name="make_readonly" invisible="1"/>
                            <field name="is_creator" invisible="1"/>
                            <field name="is_follower" invisible="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="memo_number" readonly="1" string="Memo Number" placeholder="Memo Number..."
                                   attrs="{'invisible': [('submission_type', '!=', 'memo')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="memo_number" readonly="1" string="Circular Number"
                                   placeholder="Circular Number..."
                                   attrs="{'invisible': [('submission_type', '!=', 'circular')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="memo_number" readonly="1" string="Procurement Number"
                                   placeholder="Procurement Number..."
                                   attrs="{'invisible': [('submission_type', '!=', 'procurement')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="date" readonly="1" string="Memo Date"
                                   attrs="{'invisible': [('submission_type', '!=', 'memo')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="date" readonly="1" string="Circular Date"
                                   attrs="{'invisible': [('submission_type', '!=', 'circular')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="date" readonly="1" string="Procurement Date"
                                   attrs="{'invisible': [('submission_type', '!=', 'procurement')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="submission_type" required="1" attrs="{'readonly': [('is_follower', '=', True)]}"/>
                            <field name="memo_type" attrs="{'readonly': [('is_follower', '=', True)]}"/>
                            <field name="building_id"
                                   attrs="{'invisible': [('memo_type', '!=', 'property')],'required': [('memo_type', '==', 'property')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="land_process"
                                   attrs="{'invisible': [('memo_type', '!=', 'property')],'required': [('memo_type', '==', 'property')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="property_type"
                                   attrs="{'invisible': [('memo_type', '!=', 'property')],'required': [('memo_type', '==', 'property')],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="template_id" widget="many2one" options="{'no_open': True, 'no_create': True}"
                                   placeholder="Choose template"
                                   attrs="{'readonly': ['|',('state', 'in', ['complete_quality_assurance','recommend', 'approved']),('is_follower', '=', True)]}"/>
                            <field name="quality_assurance_required"
                                   attrs="{'readonly': ['|',('state', 'not in', ['draft']),('is_follower', '=', True)]}"/>
                            <field name="recommender_required" attrs="{'readonly': ['|',('state', 'not in', ['draft']),('is_follower', '=', True)]}"/>
                        </group>
                        <group name="general_information" string="General Information">
                            <field name="subject" placeholder="Add subject..." attrs="{'readonly': [('is_follower', '=', True)]}"/>
                            <field name="change_reason" placeholder="Add change reason..."
                                   attrs="{'invisible': [('state', 'not in', ['change_requested'])],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="rejection_reason" placeholder="Add rejection reason..."
                                   attrs="{'invisible': [('state', 'not in', ['rejected'])],'readonly': [('is_follower', '=', True)]}"/>
                            <field name="target_group_ids" widget="many2many_tags" placeholder="Choose Target Group..."
                                   options="{'no_open': True, 'no_create': True}" attrs="{'readonly': [('is_follower', '=', True)]}"
                                   invisible="1"/>
                            <field name="branch_id" placeholder="Select Department..." context="{'hierarchical_naming':False}"
                                   options="{'no_open': True, 'no_create': True}" attrs="{'readonly': [('is_follower', '=', True)]}"/>
                            <field name="company_id" options="{'no_open': True, 'no_create': True}" attrs="{'readonly': [('is_follower', '=', True)]}"/>
                            <field name="attachment_id" readonly="1" invisible="0"/>
                            <field name="folder_id" readonly="1" invisible="0"/>
                        </group>
                    </group>
                    <notebook>

                        <page string="Memo Content" attrs="{'invisible': [('submission_type', '!=', 'memo')]}">
                            <group>
                                <!--                                <field name="purpose_body" widget="html" class="o_fullscreen_editor"-->
                                <!--                                       placeholder="Add Memo Purpose here..."-->
                                <!--                                       attrs="{'readonly': [('state', 'in', ['complete_quality_assurance','recommend', 'approved'])]}"/>-->
                                <field name="background_body" widget="html" class="o_fullscreen_editor"
                                       placeholder="Add Memo Background here..."
                                       attrs="{'readonly': ['|',('state', 'in', ['complete_quality_assurance','recommend', 'approved']),('is_follower', '=', True)]}"/>
                                <!--                                <field name="motivation_body" widget="html" class="o_fullscreen_editor"-->
                                <!--                                       placeholder="Add Memo Motivation here..."-->
                                <!--                                       attrs="{'readonly': [('state', 'in', ['complete_quality_assurance','recommend', 'approved'])]}"/>-->
                            </group>
                        </page>
                        <page string="Circular Content" attrs="{'invisible': [('submission_type', '!=', 'circular')]}">
                            <group>
                                <!--                                <field name="purpose_body" widget="html" class="o_fullscreen_editor"-->
                                <!--                                       placeholder="Add Circular Purpose here..."-->
                                <!--                                       attrs="{'readonly': [('state', 'in', ['complete_quality_assurance','recommend', 'approved'])]}"/>-->
                                <field name="background_body" widget="html" class="o_fullscreen_editor"
                                       placeholder="Add Circular Background here..."
                                       attrs="{'readonly': ['|',('state', 'in', ['complete_quality_assurance','recommend', 'approved']),('is_follower', '=', True)]}"/>
                                <!--                                <field name="motivation_body" widget="html" class="o_fullscreen_editor"-->
                                <!--                                       placeholder="Add Circular Motivation here..."-->
                                <!--                                       attrs="{'readonly': [('state', 'in', ['complete_quality_assurance','recommend', 'approved'])]}"/>-->
                            </group>
                        </page>
                        <page string="Procurement Content"
                              attrs="{'invisible': [('submission_type', '!=', 'procurement')]}">
                            <group>
                                <!--                                <field name="purpose_body" widget="html" class="o_fullscreen_editor"-->
                                <!--                                       placeholder="Add Procurement Purpose here..."-->
                                <!--                                       attrs="{'readonly': [('state', 'in', ['complete_quality_assurance','recommend', 'approved'])]}"/>-->
                                <field name="background_body" widget="html" class="o_fullscreen_editor"
                                       placeholder="Add Procurement Background here..."
                                       attrs="{'readonly': ['|',('state', 'in', ['complete_quality_assurance','recommend', 'approved']),('is_follower', '=', True)]}"/>
                                <!--                                <field name="motivation_body" widget="html" class="o_fullscreen_editor"-->
                                <!--                                       placeholder="Add Procurement Motivation here..."-->
                                <!--                                       attrs="{'readonly': [('state', 'in', ['complete_quality_assurance','recommend', 'approved'])]}"/>-->
                            </group>
                        </page>
                        <!--                        <page string="Financial Implications">-->
                        <!--                            <group>-->
                        <!--                                <field name="is_financial"-->
                        <!--                                       attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                <field name="financial_sentence" widget="html" class="o_fullscreen_editor"-->
                        <!--                                       placeholder="Add Financial Sentence here..."-->
                        <!--                                       attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                            </group>-->
