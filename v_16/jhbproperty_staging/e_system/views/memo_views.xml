                        <!--                                    <field name="funds"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="responsibility"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="objective"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="item"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="project"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                </group>-->
                        <!--                                <group>-->
                        <!--                                    <field name="asset"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="regional_identifier"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="amount_paid"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="service_provider"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                    <field name="infrastructure"-->
                        <!--                                           attrs="{'required': [('submission_type', '==', 'procurement')]}"/>-->
                        <!--                                </group>-->
                        <!--                            </group>-->
                        <!--                        </page>-->
                        <page string="Requester">
                            <group>
                                <field name="requester_id" string="Requester"
                                       options="{'no_open': True, 'no_create': True}"
                                       attrs="{'readonly': ['|',('requester_sign', '!=', False),('is_follower', '=', True)]}"/>
                                <label for="requester_sign" class="oe_inline"/>
                                <div class="o_row o_row_readonly">
                                    <field name="requester_sign" widget="image" options="{'size': [0, 50]}"
                                           readonly="1"/>
                                    <button name="action_sign_request" type="object" string="Sign Request"
                                            class="oe_highlight"
                                            attrs="{'invisible': [('requester_sign', '!=', False)],'readonly': [('is_follower', '=', True)]}"/>
                                </div>
                            </group>
                        </page>
                        <page string="Quality Assurance"
                              attrs="{'invisible': [('quality_assurance_required', '!=', True)]}">
                            <field name="quality_assurance_ids" mode="list,kanban"
                                   attrs="{'readonly': ['|',('state', 'not in', ['draft','quality_assurance','complete_quality_assurance','change_requested']),('is_follower', '=', True)]}">
                                <tree editable="bottom" decoration-success="status=='Completed'"
                                      decoration-danger="status=='Non-Completed'" no_open="1">
                                    <field name="existing_request_user_ids" invisible="1"/>
                                    <field name="display_name" invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id" string="Quality Assurance User" force_save="1"
                                           options="{'no_open': True, 'no_create': True}"
                                           attrs="{'readonly':['|',('sign_initials','!=',False),('parent.make_readonly','=',True)]}"/>
                                    <field name="required" force_save="1"/>
                                    <field name="date" readonly="1" force_save="1"/>
                                    <field name="status" force_save="1"/>
                                    <field name="comment" force_save="1"/>
                                    <field name="sign_initials" widget="image" options="{'size': [0, 50]}"
                                           readonly="1"/>
                                    <button string="Sign" type="object" name="action_sign_line"
                                            attrs="{'invisible':[('sign_initials','!=',False)]}"/>
                                </tree>
                                <kanban class="o_kanban_mobile">
                                    <templates>
                                        <t t-name="kanban-box" class="flex-row">
                                            <field name="user_id"/>
                                            <t t-if="record.status.raw_value">
                                                <t t-set="classname"
                                                   t-value="{'Completed': 'text-bg-success','Non-Completed': 'text-bg-danger'}[record.status.raw_value] || 'text-bg-light'"/>
                                                <span t-attf-class="ms-auto rounded-pill {{ classname }}">
                                                    <field name="status"/>
                                                </span>
                                            </t>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="existing_request_user_ids" invisible="1"/>
                                        <field name="user_id"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Recommendation" attrs="{'invisible': [('recommender_required', '!=', True)]}">
                            <group>
                                <field name="recommendation" widget="html" class="o_fullscreen_editor"
                                       placeholder="Add Recommendation Sentence here..." attrs="{'readonly': [('is_follower', '=', True)]}"/>
                            </group>
                            <field name="recommender_ids" mode="tree,kanban"
                                   attrs="{'readonly': ['|',('state', 'not in', ['draft','quality_assurance','complete_quality_assurance','change_requested','recommend']),('is_follower', '=', True)]}">
                                <tree editable="bottom" decoration-success="status=='Recommended'"
                                      decoration-danger="status=='Non-Recommended'" no_open="1">
                                    <field name="existing_request_user_ids" invisible="1"/>
                                    <field name="display_name" invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id" string="Recommender"
                                           options="{'no_open': True, 'no_create': True}" force_save="1"
                                           attrs="{'readonly':['|',('sign_initials','!=',False),('parent.make_readonly','=',True)]}"/>
                                    <field name="required" force_save="1"/>
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="comment"/>
                                    <field name="sign_initials" widget="image" options="{'size': [0, 50]}"
                                           readonly="1"/>
                                    <button string="Sign" type="object" name="action_sign_line"
                                            attrs="{'invisible': [('sign_initials', '!=', False)]}"/>
                                </tree>
                                <kanban class="o_kanban_mobile">
                                    <templates>
                                        <t t-name="kanban-box" class="flex-row">
                                            <field name="user_id"/>
                                            <t t-if="record.status.raw_value">
                                                <t t-set="classname"
                                                   t-value="{'Recommended': 'text-bg-success','Non-Recommended': 'text-bg-danger'}[record.status.raw_value] || 'text-bg-light'"/>
                                                <span t-attf-class="ms-auto rounded-pill {{ classname }}">
                                                    <field name="status"/>
                                                </span>
                                            </t>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="existing_request_user_ids" invisible="1"/>
                                        <field name="user_id"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Approver">
                            <group>
                                <field name="approver_id" options="{'no_open': True, 'no_create': True}" required="1"
                                       attrs="{'readonly': ['|',('approver_sign', '!=', False),('is_follower', '=', True)]}"/>
                                <label for="approver_sign" class="oe_inline"/>
                                <div class="o_row o_row_readonly">
                                    <field name="approver_sign" widget="image" options="{'size': [0, 50]}"
                                           readonly="1"/>
                                    <button name="action_sign_approver" type="object" string="Sign Approver"
                                            class="oe_highlight"
                                            attrs="{'invisible': [('approver_sign', '!=', False)],'readonly': [('is_follower', '=', True)]}"/>
                                </div>
                                <field name="approve_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Acknowledgment" invisible="1">
                            <group>
                                <field name="ack_required" attrs="{'readonly': [('is_follower', '=', True)]}"/>
                                <field name="acknowledged_ids" widget="many2many_tags"
                                       options="{'no_open': True, 'no_create': True}"
                                       attrs="{'invisible': [('ack_required', '=', True)],'readonly': [('is_follower', '=', True)]}"/>
                                <field name="read_count" readonly="1"/>
                            </group>
                        </page>
                        <page string="Documents">
                            <field name="document_upload_ids" mode="tree,form" attrs="{'readonly': [('is_follower', '=', True)]}">
                                <tree editable="bottom" decoration-info="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="attachment_id" domain="[('id', '=', False)]"
                                           options="{'create': false, 'create_edit': false}"
                                           context="{'default_res_model': 'memo.document.upload'}"
                                           attrs="{'column_invisible': True}"/>
                                    <field name="datas" filename="name" string="File"/>
                                    <field name="name" string="Document Name"/>
                                    <field name="sign_required"/>
                                    <field name="signature_status" attrs="{'invisible': [('sign_required', '=', False)], 'readonly': [('sign_required', '=', True)]}"/>
                                    <field name="sign_request_id" attrs="{'invisible': [('sign_required', '=', False)], 'readonly': [('sign_required', '=', True)]}"/>
                                    <button name="action_preview_document" type="object" string="Preview"
                                            class="btn-primary"
                                            attrs="{'invisible': [('attachment_id', '=', False)]}"/>
                                    <button name="action_doc_sign_request" type="object" string="Sign Request"
                                            class="btn-primary"
                                            attrs="{'invisible': ['|','|',('sign_required','=',False),('attachment_id', '=', False),('sign_request_id','!=',False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Followers">
                            <field name="message_follower_ids" context="{'default_res_model': 'memo.memo','default_res_id': active_id}" attrs="{'readonly': [('is_follower', '=', True)]}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="email"/>
                                    <field name="res_model" attrs="{'column_invisible': True}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Versions">
                            <field name="version_ids" attrs="{'readonly': [('is_follower', '=', True)]}">
                                <tree string="Memo Versions" default_order="id" edit="0" create="0">
                                    <field name="version_number"/>
                                    <field name="comment"/>
                                    <field name="created_by"/>
                                    <field name="date"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="version_number"/>
                                            <field name="comment"/>
                                        </group>
                                        <group>
                                            <field name="created_by"/>
                                            <field name="date"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="subject"/>
                                        <field name="purpose_body" widget="html" class="o_fullscreen_editor"/>
                                        <field name="background_body" widget="html" class="o_fullscreen_editor"/>
                                        <field name="motivation_body" widget="html" class="o_fullscreen_editor"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

