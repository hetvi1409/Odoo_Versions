    <record model="ir.ui.view" id="building_form_inherit">
        <field name="name">building.inherit_pages.form</field>
        <field name="model">building</field>
        <field name="inherit_id" ref="itsys_real_estate.building_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="folder_id" widget="documents_folder_many2one" readonly="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_sharepoint"
                        type="object"
                        string="SharePoint Documents"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

