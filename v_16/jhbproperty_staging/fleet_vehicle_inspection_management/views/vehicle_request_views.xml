<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_request_action" model="ir.actions.act_window">
        <field name="name">Vehicle Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.vehicle.request</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
    </record>

    <menuitem id="fleet_vehicle_request_menu"
              name="Vehicle Requests"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
              action="fleet_vehicle_request_action"/>

    <record id="fleet_vehicle_request_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.request.view.form</field>
        <field name="model">fleet.vehicle.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,manager_approved,fleet_approved,allocated,completed"/>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_manager_approve" type="object"
                            string="Manager Approve" class="oe_highlight"
                            groups="fleet_vehicle_inspection_management.group_fleet_request_manager"
                            attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_fleet_approve" type="object"
                            string="Fleet Approve" class="oe_highlight"
                            groups="fleet_vehicle_inspection_management.group_fleet_office"
                            attrs="{'invisible': [('state', '!=', 'manager_approved')]}"/>
                    <button name="action_allocate" type="object"
                            string="Allocate" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'fleet_approved')]}"/>
                    <button name="action_complete" type="object"
                            string="Complete" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'allocated')]}"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-secondary"
                            attrs="{'invisible': [('state', 'in', ['rejected','completed'])]}"/>
                </header>
                <sheet>
                    <field name="trip_log_id" invisible="1"/>
                    <field name="key_register_id" invisible="1"/>
                    <field name="checklist_ids" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trip_log" type="object"
                                class="oe_stat_button" icon="fa-road"
                                attrs="{'invisible': [('trip_log_id', '=', False)]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Trip</span>
                                <span class="o_stat_text">Log</span>
                            </div>
                        </button>
                        <button name="action_view_key_register" type="object"
                                class="oe_stat_button" icon="fa-key"
                                attrs="{'invisible': [('key_register_id', '=', False)]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Key</span>
                                <span class="o_stat_text">Register</span>
                            </div>
                        </button>
                        <button name="action_view_checklists" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                attrs="{'invisible': [('checklist_ids', '=', [])]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Daily</span>
                                <span class="o_stat_text">Checklist</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id"/>
                            <field name="department_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="is_urgent"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="requested_vehicle_model_id"/>
                            <field name="requested_vehicle_type"/>
                            <field name="transport_type"/>
                            <field name="number_of_passengers"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="pickup_location"/>
                            <field name="destination"/>
                            <field name="distance_km"/>
                            <field name="purpose"/>
                            <field name="passenger_names"/>
                        </group>
                        <group>
                            <field name="after_hours_id"/>
                            <field name="company_id"/>
                            <button name="action_create_checklist" type="object"
                                    string="Create Daily Checklist" class="oe_highlight"
                                    attrs="{'invisible': [('state', 'not in', ['allocated', 'completed'])]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fleet_vehicle_request_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.request.view.tree</field>
        <field name="model">fleet.vehicle.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="priority" widget="priority"/>
                <field name="is_urgent"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="fleet_vehicle_request_view_calendar" model="ir.ui.view">
        <field name="name">fleet.vehicle.request.view.calendar</field>
        <field name="model">fleet.vehicle.request</field>
        <field name="arch" type="xml">
            <calendar date_start="start_datetime" date_stop="end_datetime"
                      string="Vehicle Requests" mode="month">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="priority"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="fleet_vehicle_request_view_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.request.view.search</field>
        <field name="model">fleet.vehicle.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="vehicle_id"/>
                <field name="state"/>
                <group expand="1" string="Group By">
                    <filter string="Requester" name="requester_id"
                            context="{'group_by':'requester_id'}"/>
                    <filter string="Vehicle" name="vehicle_id"
                            context="{'group_by':'vehicle_id'}"/>
                    <filter string="State" name="state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
