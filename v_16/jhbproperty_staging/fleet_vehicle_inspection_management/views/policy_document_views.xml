<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_policy_document_action" model="ir.actions.act_window">
        <field name="name">Policy Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.policy.document</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="fleet_policy_document_menu"
              name="Policy Documents"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
              action="fleet_policy_document_action"/>

    <record id="fleet_policy_document_view_form" model="ir.ui.view">
        <field name="name">fleet.policy.document.view.form</field>
        <field name="model">fleet.policy.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_type"/>
                            <field name="effective_date"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="policy_from"/>
                            <field name="policy_to"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Signature">
                            <field name="signature" widget="signature"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fleet_policy_document_view_tree" model="ir.ui.view">
        <field name="name">fleet.policy.document.view.tree</field>
        <field name="model">fleet.policy.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="policy_type"/>
                <field name="effective_date"/>
            </tree>
        </field>
    </record>
</odoo>
