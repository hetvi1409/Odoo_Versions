<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_key_register_action" model="ir.actions.act_window">
        <field name="name">Key Register</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.vehicle.key.register</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="fleet_key_register_menu"
              name="Key Register"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
              action="fleet_key_register_action"/>

    <record id="fleet_key_register_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.key.register.view.form</field>
        <field name="model">fleet.vehicle.key.register</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="out,returned"/>
                    <button name="action_return" type="object" string="Return Key"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'out')]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="key_number"/>
                            <field name="issued_to_id"/>
                        </group>
                        <group>
                            <field name="issued_by_id"/>
                            <field name="issued_datetime"/>
                            <field name="returned_datetime"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="odometer_at_issue"/>
                            <field name="odometer_at_return"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fleet_key_register_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.key.register.view.tree</field>
        <field name="model">fleet.vehicle.key.register</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="key_number"/>
                <field name="issued_to_id"/>
                <field name="issued_datetime"/>
                <field name="returned_datetime"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
</odoo>
