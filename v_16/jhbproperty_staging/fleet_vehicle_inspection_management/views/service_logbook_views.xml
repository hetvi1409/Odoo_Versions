<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_service_logbook_action" model="ir.actions.act_window">
        <field name="name">Service Logbook</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.vehicle.service.logbook</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="fleet_service_logbook_menu"
              name="Service Logbook"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
              action="fleet_service_logbook_action"/>

    <record id="fleet_service_logbook_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.service.logbook.view.form</field>
        <field name="model">fleet.vehicle.service.logbook</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="depot_name"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="opening_odometer"/>
                            <field name="closing_odometer"/>
                            <field name="total_kms"/>
                        </group>
                        <group>
                            <field name="service_department"/>
                        </group>
                    </group>
                    <group>
                        <field name="service_maintenance"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fleet_service_logbook_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.service.logbook.view.tree</field>
        <field name="model">fleet.vehicle.service.logbook</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="service_department"/>
            </tree>
        </field>
    </record>
</odoo>
