<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_trip_log_action" model="ir.actions.act_window">
        <field name="name">Trip Logs</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.vehicle.trip.log</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>

    <menuitem id="fleet_trip_log_menu"
              name="Trip Logs"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
              action="fleet_trip_log_action"/>

    <record id="fleet_trip_log_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.trip.log.view.form</field>
        <field name="model">fleet.vehicle.trip.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="start_time"/>
                            <field name="end_time"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_odometer"/>
                            <field name="end_odometer"/>
                            <field name="distance"/>
                        </group>
                        <group>
                            <field name="destination"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fleet_trip_log_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.trip.log.view.tree</field>
        <field name="model">fleet.vehicle.trip.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="distance"/>
            </tree>
        </field>
    </record>

    <record id="fleet_trip_log_view_calendar" model="ir.ui.view">
        <field name="name">fleet.vehicle.trip.log.view.calendar</field>
        <field name="model">fleet.vehicle.trip.log</field>
        <field name="arch" type="xml">
            <calendar date_start="date" date_stop="date_end" string="Trip Logs" mode="month">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="distance"/>
            </calendar>
        </field>
    </record>
</odoo>
