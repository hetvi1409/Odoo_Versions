<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--actions for Inspection request-->
    <record id="inspection_request_action" model="ir.actions.act_window">
        <field name="name">Inspection Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">inspection.request</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <record id="inspection_request_action_to_start"
            model="ir.actions.act_window">
        <field name="name">Started Inspections</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">inspection.request</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
        <field name="domain">[('state','=','inspection_started')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <!--action-->
    <record id="inspection_request_action_to_finish"
            model="ir.actions.act_window">
        <field name="name">Finished Inspections</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">inspection.request</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
        <field name="domain">[('state','=','inspection_finished')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <!--    Inspection Request menus-->
    <menuitem id="inspection_request_menu"
              name="Inspection Request"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
    />
    <menuitem id="inspection_request_details_menu"
              name="Inspection Request"
              parent="inspection_request_menu"
              action="inspection_request_action"/>
    <menuitem id="inspection_request_to_start_menu"
              name="Inspection Started"
              parent="inspection_request_menu"
              action="inspection_request_action_to_start"/>
    <menuitem id="inspection_request_to_finish_menu"
              name="Inspection Finished"
              parent="inspection_request_menu"
              action="inspection_request_action_to_finish"/>
    <!--   Inspection Request views-->
    <record id="inspection_requests_view_form" model="ir.ui.view">
        <field name="name">inspection.request.view.form</field>
        <field name="model">inspection.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget='statusbar'
                           statusbar_visible='draft,new,inspection_started,inspection_finished'/>
                    <button name="action_start_inspection"
                            class="oe_highlight"
                            string="Start Inspection"
                            type="object"
                            help="Start Vehicle Inspection"
                            attrs="{'invisible': [('state', '!=', 'new')]}"/>
                    <button name="action_confirm_inspection"
                            class="oe_highlight"
                            string="Confirm"
                            type="object"
                            help="Confirm Inspection Request"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_finish_inspection"
                            class="oe_highlight"
                            string="Finish Inspection" type="object"
                            help="Finish Vehicle Inspection"
                            attrs="{'invisible': [('state', '!=', 'inspection_started')]}"/>
                    <button name="action_create_service"
                            class="oe_highlight"
                            string="Create Service" type="object"
                            help="Create Service"
                            attrs="{'invisible': [('state', '!=', 'inspection_started')]}"/>
                    <button name="action_print_report"
                            class="oe_highlight"
                            string="PDF Report"
                            type="object"
                            help="Print PDF Report"
                            attrs="{'invisible': [('state', '!=', 'inspection_finished')]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="get_vehicle_service"
                                icon="fa-wrench"
                                string="Service"
                                attrs="{'invisible': [('service_active', '==', False)]}">
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="get_fleet_vehicle"
                                icon="fa-car"
                                string="Fleet Vehicle"
                                attrs="{'invisible': [('fleet_active', '==', False)]}">
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="New"/>
                            <field name="inspection_id"
                                   placeholder="Vehicle Inspection"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="vehicle_model_id"/>
                            <field name="license_plate"/>
                            <field name="service_active" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_create"/>
                            <field name="inspection_date"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="fleet_active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Inspection Information">
                            <group>
                                <group>
                                    <field name="inspection_result"/>
                                </group>
                                <group>
                                    <field name="internal_note"/>
                                </group>
                            </group>
                        </page>
                        <page name="Inspection Images"
                            attrs="{'invisible': [('state', '!=', 'inspection_started')]}">
                            <field name="inspection_image_ids">
                                <kanban>
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="image"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div t-attf-class="oe_kanban_global_click">
                                                <div class="o_kanban_image">
                                                    <field name="image"
                                                           widget="image"
                                                           class="oe_avatar"/>
                                                </div>
                                                <div class="oe_kanban_details">
                                                    <t class="o_kanban_record_title">
                                                        <strong>
                                                            <field name="name"/>
                                                        </strong>
                                                        <br/>

                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>

                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="image"/>
                                        </group>
                                    </sheet>
                                </form>

                            </field>

                        </page>
                        <!-- <page name="Inspection Details" attrs="{'invisible': [('state', '!=', 'inspection_started')]}"> -->
                        <page name="Inspection Details">
                            <group>
                                <group string="Exterior Inspection (360 Walk Around)">
                                    <field name="exterior_visible_damage_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="exterior_four_tyres_inflated_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="exterior_fluid_leakage_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="exterior_clean_appearance_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="exterior_four_tyres_inflated_gauge_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="exterior_tread_depth_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="exterior_wiper_blades_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                </group>

                                <!-- Interior -->
                                <group string="Interior Inspection">
                                    <field name="interior_clean_check" widget="radio" options="{'horizontal': true}"/>
                                    <field name="interior_visible_damage_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_safety_belts_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_first_aid_kit_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_emergency_kit_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_registration_accessible_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_insurance_accessible_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_spare_tyre_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_jack_system_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_owner_manual_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="interior_accident_kit_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                </group>
                                <group string="Operating Inspection">
                                    <field name="operating_headlights_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_taillights_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_brake_lights_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_backup_lights_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_interior_lights_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_windscreen_wipers_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_horn_check" widget="radio" options="{'horizontal': true}"/>
                                    <field name="operating_mirrors_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_parking_brake_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_turn_signals_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_sun_visor_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_heating_cooling_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="operating_fuel_tank_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                </group>
                                <group string="Under-The Hood Inspection">
                                    <field name="underhood_engine_oil_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="underhood_windshield_fluid_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="underhood_power_steering_fluid_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="underhood_transmission_fluid_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="underhood_brake_fluid_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="underhood_coolant_level_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="underhood_belt_condition_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                </group>
                                <group string="Post-Trip Inspection">
                                    <field name="posttrip_vehicle_operate_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="posttrip_warning_lights_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="posttrip_warning_light_display_check" widget="radio"
                                           options="{'horizontal': true}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <!--tree view-->
    <record id="inspection_requests_view_tree" model="ir.ui.view">
        <field name="name">inspection.request.view.tree</field>
        <field name="model">inspection.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="inspection_id"/>
                <field name="vehicle_id"/>
                <field name="vehicle_model_id"/>
                <field name="license_plate"/>
                <field name="date_create"/>
                <field name="inspection_date"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'inspection_finished'"
                       decoration-warning="state == 'inspection_started'"
                       decoration-info="state =='new'"
                />
            </tree>
        </field>
    </record>
    <!--kanban view-->
    <record id="inspection_request_view_kanban" model="ir.ui.view">
        <field name="name">inspection.request.view.kanban</field>
        <field name="model">inspection.request</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card">
                                    <div>
                                        <b>
                                            <field name="inspection_id"
                                                   style="color:red;"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            Vehicle:
                                            <field name="vehicle_id"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            Model:
                                            <field name="vehicle_model_id"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            Inspection Supervisor:
                                            <field name="user_id"/>
                                        </b>
                                    </div>
                                    <div>
                                        <b>
                                            Inspection Date:
                                            <field name="inspection_date"/>
                                        </b>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--calendar view-->
    <record model="ir.ui.view" id="view_calendar_inspection_request">
        <field name="name">inspection.request.calendar</field>
        <field name="model">inspection.request</field>
        <field eval="2" name="priority"/>
        <field name="arch" type="xml">
            <calendar date_start="inspection_date"
                      string="Inspection Request" mode="month">
                <field name="name"/>
                <field name="inspection_id"/>
                <field name="vehicle_id"/>
                <field name="vehicle_model_id"/>
                <field name="user_id"/>
                <field name="inspection_date"/>
            </calendar>
        </field>
    </record>
    <!--    search view-->
    <record id="inspection_request_view_search" model="ir.ui.view">
        <field name="name">inspection.request.view.search</field>
        <field name="model">inspection.request</field>
        <field name="arch" type="xml">
            <search string="Search">
                <group expand="1" string="Group By">
                    <filter string="Model" name="vehicle_model_id"
                            context="{'group_by':'vehicle_model_id', 'residual_visible':True}"/>
                    <filter string="Vehicle" name="vehicle_id"
                            context="{'group_by':'vehicle_id', 'residual_visible':True}"/>
                    <filter string="Status" name="state"
                            context="{'group_by':'state', 'residual_visible':True}"/>
                    <filter string="Inspection Date" name="inspection_date"
                            context="{'group_by':'inspection_date', 'residual_visible':True}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>