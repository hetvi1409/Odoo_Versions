<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_job_card_action" model="ir.actions.act_window">
        <field name="name">Fleet Job Cards</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fleet.job.card</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="fleet_job_card_menu"
              name="Job Cards"
              parent="fleet_vehicle_inspection_management.fleet_operations_menu"
              action="fleet_job_card_action"/>

    <record id="fleet_job_card_view_form" model="ir.ui.view">
        <field name="name">fleet.job.card.view.form</field>
        <field name="model">fleet.job.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="driver_sap_number"/>
                            <field name="hours_worked"/>
                        </group>
                        <group>
                            <field name="client_name"/>
                            <field name="client_department"/>
                            <field name="po_number"/>
                            <field name="hours_with_client"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_kms"/>
                            <field name="end_kms"/>
                        </group>
                        <group>
                            <field name="service_rating"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Description">
                            <field name="work_description"/>
                        </page>
                        <page string="Feedback">
                            <field name="service_feedback"/>
                            <field name="comments"/>
                        </page>
                        <page string="Signatures">
                            <group>
                                <field name="driver_signature" widget="signature"/>
                                <field name="fleet_manager_signature" widget="signature"/>
                                <field name="client_signature" widget="signature"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fleet_job_card_view_tree" model="ir.ui.view">
        <field name="name">fleet.job.card.view.tree</field>
        <field name="model">fleet.job.card</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="hours_worked"/>
            </tree>
        </field>
    </record>
</odoo>
