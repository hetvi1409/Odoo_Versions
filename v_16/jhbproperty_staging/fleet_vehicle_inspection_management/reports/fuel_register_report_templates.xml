<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fuel Register Report Template -->
    <template id="report_fuel_register_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>

                <div class="row">
                    <div class="col-12">
                        <h2 class="text-center">
                            <strong>JPC FUEL REGISTER</strong>
                        </h2>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Month:</strong> <span t-field="o.month"/>
                    </div>
                    <div class="col-6">
                        <strong>Year:</strong> <span t-field="o.year"/>
                    </div>
                </div>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Driver Name</th>
                            <th>Depot Name</th>
                            <th>Reg Num</th>
                            <th>Make</th>
                            <th>Opening Odo</th>
                            <th>Closing Odo</th>
                            <th>Total KM</th>
                            <th>Liters</th>
                            <th>Fuel Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.line_ids" t-as="line">
                            <tr>
                                <td><span t-field="line.date"/></td>
                                <td><span t-field="line.driver_id.name"/></td>
                                <td><span t-field="o.depot_name"/></td>
                                <td><span t-field="line.vehicle_id.license_plate"/></td>
                                <td><span t-field="line.vehicle_id.model_id.name"/></td>
                                <td><span t-field="line.opening_odometer"/></td>
                                <td><span t-field="line.closing_odometer"/></td>
                                <td><span t-field="line.total_kms"/></td>
                                <td><span t-field="line.liters"/></td>
                                <td><span t-field="line.fuel_value"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row mt-5">
                    <div class="col-6 text-center">
                        <p>_____________________</p>
                        <p><strong>Depot Manager</strong></p>
                    </div>
                    <div class="col-6 text-center">
                        <p>_____________________</p>
                        <p><strong>Fleet Office</strong></p>
                    </div>
                </div>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_fuel_register">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fleet_vehicle_inspection_management.report_fuel_register_document"/>
            </t>
        </t>
    </template>
</odoo>
